-enum AddressSpace { AS_Memory, AS_ZeroPage, NumAddrSpaces };
+// AS_Memory  (0): 16-bit absolute pointer (6502 default; data-bank-relative on 65816).
+// AS_ZeroPage(1): 8-bit direct-page pointer.
+// AS_Far     (2): 32-bit "far" pointer — 65816 24-bit address in the low 3 bytes,
+//                 top byte unused (32-bit stays a simple MVT type; there is no MVT::i24). #320 Inc 1.
+// AS_FarPacked(3): 24-bit "packed" far pointer — the 3-byte STORAGE form of AS_Far. A
+//                 memory-only type: it converts to/from AS_Far (truncate/extend the pad
+//                 byte) at load/store and is NEVER held as a 24-bit register value, so it
+//                 needs no MVT::i24 / 24-bit register class. #320 five-address-space model.
+enum AddressSpace { AS_Memory, AS_ZeroPage, AS_Far, AS_FarPacked, NumAddrSpaces };
 
