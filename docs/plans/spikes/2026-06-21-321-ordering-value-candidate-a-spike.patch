+// #321 native s16 ordering-as-value: `rol a` in 16-bit-accumulator mode rotates the
+// carry into bit 0 of A16 while shifting left. Seeded from `lda #$0000` (A16=0), one
+// `rol a` yields A16 = carry (0/1) — the branchless boolean for an unsigned/signed
+// ORDERING compare consumed as a VALUE (`b = (a >= c)`), replacing the control-flow
+// select-diamond. Mirrors RORAcc16 (the carry is an operand, carry-out modeled but
+// dead here); MLow=1 so MOSInsertREPSEP keeps it inside the surrounding 16-bit run —
+// no sep, no churn (the v1 8-bit `lda #0; adc #0` tail's sep regressed a16cmpaudit).
+// The carry-in must reach here un-clobbered from the cmp/G_SBC; the Cc operand
+// dependence enforces that carry-liveness invariant. Emitted by selectCarryBool16.
+def ROLAcc16 : MOSLogicalInstr, PseudoInstExpansion<(ROL_Accumulator)> {
+  let Predicates = [HasAccum16];
+  let MLow = 1;
+  let Constraints = "$dst = $src";
+  dag OutOperandList = (outs Ac16:$dst, Cc:$carryout);
+  dag InOperandList = (ins Ac16:$src, Cc:$carryin);
+}
+
+// lda #imm16 — load a 16-bit immediate into A16 (M=0). LDA_Immediate16 is generated
+// by the CC1_All multiclass (like CMP_Immediate16). MLow=1 so MOSInsertREPSEP runs it
+// inside the 16-bit region. `lda` sets only N/Z (NOT C), so it is carry-transparent:
+// selectCarryBool16 uses it to seed `lda #$0000` between the ordering cmp (which sets
+// C) and the `rol a` that rotates C into bit 0, without disturbing that carry.
+def LDAImm16 : MOSLogicalInstr, PseudoInstExpansion<(LDA_Immediate16 imm16:$val)> {
+  let Predicates = [HasAccum16];
+  let MLow = 1;
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList = (ins imm16:$val);
+}
