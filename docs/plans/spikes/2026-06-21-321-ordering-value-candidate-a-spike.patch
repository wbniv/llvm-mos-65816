+// #321 native s16 ordering-as-value: lower G_CARRY_BOOL16 (Dst:s16 = the C flag of a
+// 16-bit ordering G_SBC) to a branchless `lda #$0000; rol a` materialization at M=0.
+// `rol a` rotates the carry into bit 0 of A16 (which `lda #$0000` cleared), so
+// A16 = carry (0/1); the result lands in Imag16 via STAImag16. The whole run is M=0
+// (LDAImm16/ROLAcc16/STAImag16 are MLow=1), so it sits inside the ambient 16-bit
+// region with no rep/sep — the mode-matched fix for the v1 8-bit `adc` tail's churn.
+// Carry-liveness: `lda #imm` sets only N/Z, so the carry from the cmp survives to the
+// rol; the explicit Cc carry-in operand keeps that dependence intact through regalloc.
+// The value enters A16 only via LDAImm16 and leaves only via STAImag16 — never an
+// Ac16<->8-bit COPY (the coalescer invariant the other native-s16 selectors honor).
+bool MOSInstructionSelector::selectCarryBool16(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  Register Dst = MI.getOperand(0).getReg();   // s16 result (Imag16-resident)
+  Register Carry = MI.getOperand(1).getReg(); // s1 — the ordering G_SBC carry-out
+
+  SmallVector<MachineInstrBuilder, 4> New;
+
+  // lda #$0000 -> A16  (carry-transparent: lda touches only N/Z)
+  Register Zero = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  New.push_back(Builder.buildInstr(MOS::LDAImm16).addDef(Zero).addImm(0));
+
+  // rol a -> A16 = (A16 << 1) | C = carry (A16 was 0). The carry-out (old bit 15 = 0)
+  // is dead.
+  Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  Register DeadCarry = MRI.createVirtualRegister(&MOS::CcRegClass);
+  New.push_back(Builder.buildInstr(MOS::ROLAcc16)
+                    .addDef(Res)
+                    .addDef(DeadCarry)
+                    .addUse(Zero)
+                    .addUse(Carry));
+
+  // sta dst (16-bit): the Imag16 dst is DEF'd by the store (imaginary-reg write).
+  New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Res));
+
+  for (MachineInstrBuilder &Bld : New)
+    constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
 
   MI.eraseFromParent();
   return true;
