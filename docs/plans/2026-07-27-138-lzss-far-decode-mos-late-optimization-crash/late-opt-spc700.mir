# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-late-opt -verify-machineinstrs -o - %s | FileCheck %s

# #138 regression: on SPC700, MOSInstrInfo::getRegClass widens LDImm's
# destination register class to Anyi8, so `$rcN = LDImm imm` (`mov dp, #imm`)
# is legal, verifier-clean MIR.  combineLdImm switched the destination over
# {A, X, Y} only and then unconditionally stored through the resulting
# ImmLoad*, which is null for any other destination -> SIGSEGV.
#
# The primary assertion is "no crash + machine verification succeeds"; the
# CHECK lines additionally pin that an imaginary destination is transparent to
# the A/X/Y value tracking (it clobbers none of them).
#
# NOTE: the CHECK lines below are hand-written and MUST be regenerated with
# llvm/utils/update_mir_test_checks.py once the fix is built.

---
name: ldimm_imag8_only
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: ldimm_imag8_only
    ; CHECK: $rc2 = LDImm 42
    ; CHECK-NEXT: RTS implicit $rc2
    $rc2 = LDImm 42
    RTS implicit $rc2
...
---
name: ldimm_imag8_between_gprs
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: ldimm_imag8_between_gprs
    ; CHECK: $a = LDImm 7
    ; CHECK-NEXT: $rc2 = LDImm 7
    ; CHECK-NEXT: $x = TA $a
    ; CHECK-NEXT: RTS implicit $a, implicit $x, implicit $rc2
    $a = LDImm 7
    $rc2 = LDImm 7
    $x = LDImm 7
    RTS implicit $a, implicit $x, implicit $rc2
...
