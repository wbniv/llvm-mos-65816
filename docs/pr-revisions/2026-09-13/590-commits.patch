From 532900273ba95cda6b832de005d2034e031c4eaf Mon Sep 17 00:00:00 2001
From: Will Norris <will@biohack.net>
Date: Mon, 14 Sep 2026 04:12:18 +0700
Subject: [PATCH 3/3] [MOS] Explain why allocation iteration must be
 deterministic

---
 llvm/lib/Target/MOS/MOSZeroPageAlloc.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/Target/MOS/MOSZeroPageAlloc.cpp b/llvm/lib/Target/MOS/MOSZeroPageAlloc.cpp
index 4d2d87272c39..3651cf6413b2 100644
--- a/llvm/lib/Target/MOS/MOSZeroPageAlloc.cpp
+++ b/llvm/lib/Target/MOS/MOSZeroPageAlloc.cpp
@@ -416,8 +416,9 @@ SCCGraph MOSZeroPageAlloc::buildSCCGraph(Module &M) {
   LLVM_DEBUG(CG.dump());
 
   std::vector<SCC> SCCs;
-  // Iteration order must be deterministic for SCCCallees, GlobalBenefit, and
-  // CalleeFreqs.
+  // Keep SCCCallees, GlobalBenefit, and CalleeFreqs iteration deterministic:
+  // it affects allocation tie-breaking and floating-point accumulation, which
+  // can otherwise change zero-page placement for identical inputs.
   std::vector<SmallSetVector<const CallGraphNode *, 4>> SCCCallees;
   DenseMap<const CallGraphNode *, size_t> SCCIdx;
   std::vector<std::unique_ptr<Candidate>> Candidates;
-- 
