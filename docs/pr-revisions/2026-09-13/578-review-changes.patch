--- a/llvm/test/CodeGen/MOS/coalesce-rotate-ac.mir
+++ /dev/null
@@ -1,25 +0,0 @@
-# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=register-coalescer %s -o - | FileCheck %s
-
-# A value used by a rotate (ROL) is pinned to the accumulator (the Ac class), the
-# only register the rotate can read/write. Coalescing two such values together
-# into Ac removes the COPY that lets the live value vacate A when the other arm of
-# an enclosing conditional needs A (e.g. an inlined CRC16 bit loop). That strands
-# the value and the back-edge rotate reads a stale A -> a silent miscompile. The
-# coalescer must keep the COPY (MOSRegisterInfo::shouldCoalesce).
----
-name: dont_coalesce_rotate_into_ac
-tracksRegLiveness: true
-body: |
-  bb.0:
-    liveins: $a, $c
-    ; CHECK: [[ROL:%[0-9]+]]:ac, {{[^=]*}} = ROL %0
-    ; CHECK-NEXT: %{{[0-9]+}}:ac = COPY [[ROL]]
-    ; CHECK-NEXT: {{%[0-9]+}}:ac, {{.*}} = ROL
-    %0:ac = COPY $a
-    %1:cc = COPY $c
-    %2:ac, %3:cc = ROL %0, %1
-    %4:ac = COPY %2
-    %5:ac, %6:cc = ROL %4, %3
-    $a = COPY %5
-    RTS implicit $a
-...
diff --git a/llvm/test/CodeGen/MOS/copy-opt-loop.mir b/llvm/test/CodeGen/MOS/copy-opt-loop.mir
new file mode 100644
index 000000000000..84071e1e02bd
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/copy-opt-loop.mir
@@ -0,0 +1,51 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=mos-copy-opt -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=COPY
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=mos-copy-opt,postrapseudos,mos-late-opt -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=LOWER
+
+# Forwarding the loop header's A = COPY Y makes A live across the latch.
+# The sign test must not clobber A after its new value is copied to Y.
+---
+name: copy_forward_loop
+tracksRegLiveness: true
+body: |
+  bb.0.entry:
+    liveins: $a, $x, $rc28
+    $y = COPY $a
+    BRA %bb.1
+
+  bb.1:
+    liveins: $x, $y, $rc28
+    ; COPY-LABEL: bb.1:
+    ; COPY: liveins: {{.*}}$a{{.*}}
+    ; COPY: $rc2 = COPY $a
+    ; COPY: $a, dead $c = ROL
+    ; LOWER-LABEL: bb.1:
+    ; LOWER: $a, dead $c = ROL
+    ; LOWER-NOT: $a = LDImag8 $rc2
+    ; LOWER: BR %bb.3
+    $a = COPY $y
+    $rc2 = COPY $y
+    $rc28, $c = ASL $rc28
+    $a, dead $c = ROL $a, $c
+    $y = COPY $a
+    CmpBrZero %bb.3, undef $n, 0, $rc2, implicit-def $c
+
+  bb.2:
+    liveins: $x, $y, $rc28
+    $a = COPY $rc28
+    $a = EORImm $a, 33
+    $rc28 = COPY $a
+    $a = COPY $y
+    $a = EORImm $a, 16
+    $y = COPY $a
+
+  bb.3:
+    liveins: $x, $y, $rc28
+    ; COPY-LABEL: bb.3:
+    ; COPY: liveins: {{.*}}$a{{.*}}
+    $x = DEC $x
+    CmpBrZero %bb.1, undef $z, 0, $x, implicit-def dead $c
+
+  bb.4:
+    liveins: $y, $rc28
+    RTS implicit $y, implicit $rc28
+...
