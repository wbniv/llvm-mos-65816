diff --git a/examples/snes/snesgfx/dispatch.h b/examples/snes/snesgfx/dispatch.h
new file mode 100644
index 0000000..26a546c
--- /dev/null
+++ b/examples/snes/snesgfx/dispatch.h
@@ -0,0 +1,41 @@
+/* snesgfx — dispatch.h: the SNESGFX_DISPATCH experiment switch (static vs all-virtual).
+ *
+ * Selects how every snesgfx "member function" (`Type_verb(Type *self, …)`) is dispatched:
+ *
+ *   SNESGFX_DISPATCH=0  static inline (production default — byte-identical to the pre-switch code)
+ *   SNESGFX_DISPATCH=1  out-of-line direct calls: impls are noinline, call sites still direct.
+ *                       Isolates the LOSS-OF-INLINING cost (an address-taken impl can't inline).
+ *   SNESGFX_DISPATCH=2  per-type vtable: every member call goes self->vt->verb(self, …).
+ *                       Adds the INDIRECT-DISPATCH cost on top of mode 1.
+ *
+ * Scope exclusions (see docs/oop-in-c.md §8): constructors (*_init — they SET the vt pointer),
+ * HScrollN-receiver functions (HScrollN.tab is the literal DMA-visible HDMA table; a vt member
+ * would corrupt its layout), free functions (splash_show, m7splash* — no receiver), and the
+ * pre-existing DrawableVT (already virtual by design).
+ *
+ * Each Type_verb is a static-inline forwarder around a _Type_verb_impl; all demos compile
+ * unchanged in every mode. Header-only. */
+#ifndef SNESGFX_DISPATCH_H
+#define SNESGFX_DISPATCH_H
+
+#ifndef SNESGFX_DISPATCH
+#define SNESGFX_DISPATCH 0
+#endif
+
+#if SNESGFX_DISPATCH == 0
+#define SNESGFX_IMPL static inline
+#else
+/* noinline: force a real out-of-line function (modes 1 & 2). unused: a demo that includes a
+   header without calling some member must not warn (static non-inline functions do). */
+#define SNESGFX_IMPL static __attribute__((noinline, unused))
+#endif
+
+/* Constructor helper: install a type's vtable in mode 2; expands to nothing otherwise
+   (the vtable symbol does not exist outside mode 2 — the macro must not reference it). */
+#if SNESGFX_DISPATCH == 2
+#define SNESGFX_SET_VT(obj, vtbl) ((obj)->vt = &(vtbl))
+#else
+#define SNESGFX_SET_VT(obj, vtbl) ((void)0)
+#endif
+
+#endif /* SNESGFX_DISPATCH_H */
