diff --git a/dev/measure-snesgfx-dispatch.sh b/dev/measure-snesgfx-dispatch.sh
new file mode 100755
index 0000000..cafced5
--- /dev/null
+++ b/dev/measure-snesgfx-dispatch.sh
@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# dev/measure-snesgfx-dispatch.sh — static vs all-virtual snesgfx dispatch: size + throughput.
+#
+# Builds examples/snes/snesgfx_bench.c at SNESGFX_DISPATCH = 0 (static inline, production),
+# 1 (out-of-line direct calls), 2 (per-type vtables), then for each mode:
+#   - .text bytes (the bench's .lto.o lines in the linker map)
+#   - indirect dispatch call sites (jmp-ind + jsr-ind + jsr __call_indir) in the ELF
+#   - correctness: corpus_result == host oracle (tools/snesgfx-bench-oracle.c) on bsnes-jg
+#   - throughput: `iters` (full canvas redraws) completed after BENCH_FRAMES deterministic
+#     bsnes-jg frames — more iters == cheaper dispatch. No MAME leg: the SPC700 IPL is not
+#     present in this environment; the deterministic bsnes-jg core carries the verdict
+#     (the repo's JG_ONLY convention, cf. dev/_emu.sh require_bios).
+#
+# Drive: dev/run.sh measure-snesgfx-dispatch. Env: BENCH_FRAMES (default 600 ≈ 10 s emulated).
+set -euo pipefail
+case "${1-}" in -h|--help)
+  echo "Usage: dev/run.sh measure-snesgfx-dispatch   # 3-mode dispatch-cost benchmark (bsnes-jg)"
+  exit 0;; esac
+
+ROOT=/work
+BUILD="$ROOT/build"
+TOOL="${MOS_TOOLCHAIN:-$BUILD/llvm-mos-install}/bin"
+CFG="$BUILD/install/bin/mos-snes.cfg"
+SRC="$ROOT/examples/snes/snesgfx_bench.c"
+VENDOR="$ROOT/vendor/bsnes-jg"
+JGX="$BUILD/jgxcheck"
+FRAMES="${BENCH_FRAMES:-600}"
+
+[ -x "$TOOL/mos-clang" ] || { echo "FATAL: no from-source toolchain at $TOOL"; exit 1; }
+[ -f "$CFG" ] || { echo "FATAL: SDK/snes not built"; exit 1; }
+[ -x "$JGX" ] || { echo "FATAL: build/jgxcheck missing (run a demo gate once to build it)"; exit 1; }
+
+"$ROOT/dev/sync-platform.sh"
+
+# Host oracle: the expected corpus_result (independent reimplementation).
+cc -O2 -o "$BUILD/snesgfx-bench-oracle" "$ROOT/tools/snesgfx-bench-oracle.c"
+WANT="$("$BUILD/snesgfx-bench-oracle")"
+echo "==> snesgfx dispatch benchmark: host oracle corpus_result=$WANT, frames=$FRAMES"
+echo
+
+declare -A TEXTSZ IND ITERS CRCOK
+
+for m in 0 1 2; do
+  rom="$BUILD/snesgfx-bench-m$m.sfc"
+  map="$BUILD/snesgfx-bench-m$m.map"
+  "$TOOL/mos-clang" --config "$CFG" -mcpu=mosw65816 \
+    -Xclang -target-feature -Xclang +mos-a16 -Os \
+    -mllvm -verify-machineinstrs \
+    -DSNESGFX_DISPATCH=$m \
+    -Wl,-Map="$map" -o "$rom" "$SRC"
+  python3 "$ROOT/tools/snes-checksum.py" "$rom" >/dev/null
+
+  # .text bytes attributed to the bench's LTO object (library/crt excluded).
+  # (bash 16# arithmetic, not awk strtonum — the container's mawk lacks it.)
+  sum=0
+  for h in $(awk "/snesgfx-bench-m$m\\.sfc\\.lto\\.o.*\\.text/{print \$3}" "$map"); do
+    sum=$((sum + 16#$h))
+  done
+  TEXTSZ[$m]=$sum
+
+  # Indirect dispatch call sites in the ELF (must exist — a missing ELF must FAIL, not read 0).
+  elf="$rom.elf"
+  [ -f "$elf" ] || { echo "FATAL: $elf missing"; exit 1; }
+  IND[$m]=$("$TOOL/llvm-objdump" -d --mcpu=mosw65816 "$elf" \
+              | grep -cE 'jmp \(|jsr \(|jsr.*<__call_indir>' || true)
+
+  # WRAM offsets from the linker map.
+  caddr=$(awk '$NF=="corpus_result"{print $1; exit}' "$map")
+  iaddr=$(awk '$NF=="iters"{print $1; exit}' "$map")
+  [ -n "$caddr" ] && [ -n "$iaddr" ] || { echo "FATAL: corpus_result/iters not in $map"; exit 1; }
+
+  # Leg 1 — correctness: corpus_result must equal the host oracle after $FRAMES frames.
+  line_c="$("$JGX" "$rom" "$VENDOR/Database" "0x$caddr" 2 "$WANT" "$FRAMES" 2>/dev/null | grep -m1 '^SMOKE:' || true)"
+  echo "  mode $m corpus:  $line_c"
+  case "$line_c" in "SMOKE: PASS"*) CRCOK[$m]=1 ;; *) CRCOK[$m]=0 ;; esac
+
+  # Leg 2 — throughput: read the 4-byte iters counter at the same fixed frame (want
+  # deliberately impossible; the printed got= carries the value on the FAIL line).
+  line_i="$("$JGX" "$rom" "$VENDOR/Database" "0x$iaddr" 4 0xFFFFFFFF "$FRAMES" 2>/dev/null | grep -m1 '^SMOKE:' || true)"
+  got=$(printf '%s' "$line_i" | sed -n 's/.*got=0x\([0-9A-Fa-f]*\).*/\1/p')
+  ITERS[$m]=$((16#${got:-0}))
+  echo "  mode $m iters:   ${ITERS[$m]}  (raw: $line_i)"
+done
+
+echo
+echo "==> RESULTS (bsnes-jg, $FRAMES deterministic frames; iters = full canvas redraws)"
+printf '  %-28s %10s %10s %10s\n' "mode" ".text B" "ind.calls" "iters"
+printf '  %-28s %10s %10s %10s\n' "0 static inline (today)"    "${TEXTSZ[0]}" "${IND[0]}" "${ITERS[0]}"
+printf '  %-28s %10s %10s %10s\n' "1 out-of-line direct"       "${TEXTSZ[1]}" "${IND[1]}" "${ITERS[1]}"
+printf '  %-28s %10s %10s %10s\n' "2 all-virtual (vtables)"    "${TEXTSZ[2]}" "${IND[2]}" "${ITERS[2]}"
+if [ "${ITERS[1]}" -gt 0 ] && [ "${ITERS[2]}" -gt 0 ]; then
+  r01=$(awk "BEGIN{printf \"%.2f\", ${ITERS[0]}/${ITERS[1]}}")
+  r12=$(awk "BEGIN{printf \"%.2f\", ${ITERS[1]}/${ITERS[2]}}")
+  r02=$(awk "BEGIN{printf \"%.2f\", ${ITERS[0]}/${ITERS[2]}}")
+  echo "  inlining-loss cost   (iters0/iters1): ${r01}x"
+  echo "  indirection cost     (iters1/iters2): ${r12}x"
+  echo "  total virtual cost   (iters0/iters2): ${r02}x"
+fi
+
+rc=0
+for m in 0 1 2; do [ "${CRCOK[$m]}" = 1 ] || { echo "FAIL: mode $m corpus_result mismatch"; rc=1; }; done
+# Mode 1 BEATING mode 0 is a real 65816 effect (out-of-line calls shrink the caller's
+# a16 register/ZP live set — same reason canvas_line was already noinline). But virtual
+# dispatch (2) beating direct calls (1) would be nonsense — flag that.
+[ "${ITERS[1]}" -ge "${ITERS[2]}" ] \
+  || echo "NOTE: mode 2 (virtual) outran mode 1 (direct) — implausible; investigate before quoting"
+if [ "$rc" -eq 0 ]; then echo "RESULT: PASS — all 3 modes correct; see table"; else echo "RESULT: FAIL"; fi
+exit $rc
