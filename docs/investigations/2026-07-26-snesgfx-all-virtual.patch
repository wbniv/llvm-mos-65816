@@ -0,0 +1,54 @@
+// snesgfx dispatch-cost CYCLE benchmark (SNESGFX_DISPATCH-variant-agnostic).
+//
+// Throughput proxy for the static-vs-virtual dispatch measurement
+// (dev/measure-snesgfx-dispatch.sh). Hammers the snesgfx hot path — canvas_clear +
+// a 12-line star via canvas_line (whose Bresenham loop calls canvas_plot per pixel,
+// so dispatch mode 2 pays a virtual call per plotted pixel) — in an INFINITE loop
+// that increments a volatile counter `iters` per full redraw. The harness runs a
+// FIXED number of bsnes-jg frames (deterministic emulation), then reads `iters`:
+// more redraws completed in the same wall of emulated time == cheaper dispatch for
+// that mode. No MAME leg: the SPC700 IPL is not present in this environment, and the
+// deterministic bsnes-jg core carries the verdict (the repo's JG_ONLY convention).
+//
+// corpus_result = CRC16-CCITT of the 4 KB canvas chr shadow after the FIRST redraw —
+// the correctness sentinel: a fast-but-wrong dispatch mode can't score. The host
+// oracle (tools/snesgfx-bench-oracle.c) reimplements plot/line/CRC independently.
+//
+// Variant = build flag: -DSNESGFX_DISPATCH={0,1,2}. Source identical across modes.
+//   mos-clang --config .../mos-snes.cfg -mcpu=mosw65816 +mos-a16 -Os
+// See docs/plans/2026-07-26 (snesgfx all-virtual dispatch benchmark).
+
+#include <stdint.h>
+#include "snesgfx/bitmap_canvas.h"
+
+volatile uint16_t corpus_result;  // CRC16 of chr after redraw #1 (correctness sentinel)
+volatile uint32_t iters;          // full redraws completed; sampled at a fixed frame
+
+static BitmapCanvas canvas;       // 4 KB chr shadow in bank-0 WRAM .bss
+
+// The 12-point star: centre (64,64) to 12 perimeter points of the 128x128 canvas.
+// Endpoints chosen so lines cover all octants (Bresenham takes every branch shape).
+static const int16_t STAR_X[12] = { 64, 96, 120, 120, 96, 64, 32,  8,  8, 32, 127,  0 };
+static const int16_t STAR_Y[12] = {  0,  8,  32,  96, 120, 127, 120, 96, 32,  8, 64, 64 };
+
+static uint16_t crc16_chr(void) {
+  uint16_t crc = 0xFFFF;
+  for (uint16_t i = 0; i < CANVAS_NTILES * CANVAS_TILEBYTES; i++) {
+    crc ^= (uint16_t)((uint16_t)canvas.chr[i] << 8);
+    for (uint8_t b = 0; b < 8; b++)
+      crc = (uint16_t)((crc & 0x8000u) ? (uint16_t)(crc << 1) ^ 0x1021u : (uint16_t)(crc << 1));
+  }
+  return crc;
+}
+
+int main(void) {
+  canvas_init(&canvas, 0x2000, 0x0400, 8, 6);   // VRAM words irrelevant — never uploaded
+  iters = 0;
+  for (;;) {
+    canvas_clear(&canvas);
+    for (uint8_t i = 0; i < 12; i++)
+      canvas_line(&canvas, 64, 64, STAR_X[i], STAR_Y[i], (uint8_t)(1u + (i & 1u)));
+    if (iters == 0) corpus_result = crc16_chr();  // sentinel from redraw #1 only
+    iters = iters + 1;                            // volatile RMW: forces the redraw + counts it
+  }
+}
diff --git a/tools/snesgfx-bench-oracle.c b/tools/snesgfx-bench-oracle.c
new file mode 100644
index 0000000..984b171
--- /dev/null
+++ b/tools/snesgfx-bench-oracle.c
@@ -0,0 +1,55 @@
+/* Host oracle for examples/snes/snesgfx_bench.c — INDEPENDENT reimplementation of the
+ * canvas plot/line rasterizer + CRC16 so the ROM's corpus_result can be checked against
+ * host-computed truth (the repo's host-vs-target differential discipline).
+ * Prints the expected 16-bit CRC as 0xXXXX. Build: cc -O2 -o bench-oracle snesgfx-bench-oracle.c */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define W 128
+#define H 128
+#define TILES_W 16
+#define TILEBYTES 16
+
+static uint8_t chr[256 * TILEBYTES];
+
+static void plot(int16_t x, int16_t y, uint8_t color) {
+  if ((uint16_t)x >= W || (uint16_t)y >= H) return;
+  uint16_t tile = (uint16_t)(((uint16_t)y >> 3) * TILES_W + ((uint16_t)x >> 3));
+  uint8_t *t = &chr[tile * TILEBYTES + ((uint8_t)y & 7) * 2];
+  uint8_t mask = (uint8_t)(0x80u >> ((uint8_t)x & 7));
+  if (color & 1) t[0] |= mask;
+  if (color & 2) t[1] |= mask;
+}
+
+static void line(int16_t x0, int16_t y0, int16_t x1, int16_t y1, uint8_t color) {
+  int16_t dx = (int16_t)(x1 > x0 ? x1 - x0 : x0 - x1);
+  int16_t dy = (int16_t)(y1 > y0 ? y1 - y0 : y0 - y1);
+  int16_t sx = (int16_t)(x0 < x1 ? 1 : -1);
+  int16_t sy = (int16_t)(y0 < y1 ? 1 : -1);
+  int16_t err = (int16_t)(dx - dy);
+  for (;;) {
+    plot(x0, y0, color);
+    if (x0 == x1 && y0 == y1) break;
+    int16_t e2 = (int16_t)(err * 2);
+    if (e2 > -dy) { err = (int16_t)(err - dy); x0 = (int16_t)(x0 + sx); }
+    if (e2 <  dx) { err = (int16_t)(err + dx); y0 = (int16_t)(y0 + sy); }
+  }
+}
+
+static const int16_t STAR_X[12] = { 64, 96, 120, 120, 96, 64, 32,  8,  8, 32, 127,  0 };
+static const int16_t STAR_Y[12] = {  0,  8,  32,  96, 120, 127, 120, 96, 32,  8, 64, 64 };
+
+int main(void) {
+  memset(chr, 0, sizeof chr);
+  for (uint8_t i = 0; i < 12; i++)
+    line(64, 64, STAR_X[i], STAR_Y[i], (uint8_t)(1u + (i & 1u)));
+  uint16_t crc = 0xFFFF;
+  for (uint16_t i = 0; i < sizeof chr; i++) {
+    crc ^= (uint16_t)((uint16_t)chr[i] << 8);
+    for (uint8_t b = 0; b < 8; b++)
+      crc = (uint16_t)((crc & 0x8000u) ? (uint16_t)(crc << 1) ^ 0x1021u : (uint16_t)(crc << 1));
+  }
+  printf("0x%04X\n", crc);
+  return 0;
+}
