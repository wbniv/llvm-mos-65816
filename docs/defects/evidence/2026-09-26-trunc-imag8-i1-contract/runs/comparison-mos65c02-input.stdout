--- |
  ; ModuleID = '/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-trunc-imag8-i1/input.ll'
  source_filename = "/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-trunc-imag8-i1/input.ll"
  target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-p3:24:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
  target triple = "mos"
  
  ; Function Attrs: norecurse
  define i8 @trunc_imag8_i1(i8 %a, i8 %x) #0 {
  entry:
    %bit = trunc i8 %x to i1
    br i1 %bit, label %subtract, label %done
  
  subtract:                                         ; preds = %entry
    %difference = sub i8 %a, %x
    br label %done
  
  done:                                             ; preds = %subtract, %entry
    %result = phi i8 [ %difference, %subtract ], [ %a, %entry ]
    ret i8 %result
  }
  
  attributes #0 = { norecurse "nonreentrant" "target-cpu"="mos65c02" }
...
