body:             |
  bb.0 (%ir-block.0):
    liveins: $x0
  
    %0:gpr64 = COPY $x0
    %1:gpr64common = COPY killed %0
    %9:gpr32 = LDRBBui %1, 7 :: (load (s8) from %ir.p + 7, basealign 8)
    %8:gpr32 = LDRBBui %1, 6 :: (load (s8) from %ir.p + 6, align 2, basealign 8)
    %7:gpr32 = LDRBBui %1, 5 :: (load (s8) from %ir.p + 5, basealign 8)
