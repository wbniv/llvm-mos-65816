--- |
  ; ModuleID = '/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-aarch64-vector-asm/probes/8xi8-noneon.ll'
  source_filename = "/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-aarch64-vector-asm/probes/8xi8-noneon.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64"
  
  define void @f(ptr %p) #0 {
    %v = load <8 x i8>, ptr %p, align 8
    call void asm sideeffect "", "r"(<8 x i8> %v)
    ret void
  }
  
  attributes #0 = { "target-features"="-neon" }
...
