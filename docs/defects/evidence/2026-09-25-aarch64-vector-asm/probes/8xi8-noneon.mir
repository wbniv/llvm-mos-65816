    %2:gpr32 = LDRBBui %1, 0 :: (load (s8) from %ir.p, align 8)
    %11:gpr32 = BFMWri %6, %7, 24, 23
    %12:gpr32 = UBFMWri %8, 16, 7
    %13:gpr32 = ORRWrs killed %12, %9, 24
    %14:gpr32 = BFMWri %13, killed %11, 0, 15
    %16:gpr64all = IMPLICIT_DEF
    %15:gpr64 = INSERT_SUBREG %16, killed %14, %subreg.sub_32
    %17:gpr32 = BFMWri %2, %3, 24, 23
    %18:gpr32 = UBFMWri %4, 16, 7
    %19:gpr32 = ORRWrs killed %18, %5, 24
    %20:gpr32 = BFMWri %19, killed %17, 0, 15
    %21:gpr32 = ORRWrs $wzr, killed %20, 0
    %22:gpr64 = SUBREG_TO_REG killed %21, %subreg.sub_32
    %23:gpr64 = ORRXrs killed %22, killed %15, 32
    %10:gpr64common = COPY %23
    INLINEASM &"", sideeffect attdialect, reguse:GPR64common, %10
    RET_ReallyLR
