# REQUIRES: thread_support, mos-registered-target
# RUN: llvm-reduce -x=mir -j 2 --delta-passes=instructions --test FileCheck --test-arg --check-prefix=INTERESTING --test-arg %s --test-arg --input-file %s -o %t
# RUN: FileCheck --check-prefix=CHECK %s < %t

# INTERESTING: STAbs {{.*}}, 1
# CHECK: STAbs {{.*}}, 1
# CHECK: RTS

---
name:            parallel_instr_reduce
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gpr = LDImm 1
    undef %1.sublo:imag16 = COPY %0
    %2:imag16 = COPY %1
    %3:gpr = COPY %2.sublo
    STAbs %3, 0
    %4:gpr = COPY %2.subhi
    STAbs %4, 1
    RTS
...
