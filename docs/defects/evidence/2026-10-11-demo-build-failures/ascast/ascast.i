__attribute__((noinline)) static void upq_flush(UploadQueue *q) {
  volatile uint8_t *dma_base =
    (volatile uint8_t *)(uintptr_t)(0x4300u + (uint16_t)q->chan * 0x10u);
  uint8_t mdmaen_bit = (uint8_t)(1u << q->chan);
  uint16_t spent = 0;
  uint8_t i = 0;

  while (i < q->n) {
    UpqJob *j = &q->job[i];

    if (j->port == UPQ_REG) {
      volatile uint8_t *r = (volatile uint8_t *)(uintptr_t)j->dest;
      *r = (uint8_t)j->src;
      *r = (uint8_t)(j->src >> 8);
      i++; continue;
    }
    if (j->port == UPQ_POKE16) {
      volatile uint8_t *r = (volatile uint8_t *)(uintptr_t)j->dest;
      r[0] = (uint8_t)j->src;
      r[1] = (uint8_t)(j->src >> 8);
      i++; continue;
    }


    if (spent && (uint16_t)(spent + j->nbytes) > 5100u) break;

    if (j->port == UPQ_VRAM) { (*(volatile uint8_t *)(uintptr_t)(0x2115)) = j->vmain; (*(volatile uint16_t *)(uintptr_t)(0x2116)) = j->dest; }
    else if (j->port == UPQ_CGRAM) { (*(volatile uint8_t *)(uintptr_t)(0x2121)) = (uint8_t)j->dest; }
    else { (*(volatile uint8_t *)(uintptr_t)(0x2102)) = (uint8_t)j->dest;
                                     (*(volatile uint8_t *)(uintptr_t)(0x2103)) = (uint8_t)(j->dest >> 8); }
    dma_base[0] = j->dmap;
    dma_base[1] = j->bbad;
    dma_base[2] = (uint8_t)j->src;
    dma_base[3] = (uint8_t)(j->src >> 8);
    dma_base[4] = j->src_bank;
    dma_base[5] = (uint8_t)j->nbytes;
    dma_base[6] = (uint8_t)(j->nbytes >> 8);
    (*(volatile uint8_t *)(uintptr_t)(0x420B)) = mdmaen_bit;

    spent = (uint16_t)(spent + j->nbytes);
    i++;
  }


  if (i >= q->n) {
    q->n = 0;
  } else if (i) {
    uint8_t k = 0;
    while (i < q->n) q->job[k++] = q->job[i++];
    q->n = k;
  }
}
