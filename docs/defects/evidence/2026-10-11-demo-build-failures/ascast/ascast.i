typedef struct {
  UploadQueue q;
  VramAlloc va;
  Scene scene;
  uint8_t tm;
  uint8_t shown;
  uint8_t late_add;




  uint8_t bright;
  uint8_t btgt;
} Display;




static inline void display_init(Display *d) {
  snes_ppu_reset_blank();
  upq_init(&d->q, 0);
  vram_init(&d->va, 0x0000, 0x0000);
  scene_init(&d->scene);
  d->tm = 0;
  d->shown = 0;
  d->late_add = 0;



  d->bright = 0x0F;
  d->btgt = 0x0F;
  (*(volatile uint8_t *)(uintptr_t)(0x2105)) = 0x01;
  (*(volatile uint8_t *)(uintptr_t)(0x212C)) = 0;
  (*(volatile uint8_t *)(uintptr_t)(0x4200)) = 0x80 | 0x01;
}
# 82 "examples/snes/snesgfx/display.h"
static inline void display_add(Display *d, Drawable *layer) {
  if (d->shown) d->late_add = 1;
  scene_add(&d->scene, layer);
  drawable_reserve(layer, &d->va);



  d->tm = (uint8_t)(d->tm | layer->tm_bits);
  (*(volatile uint8_t *)(uintptr_t)(0x212C)) = d->tm;
}





static inline void display_hide_layer(Display *d, Drawable *layer) {
  d->tm = (uint8_t)(d->tm & (uint8_t)~layer->tm_bits);
  (*(volatile uint8_t *)(uintptr_t)(0x212C)) = d->tm;
}
