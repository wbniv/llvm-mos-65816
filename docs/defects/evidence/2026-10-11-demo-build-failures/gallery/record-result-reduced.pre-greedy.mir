liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: all
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.3):
    successors: %bb.1(0x30000000), %bb.2(0x50000000)
    liveins: $a, $x, $rc2, $rc3
  
    %0:xy = COPY $a
    %113:gpr = COPY $x
    undef %31.subhi:imag16 = COPY $rc2
    %2:ac = COPY $rc3
    STAbsIdx %2, @g_failed, %0 :: (store (s8) into %ir.5, !tbaa !7)
    %10:gpr = LDAbsIdx @g_done, %0 :: (load (s8) from %ir.6, !tbaa !7)
    CmpBrZero %bb.2, undef $z, 0, %10, implicit-def dead $c
    BRA %bb.1
  
  bb.1 (%ir-block.9):
    successors: %bb.3(0x80000000)
  
    %94:ac = LDImm 1
    STAbsIdx %94, @g_done, %0 :: (store (s8) into %ir.6, !tbaa !7)
    %108:gpr = LDAbs @g_count :: (dereferenceable load (s8) from @g_count, !tbaa !7)
    %108:gpr = INC %108
    INCAbs @g_count :: (store (s8) into @g_count, !tbaa !7), (dereferenceable load (s8) from @g_count, !tbaa !7)
    BRA %bb.3
  
  bb.2 (%ir-block.12):
    successors: %bb.3(0x80000000)
  
    %108:gpr = LDAbs @g_count :: (dereferenceable load (s8) from @g_count, !tbaa !7)
  
  bb.3 (%ir-block.14):
    successors: %bb.4(0x40000000), %bb.10(0x40000000)
  
    CmpBrImm %bb.10, undef $z, 0, %108, 62, implicit-def dead $c
    BRA %bb.4
  
  bb.4..preheader:
    successors: %bb.9(0x80000000)
  
    undef %23.subhi:imag16 = LDZ
    %101:cc = LDImm1 0
    %23.sublo:imag16 = COPY %23.subhi
    %112:ac = COPY %23.subhi
    BRA %bb.9
  
  bb.5 (%ir-block.17):
    successors: %bb.6(0x30000000), %bb.7(0x50000000)
  
    %113:gpr = LDImm 18
    CmpBrZero %bb.7, undef $z, 0, %112, implicit-def dead $c
  
  bb.6:
    successors: %bb.8(0x80000000)
  
    %89:gpr = LDImm 21
    undef %31.subhi:imag16 = COPY %89
    BRA %bb.8
  
  bb.7.select.false:
    successors: %bb.8(0x80000000)
  
    %88:gpr = LDImm -107
    undef %31.subhi:imag16 = COPY %88
  
  bb.8.select.end:
    successors: %bb.10(0x80000000)
  
    %31.sublo:imag16 = COPY %113
    %99:ac16 = LDAImag16 %31
    STAbs16 %99, @corpus_result :: (volatile store (s16) into @corpus_result, align 1, !tbaa !8)
    BRA %bb.10
  
  bb.9 (%ir-block.20):
    successors: %bb.5(0x04000000), %bb.9(0x7c000000)
  
    %98:imag16, dead early-clobber %105:gpr = LDImm16 @g_failed
    %102:ac16 = LDAImag16 %98
    %102:ac16, dead %103:cc, dead %104:vc = ADCImag16 %102, %23, %101
    %67:imag16 = STAImag16 %102
    %112:ac = ORAIndir %112, %67 :: (load (s8) from %ir.scevgep, !tbaa !7)
    %107:gpr = COPY %23.sublo
    %107:gpr = nuw nsw INC %107
    %23.sublo:imag16 = COPY %107
    CmpBrImm %bb.5, undef $z, 1, %107, 62, implicit-def dead $c
    BRA %bb.9
  
  bb.10 (%ir-block.28):
    $x = COPY %31.subhi
    $a = COPY %113
    RTS implicit $a, implicit $x
...
