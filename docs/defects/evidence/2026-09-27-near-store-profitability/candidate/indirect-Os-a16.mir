body:             |
  bb.1 (%ir-block.2):
    liveins: $a, $x, $rs1
  
    %0:_(p0) = COPY $rs1
    %2:_(s8) = COPY $a
    %3:_(s8) = COPY $x
    %1:_(s16) = G_MERGE_VALUES %2(s8), %3(s8)
    %5:_(s16) = G_LOAD16_INDIR %0(p0) :: (load (p0) from %ir.0, align 1, !tbaa !8)
    %4:_(p0) = G_INTTOPTR %5(s16)
    G_STORE16_INDIR %1(s16), %4(p0) :: (store (s16) into %ir.3, align 1, !tbaa !6)
    RTS
...
