--- |
  ; ModuleID = '/home/will/llvm-mos-65816/build/far-word-upstream/allocation-baseline/far-global-long-x.ll'
  source_filename = "/home/will/llvm-mos-65816/build/far-word-upstream/allocation-baseline/far-global-long-x.ll"
  target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
  target triple = "mos"
  
  @table = external addrspace(2) global [256 x i8]
  @output = external addrspace(2) global [256 x i8]
  @index8 = external global i8
  @sink16 = external global i16
  
  ; Function Attrs: norecurse
  define i8 @load_byte(i8 %index) #0 {
    %offset = zext i8 %index to i32
    %ptr = getelementptr i8, ptr addrspace(2) @table, i32 %offset
    %value = load i8, ptr addrspace(2) %ptr, align 1
    ret i8 %value
  }
  
  ; Function Attrs: norecurse
  define void @store_byte(i8 %index, i8 %value) #0 {
    %offset = zext i8 %index to i32
    %ptr = getelementptr i8, ptr addrspace(2) @output, i32 %offset
    store i8 %value, ptr addrspace(2) %ptr, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define i8 @load_byte_wide_index(i16 %index) #0 {
    %offset = zext i16 %index to i32
    %ptr = getelementptr i8, ptr addrspace(2) @table, i32 %offset
    %value = load i8, ptr addrspace(2) %ptr, align 1
    ret i8 %value
  }
  
  ; Function Attrs: norecurse
  define void @load_memory_index() #0 {
    %index = load volatile i8, ptr @index8, align 1
    %offset = zext i8 %index to i32
    %ptr = getelementptr i8, ptr addrspace(2) @table, i32 %offset
    %value = load i8, ptr addrspace(2) %ptr, align 1
    %wide = zext i8 %value to i16
    store volatile i16 %wide, ptr @sink16, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @store_memory_index(i8 %value) #0 {
    %index = load volatile i8, ptr @index8, align 1
    %offset = zext i8 %index to i32
    %ptr = getelementptr i8, ptr addrspace(2) @output, i32 %offset
    store i8 %value, ptr addrspace(2) %ptr, align 1
    ret void
  }
  
  attributes #0 = { norecurse "nonreentrant" "target-cpu"="mosw65816" "target-features"="+mos-a16,+mos-xy16" }
...
