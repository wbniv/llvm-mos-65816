--- |
  ; ModuleID = '/home/will/llvm-mos-65816/build/far-word-upstream/allocation-baseline/far-native-word.ll'
  source_filename = "/home/will/llvm-mos-65816/build/far-word-upstream/allocation-baseline/far-native-word.ll"
  target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
  target triple = "mos"
  
  @farword = external addrspace(2) global i16
  @nearword = external global i16
  @fararray = external addrspace(2) global [256 x i16]
  
  ; Function Attrs: norecurse
  define void @far_global_copy() #0 {
    %value = load volatile i16, ptr addrspace(2) @farword, align 1
    store volatile i16 %value, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_global_store() #0 {
    %value = load volatile i16, ptr @nearword, align 1
    %sum = add i16 %value, 1
    store volatile i16 %sum, ptr addrspace(2) @farword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_runtime_load(ptr addrspace(2) %pointer) #0 {
    %value = load volatile i16, ptr addrspace(2) %pointer, align 1
    %sum = add i16 %value, 1
    store volatile i16 %sum, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_runtime_store(ptr addrspace(2) %pointer) #0 {
    %value = load volatile i16, ptr @nearword, align 1
    %sum = add i16 %value, 1
    store volatile i16 %sum, ptr addrspace(2) %pointer, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_global_word_indexed(i8 %index) #0 {
    %offset = zext i8 %index to i32
    %pointer = getelementptr i8, ptr addrspace(2) @farword, i32 %offset
    %value = load volatile i16, ptr addrspace(2) %pointer, align 1
    store volatile i16 %value, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_runtime_word_indexed(ptr addrspace(2) %base) #0 {
    %pointer = getelementptr i8, ptr addrspace(2) %base, i32 1
    %value = load volatile i16, ptr addrspace(2) %pointer, align 1
    store volatile i16 %value, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_scaled_word(i8 %index) #0 {
    %offset = zext i8 %index to i32
    %pointer = getelementptr [2 x i8], ptr addrspace(2) @fararray, i32 %offset
    %value = load volatile i16, ptr addrspace(2) %pointer, align 1
    store volatile i16 %value, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_scaled_word_wide(i16 %index) #0 {
    %offset = zext i16 %index to i32
    %pointer = getelementptr [2 x i8], ptr addrspace(2) @fararray, i32 %offset
    %value = load volatile i16, ptr addrspace(2) %pointer, align 1
    store volatile i16 %value, ptr @nearword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_byte_argument(i16 %value) #0 {
    store i16 %value, ptr addrspace(2) @farword, align 1
    ret void
  }
  
  ; Function Attrs: norecurse
  define i16 @far_byte_return() #0 {
    %value = load i16, ptr addrspace(2) @farword, align 1
    ret i16 %value
  }
  
  attributes #0 = { norecurse "nonreentrant" "target-cpu"="mosw65816" "target-features"="+mos-a16,+mos-xy16" }
...
