*** IR Dump After MOS recover near address no-wrap proofs (mos-recover-near-nowrap) ***
; Preheader:
entry:
  %p = inttoptr i32 %a to ptr addrspace(2)
  br label %loop

; Loop:
loop:                                             ; preds = %loop, %entry
  %j = phi i8 [ 0, %entry ], [ %j1, %loop ]
  %x = zext i8 %j to i32
  %q = getelementptr inbounds i8, ptr addrspace(2) %p, i32 %x
  %v = load i8, ptr addrspace(2) %q, align 1
  %0 = zext nneg i8 %j to i16
  %scevgep = getelementptr nuw i8, ptr %dst, i16 %0
  store i8 %v, ptr %scevgep, align 1
  %j1 = add nuw nsw i8 %j, 1
  %c = icmp eq i8 %j1, 64
  br i1 %c, label %exit, label %loop

; Exit blocks
exit:                                             ; preds = %loop
  ret void
