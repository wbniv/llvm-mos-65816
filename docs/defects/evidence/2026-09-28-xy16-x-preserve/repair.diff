+// Count byte pushes and pulls so the spill can sit below every original byte
+// the region consumes. Explicit stack addresses and opaque stack changes need
+// a separate lowering: adding a hidden word must not change what they access.
+static std::pair<unsigned, unsigned> getStackDepths(MachineInstr &Begin,
+                                                    MachineInstr &End) {
+  int Depth = 0, MinDepth = 0;
+  for (auto I = Begin.getIterator(); I != End.getIterator(); ++I) {
+    switch (I->getOpcode()) {
+    case MOS::PH:
+      ++Depth;
+      break;
+    case MOS::PHA16:
+      Depth += 2;
+      break;
+    case MOS::PL:
+      --Depth;
+      break;
+    case MOS::PLA16:
+      Depth -= 2;
+      break;
+    default:
+      if (I->isCall() || I->isInlineAsm() ||
+          (!I->getDesc().isPseudo() && I->getOpcode() != MOS::REP_Immediate &&
+           I->getOpcode() != MOS::SEP_Immediate))
+        report_fatal_error("cannot preserve live 16-bit X across an opaque "
+                           "hard-stack operation");
+    }
+    MinDepth = std::min(MinDepth, Depth);
+  }
+  unsigned Before = -MinDepth, After = Depth - MinDepth;
+  if (Before > 250 || After > 250)
+    report_fatal_error("16-bit X preservation exceeds stack-relative range");
+  return {Before, After};
+}
+
+void MOSInsertREPSEP::preserveX(MachineBasicBlock &MBB, MachineInstr &Narrow,
+                                MachineInstr &Reader, bool SaveM16,
+                                bool RestoreM16) {
+  auto [Before, After] = getStackDepths(Narrow, Reader);
+  BuildMI(MBB, Narrow, Narrow.getDebugLoc(), TII->get(MOS::PHX_Implied))
+      .addReg(MOS::X16, RegState::Implicit);
+
+  auto LiveBefore = [&](MachineInstr &MI, LivePhysRegs &Live) {
+    Live.addLiveOuts(MBB);
+    for (auto I = MBB.rbegin(); &*I != &MI; ++I)
+      Live.stepBackward(*I);
+    Live.stepBackward(MI);
+  };
+  // Each shuffle uses A16 as a courier and preserves A/P in three bytes above
+  // the spill. PLP restores the exact incoming flags and accumulator width.
+  auto SaveAP = [&](MachineInstr &MI, bool M16, const LivePhysRegs &Live) {
+    bool PLive = Live.contains(MOS::C) || Live.contains(MOS::N) ||
+                 Live.contains(MOS::Z) || Live.contains(MOS::V);
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::PH))
+        .addReg(MOS::P, getUndefRegState(!PLive));
+    if (!M16)
+      BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::REP_Immediate))
+          .addImm(MFlagBit);
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::PHA16))
+        .addReg(MOS::A16, getUndefRegState(!Live.contains(MOS::A) &&
+                                           !Live.contains(MOS::B)));
+  };
+  auto Load = [&](MachineInstr &MI, unsigned Offset, Register Reg) {
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::LDA_StackRelative))
+        .addImm(Offset)
+        .addReg(Reg, RegState::ImplicitDefine);
+  };
+  auto Store = [&](MachineInstr &MI, unsigned Offset, Register Reg) {
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::STA_StackRelative))
+        .addImm(Offset)
+        .addReg(Reg, RegState::Implicit);
+  };
+  auto SwitchM = [&](MachineInstr &MI, bool Wide) {
+    BuildMI(MBB, MI, MI.getDebugLoc(),
+            TII->get(Wide ? MOS::REP_Immediate : MOS::SEP_Immediate))
+        .addImm(MFlagBit);
+  };
+  auto RestoreAP = [&](MachineInstr &MI) {
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::PLA16), MOS::A16);
+    BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(MOS::PL), MOS::P);
+  };
+
+  if (Before) {
+    // Move the original bytes above X so any unmatched pulls consume their
+    // own values. Copy toward smaller offsets before writing X at the bottom.
+    LivePhysRegs SaveLive(*TRI);
+    LiveBefore(Narrow, SaveLive);
+    SaveAP(Narrow, SaveM16, SaveLive);
+    unsigned I = 0;
+    for (; I + 1 < Before; I += 2) {
+      Load(Narrow, 6 + I, MOS::A16);
+      Store(Narrow, 4 + I, MOS::A16);
+    }
+    if (I < Before) {
+      SwitchM(Narrow, false);
+      Load(Narrow, 6 + I, MOS::A);
+      Store(Narrow, 4 + I, MOS::A);
+      SwitchM(Narrow, true);
+    }
+    BuildMI(MBB, Narrow, Narrow.getDebugLoc(), TII->get(MOS::TXA16), MOS::A16)
+        .addReg(MOS::X16);
+    Store(Narrow, 4 + Before, MOS::A16);
+    RestoreAP(Narrow);
+  }
+
+  LivePhysRegs Live(*TRI);
+  LiveBefore(Reader, Live);
+  if (!After && !Live.contains(MOS::N) && !Live.contains(MOS::Z)) {
+    BuildMI(MBB, Reader, Reader.getDebugLoc(), TII->get(MOS::PLX_Implied))
+        .addReg(MOS::X16, RegState::ImplicitDefine);
+    return;
+  }
+
+  // The stack is [A.lo, A.hi, P, original bytes..., X.lo, X.hi]. Load X,
+  // then shift the prefix two bytes toward larger offsets, copying backward
+  // to handle overlap. Discarding the first word removes the spill; A/P and
+  // every original stack byte then occupy their required positions.
+  SaveAP(Reader, RestoreM16, Live);
+  Load(Reader, 4 + After, MOS::A16);
+  BuildMI(MBB, Reader, Reader.getDebugLoc(), TII->get(MOS::TAX16), MOS::X16)
+      .addReg(MOS::A16);
+  unsigned I = 3 + After;
+  for (; I >= 2; I -= 2) {
+    Load(Reader, I - 1, MOS::A16);
+    Store(Reader, I + 1, MOS::A16);
+  }
+  if (I) {
+    SwitchM(Reader, false);
+    Load(Reader, 1, MOS::A);
+    Store(Reader, 3, MOS::A);
+    SwitchM(Reader, true);
+  }
+  BuildMI(MBB, Reader, Reader.getDebugLoc(), TII->get(MOS::PLA16), MOS::A16);
+  RestoreAP(Reader);
+}
