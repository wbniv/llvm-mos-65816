  target triple = "mos"
  
  ; Function Attrs: mustprogress nofree noinline norecurse nosync nounwind optsize willreturn memory(argmem: readwrite)
  define dso_local void @newton_step(ptr noundef captures(none) %0, ptr noundef captures(none) %1) local_unnamed_addr #0 {
    %3 = load i16, ptr %0, align 1, !tbaa !2
    %4 = load i16, ptr %1, align 1, !tbaa !2
    %5 = sext i16 %3 to i32
    %6 = sext i16 %4 to i32
    %7 = add nsw i32 %6, %5
