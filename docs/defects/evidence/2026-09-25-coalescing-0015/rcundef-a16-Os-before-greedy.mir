    %9 = shl nsw i32 %8, 8
    %10 = mul i32 %9, %7
    %11 = ashr i32 %10, 16
    %12 = shl nsw i32 %5, 9
    %13 = mul i32 %12, %6
    %14 = ashr i32 %13, 16
    %15 = trunc nsw i32 %11 to i16
    %16 = mul i16 %15, 3
    %17 = trunc nsw i32 %14 to i16
    %18 = mul i16 %17, 3
    %19 = ashr i16 %16, 1
    %20 = sext i16 %19 to i32
    %21 = ashr i16 %18, 1
    %22 = sext i16 %21 to i32
    %23 = mul nsw i32 %20, %20
    %24 = mul nsw i32 %22, %22
    %25 = add nuw nsw i32 %23, %24
    %26 = icmp eq i32 %25, 0
    br i1 %26, label %71, label %27
  
  27:                                               ; preds = %2
    %28 = sext i16 %21 to i32
    %29 = sext i16 %19 to i32
    %30 = sext i16 %4 to i32
    %31 = sext i16 %3 to i32
    %32 = mul nsw i32 %11, %30
    %33 = mul nsw i32 %14, %31
