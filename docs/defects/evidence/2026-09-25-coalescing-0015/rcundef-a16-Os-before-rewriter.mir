    %9 = shl nsw i32 %8, 8
    %10 = mul i32 %9, %7
    %11 = ashr i32 %10, 16
    %12 = shl nsw i32 %5, 9
    %13 = mul i32 %12, %6
    %14 = ashr i32 %13, 16
