    %17 = trunc nsw i32 %14 to i16
    %18 = mul i16 %17, 3
    %19 = ashr i16 %16, 1
    %20 = sext i16 %19 to i32
    %21 = ashr i16 %18, 1
    %22 = sext i16 %21 to i32
    %23 = mul nsw i32 %20, %20
    %24 = mul nsw i32 %22, %22
    %25 = add nuw nsw i32 %23, %24
