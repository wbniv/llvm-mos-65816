+
+// Register pressure under native widths.
+//
+// Ac16, Xc16 and Yc16 set GeneratePressureSet = 0, so the generated pressure
+// sets are exactly those of the 8-bit register file: the opt-in 16-bit
+// registers leave MachineLICM, MachineSink and the scheduler unchanged for
+// every subtarget that doesn't enable them. Under +mos-a16 (and so +mos-xy16),
+// each native class counts toward its low byte's generated sets, and below
+// -O3 these hooks also append one set per 16-bit register, holding its two
+// byte units with a limit of 2. The 8-bit A, X or Y and the 16-bit register
+// that contains it count toward the same set, so the heuristics see that an
+// 8-bit value live across a 16-bit one competes for the same physical
+// register. That saves code size but costs cycles, so -O3 leaves it out.
+bool MOSRegisterInfo::hasNativePressureSets() const { return STI.hasAccum16(); }
+
+unsigned MOSRegisterInfo::getNumRegPressureSets() const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  return hasNativePressureSets() && AppendNativePressureSets
+             ? N + std::size(NativePressureRegs)
+             : N;
+}
+
+const char *MOSRegisterInfo::getRegPressureSetName(unsigned Idx) const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  if (Idx < N)
+    return MOSGenRegisterInfo::getRegPressureSetName(Idx);
+  return getName(NativePressureRegs[Idx - N]);
+}
+
+unsigned MOSRegisterInfo::getRegPressureSetLimit(const MachineFunction &MF,
+                                                 unsigned Idx) const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  if (Idx < N)
+    return MOSGenRegisterInfo::getRegPressureSetLimit(MF, Idx);
+  auto Units = regunits(NativePressureRegs[Idx - N]);
+  return std::distance(Units.begin(), Units.end());
+}
+
+const int *
+MOSRegisterInfo::getRegClassPressureSets(const TargetRegisterClass *RC) const {
+  if (hasNativePressureSets()) {
+    const auto &L = NativeClassPSets[RC->getID()];
+    if (!L.empty())
+      return L.data();
+  }
+  return MOSGenRegisterInfo::getRegClassPressureSets(RC);
+}
+
+const int *MOSRegisterInfo::getRegUnitPressureSets(MCRegUnit RegUnit) const {
+  if (hasNativePressureSets()) {
+    const auto &L = NativeUnitPSets[static_cast<unsigned>(RegUnit)];
+    if (!L.empty())
+      return L.data();
+  }
+  return MOSGenRegisterInfo::getRegUnitPressureSets(RegUnit);
 }
 
