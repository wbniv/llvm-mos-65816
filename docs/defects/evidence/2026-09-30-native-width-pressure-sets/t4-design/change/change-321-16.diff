     // use them.
@@ -73,6 +79,114 @@ MOSRegisterInfo::MOSRegisterInfo()
 
   // Reserve one temporary register for use by register scavenger.
   reserveAllSubregs(&Reserved, MOS::RS8);
+
+  // Build the native-width pressure-set lists; see getNumRegPressureSets.
+  auto Generated = [](const int *PSets) {
+    SmallVector<int, 8> L;
+    for (; *PSets != -1; ++PSets)
+      L.push_back(*PSets);
+    return L;
+  };
+  NativeClassPSets.resize(getNumRegClasses());
+  NativeUnitPSets.resize(getNumRegUnits());
+  const int NumGenerated = MOSGenRegisterInfo::getNumRegPressureSets();
+  for (unsigned I = 0; I < std::size(NativePressureRegs); ++I) {
+    const MCPhysReg Wide = NativePressureRegs[I];
+    const int PSet = NumGenerated + I;
+    // Each unit of the wide register counts toward its set.
+    for (MCRegUnit Unit : regunits(Wide)) {
+      auto &L = NativeUnitPSets[static_cast<unsigned>(Unit)];
+      if (L.empty())
+        L = Generated(MOSGenRegisterInfo::getRegUnitPressureSets(Unit));
+      L.push_back(PSet);
+    }
+    // So does each class whose registers all lie within the wide register:
+    // its low byte's class (Ac, Xc, Yc) and its own class (Ac16, Xc16, Yc16).
+    // The latter has GeneratePressureSet = 0 and so no generated sets; it also
+    // counts toward its low byte's sets, like the 8-bit register it contains.
+    const TargetRegisterClass *LoRC =
+        getMinimalPhysRegClass(getSubReg(Wide, MOS::sublo));
+    for (unsigned ID = 0; ID < getNumRegClasses(); ++ID) {
+      const TargetRegisterClass *RC = getRegClass(ID);
+      if (!RC->getNumRegs() || !all_of(*RC, [&](MCPhysReg Reg) {
+            return isSubRegisterEq(Wide, Reg);
+          }))
+        continue;
+      auto &L = NativeClassPSets[ID];
+      if (L.empty())
+        L = Generated(MOSGenRegisterInfo::getRegClassPressureSets(
+            RC->contains(Wide) ? LoRC : RC));
+      L.push_back(PSet);
+    }
+  }
+  for (auto &L : NativeClassPSets)
+    if (!L.empty())
+      L.push_back(-1);
+  for (auto &L : NativeUnitPSets)
+    if (!L.empty())
+      L.push_back(-1);
+}
+
+// Register pressure under native widths.
+//
+// Ac16, Xc16 and Yc16 set GeneratePressureSet = 0, so the generated pressure
+// sets are exactly those of the 8-bit register file: the opt-in 16-bit
+// registers leave MachineLICM, MachineSink and the scheduler unchanged for
+// every subtarget that doesn't enable them. Under +mos-a16 (and so +mos-xy16),
+// these hooks append one set per 16-bit register, holding its two byte units
+// with a limit of 2. The 8-bit A, X or Y and the 16-bit register that
+// contains it count toward the same set, so the heuristics see that an 8-bit
+// value live across a 16-bit one competes for the same physical register.
+bool MOSRegisterInfo::hasNativePressureSets() const {
+  return STI.hasAccum16();
+}
+
+unsigned MOSRegisterInfo::getNumRegPressureSets() const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  return hasNativePressureSets() ? N + std::size(NativePressureRegs) : N;
+}
+
+const char *MOSRegisterInfo::getRegPressureSetName(unsigned Idx) const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  if (Idx < N)
+    return MOSGenRegisterInfo::getRegPressureSetName(Idx);
+  return getName(NativePressureRegs[Idx - N]);
+}
+
+unsigned MOSRegisterInfo::getRegPressureSetLimit(const MachineFunction &MF,
+                                                 unsigned Idx) const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  if (Idx < N)
+    return MOSGenRegisterInfo::getRegPressureSetLimit(MF, Idx);
+  auto Units = regunits(NativePressureRegs[Idx - N]);
+  return std::distance(Units.begin(), Units.end());
+}
+
+const TargetRegisterClass *
+MOSRegisterInfo::getLargestRegClassForRegPressureSet(unsigned Idx) const {
+  unsigned N = MOSGenRegisterInfo::getNumRegPressureSets();
+  if (Idx < N)
+    return MOSGenRegisterInfo::getLargestRegClassForRegPressureSet(Idx);
+  return getMinimalPhysRegClass(NativePressureRegs[Idx - N]);
+}
+
+const int *
+MOSRegisterInfo::getRegClassPressureSets(const TargetRegisterClass *RC) const {
+  if (hasNativePressureSets()) {
+    const auto &L = NativeClassPSets[RC->getID()];
+    if (!L.empty())
+      return L.data();
+  }
+  return MOSGenRegisterInfo::getRegClassPressureSets(RC);
+}
+
+const int *MOSRegisterInfo::getRegUnitPressureSets(MCRegUnit RegUnit) const {
+  if (hasNativePressureSets()) {
+    const auto &L = NativeUnitPSets[static_cast<unsigned>(RegUnit)];
+    if (!L.empty())
+      return L.data();
+  }
+  return MOSGenRegisterInfo::getRegUnitPressureSets(RegUnit);
 }
 
