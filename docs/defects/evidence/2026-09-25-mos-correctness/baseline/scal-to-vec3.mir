callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.1 (%ir-block.2):
    successors: %bb.2(0x80000000)
    liveins: $a, $x, $rs1
  
    %2:_(s8) = COPY $a
    %3:_(s8) = COPY $x
    %0:_(s16) = G_MERGE_VALUES %2(s8), %3(s8)
    %1:_(p0) = COPY $rs1
    %45:_(s16) = G_CONSTANT i16 0
    %47:_(s32) = G_FCONSTANT float 1.000000e+00
    %48:_(s32) = G_FCONSTANT float 2.000000e+00
    %49:_(s32) = G_FCONSTANT float 3.000000e+00
    %50:_(s32) = G_FCONSTANT float 4.000000e+00
    %46:_(<4 x s32>) = G_BUILD_VECTOR %47(s32), %48(s32), %49(s32), %50(s32)
    %52:_(s64) = G_FCONSTANT double 1.000000e+00
    %53:_(s64) = G_FCONSTANT double 2.000000e+00
    %51:_(<2 x s64>) = G_BUILD_VECTOR %52(s64), %53(s64)
    %55:_(<4 x s32>) = G_BUILD_VECTOR %48(s32), %48(s32), %48(s32), %48(s32)
    %61:_(s16) = G_CONSTANT i16 4
    %113:_(<2 x s64>) = G_BUILD_VECTOR %53(s64), %53(s64)
    %119:_(s16) = G_CONSTANT i16 2
    %185:_(s16) = G_CONSTANT i16 1
    %4:_(p0) = G_FRAME_INDEX %stack.0
    %5:_(p0) = G_FRAME_INDEX %stack.1
    %6:_(p0) = G_FRAME_INDEX %stack.2
    %7:_(p0) = G_FRAME_INDEX %stack.3
    %8:_(p0) = G_FRAME_INDEX %stack.4
    %9:_(p0) = G_FRAME_INDEX %stack.5
    %10:_(p0) = G_FRAME_INDEX %stack.6
    %11:_(p0) = G_FRAME_INDEX %stack.7
    %12:_(p0) = G_FRAME_INDEX %stack.8
    %13:_(p0) = G_FRAME_INDEX %stack.9
    %14:_(p0) = G_FRAME_INDEX %stack.10
    %15:_(p0) = G_FRAME_INDEX %stack.11
