body:             |
  bb.1 (%ir-block.4):
    successors: %bb.2(0x80000000)
    liveins: $a, $x, $rc6, $rc7, $rs1, $rs2
  
    %0:_(p0) = COPY $rs1
    %1:_(p0) = COPY $rs2
    %4:_(s8) = COPY $a
    %5:_(s8) = COPY $x
    %2:_(s16) = G_MERGE_VALUES %4(s8), %5(s8)
    %6:_(s8) = COPY $rc6
    %7:_(s8) = COPY $rc7
    %3:_(s16) = G_MERGE_VALUES %6(s8), %7(s8)
    %22:_(s16) = G_CONSTANT i16 4
    %23:_(s16) = G_CONSTANT i16 15
    %24:_(s16) = G_CONSTANT i16 0
    %36:_(s32) = G_CONSTANT i32 0
    %43:_(s16) = G_CONSTANT i16 1
    %123:_(s16) = G_CONSTANT i16 2
    %137:_(s16) = G_CONSTANT i16 3
    %309:_(s1) = G_CONSTANT i1 false
    %8:_(p0) = G_FRAME_INDEX %stack.0
    %9:_(p0) = G_FRAME_INDEX %stack.1
