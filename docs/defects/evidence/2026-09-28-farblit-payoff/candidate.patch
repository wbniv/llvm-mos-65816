+// A single-block counting loop starts at a constant and returns to its header
+// only while the next value differs from a larger constant. With a unit step,
+// every header value lies in [Start, End); the recurrence cannot wrap.
+static std::optional<uint64_t>
+farLoopMax(Register Reg, const MachineRegisterInfo &MRI,
+           const MachineBasicBlock &Loop) {
+  const MachineInstr *Phi = MRI.getVRegDef(Reg);
+  if (!Phi || Phi->getOpcode() != G_PHI || Phi->getParent() != &Loop ||
+      Phi->getNumOperands() != 5 || Loop.pred_size() != 2 ||
+      Loop.succ_size() != 2 || !Loop.isSuccessor(&Loop))
+    return std::nullopt;
+  unsigned Back = Phi->getOperand(2).getMBB() == &Loop ? 1 : 3;
+  unsigned Entry = Back == 1 ? 3 : 1;
+  if (Phi->getOperand(Back + 1).getMBB() != &Loop ||
+      Phi->getOperand(Entry + 1).getMBB() == &Loop)
+    return std::nullopt;
+  auto Start = getIConstantVRegValWithLookThrough(Phi->getOperand(Entry).getReg(), MRI);
+  Register Next = Phi->getOperand(Back).getReg();
+  const MachineInstr *Inc = getOpcodeDef(G_ADD, Next, MRI);
+  if (!Start || !Inc || Inc->getParent() != &Loop ||
+      Inc->getOperand(1).getReg() != Reg)
+    return std::nullopt;
+  auto Step = getIConstantVRegValWithLookThrough(Inc->getOperand(2).getReg(), MRI);
+  if (!Step || !Step->Value.isOne())
+    return std::nullopt;
+  auto Term = Loop.getFirstTerminator();
+  if (Term == Loop.end() ||
+      (Term->getOpcode() != G_BRCOND && Term->getOpcode() != MOS::G_BRCOND_IMM))
+    return std::nullopt;
+  const bool BranchToLoop = Term->getOperand(1).getMBB() == &Loop;
+  Register Bound;
+  if (Term->getOpcode() == G_BRCOND) {
+    const MachineInstr *Cmp = getOpcodeDef(G_ICMP, Term->getOperand(0).getReg(), MRI);
+    if (!Cmp || Cmp->getOperand(1).getPredicate() !=
+                    (BranchToLoop ? CmpInst::ICMP_NE : CmpInst::ICMP_EQ) ||
+        Cmp->getOperand(2).getReg() != Next)
+      return std::nullopt;
+    Bound = Cmp->getOperand(3).getReg();
+  } else {
+    // SBC with carry set computes Next-Bound. Its zero output is false
+    // exactly when the operands differ, including unsigned values above 127.
+    if (MRI.getType(Reg) != LLT::scalar(8) ||
+        Term->getOperand(2).getImm() != (BranchToLoop ? 0 : 1))
+      return std::nullopt;
+    Register Flag = Term->getOperand(0).getReg();
+    const MachineInstr *Def = MRI.getVRegDef(Flag);
+    for (unsigned N = 0; Def && Def->isCopy() && N < 4; ++N) {
+      Flag = Def->getOperand(1).getReg();
+      if (!Flag.isVirtual())
+        return std::nullopt;
+      Def = MRI.getVRegDef(Flag);
+    }
+    if (!Def || Def->getOpcode() != MOS::G_SBC ||
+        Def->getOperand(4).getReg() != Flag || Def->getOperand(5).getReg() != Next)
+      return std::nullopt;
+    auto Carry = getIConstantVRegValWithLookThrough(Def->getOperand(7).getReg(), MRI);
+    if (!Carry || !Carry->Value.isOne())
+      return std::nullopt;
+    Bound = Def->getOperand(6).getReg();
+  }
+  auto End = getIConstantVRegValWithLookThrough(Bound, MRI);
+  if (!End || End->Value.getActiveBits() > 16 ||
+      !Start->Value.ult(End->Value))
+    return std::nullopt;
+  ++Term;
+  if (Term == Loop.end() || Term->getOpcode() != G_BR ||
+      (Term->getOperand(0).getMBB() == &Loop) == BranchToLoop ||
+      ++Term != Loop.end())
+    return std::nullopt;
+  return End->Value.getZExtValue() - 1;
+}
