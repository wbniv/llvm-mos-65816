+      int Spill = DAG->isTrackingPressure() && Pressure.isValid()
+                      ? Pressure.getUnitInc() : 0;
+      int Carry = carryExcessDiff(Candidate.SU, Candidate.AtTop);
+      // An 8-bit carry diamond and compare occupy eight bytes. A zero-page
+      // store/reload pair occupies four bytes and costs six processor cycles.
+      // These are marginal proxies; allocation and native widths can differ.
+      int64_t Bytes = 8 * Carry + 4 * Spill;
+      int64_t Cycles = 8 * Carry + 6 * Spill;
+      auto Mode = MOSInstrCost::getModeFor(DAG->MF);
+      if (Objective == CarryObjective::Size)
+        Mode = MOSInstrCost::Mode::PreferBytes;
+      else if (Objective == CarryObjective::Speed)
+        Mode = MOSInstrCost::Mode::PreferCycles;
+      switch (Mode) {
+      case MOSInstrCost::Mode::PreferBytes:
+        return Bytes * (int64_t(1) << 32) + Cycles;
+      case MOSInstrCost::Mode::PreferCycles:
+        return Cycles * (int64_t(1) << 32) + Bytes;
+      case MOSInstrCost::Mode::Average:
+        return Bytes + Cycles;
+      }
+      llvm_unreachable("Unknown cost mode");
