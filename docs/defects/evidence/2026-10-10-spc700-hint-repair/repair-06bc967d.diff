diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.cpp b/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
index baf6de604cb7..d1f55aa59d22 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
@@ -698,8 +698,12 @@ bool MOSRegisterInfo::getRegAllocationHints(Register VirtReg,
   for (const auto &R : enumerate(Order))
     OriginalIndex[R.value()] = R.index();
 
-  if (std::optional<Register> StrongHint =
-          getStrongCopyHint(VirtReg, MF, VRM)) {
+  // A strong hint is a hard hint, so it must come from the allocation order.
+  // A copy can still name a register outside the order, such as the reserved
+  // RC17 that SPC700 indirect calls load with a JMP opcode. The value then
+  // needs some allocatable register, so it falls back to the cost-based hints.
+  std::optional<Register> StrongHint = getStrongCopyHint(VirtReg, MF, VRM);
+  if (StrongHint && (!*StrongHint || is_contained(Order, *StrongHint))) {
     if (*StrongHint)
       Hints.push_back(*StrongHint);
     return true;
diff --git a/llvm/test/CodeGen/MOS/regalloc-spc700.mir b/llvm/test/CodeGen/MOS/regalloc-spc700.mir
new file mode 100644
index 000000000000..b29375e7239d
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/regalloc-spc700.mir
@@ -0,0 +1,43 @@
+# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
+# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=greedy,virtregrewriter -verify-machineinstrs -o - %s | FileCheck %s
+
+# An SPC700 indirect call writes the JMP opcode into the reserved RC17 and
+# calls __rc17. The opcode is a rematerializable byte whose only use is the
+# copy into RC17, so the copy names a register outside the Anyi8 allocation
+# order. The allocator must place the byte in an allocatable register instead.
+---
+name: indirect_thunk_opcode
+legalized: true
+regBankSelected: true
+tracksRegLiveness: true
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: indirect_thunk_opcode
+    ; CHECK: renamable $x = LDImm 95
+    ; CHECK-NEXT: $rc17 = COPY killed renamable $x
+    ; CHECK-NEXT: JSR &__rc17, mos_csr, implicit $rc17
+    ; CHECK-NEXT: RTS
+    %0:anyi8 = LDImm 95
+    $rc17 = COPY %0
+    JSR &__rc17, mos_csr, implicit $rc17
+    RTS
+...
+---
+name: indirect_thunk_opcode_across_call
+legalized: true
+regBankSelected: true
+tracksRegLiveness: true
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: indirect_thunk_opcode_across_call
+    ; CHECK: renamable $rc20 = LDImm 95
+    ; CHECK-NEXT: JSR &fn, mos_csr
+    ; CHECK-NEXT: $rc17 = COPY killed renamable $rc20
+    ; CHECK-NEXT: JSR &__rc17, mos_csr, implicit $rc17
+    ; CHECK-NEXT: RTS
+    %0:anyi8 = LDImm 95
+    JSR &fn, mos_csr
+    $rc17 = COPY %0
+    JSR &__rc17, mos_csr, implicit $rc17
+    RTS
+...
