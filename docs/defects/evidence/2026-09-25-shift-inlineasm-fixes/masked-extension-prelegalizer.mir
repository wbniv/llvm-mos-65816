--- |
  ; ModuleID = '/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-shift-inlineasm-fixes/extend-masked.ll'
  source_filename = "/home/will/llvm-mos-65816/docs/defects/evidence/2026-09-25-shift-inlineasm-fixes/extend-masked.ll"
  target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-p3:24:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
  target triple = "mos"
  
  ; Function Attrs: norecurse
  define void @extend_masked(ptr %out, i8 %value) #0 {
    %scaled = mul i8 %value, 7
    %masked = and i8 %scaled, 63
    %extended = zext nneg i8 %masked to i64
    store volatile i64 %extended, ptr %out, align 1
    ret void
  }
  
  attributes #0 = { norecurse "nonreentrant" "target-cpu"="mosw65816" "target-features"="+mos-a16" }
...
