+
+def LDIndirLong16 : MOSLoad,
+    PseudoInstExpansion<(LDA_IndirectLong addr8:$addr)> {
+  let Predicates = [HasAccum16]; let MLow = 1;
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList = (ins Imag32:$addr);
+}
+
+def STIndirLong16 : MOSStore,
+    PseudoInstExpansion<(STA_IndirectLong addr8:$addr)> {
+  let Predicates = [HasAccum16]; let MLow = 1;
+  dag InOperandList = (ins Ac16:$src, Imag32:$addr);
+}
+
+def LDIndirLongIdx16 : MOSLoad,
+    PseudoInstExpansion<(LDA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasAccum16]; let MLow = 1;
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList = (ins Imag32:$addr, Yc:$offset);
+}
+
+def STIndirLongIdx16 : MOSStore,
+    PseudoInstExpansion<(STA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasAccum16]; let MLow = 1;
+  dag InOperandList = (ins Ac16:$src, Imag32:$addr, Yc:$offset);
+}
+
 def LDIndirLong : MOSLoad, PseudoInstExpansion<(LDA_IndirectLong addr8:$addr)> {
   let Predicates = [HasW65816];
   dag OutOperandList = (outs Ac:$dst);
