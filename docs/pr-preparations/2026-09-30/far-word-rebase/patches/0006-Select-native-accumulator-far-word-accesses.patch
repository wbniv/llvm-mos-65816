+def STAbsLongXIdx16 : MOSStore,
+    PseudoInstExpansion<(STA_AbsoluteXLong addr24:$dst)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
+  dag InOperandList = (ins Ac16:$src, addr24:$dst, Xc16:$idx);
