+def LDAbsLongXIdx16 : MOSLoad,
+    PseudoInstExpansion<(LDA_AbsoluteXLong addr24:$src)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
