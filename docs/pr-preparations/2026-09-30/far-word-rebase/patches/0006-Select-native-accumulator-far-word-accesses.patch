-
 def G_LOAD_FAR_ABS_IDX16 : MOSGenericInstruction {
   let Predicates = [HasIndex16];
   let OutOperandList = (outs type0:$dst);
@@ -182,6 +181,45 @@ def G_STORE_FAR_ABS_IDX16 : MOSGenericInstruction {
   let mayStore = true;
 }
 
+// Native 16-bit far accesses retain the far address or pointer operand so the
+// selector can choose an explicit long opcode in accumulator-wide mode.
+def G_LOAD16_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr);
+  let mayStore = true;
+}
+def G_LOAD16_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr, type1:$index);
+  let mayStore = true;
+}
+def G_LOAD16_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasAccum16, HasIndex16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasAccum16, HasIndex16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr, type1:$index);
+  let mayStore = true;
+}
+
 // 8-bit load/store through a RUNTIME far (addrspace 2) pointer
 // via 65816 indirect-long (`lda [dp]`/`sta [dp]`). The address operand is the
 // far pointer itself (a 32-bit value that lands in a contiguous Imag32 ZP quad);
@@ -199,6 +237,18 @@ def G_STORE_FAR_INDIR : MOSGenericInstruction {
   let InOperandList = (ins type0:$src, ptype1:$addr);
   let mayStore = true;
 }
+def G_LOAD16_FAR_INDIR : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_INDIR : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr);
+  let mayStore = true;
+}
 
 // Indexed far byte accesses use an Imag32 base and an s8 Y offset. The
 // 65816 adds Y to the full 24-bit address, including carry into the bank.
@@ -230,6 +280,18 @@ def G_STORE_FAR_INDIR_IDX16 : MOSGenericInstruction {
   let InOperandList = (ins type0:$src, ptype1:$addr, type1:$index);
   let mayStore = true;
