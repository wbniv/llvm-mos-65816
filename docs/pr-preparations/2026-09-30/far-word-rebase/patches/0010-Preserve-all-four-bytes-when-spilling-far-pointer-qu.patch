+  - { id: 0, size: 4 }
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: st_far_ptr
+    ; CHECK: $a = COPY $rc4
+    ; CHECK: $a = COPY $rc5
+    ; CHECK: $a = COPY $rc6
+    ; CHECK: $a = COPY $rc7
