diff --git a/llvm/lib/Target/MOS/MOSAsmPrinter.cpp b/llvm/lib/Target/MOS/MOSAsmPrinter.cpp
index dd5b16b807b5..27d01f28cc4d 100644
--- a/llvm/lib/Target/MOS/MOSAsmPrinter.cpp
+++ b/llvm/lib/Target/MOS/MOSAsmPrinter.cpp
@@ -125,6 +125,34 @@ void MOSAsmPrinter::EmitToStreamer(MCStreamer &S, MCInst &Inst) {
 }
 
 void MOSAsmPrinter::emitInstruction(const MachineInstr *MI) {
+  // Keep each 16-bit Y load adjacent to its access through allocation and
+  // width insertion. Both accumulator widths use an Imag16 index operand.
+  unsigned IndexedOpcode = 0;
+  switch (MI->getOpcode()) {
+  case MOS::LDIndirYIdxFused:
+  case MOS::LDIndirYIdx16Fused:
+    IndexedOpcode = MOS::LDA_IndirectIndexed;
+    break;
+  case MOS::STIndirYIdxFused:
+  case MOS::STIndirYIdx16Fused:
+    IndexedOpcode = MOS::STA_IndirectIndexed;
+    break;
+  }
+  if (IndexedOpcode) {
+    MCOperand Idx, Addr;
+    lowerOperand(MI->getOperand(2), Idx);
+    lowerOperand(MI->getOperand(1), Addr);
+    MCInst LdY;
+    LdY.setOpcode(MOS::LDY_ZeroPage);
+    LdY.addOperand(Idx);
+    EmitToStreamer(*OutStreamer, LdY);
+    MCInst Mem;
+    Mem.setOpcode(IndexedOpcode);
+    Mem.addOperand(Addr);
+    EmitToStreamer(*OutStreamer, Mem);
+    return;
+  }
+
   // Do any auto-generated pseudo lowerings.
   if (MCInst OutInst; lowerPseudoInstExpansion(MI, OutInst)) {
     EmitToStreamer(*OutStreamer, OutInst);
diff --git a/llvm/lib/Target/MOS/MOSInstrGISel.td b/llvm/lib/Target/MOS/MOSInstrGISel.td
index 6764ef9a0627..b37b32c5d9c4 100644
--- a/llvm/lib/Target/MOS/MOSInstrGISel.td
+++ b/llvm/lib/Target/MOS/MOSInstrGISel.td
@@ -205,6 +205,33 @@ def G_STORE16_INDIR_IDX : MOSGenericInstruction {
   let mayStore = true;
 }
 
+// Native indices: abs,X16 indexed load/store — lda/sta abs,X with a 16-bit X index (X=0).
+// Naming: G_LOAD_*16 = any-width data, 16-bit index (X=0). Distinct from G_LOAD16_*
+// (16-bit data, 8-bit index). Gate predicate: HasIndex16 (not HasAccum16). The
+// index type1 is s16 (Xc16 after selection); data type0 may be s8 or s16.
+def G_LOAD_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16]; let mayLoad = true;
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList  = (ins  unknown:$base, type1:$index);
+}
+def G_STORE_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16]; let mayStore = true;
+  let OutOperandList = (outs);
+  let InOperandList  = (ins  type0:$src, unknown:$base, type1:$index);
+}
+// Native indices: (zp),Y16 indirect indexed — lda/sta (zp),Y with a 16-bit Y index (X=0).
+// The base is a ZP pointer (ptype1 = Imag16 after selection); index type1 is s16 (Yc16).
+def G_LOAD_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16]; let mayLoad = true;
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList  = (ins  ptype1:$base, type1:$index);
+}
+def G_STORE_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16]; let mayStore = true;
+  let OutOperandList = (outs);
+  let InOperandList  = (ins  type0:$src, ptype1:$base, type1:$index);
+}
+
 // Generalized 8-bit store using the indirect indexed addressing mode. The index
 // argument is an 8-bit scalar. Additionally expects a MachineMemOperand.
 def G_STORE_INDIR_IDX : MOSGenericInstruction {
diff --git a/llvm/lib/Target/MOS/MOSInstrLogical.td b/llvm/lib/Target/MOS/MOSInstrLogical.td
index dd598e1dd1b6..202adbfaafb8 100644
--- a/llvm/lib/Target/MOS/MOSInstrLogical.td
+++ b/llvm/lib/Target/MOS/MOSInstrLogical.td
@@ -570,6 +570,34 @@ def STAbsIdx : MOSStore {
   dag InOperandList = (ins Ac:$src, addr16:$addr, XY:$idx);
 }
 
+// An Imag16 index is loaded into Y immediately before the byte access. Keep
+// both operations in one pseudo until emission so spills cannot insert a
+// sep #$10 between them and clear Y's high byte. XLow brackets the pair with
+// 16-bit index mode; the accumulator remains 8 bits wide.
+// The index stays in Imag16 until emission. Loading Y and using it in one
+// instruction prevents X8 spill code from clearing Y's high byte between them.
+// The full Y16 definition also prevents allocation of another live value in Y.
+let Defs = [Y16], Size = 4, Predicates = [HasW65816, HasIndex16], XLow = 1 in {
+def LDIndirYIdxFused : MOSLoad {
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList = (ins Imag16:$addr, Imag16:$idx);
+}
+def STIndirYIdxFused : MOSStore {
+  dag InOperandList = (ins Ac:$src, Imag16:$addr, Imag16:$idx);
+}
+let MLow = 1 in {
+def LDIndirYIdx16Fused : MOSLoad {
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList = (ins Imag16:$addr, Imag16:$idx);
+}
+def STIndirYIdx16Fused : MOSStore {
+  dag InOperandList = (ins Ac16:$src, Imag16:$addr, Imag16:$idx);
+}
+}
+}
+
+
+
 // STA (zp)
 def STIndir : MOSStore, PseudoInstExpansion<(STA_Indirect addr8:$addr)> {
   let Predicates = [Has65C02];
