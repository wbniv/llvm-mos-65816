+
+define void @near_store_word_wrapping(ptr %p, i16 %i, i16 %v) {
+; MIR-LABEL: name: near_store_word_wrapping
+; MIR-NOT: STIndirYIdx
+; MIR: STAIndir16 {{.*}} :: (volatile store (s16)
+; CHECK-LABEL: near_store_word_wrapping:
+; CHECK-NOT: ),y
+; CHECK: sta (__rc{{[0-9]+}})
+; CHECK: rts
+  %q = getelementptr i8, ptr %p, i16 %i
