+// Native 16-bit far accesses retain the far address or pointer operand so the
+// selector can choose an explicit long opcode in accumulator-wide mode.
+def G_LOAD16_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr);
+  let mayStore = true;
+}
+def G_LOAD16_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr, type1:$index);
+  let mayStore = true;
+}
+def G_LOAD16_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasAccum16, HasIndex16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasAccum16, HasIndex16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr, type1:$index);
+  let mayStore = true;
+}
+
