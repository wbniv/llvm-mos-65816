 }
 class MOSReg8Class<dag RegList>: MOSRegClass<[i8], 8, RegList>;
 class MOSReg16Class<dag RegList>: MOSRegClass<[i16], 8, RegList>;
+// 32-bit register class (the far-pointer ZP quad Imag32).
+class MOSReg32Class<dag RegList>: MOSRegClass<[i32], 8, RegList>;
 
 // Single register classes.
 let isPressureFineGrained = true in {
@@ -234,7 +262,11 @@ let isPressureFineGrained = true in {
 def Imag8 : MOSReg8Class<(sequence "RC%u", 0, !add(MaxImag8Regs, -1))>;
 def Imag16 : MOSReg16Class<(sequence "RS%u", 0, !add(MaxImag16Regs, -1))>;
 
-// Native widths: the 16-bit accumulator as a register class (single member,
+// the 32-bit far-pointer ZP class (4 contiguous __rc bytes).
+// The runtime far pointer dereferenced by `lda [dp]`/`sta [dp]` lives here.
+def Imag32 : MOSReg32Class<(sequence "RL%u", 0, !add(MaxImag32Regs, -1))>;
+
+// #321 Increment 1b: the 16-bit accumulator as a register class (single member,
 // A16 = B:A — NOT the carry flag C). Target of 16-bit-accumulator load/add/store
 // under +mos-a16. Named Ac16 to parallel the 8-bit accumulator class `Ac`.
 def Ac16 : MOSReg16Class<(add A16)>;
