diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.td b/llvm/lib/Target/MOS/MOSRegisterInfo.td
index e64c0860e596..2c84b489848a 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.td
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.td
@@ -27,6 +27,12 @@ def sublo : MOSSubRegIndex<8>;
 // High byte of a 16-bit imaginary pointer register.
 def subhi : MOSSubRegIndex<8, 8>;
 
+// 16-bit-word subregister indices for the 32-bit imaginary
+// far-pointer register Imag32 (a quad = pair of 16-bit RS words = 4 contiguous
+// zero-page __rc bytes). The low word reuses sublo/subhi for its two bytes.
+def sublo16 : MOSSubRegIndex<16>;
+def subhi16 : MOSSubRegIndex<16, 16>;
+
 // Carry bit of the 8-bit processor status register.
 def subcarry : MOSSubRegIndex<1>;
 
@@ -201,6 +207,26 @@ foreach I = 0...!add(MaxImag16Regs, -1) in {
        !cast<Register>("RC"#!add(!shl(I,1),1))]>;
 }
 
+// Far-pointer quads consist of two Imag16 pairs and four consecutive bytes.
+// Their subregister layout supplies the three bytes read by [dp] addressing.
+// getReservedRegs reserves a quad whenever either constituent pair is reserved.
+// Quads have no assigned DWARF number; their byte and word subregisters retain
+// the existing MOS DWARF mappings.
+class MOSImagReg32<bits<32> num, string name, list<Register> subregs>
+    : MOSReg<num, name> {
+  let DwarfNumbers = [-1];
+  let SubRegs = subregs;
+  let SubRegIndices = [sublo16, subhi16];
+  let CoveredBySubRegs = 1;
+}
+defvar MaxImag32Regs = !sra(MaxImag16Regs, 1);
+defvar Imag32RegsOffset = 0x600;
+foreach K = 0...!add(MaxImag32Regs, -1) in {
+  def RL#K: MOSImagReg32<!add(K, Imag32RegsOffset), "rl"#!cast<string>(K),
+      [!cast<Register>("RS"#!shl(K, 1)),
+       !cast<Register>("RS"#!add(!shl(K,1),1))]>;
+}
+
