 #include "llvm/CodeGen/GlobalISel/LegalizerHelper.h"
 #include "llvm/CodeGen/GlobalISel/LegalizerInfo.h"
 #include "llvm/CodeGen/GlobalISel/LostDebugLocObserver.h"
@@ -2246,6 +2247,23 @@ static bool willBeStaticallyAllocated(const MachineOperand &MO) {
   return !MF.getFrameInfo().isFixedObjectIndex(MO.getIndex());
 }
 
+// Native 65816 indexed addressing carries out of the 16-bit address into
+// DBR. A near G_PTR_ADD wraps at 16 bits, so folding it into an index requires
+// proof that its unsigned sum cannot wrap. Inbounds alone permits subtraction.
+static bool canFoldNearIndex(const GPtrAdd &PtrAdd, LegalizerHelper &Helper) {
+  const auto &STI = Helper.MIRBuilder.getMF().getSubtarget<MOSSubtarget>();
+  if (!STI.hasW65816() || PtrAdd.getFlag(MachineInstr::NoUWrap))
+    return true;
+  auto *VT = Helper.getValueTracking();
+  KnownBits Offset = VT->getKnownBits(PtrAdd.getOffsetReg());
+  if (PtrAdd.getFlag(MachineInstr::NoUSWrap) && Offset.isNonNegative())
+    return true;
+  KnownBits Base = VT->getKnownBits(PtrAdd.getBaseReg());
+  bool Overflow;
+  (void)Base.getMaxValue().uadd_ov(Offset.getMaxValue(), Overflow);
+  return !Overflow;
+}
