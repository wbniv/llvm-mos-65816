From fca866fa6f759b040fa026b834ba59a24e3a8e20 Mon Sep 17 00:00:00 2001
From: Will Norris <will@biohack.net>
Date: Wed, 30 Sep 2026 00:00:00 +0000
Subject: [PATCH 15/36] [MOS] Keep small 8-bit adds relocatable under +mos-a16

Under +mos-a16, an 8-bit add or subtract of 2 selects as two G_INC/G_DEC steps constrained to Anyi8 instead of `clc; adc #2`, whose operand is pinned to A.

A counter pinned to A that stays live across a 16-bit indexed-load transit (Ac16, which covers A) can deadlock greedy allocation: the counter cannot be recolored off its single register, and the single-instruction Ac16 transit cannot be spilled. An Anyi8 counter can live in X, Y or zero page. The step limit keeps the chain no larger than `clc; adc`. The result is the same modular value.

Default-mode effect: none (gated on +mos-a16; fixed input set identical).

Tests: a16-small-add.ll checks that +2 and -2 become two `inx`/`dex` under +mos-a16, that +3 keeps `adc`, and that the default mode keeps `adc` for all three. It checks the selection, not the allocation failure itself, which needs a larger function.

Validate: `build/bin/llvm-lit -v llvm/test/CodeGen/MOS/a16-small-add.ll`.

Extraction of the monolithic native-width patch: OpenAI Codex CLI 0.158.0 (codex-tui), model gpt-6-astra, xhigh reasoning effort; verified session 01a0e75a-a9ed-7372-9bac-b19b732a46a2. Split into this series: Claude Code 2.1.283 (t4-opus-high agent), model Claude Opus 5.5 (claude-opus-5-5), high reasoning effort.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HAKZG571yi9zqmAeWQZVtk
---
 .../lib/Target/MOS/MOSInstructionSelector.cpp | 45 +++++++++++++++++++
 llvm/test/CodeGen/MOS/a16-small-add.ll        | 39 ++++++++++++++++
 2 files changed, 84 insertions(+)
 create mode 100644 llvm/test/CodeGen/MOS/a16-small-add.ll

diff --git a/llvm/lib/Target/MOS/MOSInstructionSelector.cpp b/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
index a08f97853e45..553993ba3f84 100644
--- a/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
+++ b/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
@@ -545,6 +545,51 @@ bool MOSInstructionSelector::selectAddSub(MachineInstr &MI) {
     // Don't inhibit generation of INC/DEC.
     if (RHSConst->Value.abs().isOne())
       return false;
+
+    // A16 register-pressure relief: under +mos-a16, lower a SMALL-constant
+    // 8-bit add/sub to a short chain of relocatable INC/DEC (G_INC/G_DEC ->
+    // IncMB/DecMB on the Anyi8 class = A/X/Y/zp) instead of the A-pinned `add
+    // Ac,imm -> ADCImm` selImpl pattern (ADCImm constrains its operand to
+    // Ac={A} because `adc` is hardware-A-only). WHY: an A-pinned i8 loop
+    // counter — e.g. a u16-array byte index stepped `i += 2` — held live across
+    // a 16-bit indexed-load transit (Ac16 = A:B) deadlocks greedy register
+    // allocation: the counter cannot be recolored off the singleton A and the
+    // single-instruction INF Ac16 transit cannot spill (a16regpress.c: "ran out
+    // of registers"; pinpointed on an asserts build — last-chance recoloring of
+    // the {A} counter fails, so the Ac16 transit never gets $a16). A
+    // relocatable Anyi8 counter instead coalesces into the X array index (which
+    // is itself a COPY of the counter), freeing A16. selectIncDecMB constrains
+    // the chain to Anyi8 (the real relocate-off-A mechanism). Gated on
+    // hasAccum16() so the DEFAULT 8-bit build is byte-identical (it keeps the
+    // ADCImm pattern). Bounded by kMaxA16IncDecChain so the chain is never
+    // larger than clc;adc (an inc is 1 B in a register / a 65C02 `inc a`; a
+    // value that must round-trip through A for `adc` costs at least as much in
+    // every residency). A miss only keeps the ADC — never a wrong value:
+    // G_ADD/G_SUB are plain modular ops with no carry-out operand, so an
+    // inc/dec chain is value-identical (exactly as the pre-existing ±1 rewrite
+    // already relies on).
+    constexpr int64_t kMaxA16IncDecChain = 2;
+    if (STI.hasAccum16() && MRI.getType(Dst) == LLT::scalar(8)) {
+      int64_t Amt = RHSConst->Value.getSExtValue();
+      if (MI.getOpcode() == MOS::G_SUB)
+        Amt = -Amt;
+      int64_t Steps = std::abs(Amt);
+      if (Steps >= 2 && Steps <= kMaxA16IncDecChain) {
+        unsigned GOpc = Amt > 0 ? MOS::G_INC : MOS::G_DEC;
+        Register Cur = MI.getOperand(1).getReg();
+        for (int64_t I = 0; I < Steps; ++I) {
+          Register Out = (I + 1 == Steps)
+                             ? Dst
+                             : MRI.createGenericVirtualRegister(LLT::scalar(8));
+          MachineInstr *G = Builder.buildInstr(GOpc, {Out}, {Cur});
+          if (!selectIncDecMB(*G))
+            return false;
+          Cur = Out;
+        }
+        MI.eraseFromParent();
+        return true;
+      }
+    }
   }
 
   int64_t CarryInVal = MI.getOpcode() == MOS::G_ADD ? 0 : -1;
diff --git a/llvm/test/CodeGen/MOS/a16-small-add.ll b/llvm/test/CodeGen/MOS/a16-small-add.ll
new file mode 100644
index 000000000000..3c2ede8d6bf9
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-small-add.ll
@@ -0,0 +1,39 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefix=DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefix=NATIVE
+
+; Under +mos-a16, adding or subtracting 2 on a byte uses two increments or
+; decrements that any 8-bit register can hold, instead of an adc pinned to A.
+; Larger steps, and the default mode, keep the adc.
+
+define i8 @add2(i8 %a, i8 %b) {
+; DEFAULT-LABEL: add2:
+; DEFAULT:      adc #2
+; NATIVE-LABEL: add2:
+; NATIVE:       inx
+; NATIVE-NEXT:  inx
+; NATIVE-NEXT:  txa
+; NATIVE-NEXT:  rts
+  %r = add i8 %b, 2
+  ret i8 %r
+}
+
+define i8 @sub2(i8 %a, i8 %b) {
+; DEFAULT-LABEL: sub2:
+; DEFAULT:      adc #254
+; NATIVE-LABEL: sub2:
+; NATIVE:       dex
+; NATIVE-NEXT:  dex
+; NATIVE-NEXT:  txa
+; NATIVE-NEXT:  rts
+  %r = sub i8 %b, 2
+  ret i8 %r
+}
+
+define i8 @add3(i8 %a, i8 %b) {
+; DEFAULT-LABEL: add3:
+; DEFAULT:      adc #3
+; NATIVE-LABEL: add3:
+; NATIVE:       adc #3
+  %r = add i8 %b, 3
+  ret i8 %r
+}
