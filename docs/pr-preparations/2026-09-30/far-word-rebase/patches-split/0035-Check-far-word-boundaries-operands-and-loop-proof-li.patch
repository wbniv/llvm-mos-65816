+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=mos-insert-rep-sep -verify-machineinstrs %s -o - | FileCheck %s
+
+# The folded far word load reads `lda [dp],y` with an 8-bit Y. Under
+# +mos-xy16 a preceding 16-bit index instruction leaves X=0, so REP/SEP
+# insertion must set X=1 (sep #$10) together with M=0 before the load.
+---
+name: x16_then_word
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $y
+    ; CHECK-LABEL: name: x16_then_word
+    ; CHECK: REP_Immediate 16
+    ; CHECK-NEXT: $x16 = LDXImm16 1000
+    ; CHECK-NEXT: STXAbs16 killed $x16, 4864
+    ; CHECK-NEXT: REP_Immediate 32
+    ; CHECK-NEXT: SEP_Immediate 16
+    ; CHECK-NEXT: $a16 = LDIndirLongIdx16 $rl1, killed $y
+    ; CHECK-NEXT: STAbs16 killed $a16, 4866
+    ; CHECK-NEXT: SEP_Immediate 32
+    ; CHECK-NEXT: RTS
+    $x16 = LDXImm16 1000
+    STXAbs16 killed $x16, 4864
+    $a16 = LDIndirLongIdx16 $rl1, killed $y
+    STAbs16 killed $a16, 4866
+    RTS
+...
