index 000000000000..c1c5ee3efa68
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-word-index-boundaries.mir
@@ -0,0 +1,168 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+#
+# The group's last byte must fit Y8, and the indexed word keeps its original
+# base, narrowed offset, and volatile memory operand. The offset's maximum is
+# provided by known bits, independently of the loop-range matcher.
+--- |
+  declare void @callee()
+  define void @end254() { ret void }
+  define void @end255() { ret void }
+  define void @atomic() { ret void }
+  define void @escape() { ret void }
+  define void @call_between() { ret void }
+  define void @word_store_sibling() { ret void }
+  define void @byte_store_sibling() { ret void }
+...
+
+# CHECK-LABEL: name: end254
+# CHECK: %[[BASE:[a-zA-Z0-9_]+]]:_(p2) = COPY $rl1
+# CHECK: %[[OFFSET:[a-zA-Z0-9_]+]]:_(s8) = G_AND
+# CHECK-NOT: G_PTR_ADD
+# CHECK: = G_LOAD16_FAR_INDIR_IDX{{ }}%[[BASE]](p2), %[[OFFSET]] :: (volatile load (s16), align 1, addrspace 2)
+# CHECK-NOT: G_PTR_ADD
+---
+name: end254
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 254
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    RTS
+...
+
+# CHECK-LABEL: name: end255
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+# CHECK: = G_LOAD16_FAR_INDIR{{ }}
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+---
+name: end255
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 255
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    RTS
+...
+
+# CHECK-LABEL: name: atomic
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+---
+name: atomic
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 254
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %value:_(s16) = G_LOAD %ptr(p2) :: (load monotonic (s16), align 2, addrspace 2)
+    RTS
+...
+
+# CHECK-LABEL: name: escape
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+# CHECK: = G_LOAD16_FAR_INDIR{{ }}
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+---
+name: escape
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 254
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %out:_(p0) = G_CONSTANT i16 512
+    %escaped:_(s32) = G_PTRTOINT %ptr(p2)
+    G_STORE %escaped(s32), %out(p0) :: (volatile store (s32))
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    RTS
+...
+
+# CHECK-LABEL: name: call_between
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+# CHECK: = G_LOAD16_FAR_INDIR{{ }}
+# CHECK-NOT: G_LOAD16_FAR_INDIR_IDX
+---
+name: call_between
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 254
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    JSR @callee, mos_csr
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    RTS
+...
+
+# A word store is never folded, so a word store sharing the address rejects the
+# whole group: the word load keeps its explicit pointer too.
+# CHECK-LABEL: name: word_store_sibling
+# CHECK-NOT: _IDX
+# CHECK: = G_LOAD16_FAR_INDIR{{ }}%ptr(p2)
+# CHECK-NEXT: G_STORE16_FAR_INDIR{{ }}%v(s16), %ptr(p2)
+# CHECK-NOT: _IDX
+---
+name: word_store_sibling
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a, $rs2
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %v:_(s16) = COPY $rs2
+    %mask:_(s8) = G_CONSTANT i8 127
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    G_STORE %v(s16), %ptr(p2) :: (volatile store (s16), align 1, addrspace 2)
+    RTS
+...
+
+# The same group with a byte store folds both accesses on the shared base.
+# CHECK-LABEL: name: byte_store_sibling
+# CHECK: = G_LOAD16_FAR_INDIR_IDX{{ }}%base(p2), %bound
+# CHECK-NEXT: G_STORE_FAR_INDIR_IDX{{ }}%byte(s8), %base(p2), %bound
+# CHECK-NOT: G_PTR_ADD
+---
+name: byte_store_sibling
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rl1, $a
+    %base:_(p2) = COPY $rl1
+    %byte:_(s8) = COPY $a
+    %mask:_(s8) = G_CONSTANT i8 127
+    %bound:_(s8) = G_AND %byte, %mask
+    %offset:_(s32) = G_ZEXT %bound(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %offset(s32)
+    %value:_(s16) = G_LOAD %ptr(p2) :: (volatile load (s16), align 1, addrspace 2)
+    G_STORE %byte(s8), %ptr(p2) :: (volatile store (s8), addrspace 2)
+    RTS
+...
diff --git a/llvm/test/CodeGen/MOS/far-word-index-integration.ll b/llvm/test/CodeGen/MOS/far-word-index-integration.ll
new file mode 100644
index 000000000000..4ea34f438809
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-word-index-integration.ll
@@ -0,0 +1,29 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -stop-after=legalizer -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=BYTE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -stop-after=legalizer -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=MIR
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM
+
+; Known bits bounds the starting offset by 254 without a loop proof. The live
+; arithmetic result and volatile store keep the native word consumer observable.
+@result = external global i16
+
+define void @bounded_word(ptr addrspace(2) %base, i8 %index) {
+; BYTE-LABEL: name: bounded_word
+; BYTE-NOT: G_LOAD16_FAR_INDIR
+; BYTE: = G_LOAD_FAR_INDIR_IDX{{ }}
+; BYTE-NOT: G_LOAD16_FAR_INDIR
+; MIR-LABEL: name: bounded_word
+; MIR: = G_LOAD16_FAR_INDIR_IDX{{ }}
+; ASM-LABEL: bounded_word:
+; ASM: rep #32
+; ASM: lda [__rc{{[0-9]+}}],y
+; ASM: sta result
+; ASM: sep #32
+  %bounded = and i8 %index, -2
+  %offset = zext i8 %bounded to i32
+  %address = getelementptr i8, ptr addrspace(2) %base, i32 %offset
+  %value = load volatile i16, ptr addrspace(2) %address, align 1
+  %sum = add i16 %value, 1234
+  store volatile i16 %sum, ptr @result
+  ret void
+}
