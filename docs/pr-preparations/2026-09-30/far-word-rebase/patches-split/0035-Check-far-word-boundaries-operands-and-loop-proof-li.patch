+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+#
+# PHI operand order does not change the recurrence. A narrow scale must preserve
+# its own width, and range recursion and multiple entries conservatively bound
+# the analysis.
+
+# CHECK-LABEL: name: reverse_phi
+# CHECK: = G_LOAD_FAR_INDIR_IDX{{ }}
+---
+name: reverse_phi
+tracksRegLiveness: true
+body: |
+  bb.0:
+    successors: %bb.1
+    liveins: $rs0, $rs2
+    %lo:_(s16) = COPY $rs0
+    %hi:_(s16) = COPY $rs2
+    %raw:_(s32) = G_MERGE_VALUES %lo(s16), %hi(s16)
+    %base:_(p2) = G_INTTOPTR %raw(s32)
+    %start:_(s8) = G_CONSTANT i8 0
+    %end:_(s8) = G_CONSTANT i8 48
+    %step:_(s8) = G_CONSTANT i8 1
+    %carry:_(s1) = G_CONSTANT i1 1
+    %disp:_(s32) = G_CONSTANT i32 8
+    %shift:_(s32) = G_CONSTANT i32 1
+    %wrapadd:_(s8) = G_CONSTANT i8 248
+    G_BR %bb.1
+  bb.1:
+    successors: %bb.1, %bb.2
+    %iv:_(s8) = G_PHI %next(s8), %bb.1, %start(s8), %bb.0
+    %off:_(s32) = G_ZEXT %iv(s8)
+    %ptr:_(p2) = G_PTR_ADD %base, %off(s32)
+    %addr:_(p2) = G_PTR_ADD %ptr, %disp(s32)
+    %value:_(s8) = G_LOAD %addr(p2) :: (volatile load (s8), addrspace 2)
+    %next:_(s8) = G_ADD %iv, %step
+    %sub:_(s8), %carryout:_(s1), %negative:_(s1), %overflow:_(s1), %zero:_(s1) = G_SBC %next, %end, %carry
+    G_BRCOND_IMM %zero(s1), %bb.1, 0
+    G_BR %bb.2
+  bb.2:
+    RTS
+...
+
