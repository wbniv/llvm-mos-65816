diff --git a/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.cpp b/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.cpp
index 52307132776f..3687db758249 100644
--- a/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.cpp
+++ b/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.cpp
@@ -78,6 +78,37 @@ void MOSInstPrinter::printOperand(const MCInst *MI, unsigned OpNo,
   }
 }
 
+// A 24-bit address prints its width explicitly whenever the bare text could be
+// re-parsed as something narrower. `lda far_sym` is indistinguishable from a
+// 16-bit absolute load, so reassembling printed assembly -- which is what
+// -save-temps does -- silently selects the near instruction: a far load or
+// store loses its bank byte and becomes DBR-relative, and a long jump ($5C)
+// becomes a bank-local one ($4C). Wrapping in mos24() pins the width; the
+// assembler already honours the modifier, and $5C needs no mnemonic of its own
+// once its operand says how wide it is.
+//
+// The wrapper is omitted where the text is already unambiguous, so ordinary
+// disassembly of a bank-non-zero address stays readable.
+void MOSInstPrinter::printAddr24Operand(const MCInst *MI, unsigned OpNo,
+                                        raw_ostream &OS) {
+  const MCOperand &Op = MI->getOperand(OpNo);
+
+  // A constant that cannot fit a 16-bit operand already states its own width.
+  if (Op.isImm() && (Op.getImm() < 0 || Op.getImm() > 0xFFFF))
+    return printOperand(MI, OpNo, OS);
+
+  // An expression that already carries a MOS modifier prints that modifier
+  // itself; wrapping it again would yield mos24(mos24(x)).
+  if (Op.isExpr())
+    if (const auto *MME = dyn_cast<MOSMCExpr>(Op.getExpr()))
+      if (MME->getKind() != MOSMCExpr::VK_NONE)
+        return printOperand(MI, OpNo, OS);
+
+  OS << "mos24(";
+  printOperand(MI, OpNo, OS);
+  OS << ')';
+}
+
 // A 16-bit immediate prints its width explicitly whenever the bare text could
 // be re-parsed as an 8-bit one. The assembler has no notion of the M/X flags,
 // so `adc #66` always matches the narrowest candidate and reassembles to two
diff --git a/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.h b/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.h
index 50b49bd88126..d9f970989c2b 100644
--- a/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.h
+++ b/llvm/lib/Target/MOS/MCTargetDesc/MOSInstPrinter.h
@@ -37,6 +37,7 @@ public:
 
   // generated by TableGen
   void printInstruction(const MCInst *MI, uint64_t Address, raw_ostream &OS);
+  void printAddr24Operand(const MCInst *MI, unsigned OpNo, raw_ostream &OS);
   void printOperand(const MCInst *MI, unsigned OpNo, raw_ostream &OS);
   void printImm16Operand(const MCInst *MI, unsigned OpNo, raw_ostream &OS);
   void printBranchOperand(const MCInst *MI, uint64_t Address, unsigned OpNo,
diff --git a/llvm/lib/Target/MOS/MOSInstrFormats.td b/llvm/lib/Target/MOS/MOSInstrFormats.td
index faddda0a9cc5..fdde627909f5 100644
--- a/llvm/lib/Target/MOS/MOSInstrFormats.td
+++ b/llvm/lib/Target/MOS/MOSInstrFormats.td
@@ -287,6 +287,7 @@ def addr16at3 : addr16at<3>;
 
 class addr24at<int offset> : Operand<i32> {
   let ParserMatchClass = Addr24Operand<"Addr24">;
+  let PrintMethod = "printAddr24Operand";
   let EncoderMethod = "encodeImm<MOS::Addr24, " # offset # ">";
   let DecoderMethod = "decodeUImmOperand<24>";
   let OperandType = "OPERAND_ADDR24";
diff --git a/llvm/test/CodeGen/MOS/long-address-symbol-printer.mir b/llvm/test/CodeGen/MOS/long-address-symbol-printer.mir
new file mode 100644
index 000000000000..2afddf941db1
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/long-address-symbol-printer.mir
@@ -0,0 +1,18 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -start-after=machine-opt-remark-emitter -verify-machineinstrs %s -o - | FileCheck %s
+# Symbolic long operands retain their address width when the text is reassembled.
+# The explicit instructions do not require a far-pointer code generation feature.
+---
+name: long_symbol
+body: |
+  bb.0.entry:
+    LDA_AbsoluteLong &long_data
+    STA_AbsoluteLong &long_data
+    LDA_AbsoluteXLong &long_data
+    JSL_AbsoluteLong &long_target
+    RTS
+    ; CHECK-LABEL: long_symbol:
+    ; CHECK: lda mos24(long_data)
+    ; CHECK: sta mos24(long_data)
+    ; CHECK: lda mos24(long_data),x
+    ; CHECK: jsl mos24(long_target)
+...
diff --git a/llvm/test/MC/MOS/long-address-roundtrip-65816.s b/llvm/test/MC/MOS/long-address-roundtrip-65816.s
new file mode 100644
index 000000000000..2c182109e414
--- /dev/null
+++ b/llvm/test/MC/MOS/long-address-roundtrip-65816.s
@@ -0,0 +1,51 @@
+# RUN: llvm-mc -triple mos -mcpu=mosw65816 -disassemble %s | FileCheck %s
+# RUN: llvm-mc -triple mos -mcpu=mosw65816 -disassemble %s \
+# RUN:   | llvm-mc -triple mos -mcpu=mosw65816 -show-encoding | FileCheck %s --check-prefix=RT
+
+# A 24-bit address has to be printed with an explicit width, or the assembly
+# does not survive being read back: a bare operand matches the narrowest
+# candidate, so a far load collapses to a zero page or absolute one (losing its
+# bank byte and becoming DBR-relative) and a $5C long jump collapses to a $4C
+# bank-local one. $5C has no mnemonic of its own -- it is spelled "jmp", like
+# $4C -- so the operand's modifier is what keeps the two apart.
+
+# absolute long, bank 0: without mos24() this reads back as `lda <240` ($a5).
+0xaf,0xf0,0x00,0x00
+# CHECK: lda mos24(240)
+# RT: encoding: [0xaf,0xf0,0x00,0x00]
+
+0x8f,0xf0,0x00,0x00
+# CHECK: sta mos24(240)
+# RT: encoding: [0x8f,0xf0,0x00,0x00]
+
+# absolute long,X in the 16-bit range: without mos24() this reads back as
+# `lda $abcd,x` ($bd), three bytes instead of four.
+0xbf,0xcd,0xab,0x00
+# CHECK: lda mos24(43981),x
+# RT: encoding: [0xbf,0xcd,0xab,0x00]
+
+# the long jump: without mos24() this reads back as $4c, a jump inside the
+# current program bank rather than to bank 0 -- a different destination.
+0x5c,0xf0,0x00,0x00
+# CHECK: jmp mos24(240)
+# RT: encoding: [0x5c,0xf0,0x00,0x00]
+
+# jsl has no narrower form to collapse into, but is marked for consistency.
+0x22,0xf0,0x00,0x00
+# CHECK: jsl mos24(240)
+# RT: encoding: [0x22,0xf0,0x00,0x00]
+
+# An address that cannot fit a 16-bit operand already states its own width, so
+# it stays bare and ordinary disassembly does not grow a wrapper.
+0xaf,0xea,0xea,0xea
+# CHECK: lda 15395562
+# CHECK-NOT: mos24
+# RT: encoding: [0xaf,0xea,0xea,0xea]
+
+0x5c,0xea,0xea,0xea
+# CHECK: jmp 15395562
+# RT: encoding: [0x5c,0xea,0xea,0xea]
+
+# The modifier is idempotent: re-printing an operand that already carries one
+# must not wrap it a second time.
+# RT-NOT: mos24(mos24(
