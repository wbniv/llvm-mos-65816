 .../MOS/MCTargetDesc/MOSInstPrinter.cpp       | 31 +++++++++++
 .../Target/MOS/MCTargetDesc/MOSInstPrinter.h  |  1 +
 llvm/lib/Target/MOS/MOSInstrFormats.td        |  1 +
 .../MOS/long-address-symbol-printer.mir       | 18 +++++++
 .../MC/MOS/long-address-roundtrip-65816.s     | 51 +++++++++++++++++++
 5 files changed, 102 insertions(+)
 create mode 100644 llvm/test/CodeGen/MOS/long-address-symbol-printer.mir
