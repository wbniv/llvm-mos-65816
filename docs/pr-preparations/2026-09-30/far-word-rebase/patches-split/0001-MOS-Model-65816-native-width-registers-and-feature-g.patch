+; RUN: llc -mtriple=mos -mcpu=mos6502 -verify-machineinstrs < %s | FileCheck %s --check-prefix=MOS6502
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefix=W65816
+
+; The opt-in 65816 native-width registers must not change register pressure,
+; and so code, for subtargets that don't enable them. Pressure sets derived
+; from Ac16, Xc16 and Yc16 would move the low-byte subtraction of this compare
+; in both modes. The expected output is the one without those registers.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+define i16 @scmp_i16_i32(i32 %a, i32 %b) {
+; MOS6502-LABEL: scmp_i16_i32:
