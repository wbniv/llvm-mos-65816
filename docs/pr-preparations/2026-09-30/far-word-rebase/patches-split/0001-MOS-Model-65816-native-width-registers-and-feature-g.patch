+; MOS6502-NEXT:    rts
+;
+; W65816-LABEL: scmp_i16_i32:
+; W65816:       ; %bb.0:
+; W65816-NEXT:    sta __rc9
+; W65816-NEXT:    stx __rc8
+; W65816-NEXT:    ldy __rc7
+; W65816-NEXT:    pha
+; W65816-NEXT:    lda __rc4
