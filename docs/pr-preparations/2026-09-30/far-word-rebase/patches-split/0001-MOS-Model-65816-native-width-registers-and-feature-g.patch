diff --git a/llvm/lib/Target/MOS/MOSFeatures.td b/llvm/lib/Target/MOS/MOSFeatures.td
index 76d7409c1f1b..180dbaf85a09 100644
--- a/llvm/lib/Target/MOS/MOSFeatures.td
+++ b/llvm/lib/Target/MOS/MOSFeatures.td
@@ -19,3 +19,19 @@ def FeatureStaticStack :
   SubtargetFeature<
     "static-stack", "StaticStack", "true",
     "Whether to use statically-allocated stack frames if possible.">;
+
+// Native widths: opt-in 16-bit accumulator mode for the WDC 65816 (REP/SEP-bracketed
+// 16-bit-A codegen). Enable with -mattr=+mos-a16; NOT implied by FamilyW65816,
+// so default mosw65816 codegen is unaffected.
+def FeatureAccum16 :
+  SubtargetFeature<
+    "mos-a16", "HasAccum16", "true",
+    "16-bit accumulator mode (insert REP/SEP) on the WDC 65816.">;
+
+// Native indices: opt-in 16-bit index register mode for the WDC 65816.
+// Implies +mos-a16: soft-stack spill uses TXA→A16→STA (needs M=0 bracket).
+def FeatureIndex16 :
+  SubtargetFeature<
+    "mos-xy16", "HasIndex16", "true",
+    "16-bit index register mode (insert REP/SEP X) on the WDC 65816.",
+    [FeatureAccum16]>;
diff --git a/llvm/lib/Target/MOS/MOSRegisterBanks.td b/llvm/lib/Target/MOS/MOSRegisterBanks.td
index 868f6c71270a..d7e981ef61dc 100644
--- a/llvm/lib/Target/MOS/MOSRegisterBanks.td
+++ b/llvm/lib/Target/MOS/MOSRegisterBanks.td
@@ -11,4 +11,7 @@
 //===----------------------------------------------------------------------===//
 
 // Register banks are unused, so place everything in one big bank.
-def AnyRegBank : RegisterBank<"Any", [Anyi1, Anyi8, Imag16, Fakei32, Fakei64]>;
+// Native widths: Ac16 (the 16-bit accumulator A16) joins the bank so 16-bit
+// accumulator ops can be allocated. Allocation to A16 is forced by the Ac16
+// register class on the selected ops, not by the bank (banks are unused here).
+def AnyRegBank : RegisterBank<"Any", [Anyi1, Anyi8, Imag16, Ac16, Fakei32, Fakei64]>;
diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.td b/llvm/lib/Target/MOS/MOSRegisterInfo.td
index 5d4b239d1f3d..52d4cbc453be 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.td
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.td
@@ -111,6 +111,28 @@ def P : MOSReg<3, "P"> {
   let SubRegIndices = [subcarry, subnz, subv];
 }
 
+// Native registers alias their byte halves for allocation and liveness. The
+// full registers use the MOS DWARF native-mode numbers. Internal high-byte
+// pieces have no standalone DWARF location.
+def B : MOSReg<0, "b"> { let DwarfNumbers = [-1]; }
+def A16 : MOSReg<0x01000000, "a16"> {
+  let SubRegs = [A, B];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+def XH : MOSReg<0, "xh"> { let DwarfNumbers = [-1]; }
+def YH : MOSReg<0, "yh"> { let DwarfNumbers = [-1]; }
+def X16 : MOSReg<0x01000001, "x16"> {
+  let SubRegs = [X, XH];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+def Y16 : MOSReg<0x01000002, "y16"> {
+  let SubRegs = [Y, YH];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+
 //===----------------------------------------------------------------------===//
 //  Imaginary registers
 //===----------------------------------------------------------------------===//
@@ -212,6 +234,22 @@ let isPressureFineGrained = true in {
 def Imag8 : MOSReg8Class<(sequence "RC%u", 0, !add(MaxImag8Regs, -1))>;
 def Imag16 : MOSReg16Class<(sequence "RS%u", 0, !add(MaxImag16Regs, -1))>;
 
+// The native-width classes below are opt-in and must not create register
+// pressure sets: MachineLICM, MachineSink and the scheduler read the pressure
+// tables in every mode, so new sets would change code for programs that never
+// enable +mos-a16 or +mos-xy16.
+let GeneratePressureSet = 0 in {
+// Native widths: the 16-bit accumulator as a register class (single member,
+// A16 = B:A — NOT the carry flag C). Target of 16-bit-accumulator load/add/store
+// under +mos-a16. Named Ac16 to parallel the 8-bit accumulator class `Ac`.
+def Ac16 : MOSReg16Class<(add A16)>;
+
+// Native indices: 16-bit index register classes, one member each. Used only under
+// +mos-xy16; inert otherwise. Mirror Ac16.
+def Xc16 : MOSReg16Class<(add X16)>;
+def Yc16 : MOSReg16Class<(add Y16)>;
+}
+
 // Instruction-specific register classes.
 def AImag8 : MOSReg8Class<(add Imag8, A)>;
 let isPressureFineGrained = true in {
diff --git a/llvm/lib/Target/MOS/MOSSubtarget.h b/llvm/lib/Target/MOS/MOSSubtarget.h
index 6d303255c67f..aaac0ceb50bb 100644
--- a/llvm/lib/Target/MOS/MOSSubtarget.h
+++ b/llvm/lib/Target/MOS/MOSSubtarget.h
@@ -115,6 +115,14 @@ public:
   bool hasJMPIdxIndir() const { return has65C02() || hasSPC700(); }
   bool staticStack() const { return StaticStack; }
 
+  // Native widths: opt-in 16-bit accumulator mode (REP/SEP-bracketed 16-bit-A
+  // codegen).
+  bool hasAccum16() const { return HasAccum16; }
+
+  // Native indices: opt-in 16-bit index register mode (REP/SEP-bracketed
+  // 16-bit-X/Y).
+  bool hasIndex16() const { return HasIndex16; }
+
   bool hasW65816Or65EL02() const { return HasW65816Insns || Has65EL02Insns; }
 
 private:
@@ -140,6 +148,8 @@ private:
 
   bool LongRegisterNames = false;
   bool StaticStack = false;
+  bool HasAccum16 = false;
+  bool HasIndex16 = false;
 
   // Dummy member, used by FeatureSet's. We cannot have a SubtargetFeature with
   // no variable, so we instead bind pseudo features to this variable.
