diff --git a/llvm/test/MC/MOS/index-width-mapping-65816.s b/llvm/test/MC/MOS/index-width-mapping-65816.s
new file mode 100644
index 0000000..b0a5ff0
--- /dev/null
+++ b/llvm/test/MC/MOS/index-width-mapping-65816.s
@@ -0,0 +1,54 @@
+# RUN: llvm-mc -triple=mos -mcpu=mosw65816 -filetype=obj %s -o %t.o
+# RUN: llvm-objdump -t %t.o | FileCheck %s
+
+# The 8-bit index-register memory forms require 8-bit index registers, so on
+# the 65816 each of them opens an $xh mapping region after a 16-bit index
+# instruction. Every probe below follows a 16-bit `ldx` ($xl), so each one
+# must start its own $xh region at its own offset.
+
+# CHECK-DAG: 00000003 l .text 00000000 $xh.1
+# CHECK-DAG: 00000008 l .text 00000000 $xh.3
+# CHECK-DAG: 0000000d l .text 00000000 $xh.5
+# CHECK-DAG: 00000013 l .text 00000000 $xh.7
+# CHECK-DAG: 00000018 l .text 00000000 $xh.9
+# CHECK-DAG: 0000001e l .text 00000000 $xh.11
+# CHECK-DAG: 00000023 l .text 00000000 $xh.13
+# CHECK-DAG: 00000029 l .text 00000000 $xh.15
+# CHECK-DAG: 0000002e l .text 00000000 $xh.17
+# CHECK-DAG: 00000034 l .text 00000000 $xh.19
+# CHECK-DAG: 00000039 l .text 00000000 $xh.21
+# CHECK-DAG: 0000003e l .text 00000000 $xh.23
+# CHECK-DAG: 00000044 l .text 00000000 $xh.25
+# CHECK-DAG: 00000049 l .text 00000000 $xh.27
+# CHECK-DAG: 0000004f l .text 00000000 $xh.29
+
+ldx #mos16($1234)
+stx $12
+ldx #mos16($1234)
+stx $12,y
+ldx #mos16($1234)
+stx $1234
+ldx #mos16($1234)
+ldx $12
+ldx #mos16($1234)
+ldx $1234
+ldx #mos16($1234)
+ldx $12,y
+ldx #mos16($1234)
+ldx $1234,y
+ldx #mos16($1234)
+sty $12
+ldx #mos16($1234)
+sty $1234
+ldx #mos16($1234)
+sty $12,x
+ldx #mos16($1234)
+ldy $12,x
+ldx #mos16($1234)
+ldy $1234,x
+ldx #mos16($1234)
+ldy $12
+ldx #mos16($1234)
+cpy $1234
+ldx #mos16($1234)
+cpx $12
diff --git a/llvm/test/CodeGen/MOS/native-width-registers.mir b/llvm/test/CodeGen/MOS/native-width-registers.mir
new file mode 100644
index 0000000..4f5f668
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/native-width-registers.mir
@@ -0,0 +1,28 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=none -verify-machineinstrs %s -o - 2>&1 | FileCheck %s
+
+# The native-width features are recognized, and the 16-bit registers and
+# classes they add parse and verify. A16, X16 and Y16 are covered by their
+# byte halves: sublo of each is the 8-bit register the backend already uses.
+
+# CHECK-NOT: not a recognized feature
+# CHECK-LABEL: name: native_registers
+# CHECK: %0:ac16 = COPY $a16
+# CHECK-NEXT: %1:xc16 = COPY $x16
+# CHECK-NEXT: %2:yc16 = COPY $y16
+# CHECK-NEXT: $a = COPY %0.sublo
+# CHECK-NEXT: $x = COPY %1.sublo
+# CHECK-NEXT: $y = COPY %2.sublo
+---
+name: native_registers
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $a16, $x16, $y16
+    %0:ac16 = COPY $a16
+    %1:xc16 = COPY $x16
+    %2:yc16 = COPY $y16
+    $a = COPY %0.sublo
+    $x = COPY %1.sublo
+    $y = COPY %2.sublo
+    RTS implicit $a, implicit $x, implicit $y
+...
diff --git a/llvm/test/CodeGen/MOS/a16-accumulator-forms.mir b/llvm/test/CodeGen/MOS/a16-accumulator-forms.mir
new file mode 100644
index 0000000..0f0a6e8
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-accumulator-forms.mir
@@ -0,0 +1,66 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -start-before=branch-relaxation -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -start-before=branch-relaxation -verify-machineinstrs -filetype=obj %s -o %t.o
+# RUN: llvm-objdump -d --print-imm-hex %t.o | FileCheck %s --check-prefix=OBJ
+
+# Each 16-bit accumulator pseudo emits the width-agnostic opcode of its
+# addressing mode. A 16-bit immediate that would fit an 8-bit field prints as
+# mos16(value), so the text reassembles to the three-byte form; a value above
+# 255 already states its width and prints bare. The object carries the
+# three-byte immediate encodings.
+
+# CHECK-LABEL: accumulator_forms:
+# CHECK:      lda __rc2
+# CHECK-NEXT: clc
+# CHECK-NEXT: adc #mos16(66)
+# CHECK-NEXT: adc #43981
+# CHECK-NEXT: and #mos16(255)
+# CHECK-NEXT: ora {{.*}}g
+# CHECK-NEXT: eor __rc4
+# CHECK-NEXT: cmp #mos16(5)
+# CHECK-NEXT: asl
+# CHECK-NEXT: lsr
+# CHECK-NEXT: inc
+# CHECK-NEXT: dec
+# CHECK-NEXT: sta __rc2
+# CHECK-NEXT: sta {{.*}}g
+# CHECK-NEXT: rts
+
+# OBJ-LABEL: <accumulator_forms>:
+# OBJ:      a5 00 {{.*}}lda
+# OBJ-NEXT: 18 {{.*}}clc
+# OBJ-NEXT: 69 42 00 {{.*}}adc
+# OBJ-NEXT: 69 cd ab {{.*}}adc
+# OBJ-NEXT: 29 ff 00 {{.*}}and
+# OBJ:      45 00 {{.*}}eor
+# OBJ-NEXT: c9 05 00 {{.*}}cmp
+# OBJ-NEXT: 0a {{.*}}asl
+# OBJ-NEXT: 4a {{.*}}lsr
+# OBJ-NEXT: 1a {{.*}}inc
+# OBJ-NEXT: 3a {{.*}}dec
+# OBJ-NEXT: 85 00 {{.*}}sta
+--- |
+  @g = global i16 0
+  define void @accumulator_forms() { ret void }
+...
+---
+name: accumulator_forms
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rs1, $rs2
+    $a16 = LDAImag16 $rs1
+    $c = LDCImm 0
+    $a16, $c, $v = ADCImm16 $a16, 66, $c
+    $a16, $c, $v = ADCImm16 $a16, 43981, $c
+    $a16 = ANDImm16 $a16, 255
+    $a16 = ORAAbs16 $a16, @g
+    $a16 = EORImag16 $a16, $rs2
+    $c = CMPImm16 $a16, 5, implicit-def $nz
+    $a16 = ASLAcc16 $a16, implicit-def $c
+    $a16 = LSRAcc16 $a16, implicit-def $c
+    $a16 = INCAcc16 $a16
+    $a16 = DECAcc16 $a16
+    $rs1 = STAImag16 $a16
+    STAbs16 killed $a16, @g
+    RTS
+...
