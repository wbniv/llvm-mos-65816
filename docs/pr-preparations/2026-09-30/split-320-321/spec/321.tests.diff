diff --git a/llvm/test/CodeGen/MOS/native-spill-copy.mir b/llvm/test/CodeGen/MOS/native-spill-copy.mir
new file mode 100644
index 0000000..00f10db
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/native-spill-copy.mir
@@ -0,0 +1,69 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=postrapseudos -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=COPY
+
+# A soft-stack spill of A16 is one word store or load through the exact slot
+# pointer; a slot at a nonzero offset first forms that pointer, because (zp)
+# addressing has no index.
+
+# CHECK-LABEL: name: spill_a16
+# CHECK:     $rc6 = COPY killed $a
+# CHECK:     $rc7 = COPY killed $a
+# CHECK:     STAIndir16 $a16, $rs3
+# CHECK-NEXT: STAIndir16 $a16, $rs0
+# CHECK:     $a16 = LDAIndir16 $rs4
+---
+name: spill_a16
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
+  - { id: 1, type: spill-slot, size: 2, alignment: 1 }
+body: |
+  bb.0:
+    liveins: $a16
+    dead early-clobber renamable $rs3 = STStk renamable $a16, %stack.0, 0
+    dead early-clobber renamable $rs3 = STStk renamable $a16, %stack.1, 0
+    renamable $a16, dead early-clobber renamable $rs4 = LDStk %stack.0, 0
+    RTS implicit $a16
+...
+
+# X16 has no (zp) store of its own, so its spill is staged through A16. A16
+# is live across the spill here, so the expansion saves it with PHA16/PLA16.
+
+# CHECK-LABEL: name: spill_x16_a_live
+# CHECK:      PHA16 $a16
+# CHECK-NEXT: $a16 = TXA16 $x16
+# CHECK-NEXT: STAIndir16 killed $a16, $rs0
+# CHECK-NEXT: $a16 = PLA16
+# CHECK-NEXT: PHA16 $a16
+# CHECK-NEXT: $a16 = LDAIndir16 $rs0
+# CHECK-NEXT: $x16 = TAX16 killed $a16
+# CHECK-NEXT: $a16 = PLA16
+---
+name: spill_x16_a_live
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
+body: |
+  bb.0:
+    liveins: $a16, $x16
+    dead early-clobber renamable $rs3 = STStk killed renamable $x16, %stack.0, 0
+    renamable $x16, dead early-clobber renamable $rs4 = LDStk %stack.0, 0
+    RTS implicit $a16, implicit $x16
+...
+
+# Copies between a 16-bit index register and an Imag16 pair are one index
+# load or store of the pair.
+
+# COPY-LABEL: name: copy_index
+# COPY:      $x16 = LDXImag16 $rs1
+# COPY-NEXT: $rs2 = STYImag16 $y16
+---
+name: copy_index
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rs1, $y16
+    $x16 = COPY killed $rs1
+    $rs2 = COPY killed $y16
+    RTS implicit $x16, implicit $rs2
+...
diff --git a/llvm/test/CodeGen/MOS/coalesce-call-clobbered-imag.mir b/llvm/test/CodeGen/MOS/coalesce-call-clobbered-imag.mir
new file mode 100644
index 0000000..ca86aea
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/coalesce-call-clobbered-imag.mir
@@ -0,0 +1,57 @@
+# RUN: llc -mtriple=mos -mcpu=mos6502 -run-pass=register-coalescer -verify-machineinstrs %s -o - | FileCheck %s
+
+# A value read straight out of a call-clobbered imaginary register ($rcN)
+# must not be folded into an Imag16 pair when it stays live across a call
+# that clobbers $rcN: the pair would inherit the $rcN hint and could be
+# assigned $rcN across the clobber. The COPYs are kept, so each byte gets its
+# own register.
+
+# CHECK-LABEL: name: live_across_call
+# CHECK:      JSR @g, mos_csr, implicit-def $rc2, implicit-def $rc3
+# CHECK-NEXT: [[LO:%[0-9]+]]:imag8 = COPY $rc2
+# CHECK-NEXT: [[HI:%[0-9]+]]:imag8 = COPY $rc3
+# CHECK-NEXT: JSR @g, mos_csr
+# CHECK-NEXT: undef [[PAIR:%[0-9]+]].sublo:imag16 = COPY [[LO]]
+# CHECK-NEXT: [[PAIR]].subhi:imag16 = COPY [[HI]]
+# CHECK-NEXT: $rs1 = COPY [[PAIR]]
+
+# Without an intervening call the guard does not apply, and the bytes are
+# coalesced into the pair as usual.
+
+# CHECK-LABEL: name: no_call_between
+# CHECK:      JSR @g, mos_csr, implicit-def $rc2, implicit-def $rc3
+# CHECK-NEXT: undef [[PAIR2:%[0-9]+]].sublo:imag16 = COPY $rc2
+# CHECK-NEXT: [[PAIR2]].subhi:imag16 = COPY $rc3
+# CHECK-NEXT: $rs1 = COPY [[PAIR2]]
+--- |
+  declare void @g()
+  define i16 @live_across_call() { ret i16 0 }
+  define i16 @no_call_between() { ret i16 0 }
+...
+---
+name: live_across_call
+tracksRegLiveness: true
+body: |
+  bb.0:
+    JSR @g, mos_csr, implicit-def $rc2, implicit-def $rc3
+    %0:imag8 = COPY $rc2
+    %1:imag8 = COPY $rc3
+    JSR @g, mos_csr
+    undef %2.sublo:imag16 = COPY %0
+    %2.subhi:imag16 = COPY %1
+    $rs1 = COPY %2
+    RTS implicit $rs1
+...
+---
+name: no_call_between
+tracksRegLiveness: true
+body: |
+  bb.0:
+    JSR @g, mos_csr, implicit-def $rc2, implicit-def $rc3
+    %0:imag8 = COPY $rc2
+    %1:imag8 = COPY $rc3
+    undef %2.sublo:imag16 = COPY %0
+    %2.subhi:imag16 = COPY %1
+    $rs1 = COPY %2
+    RTS implicit $rs1
+...
diff --git a/llvm/test/CodeGen/MOS/a16-load-store.ll b/llvm/test/CodeGen/MOS/a16-load-store.ll
new file mode 100644
index 0000000..92d804c
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-load-store.ll
@@ -0,0 +1,89 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+
+; Under +mos-a16, a 16-bit value moves through memory with one word load and
+; one word store in a single rep/sep bracket, whether the address is absolute,
+; a runtime pointer, or a runtime pointer with a Y index. A loaded value may
+; pass through its Imag16 home between the two accesses, still in M=0.
+
+@g = global i16 0, align 1
+@h = global i16 0, align 1
+
+define void @copy_indirect_to_global(ptr %p) {
+; CHECK-LABEL: copy_indirect_to_global:
+; CHECK:      rep #32
+; CHECK-NEXT: lda (__rc2)
+; CHECK-NEXT: sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load i16, ptr %p, align 1
+  store i16 %v, ptr @g, align 1
+  ret void
+}
+
+define void @copy_global_to_global() {
+; CHECK-LABEL: copy_global_to_global:
+; CHECK:      rep #32
+; CHECK-NEXT: lda g
+; CHECK-NOT:  sep
+; CHECK:      sta h
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load volatile i16, ptr @g, align 1
+  store volatile i16 %v, ptr @h, align 1
+  ret void
+}
+
+define void @copy_global_to_indirect(ptr %p) {
+; CHECK-LABEL: copy_global_to_indirect:
+; CHECK:      rep #32
+; CHECK-NEXT: lda g
+; CHECK-NEXT: sta (__rc2)
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load i16, ptr @g, align 1
+  store i16 %v, ptr %p, align 1
+  ret void
+}
+
+define void @load_runtime_index(ptr %p, i8 %i) {
+; CHECK-LABEL: load_runtime_index:
+; CHECK:      tay
+; CHECK-NEXT: rep #32
+; CHECK-NEXT: lda (__rc2),y
+; CHECK-NOT:  sep
+; CHECK:      sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %x = zext i8 %i to i16
+  %s = getelementptr inbounds nuw i8, ptr %p, i16 %x
+  %v = load volatile i16, ptr %s, align 1
+  store volatile i16 %v, ptr @g, align 1
+  ret void
+}
+
+define void @load_constant_offset(ptr %p) {
+; CHECK-LABEL: load_constant_offset:
+; CHECK:      ldy #6
+; CHECK-NEXT: rep #32
+; CHECK-NEXT: lda (__rc2),y
+; CHECK-NOT:  sep
+; CHECK:      sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %s = getelementptr inbounds nuw i8, ptr %p, i16 6
+  %v = load volatile i16, ptr %s, align 1
+  store volatile i16 %v, ptr @g, align 1
+  ret void
+}
+
+; A constant is cheaper as two byte immediate stores than materialized into
+; an Imag16 pair for a word store.
+define void @store_constant() {
+; CHECK-LABEL: store_constant:
+; CHECK-NOT:  rep
+; CHECK:      stx g
+; CHECK:      stx g+1
+; CHECK-NEXT: rts
+  store i16 4660, ptr @g, align 1
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/near-index-nowrap.ll b/llvm/test/CodeGen/MOS/near-index-nowrap.ll
new file mode 100644
index 0000000..fc9293d
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/near-index-nowrap.ll
@@ -0,0 +1,63 @@
+; RUN: llc -mtriple=mos -mcpu=mos6502 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,M6502
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,W65816
+
+; On the 65816, an indexed access adds the index to the 16-bit base with a
+; carry into the bank, while a near pointer add wraps at 16 bits. The add is
+; folded into (zp),y or abs,x only when it cannot wrap: it is nuw, it is
+; inbounds with a non-negative offset, or known bits bound the sum below
+; 0x10000. Other CPUs wrap either way and always fold.
+
+define i8 @plain(ptr %p, i8 %i) {
+; CHECK-LABEL: plain:
+; M6502:      lda (__rc2),y
+; W65816-NOT: (__rc2),y
+; W65816:     adc __rc2
+; W65816:     lda (__rc2)
+  %x = zext i8 %i to i16
+  %q = getelementptr i8, ptr %p, i16 %x
+  %v = load i8, ptr %q
+  ret i8 %v
+}
+
+define i8 @nuw(ptr %p, i8 %i) {
+; CHECK-LABEL: nuw:
+; CHECK:      tay
+; CHECK-NEXT: lda (__rc2),y
+  %x = zext i8 %i to i16
+  %q = getelementptr nuw i8, ptr %p, i16 %x
+  %v = load i8, ptr %q
+  ret i8 %v
+}
+
+define i8 @inbounds_nonnegative(ptr %p, i8 %i) {
+; CHECK-LABEL: inbounds_nonnegative:
+; CHECK:      tay
+; CHECK-NEXT: lda (__rc2),y
+  %x = zext i8 %i to i16
+  %q = getelementptr inbounds i8, ptr %p, i16 %x
+  %v = load i8, ptr %q
+  ret i8 %v
+}
+
+@t = global [16 x i8] zeroinitializer
+
+define i8 @global_base(i8 %i) {
+; CHECK-LABEL: global_base:
+; M6502:      lda t,x
+; W65816-NOT: t,x
+; W65816:     lda (__rc2)
+  %x = zext i8 %i to i16
+  %q = getelementptr i8, ptr @t, i16 %x
+  %v = load i8, ptr %q
+  ret i8 %v
+}
+
+define i8 @bounded_constant_base(i8 %i) {
+; CHECK-LABEL: bounded_constant_base:
+; CHECK:      tax
+; CHECK-NEXT: lda 4096,x
+  %x = zext i8 %i to i16
+  %q = getelementptr i8, ptr inttoptr (i16 4096 to ptr), i16 %x
+  %v = load i8, ptr %q
+  ret i8 %v
+}
diff --git a/llvm/test/CodeGen/MOS/a16-small-add.ll b/llvm/test/CodeGen/MOS/a16-small-add.ll
new file mode 100644
index 0000000..3c2ede8
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-small-add.ll
@@ -0,0 +1,39 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefix=DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefix=NATIVE
+
+; Under +mos-a16, adding or subtracting 2 on a byte uses two increments or
+; decrements that any 8-bit register can hold, instead of an adc pinned to A.
+; Larger steps, and the default mode, keep the adc.
+
+define i8 @add2(i8 %a, i8 %b) {
+; DEFAULT-LABEL: add2:
+; DEFAULT:      adc #2
+; NATIVE-LABEL: add2:
+; NATIVE:       inx
+; NATIVE-NEXT:  inx
+; NATIVE-NEXT:  txa
+; NATIVE-NEXT:  rts
+  %r = add i8 %b, 2
+  ret i8 %r
+}
+
+define i8 @sub2(i8 %a, i8 %b) {
+; DEFAULT-LABEL: sub2:
+; DEFAULT:      adc #254
+; NATIVE-LABEL: sub2:
+; NATIVE:       dex
+; NATIVE-NEXT:  dex
+; NATIVE-NEXT:  txa
+; NATIVE-NEXT:  rts
+  %r = sub i8 %b, 2
+  ret i8 %r
+}
+
+define i8 @add3(i8 %a, i8 %b) {
+; DEFAULT-LABEL: add3:
+; DEFAULT:      adc #3
+; NATIVE-LABEL: add3:
+; NATIVE:       adc #3
+  %r = add i8 %b, 3
+  ret i8 %r
+}
