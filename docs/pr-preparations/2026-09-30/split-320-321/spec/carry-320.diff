diff --git a/llvm/test/CodeGen/MOS/far-access-non-65816.ll b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
new file mode 100644
index 000000000000..e452a289ee30
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
@@ -0,0 +1,51 @@
+; RUN: split-file %s %t
+; RUN: not llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: not llc -mtriple=mos -mcpu=mos65c02 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: not llc -mtriple=mos -mcpu=mosspc700 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs %t/value.ll -o - | FileCheck %s --check-prefix=VALUE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs -o /dev/null %t/access.ll
+
+; Far (addrspace 2) memory is reached only with 65816 long addressing. On any
+; other MOS CPU a far load, store, extending load or memory intrinsic is
+; diagnosed instead of being selected as a 65816 [dp] opcode, which those CPUs
+; decode as unrelated instructions ($A7 is an undocumented LAX on the 6502).
+; Passing a far pointer as a value stays legal.
+
+; ERR: error: {{.*}}in function ld_rt i8 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function st_rt void (ptr addrspace(2), i8): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function ld_zext i16 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function set_far void (ptr addrspace(2), i16): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+
+;--- access.ll
+define i8 @ld_rt(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+define void @st_rt(ptr addrspace(2) %p, i8 %v) {
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+define i16 @ld_zext(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  %z = zext i8 %v to i16
+  ret i16 %z
+}
+
+define void @set_far(ptr addrspace(2) %p, i16 %n) {
+  call void @llvm.memset.p2.i16(ptr addrspace(2) %p, i8 0, i16 %n, i1 false)
+  ret void
+}
+
+declare void @llvm.memset.p2.i16(ptr addrspace(2), i8, i16, i1 immarg)
+
+;--- value.ll
+declare void @use(ptr addrspace(2))
+
+; VALUE-LABEL: pass:
+; VALUE: {{jsr|jmp}} use
+define void @pass(ptr addrspace(2) %p) {
+  call void @use(ptr addrspace(2) %p)
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/far-index-fold-debug.ll b/llvm/test/CodeGen/MOS/far-index-fold-debug.ll
new file mode 100644
index 000000000000..5642ea60ca6d
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-index-fold-debug.ll
@@ -0,0 +1,58 @@
+; RUN: split-file %s %t
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs -stop-after=legalizer %t/byte.ll -o - | FileCheck %s --check-prefixes=CHECK,BYTE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs %t/byte.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs %t/byte.ll -o /dev/null
+
+; When the far runtime-index fold absorbs every access through a far pointer
+; add, the add dies. salvageDebugInfo cannot express base + zext(offset), so the
+; fold drops the location of the remaining DBG_VALUE ($noreg) instead of leaving
+; it on the erased vreg, where DetectDeadLanes would mark it undef and the
+; verifier would reject it.
+
+; CHECK-LABEL: name: walk
+; CHECK: DBG_VALUE %0(p2), $noreg, ![[BASE:[0-9]+]], !DIExpression()
+; CHECK: DBG_VALUE $noreg, $noreg, ![[P:[0-9]+]], !DIExpression()
+; BYTE-NEXT: G_LOAD_FAR_INDIR_IDX %0(p2)
+; CHECK-NOT: G_PTR_ADD
+
+;--- byte.ll
+@sink = external global i16
+
+define void @walk(ptr addrspace(2) %base, i8 %n) !dbg !10 {
+entry:
+  call void @llvm.dbg.value(metadata ptr addrspace(2) %base, metadata !15, metadata !DIExpression()), !dbg !20
+  br label %loop
+loop:
+  %i = phi i8 [ 0, %entry ], [ %next, %loop ]
+  %acc = phi i16 [ 0, %entry ], [ %sum, %loop ]
+  %off = zext i8 %i to i32
+  %p = getelementptr i8, ptr addrspace(2) %base, i32 %off
+  call void @llvm.dbg.value(metadata ptr addrspace(2) %p, metadata !16, metadata !DIExpression()), !dbg !20
+  %wb = load i8, ptr addrspace(2) %p, !dbg !20
+  %w = zext i8 %wb to i16
+  %sum = add i16 %acc, %w, !dbg !20
+  %next = add i8 %i, 1
+  %done = icmp eq i8 %next, 100
+  br i1 %done, label %exit, label %loop
+exit:
+  store volatile i16 %sum, ptr @sink, !dbg !20
+  ret void, !dbg !20
+}
+
+
+declare void @llvm.dbg.value(metadata, metadata, metadata)
+
+!llvm.dbg.cu = !{!0}
+!llvm.module.flags = !{!2, !3}
+!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "probe", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
+!1 = !DIFile(filename: "dbg.c", directory: "/tmp")
+!2 = !{i32 2, !"Dwarf Version", i32 4}
+!3 = !{i32 2, !"Debug Info Version", i32 3}
+!10 = distinct !DISubprogram(name: "walk", scope: !1, file: !1, line: 1, type: !11, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
+!11 = !DISubroutineType(types: !12)
+!12 = !{null}
+!13 = !DIBasicType(name: "char", size: 8, encoding: DW_ATE_unsigned_char)
+!14 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !13, size: 32)
+!15 = !DILocalVariable(name: "base", arg: 1, scope: !10, file: !1, line: 1, type: !14)
+!16 = !DILocalVariable(name: "p", scope: !10, file: !1, line: 2, type: !14)
+!20 = !DILocation(line: 2, scope: !10)
diff --git a/llvm/test/CodeGen/MOS/far-memop-length.ll b/llvm/test/CodeGen/MOS/far-memop-length.ll
