+}
+
+; Provably bounded runtime lengths stay on the 16-bit entries.
+define void @set_zext(ptr addrspace(2) %d, i16 %n) {
+; CHECK-LABEL: set_zext:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
