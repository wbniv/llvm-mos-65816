+; A far memset/memcpy/memmove length is passed to the 16-bit __mem*_far
+; entries only when it provably fits 16 bits (a constant <= 0xFFFF, or known
+; bits). Any other length goes to the uint32_t __mem*_far32 entries and is never
+; truncated to 16 bits (which would turn 70000 into 4464, 65536 into 0 and 65537
+; into 1).
+
+define void @set_65535(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_65535:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 65535, i1 false)
+  ret void
+}
+
+define void @set_65536(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_65536:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 65536, i1 false)
+  ret void
+}
+
+define void @set_65537(ptr addrspace(2) %d) {
