+
+define void @set_var(ptr addrspace(2) %d, i32 %n) {
+; CHECK-LABEL: set_var:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 7, i32 %n, i1 false)
+  ret void
+}
+
+; The loop idiom's zext(n) * 2 can exceed 0xFFFF.
+define void @set_scaled(ptr addrspace(2) %d, i16 %n) {
+; CHECK-LABEL: set_scaled:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  %z = zext i16 %n to i32
+  %len = shl nuw nsw i32 %z, 1
