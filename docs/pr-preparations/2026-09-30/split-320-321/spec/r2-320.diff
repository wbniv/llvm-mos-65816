index 000000000000..4e66d53cc0ed
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-quad-spill-call.ll
@@ -0,0 +1,22 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O0 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O0 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs < %s | FileCheck %s
+
+; Four far pointers live across a call: only three callee-saved quads exist
+; (__rc20-__rc31), so at least one quad is spilled and reloaded as four bytes.
+
+declare void @ext()
+
+; CHECK-LABEL: f:
+; CHECK: jsr ext
+; CHECK-COUNT-4: lda [__rc{{[0-9]+}}]
+; CHECK: rts
+define i8 @f(ptr addrspace(2) %p0, ptr addrspace(2) %p1, ptr addrspace(2) %p2, ptr addrspace(2) %p3) {
+  call void @ext()
+  %v0 = load volatile i8, ptr addrspace(2) %p0
+  %v1 = load volatile i8, ptr addrspace(2) %p1
+  %v2 = load volatile i8, ptr addrspace(2) %p2
+  %v3 = load volatile i8, ptr addrspace(2) %p3
+  ret i8 %v0
+}
diff --git a/llvm/test/CodeGen/MOS/imag32-allocation-gate.mir b/llvm/test/CodeGen/MOS/imag32-allocation-gate.mir
