+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs < %s | FileCheck %s
+
+; An Imag32 quad that overlaps a reserved pair is reserved too. Otherwise the
+; stack pointer's register units are no longer reserved (RL0 covers RS0), and a
+; call with stack arguments aborts live-range computation in the register
+; coalescer with "Invalid global physical register".
+
+; CHECK-LABEL: main:
+; CHECK: jsr mini_sprintf
+define i16 @main() {
+  call void (ptr, ptr, ...) @mini_sprintf(ptr null, ptr null, i16 0, i16 0)
+  ret i16 0
+}
+
+declare void @mini_sprintf(ptr, ptr, ...)
