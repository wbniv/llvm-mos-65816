index 000000000000..ff5bfae19533
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/imag32-allocation-gate.mir
@@ -0,0 +1,20 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -start-before=greedy -stop-after=virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ALLOC
+# RUN: not llc -mtriple=mos -mcpu=mos6502 -start-before=greedy -stop-after=virtregrewriter -verify-machineinstrs %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESERVED
+
+# Imag32 quads are allocated only where MOSSubtarget::hasAllocatableImag32()
+# holds, which is the 65816; every other CPU has an empty Imag32 allocation
+# order, because linker scripts may place adjacent RS registers apart. A copy
+# from a quad outside the order is not used as an allocation hint.
+
+# ALLOC: renamable $rl1 = IMPLICIT_DEF
+# ALLOC-NEXT: RTS implicit $rl1
+# RESERVED: error: {{.*}}no registers from class available to allocate in function 'imag32_vreg'
+---
+name: imag32_vreg
+tracksRegLiveness: true
+body: |
+  bb.0.entry:
+    %0:imag32 = IMPLICIT_DEF
+    $rl1 = COPY %0
+    RTS implicit $rl1
+...
