From 5f5d76c59fa963dbeda9d9b4f04de299c692c93a Mon Sep 17 00:00:00 2001
From: Will Norris <will@biohack.net>
Date: Fri, 31 Jul 2026 15:24:51 -0600
Subject: [PATCH] [MOS] Fix non-GPR immediate loads in mos-late-opt

On SPC700, LDImm accepts imaginary-register destinations to represent
`mov dp, #imm`. `combineLdImm` tracks only A/X/Y; processing an
imaginary destination through that path dereferences a null tracking
pointer.

Restrict immediate-load folding to GPR destinations in the existing
filtering condition. Other instructions use the existing
register-invalidation path. The sibling TA handler keeps its original
behavior.

The SPC700 MIR regression covers an imaginary-register immediate load
and confirms that it does not interfere with folding an adjacent GPR
load to TAX.

On 06bc967d2668, 13 of the 38 CodeGen/MOS .ll tests crash in "MOS Late
Optimizations" at -mcpu=mosspc700 -O2 (for example fcmp.ll, zp-alloc.ll
and light-spill.ll); with this change all of them compile.

Carry note: this is the net diff of llvm-mos PR #584
(wbniv:mos-late-opt-nongpr-ldimm @ 7f4c37de6219), squashed as upstream
merges, with the PR's title and description. Squashed for the #320/#321
series by Claude Code 2.1.285 (t4-opus-high agent), model Claude Opus 5.5
(claude-opus-5-5), high reasoning effort.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 llvm/lib/Target/MOS/MOSLateOptimization.cpp |  6 ++---
 llvm/test/CodeGen/MOS/late-opt-spc700.mir   | 29 +++++++++++++++++++++
 2 files changed, 32 insertions(+), 3 deletions(-)
 create mode 100644 llvm/test/CodeGen/MOS/late-opt-spc700.mir

diff --git a/llvm/lib/Target/MOS/MOSLateOptimization.cpp b/llvm/lib/Target/MOS/MOSLateOptimization.cpp
index af0fdc7596c8..597976b1346e 100644
--- a/llvm/lib/Target/MOS/MOSLateOptimization.cpp
+++ b/llvm/lib/Target/MOS/MOSLateOptimization.cpp
@@ -287,9 +287,9 @@ bool MOSLateOptimization::combineLdImm(MachineBasicBlock &MBB) const {
       continue;
     }
 
-    if (MI.getOpcode() != MOS::LDImm || !MI.getOperand(1).isImm()) {
-      // If a register is overwritten with an instruction other than
-      // an immediate load, mark register value as unknown.
+    if (MI.getOpcode() != MOS::LDImm || !MI.getOperand(1).isImm() ||
+        !MOS::GPRRegClass.contains(MI.getOperand(0).getReg())) {
+      // Mark overwritten register values as unknown.
       if (MI.modifiesRegister(MOS::A, TRI))
         LoadA.MI = nullptr;
       if (MI.modifiesRegister(MOS::X, TRI))
diff --git a/llvm/test/CodeGen/MOS/late-opt-spc700.mir b/llvm/test/CodeGen/MOS/late-opt-spc700.mir
new file mode 100644
index 000000000000..fbf44581f299
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/late-opt-spc700.mir
@@ -0,0 +1,29 @@
+# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-late-opt -verify-machineinstrs -o - %s | FileCheck %s
+
+# SPC700 widens LDImm's destination to Anyi8 (`mov dp, #imm`). combineLdImm must
+# skip non-GPR destinations without disturbing its A/X/Y value tracking.
+
+---
+name: ldimm_imag8_only
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: ldimm_imag8_only
+    ; CHECK: $rc2 = LDImm 42
+    ; CHECK-NEXT: RTS implicit $rc2
+    $rc2 = LDImm 42
+    RTS implicit $rc2
+...
+---
+name: ldimm_imag8_between_gprs
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: ldimm_imag8_between_gprs
+    ; CHECK: $a = LDImm 7
+    ; CHECK-NEXT: $rc2 = LDImm 7
+    ; CHECK-NEXT: $x = TA $a
+    ; CHECK-NEXT: RTS implicit $a, implicit $x, implicit $rc2
+    $a = LDImm 7
+    $rc2 = LDImm 7
+    $x = LDImm 7
+    RTS implicit $a, implicit $x, implicit $rc2
+...
