   let OutOperandList = (outs);
   let InOperandList = (ins type0:$src, unknown:$base, type1:$index);
@@ -133,6 +161,50 @@ def G_STORE_INDIR : MOSGenericInstruction {
   let mayStore = true;
 }
 
+// #321 native s16: a 16-bit indirect store `sta (zp)` in 16-bit-accumulator mode —
+// stores a 16-bit value through a runtime pointer. Mirror of G_LOAD16_INDIR; the
+// selector lowers it to LDAImag16 (value -> A16) -> STAIndir16 (one rep/sep).
+def G_STORE16_INDIR : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$base);
+  let mayStore = true;
+}
+
+// #321 native s16: 16-bit abs,x load/store `lda abs,x` / `sta abs,x` in M=0 mode.
+// Mirrors G_LOAD_ABS_IDX / G_STORE_ABS_IDX for 16-bit data; the legalizer emits
+// these when the address is G_PTR_ADD(global/const, 8-bit-index). The selector
+// lowers them to LDAbsIdx16/STAbsIdx16 (one rep/sep bracket via MLow=1).
+def G_LOAD16_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$base, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$base, type1:$index);
+  let mayStore = true;
+}
+
+// #321 native s16: 16-bit (zp),y load/store in M=0 mode. Mirrors G_LOAD_INDIR_IDX /
+// G_STORE_INDIR_IDX for 16-bit data; the legalizer emits these when the address is
+// G_PTR_ADD(runtime_ptr, 8-bit-index). The selector lowers them to LDIndirIdx16 /
+// STIndirIdx16 (one rep/sep bracket via MLow=1).
+def G_LOAD16_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$base, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE16_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
