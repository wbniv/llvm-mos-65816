diff --git a/llvm/test/CodeGen/MOS/a16-load-store.ll b/llvm/test/CodeGen/MOS/a16-load-store.ll
new file mode 100644
index 000000000000..92d804cd5aa5
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-load-store.ll
@@ -0,0 +1,89 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+
+; Under +mos-a16, a 16-bit value moves through memory with one word load and
+; one word store in a single rep/sep bracket, whether the address is absolute,
+; a runtime pointer, or a runtime pointer with a Y index. A loaded value may
+; pass through its Imag16 home between the two accesses, still in M=0.
+
+@g = global i16 0, align 1
+@h = global i16 0, align 1
+
+define void @copy_indirect_to_global(ptr %p) {
+; CHECK-LABEL: copy_indirect_to_global:
+; CHECK:      rep #32
+; CHECK-NEXT: lda (__rc2)
+; CHECK-NEXT: sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load i16, ptr %p, align 1
+  store i16 %v, ptr @g, align 1
+  ret void
+}
+
+define void @copy_global_to_global() {
+; CHECK-LABEL: copy_global_to_global:
+; CHECK:      rep #32
+; CHECK-NEXT: lda g
+; CHECK-NOT:  sep
+; CHECK:      sta h
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load volatile i16, ptr @g, align 1
+  store volatile i16 %v, ptr @h, align 1
+  ret void
+}
+
+define void @copy_global_to_indirect(ptr %p) {
+; CHECK-LABEL: copy_global_to_indirect:
+; CHECK:      rep #32
+; CHECK-NEXT: lda g
+; CHECK-NEXT: sta (__rc2)
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %v = load i16, ptr @g, align 1
+  store i16 %v, ptr %p, align 1
+  ret void
+}
+
+define void @load_runtime_index(ptr %p, i8 %i) {
+; CHECK-LABEL: load_runtime_index:
+; CHECK:      tay
+; CHECK-NEXT: rep #32
+; CHECK-NEXT: lda (__rc2),y
+; CHECK-NOT:  sep
+; CHECK:      sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %x = zext i8 %i to i16
+  %s = getelementptr inbounds nuw i8, ptr %p, i16 %x
+  %v = load volatile i16, ptr %s, align 1
+  store volatile i16 %v, ptr @g, align 1
+  ret void
+}
+
+define void @load_constant_offset(ptr %p) {
+; CHECK-LABEL: load_constant_offset:
+; CHECK:      ldy #6
+; CHECK-NEXT: rep #32
+; CHECK-NEXT: lda (__rc2),y
+; CHECK-NOT:  sep
+; CHECK:      sta g
+; CHECK-NEXT: sep #32
+; CHECK-NEXT: rts
+  %s = getelementptr inbounds nuw i8, ptr %p, i16 6
+  %v = load volatile i16, ptr %s, align 1
+  store volatile i16 %v, ptr @g, align 1
+  ret void
+}
+
+; A constant is cheaper as two byte immediate stores than materialized into
+; an Imag16 pair for a word store.
+define void @store_constant() {
+; CHECK-LABEL: store_constant:
+; CHECK-NOT:  rep
+; CHECK:      stx g
+; CHECK:      stx g+1
+; CHECK-NEXT: rts
+  store i16 4660, ptr @g, align 1
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/native-width-pressure-opt-level.ll b/llvm/test/CodeGen/MOS/native-width-pressure-opt-level.ll
new file mode 100644
index 000000000000..4294eaeed5df
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/native-width-pressure-opt-level.ll
@@ -0,0 +1,30 @@
+; REQUIRES: asserts
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -debug-only=machine-scheduler \
+; RUN:   < %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SETS
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O3 -debug-only=machine-scheduler \
+; RUN:   < %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=NOSETS
+
+; Under +mos-a16, a 16-bit accumulator value counts toward the pressure sets of
+; its low byte, A. Below -O3, it and the 8-bit A also count toward an appended
+; A16 set with a limit of 2, so the heuristics see that an 8-bit value live
+; across a 16-bit one competes for the same register. That set saves code size
+; but costs cycles, so -O3 leaves it out.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@g = global i16 0, align 1
+@h = global i16 0, align 1
+
+define void @copy_global_to_global() {
+; SETS:         Max Pressure: GPR_LSB=2 GPR_LSB_with_Pc=2 Anyi1=2 Anyi1_with_Pc=2 A16=2 {{$}}
+; SETS:         STAImag16 %{{[0-9]+}}:ac16
+; SETS:         Pressure Diff      : GPR_LSB 2    GPR_LSB_with_Pc 2    A16 2{{$}}
+; NOSETS-NOT:   A16{{[= ]}}
+; NOSETS:       Max Pressure: GPR_LSB=2 GPR_LSB_with_Pc=2 Anyi1=2 Anyi1_with_Pc=2 {{$}}
+; NOSETS:       STAImag16 %{{[0-9]+}}:ac16
+; NOSETS:       Pressure Diff      : GPR_LSB 2    GPR_LSB_with_Pc 2{{$}}
+; NOSETS-NOT:   A16{{[= ]}}
+  %v = load volatile i16, ptr @g, align 1
+  store volatile i16 %v, ptr @h, align 1
+  ret void
+}
