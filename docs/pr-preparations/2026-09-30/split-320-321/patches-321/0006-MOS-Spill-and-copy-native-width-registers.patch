@@ -933,7 +945,17 @@ void MOSInstrInfo::loadStoreRegStackSlot(
       Instr.addDef(Ptr, RegState::EarlyClobber);
     Instr.addFrameIndex(FrameIndex).addImm(0).addMemOperand(MMO);
   } else {
-    if ((Reg.isPhysical() && MOS::Imag16RegClass.contains(Reg)) ||
