+      // wraps the XLow=1 op in its own rep/sep #$10.
+      Builder.buildInstr(IsLoad ? MOS::LDXAbs16 : MOS::STXAbs16)
+          .addReg(Reg, getDefRegState(IsLoad) | getKillRegState(IsKill))
+          .addFrameIndex(FrameIndex)
+          .addMemOperand(MMO);
+    } else if ((Reg.isPhysical() && MOS::Yc16RegClass.contains(Reg)) ||
+               (Reg.isVirtual() &&
+                MRI.getRegClass(Reg)->hasSuperClassEq(&MOS::Yc16RegClass))) {
+      // Native indices: spill/reload Y16 with a single 16-bit abs load/store.
+      Builder.buildInstr(IsLoad ? MOS::LDYAbs16 : MOS::STYAbs16)
+          .addReg(Reg, getDefRegState(IsLoad) | getKillRegState(IsKill))
+          .addFrameIndex(FrameIndex)
+          .addMemOperand(MMO);
     } else {
+      // #321 SPILL CONTRACT (static-stack mirror of MOSRegisterInfo::expandLDSTStk):
+      // this single-byte fall-through is correct ONLY for 8-bit classes. Every
+      // spillable >=16-bit register class needs its OWN case above. Handled:
