index 21910cfeab37..820f09f6f564 100644
--- a/llvm/lib/Target/MOS/MOSInstrPseudos.td
+++ b/llvm/lib/Target/MOS/MOSInstrPseudos.td
@@ -359,4 +359,45 @@ let mayLoad = true in {
   def CmpBrIndirIdx : MOSCmpBr {
     dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, Ac:$l, Imag16:$addr, Yc:$idx);
   }
+  // #321 native s16 equality (== / !=): a fused 16-bit compare-and-branch. The LHS
+  // is an Imag16 pair (loaded into A16 at expansion, unlike the 8-bit forms whose
+  // LHS is already in a GPR); the RHS is an Imag16 pair or a 16-bit immediate.
+  // expandCmpBr lowers these to `LDAImag16; CMPImag16/CMPImm16` (both MLow=1, so the
+  // REP/SEP pass brackets the lda/cmp) + BR reading Z (sep doesn't touch Z).
+  // Defs A16 + NZ: the expansion loads $l into the 16-bit accumulator and the cmp
+  // sets N/Z, so regalloc must treat both as clobbered across the pseudo (C is in
+  // the MOSCmpBr base).
+  def CmpBrImag16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, Imag16:$l, Imag16:$r);
+  }
+  def CmpBrImm16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, Imag16:$l, i16imm:$r);
+  }
+  // A native equality branch can fold two near absolute loads. The pseudo
+  // retains both memory references for expansion into LDAbs16 and CMPAbs16.
+  def CmpBrAbsAbs16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, addr16:$l, addr16:$r);
+  }
+  // A near absolute load compared with a constant expands to LDAbs16,
+  // CMPImm16, and a branch. getI16Const also recognizes split constants.
+  def CmpBrAbsImm16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, addr16:$l, i16imm:$r);
+  }
+  // Native widths: computed-vs-global: Imag16-resident LHS (computed/indirect value in zp) vs near-abs
+  // GLOBAL RHS — `lda zp_l` (LDAImag16, LhsAbs=false) + `cmp abs_r` (CMPAbs16). The global's
+  // memref rides on this pseudo and is cloned to the CMP by expandCmpBr16. Fills the mixed gap
+  // between CmpBrImag16 (both-Imag16) and CmpBrAbsAbs16 (both-global).
+  def CmpBrImagAbs16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, Imag16:$l, addr16:$r);
+  }
 }
