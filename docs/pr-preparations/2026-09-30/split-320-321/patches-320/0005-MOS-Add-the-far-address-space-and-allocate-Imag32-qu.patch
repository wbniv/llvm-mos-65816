-// Linker scripts may place adjacent RS registers apart, so RL cannot be
-// allocated safely.
-let isAllocatable = false in
-def Imag32 : MOSReg32Class<(sequence "RL%u", 0, !add(MaxImag32Regs, -1))>;
+// RL is allocatable only where its four RS bytes are known to be contiguous:
+// linker scripts may place adjacent RS registers apart. Unless
+// MOSSubtarget::hasAllocatableImag32() holds, Imag32 has an empty allocation
+// order. The registers stay unreserved, so the byte and word registers they
+// overlap keep their calling-convention roles.
+def Imag32 : MOSReg32Class<(sequence "RL%u", 0, !add(MaxImag32Regs, -1))> {
+  let AltOrders = [(sub (sequence "RL%u", 0, !add(MaxImag32Regs, -1)),
+                        (sequence "RL%u", 0, !add(MaxImag32Regs, -1)))];
+  let AltOrderSelect = [{
+    return MF.getSubtarget<MOSSubtarget>().hasAllocatableImag32() ? 0 : 1;
+  }];
+}
 
