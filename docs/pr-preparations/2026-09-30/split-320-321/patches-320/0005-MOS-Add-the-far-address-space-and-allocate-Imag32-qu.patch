diff --git a/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll b/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll
new file mode 100644
index 000000000000..bb817bd9454e
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll
@@ -0,0 +1,85 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s --check-prefix=STACK
+
+; A far (addrspace 2) pointer argument that finds no free quad goes to a
+; 4-byte stack slot. It must never reach the generic 16-bit CCIfPtr rule, whose
+; RS pair cannot hold the 32-bit value (a "COPY $rs1" into a p2 is a
+; size-mismatched copy). Quads are allocated only on the 65816
+; (MOSSubtarget::hasAllocatableImag32), so on other CPUs every far pointer
+; argument takes a stack slot.
+
+; Four far pointers: the fourth exceeds RL1..RL3 while RS1 is still free.
+define i8 @callee4(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d) {
+; CHECK-LABEL: name: callee4
+; CHECK: fixedStack:
+; CHECK-NEXT: - { id: 0, type: default, offset: 0, size: 4,
+; CHECK: liveins: $rl1, $rl2, $rl3{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[D:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK-NOT: COPY $rs
+; CHECK: G_LOAD [[D]](p2) :: (volatile load (s8) from %ir.d, addrspace 2)
+; STACK-LABEL: name: callee4
+; STACK: - { id: 3, type: default, offset: 0, size: 4,
+; STACK-NOT: liveins: $rl
+; STACK: [[A:%[0-9]+]]:_(p2) = G_LOAD {{%[0-9]+}}(p0) :: (invariant load (p2) from %fixed-stack.3, align 1)
+; STACK: G_LOAD [[A]](p2) :: (volatile load (s8) from %ir.a, addrspace 2)
+  %va = load volatile i8, ptr addrspace(2) %a
+  %vd = load volatile i8, ptr addrspace(2) %d
+  %s = add i8 %va, %vd
+  ret i8 %s
+}
+
+define i8 @caller4(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d) {
+; CHECK-LABEL: name: caller4
+; CHECK: ADJCALLSTACKDOWN 4, 0
+; CHECK: G_STORE %0(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack, align 1)
+; CHECK: JSR @callee4, mos_csr, implicit $rl1, implicit $rl2, implicit $rl3, implicit-def $a
+; CHECK: ADJCALLSTACKUP 4, 0
+; STACK-LABEL: name: caller4
+; STACK: ADJCALLSTACKDOWN 16, 0
+; STACK: G_STORE {{%[0-9]+}}(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack, align 1)
+; STACK: G_STORE {{%[0-9]+}}(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack + 12, align 1)
+; STACK-NEXT: JSR @callee4, mos_csr, implicit-def $a
+  %r = call i8 @callee4(ptr addrspace(2) %d, ptr addrspace(2) %c, ptr addrspace(2) %b, ptr addrspace(2) %a)
+  ret i8 %r
+}
+
+; Near/far interleaving: the quads are used up with RS1 free, the fourth far
+; pointer is stacked, and the trailing near pointer still takes RS1.
+define i8 @callee_ffffn(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d, ptr %n) {
+; CHECK-LABEL: name: callee_ffffn
+; CHECK: liveins: $rl1, $rl2, $rl3, $rs1{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[D:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK: {{%[0-9]+}}:_(p0) = COPY $rs1
+; CHECK: G_LOAD [[D]](p2) :: (volatile load (s8) from %ir.d, addrspace 2)
+  %vd = load volatile i8, ptr addrspace(2) %d
+  %vn = load volatile i8, ptr %n
+  %s = add i8 %vd, %vn
+  ret i8 %s
+}
+
+define i8 @caller_ffffn(ptr addrspace(2) %a, ptr %n) {
+; CHECK-LABEL: name: caller_ffffn
+; CHECK: ADJCALLSTACKDOWN 4, 0
+; CHECK: G_STORE %0(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack, align 1)
+; CHECK: JSR @callee_ffffn, mos_csr, implicit $rl1, implicit $rl2, implicit $rl3, implicit $rs1, implicit-def $a
+  %r = call i8 @callee_ffffn(ptr addrspace(2) %a, ptr addrspace(2) %a, ptr addrspace(2) %a, ptr addrspace(2) %a, ptr %n)
+  ret i8 %r
+}
+
+; Near pointers take RS1..RS3, which blocks RL1 (RS2:RS3): the first two far
+; pointers use RL2/RL3 and the third is stacked.
+define i8 @callee_nnnfff(ptr %n1, ptr %n2, ptr %n3, ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c) {
+; CHECK-LABEL: name: callee_nnnfff
+; CHECK: liveins: $rl2, $rl3, $rs1, $rs2, $rs3{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[C:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK: G_LOAD [[C]](p2) :: (volatile load (s8) from %ir.c, addrspace 2)
+  %vc = load volatile i8, ptr addrspace(2) %c
+  %vn = load volatile i8, ptr %n3
+  %s = add i8 %vc, %vn
+  ret i8 %s
+}
