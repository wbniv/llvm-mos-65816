--- a/llvm/lib/Target/MOS/MOSRegisterBanks.td
+++ b/llvm/lib/Target/MOS/MOSRegisterBanks.td
@@ -14,4 +14,11 @@
 // Native widths: Ac16 (the 16-bit accumulator A16) joins the bank so 16-bit
 // accumulator ops can be allocated. Allocation to A16 is forced by the Ac16
 // register class on the selected ops, not by the bank (banks are unused here).
-def AnyRegBank : RegisterBank<"Any", [Anyi1, Anyi8, Imag16, Ac16, Fakei32, Fakei64]>;
+// Imag32 (the real far-pointer ZP quad, distinct from the Fakei32
+// legalization placeholder) joins the bank so a 32-bit far pointer that is only
+// COPY'd through a function — e.g. received from one call and passed to the next,
+// never dereferenced locally — can be constrained to Imag32 by constrainGenericOp
+// (which needs the bank to COVER Imag32). Inert for default codegen: the only real
+// 32-bit register-resident value is a far (addrspace 2) pointer; s32 scalars are
+// narrowed by the legalizer and never reach selection as a single 32-bit vreg.
+def AnyRegBank : RegisterBank<"Any", [Anyi1, Anyi8, Imag16, Imag32, Ac16, Fakei32, Fakei64]>;
