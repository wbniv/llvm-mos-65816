+  // Far data pointers occupy one caller-saved imaginary quad where quads are
+  // allocatable. Register units alias the near-pointer pairs, so argument
+  // assignments cannot overlap.
+  CCIf<"State.getMachineFunction().getSubtarget<MOSSubtarget>()"
+       ".hasAllocatableImag32()",
+       CCIfPtrAddrSpace<2, CCAssignToReg<[RL1, RL2, RL3]>>>,
+  // A far pointer that finds no free quad goes to a 4-byte stack slot. Without
+  // this it would reach the generic CCIfPtr rule below and take a 16-bit RS
+  // pair, which cannot hold the 32-bit value.
+  CCIfPtrAddrSpace<2, CCAssignToStack<4, 1>>,
+
   // An 8-bit direct-page (addrspace 1) pointer is only 8 bits wide, so it must take
   // an 8-bit slot like an i8 value -- NOT the 16-bit RS pair the generic CCIfPtr rule
   // below would assign, which yields an illegal size-mismatched COPY ((p1) = COPY
