diff --git a/llvm/test/CodeGen/MOS/far-access-non-65816.ll b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
new file mode 100644
index 000000000000..c7ded3325b5e
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
@@ -0,0 +1,43 @@
+; RUN: split-file %s %t
+; RUN: not llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: not llc -mtriple=mos -mcpu=mos65c02 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: not llc -mtriple=mos -mcpu=mosspc700 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs %t/value.ll -o - | FileCheck %s --check-prefix=VALUE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs -o /dev/null %t/access.ll
+
+; Far (addrspace 2) memory is reached only with 65816 long addressing. On any
+; other MOS CPU a far load, store or extending load is diagnosed instead of
+; being selected as a 65816 [dp] opcode, which those CPUs decode as unrelated
+; instructions ($A7 is an undocumented LAX on the 6502). Passing a far pointer
+; as a value stays legal.
+
+; ERR: error: {{.*}}in function ld_rt i8 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function st_rt void (ptr addrspace(2), i8): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function ld_zext i16 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+
+;--- access.ll
+define i8 @ld_rt(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+define void @st_rt(ptr addrspace(2) %p, i8 %v) {
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+define i16 @ld_zext(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  %z = zext i8 %v to i16
+  ret i16 %z
+}
+
+;--- value.ll
+declare void @use(ptr addrspace(2))
+
+; VALUE-LABEL: pass:
+; VALUE: {{jsr|jmp}} use
+define void @pass(ptr addrspace(2) %p) {
+  call void @use(ptr addrspace(2) %p)
+  ret void
+}
