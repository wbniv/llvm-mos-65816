+;   * a LINK-TIME far address (an addrspace(2) global -- isFarSymbol) is an
+;     absolute-long operand:         lda long / sta long  ($af / $8f)
+;   * a RUNTIME far address (inttoptr of a 32-bit value, held in an Imag32 zero-page
+;     quad) is direct-indirect-long: lda [dp] / sta [dp]  ($a7 / $87)
+;
+; The second RUN line disassembles the object so the opcode BYTE is pinned, not
+; just the mnemonic -- `lda mos24(x)` and `lda x` print similarly but are $af vs $ad.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@fardata = addrspace(2) global i8 0
+@farbuf = addrspace(2) global i8 0
+
+; A far global's address is a link-time 24-bit constant: absolute long, $af.
+define i8 @far_load_abs() {
+; CHECK-LABEL: far_load_abs:
+; CHECK: lda mos24(fardata)
+; CHECK: rts
+; OBJ-LABEL: <far_load_abs>:
+; OBJ: af {{[0-9a-f]+ [0-9a-f]+ [0-9a-f]+}} {{.*}}lda
+  %v = load i8, ptr addrspace(2) @fardata
+  ret i8 %v
+}
+
+; ... and the store half, $8f.
+define void @far_store_abs(i8 %v) {
+; CHECK-LABEL: far_store_abs:
+; CHECK: sta mos24(farbuf)
+; CHECK: rts
+; OBJ-LABEL: <far_store_abs>:
+; OBJ: 8f {{[0-9a-f]+ [0-9a-f]+ [0-9a-f]+}} {{.*}}sta
+  store i8 %v, ptr addrspace(2) @farbuf
+  ret void
+}
+
+; A runtime far pointer (inttoptr i32) lands in an Imag32 zero-page quad and is
+; dereferenced with direct-indirect-long, $a7. This is the far_indir.c shape.
+define i8 @far_load_indir(i32 %a) {
+; CHECK-LABEL: far_load_indir:
+; CHECK: lda [__rc{{[0-9]+}}]
+; CHECK: rts
+; OBJ-LABEL: <far_load_indir>:
+; OBJ: a7 {{[0-9a-f]+}} {{.*}}lda [
+  %p = inttoptr i32 %a to ptr addrspace(2)
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+; ... and the store half, $87. This is the far_store.c shape.
+define void @far_store_indir(i32 %a, i8 %v) {
+; CHECK-LABEL: far_store_indir:
+; CHECK: sta [__rc{{[0-9]+}}]
+; CHECK: rts
+; OBJ-LABEL: <far_store_indir>:
+; OBJ: 87 {{[0-9a-f]+}} {{.*}}sta [
+  %p = inttoptr i32 %a to ptr addrspace(2)
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+; A plain (AS0) global merely PLACED in a .far_* section keeps its NEAR 16-bit
+; address -- isFarSymbol restricts the section test to FUNCTIONS on purpose, so
+; taking &it must not over-trigger 24-bit materialization into a 16-bit context
+; (selectAddrLoHi/buildFarAddrWords require a 24-bit destination). Codegen must
+; emit a BARE symbol operand here, not mos24(...); dev/run.sh far_indir is the
+; matching runtime gate.
+;
+; Asm-only: what the ASSEMBLER then does with a bare unresolved symbol operand on
+; W65816 is a separate, already-tracked MC-layer question (the failing `addr24`
+; bare-symbol line in MC/MOS/addressing-modes-65816.s), so this case deliberately
+; carries no OBJ check -- it pins the codegen decision, not the encoding choice.
+@near_in_far_section = global i8 -87, section ".far_data"
+
+define i8 @near_symbol_in_far_section() {
+; CHECK-LABEL: near_symbol_in_far_section:
+; CHECK: lda near_in_far_section
+; CHECK-NOT: mos24(near_in_far_section)
+; CHECK: rts
+  %v = load volatile i8, ptr @near_in_far_section
+  ret i8 %v
+}
diff --git a/llvm/test/CodeGen/MOS/far-phi.ll b/llvm/test/CodeGen/MOS/far-phi.ll
new file mode 100644
index 000000000000..d476ce22ce22
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-phi.ll
@@ -0,0 +1,60 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs -stop-after=legalizer -o - < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefix=ASM
+
+; A far-pointer PHI crosses the p2/s32 bridge before scalar narrowing.
+; Incoming values are converted in their predecessor blocks; the result is
+; converted back after all PHIs. A volatile stride keeps the far pointer on
+; the back-edge so both conversion directions and the final dereference remain.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@stride = global i32 0
+
+define i8 @far_ptr_induction(i32 %a, i16 %n) {
+; CHECK-LABEL: name: far_ptr_induction
+;
+; Preheader: the incoming far pointer is ptrtoint'd and unmerged to the four
+; bytes that feed the phis.
+; CHECK: bb.{{[0-9]+}}.entry:
+; CHECK: %[[P0:[0-9]+]]:_(p2) = G_INTTOPTR
+; CHECK: %[[I0:[0-9]+]]:_(s32) = G_PTRTOINT %[[P0]](p2)
+; CHECK: %[[W0:[0-9]+]]:_(s16), %[[W1:[0-9]+]]:_(s16) = G_UNMERGE_VALUES %[[I0]](s32)
+; CHECK: %[[A0:[0-9]+]]:_(s8), %[[A1:[0-9]+]]:_(s8) = G_UNMERGE_VALUES %[[W0]](s16)
+; CHECK: %[[A2:[0-9]+]]:_(s8), %[[A3:[0-9]+]]:_(s8) = G_UNMERGE_VALUES %[[W1]](s16)
+;
+; Loop header: four s8 phis -- NOT a p2 phi -- re-merged and inttoptr'd back to
+; p2 for the dereference.
+; CHECK: bb.{{[0-9]+}}.loop:
+; CHECK-NOT: (p2) = G_PHI
+; CHECK: %[[Q0:[0-9]+]]:_(s8) = G_PHI %[[A0]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q1:[0-9]+]]:_(s8) = G_PHI %[[A1]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q2:[0-9]+]]:_(s8) = G_PHI %[[A2]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q3:[0-9]+]]:_(s8) = G_PHI %[[A3]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[V0:[0-9]+]]:_(s16) = G_MERGE_VALUES %[[Q0]](s8), %[[Q1]](s8)
+; CHECK: %[[V1:[0-9]+]]:_(s16) = G_MERGE_VALUES %[[Q2]](s8), %[[Q3]](s8)
+; CHECK: %[[J:[0-9]+]]:_(s32) = G_MERGE_VALUES %[[V0]](s16), %[[V1]](s16)
+; CHECK: %[[P:[0-9]+]]:_(p2) = G_INTTOPTR %[[J]](s32)
+; CHECK: G_LOAD_FAR_INDIR %[[P]](p2)
+;
+; And it reaches a real indirect-long dereference in the emitted loop.
+; ASM-LABEL: far_ptr_induction:
+; ASM: lda [__rc{{[0-9]+}}]
+entry:
+  %p0 = inttoptr i32 %a to ptr addrspace(2)
+  br label %loop
+
+loop:
+  %p = phi ptr addrspace(2) [ %p0, %entry ], [ %pn, %loop ]
+  %i = phi i16 [ 0, %entry ], [ %in, %loop ]
+  %acc = phi i8 [ 0, %entry ], [ %accn, %loop ]
+  %v = load i8, ptr addrspace(2) %p
+  %accn = add i8 %acc, %v
+  %s = load volatile i32, ptr @stride
+  %pn = getelementptr inbounds i8, ptr addrspace(2) %p, i32 %s
+  %in = add i16 %i, 1
+  %c = icmp ult i16 %in, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret i8 %accn
+}
diff --git a/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll b/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll
new file mode 100644
index 000000000000..ee881cbae379
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-ptr-arg-exhaustion.ll
@@ -0,0 +1,78 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs -o /dev/null < %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs -o /dev/null < %s
+
+; A far (addrspace 2) pointer argument that finds no free quad goes to a
+; 4-byte stack slot. It must never reach the generic 16-bit CCIfPtr rule, whose
+; RS pair cannot hold the 32-bit value (a "COPY $rs1" into a p2 is a
+; size-mismatched copy). Plain mosw65816 is checked through call lowering only:
+; without +mos-a16 a far pointer value in memory (here the stacked argument) is
+; not legalizable, the same limitation as loading a far pointer from any other
+; memory.
+
+; Four far pointers: the fourth exceeds RL1..RL3 while RS1 is still free.
+define i8 @callee4(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d) {
+; CHECK-LABEL: name: callee4
+; CHECK: fixedStack:
+; CHECK-NEXT: - { id: 0, type: default, offset: 0, size: 4,
+; CHECK: liveins: $rl1, $rl2, $rl3{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[D:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK-NOT: COPY $rs
+; CHECK: G_LOAD [[D]](p2) :: (volatile load (s8) from %ir.d, addrspace 2)
+  %va = load volatile i8, ptr addrspace(2) %a
+  %vd = load volatile i8, ptr addrspace(2) %d
+  %s = add i8 %va, %vd
+  ret i8 %s
+}
+
+define i8 @caller4(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d) {
+; CHECK-LABEL: name: caller4
+; CHECK: ADJCALLSTACKDOWN 4, 0
+; CHECK: G_STORE %0(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack, align 1)
+; CHECK: JSR @callee4, mos_csr, implicit $rl1, implicit $rl2, implicit $rl3, implicit-def $a
+; CHECK: ADJCALLSTACKUP 4, 0
+  %r = call i8 @callee4(ptr addrspace(2) %d, ptr addrspace(2) %c, ptr addrspace(2) %b, ptr addrspace(2) %a)
+  ret i8 %r
+}
+
+; Near/far interleaving: the quads are used up with RS1 free, the fourth far
+; pointer is stacked, and the trailing near pointer still takes RS1.
+define i8 @callee_ffffn(ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c, ptr addrspace(2) %d, ptr %n) {
+; CHECK-LABEL: name: callee_ffffn
+; CHECK: liveins: $rl1, $rl2, $rl3, $rs1{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[D:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK: {{%[0-9]+}}:_(p0) = COPY $rs1
+; CHECK: G_LOAD [[D]](p2) :: (volatile load (s8) from %ir.d, addrspace 2)
+  %vd = load volatile i8, ptr addrspace(2) %d
+  %vn = load volatile i8, ptr %n
+  %s = add i8 %vd, %vn
+  ret i8 %s
+}
+
+define i8 @caller_ffffn(ptr addrspace(2) %a, ptr %n) {
+; CHECK-LABEL: name: caller_ffffn
+; CHECK: ADJCALLSTACKDOWN 4, 0
+; CHECK: G_STORE %0(p2), {{%[0-9]+}}(p0) :: (store (p2) into stack, align 1)
+; CHECK: JSR @callee_ffffn, mos_csr, implicit $rl1, implicit $rl2, implicit $rl3, implicit $rs1, implicit-def $a
+  %r = call i8 @callee_ffffn(ptr addrspace(2) %a, ptr addrspace(2) %a, ptr addrspace(2) %a, ptr addrspace(2) %a, ptr %n)
+  ret i8 %r
+}
+
+; Near pointers take RS1..RS3, which blocks RL1 (RS2:RS3): the first two far
+; pointers use RL2/RL3 and the third is stacked.
+define i8 @callee_nnnfff(ptr %n1, ptr %n2, ptr %n3, ptr addrspace(2) %a, ptr addrspace(2) %b, ptr addrspace(2) %c) {
+; CHECK-LABEL: name: callee_nnnfff
+; CHECK: liveins: $rl2, $rl3, $rs1, $rs2, $rs3{{$}}
+; CHECK: [[FI:%[0-9]+]]:_(p0) = G_FRAME_INDEX %fixed-stack.0
+; CHECK-NEXT: [[C:%[0-9]+]]:_(p2) = G_LOAD [[FI]](p0) :: (invariant load (p2) from %fixed-stack.0, align 1)
+; CHECK: G_LOAD [[C]](p2) :: (volatile load (s8) from %ir.c, addrspace 2)
+  %vc = load volatile i8, ptr addrspace(2) %c
+  %vn = load volatile i8, ptr %n3
+  %s = add i8 %vc, %vn
+  ret i8 %s
+}
+
diff --git a/llvm/test/CodeGen/MOS/far-ptr-trunc.ll b/llvm/test/CodeGen/MOS/far-ptr-trunc.ll
new file mode 100644
index 000000000000..cd8604fb1836
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-ptr-trunc.ll
@@ -0,0 +1,28 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O0 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs < %s | FileCheck %s
+
+; The low word of a far pointer (an s32 in an Imag32 quad) is its sublo16
+; subregister: a far-to-near cast and a truncated ptrtoint both read the quad's
+; low pair directly.
+
+define i8 @far_to_near(ptr addrspace(2) %p) {
+; CHECK-LABEL: far_to_near:
+; CHECK:       ; %bb.0:
+; CHECK-NEXT:    lda (__rc4)
+; CHECK-NEXT:    rts
+  %n = addrspacecast ptr addrspace(2) %p to ptr
+  %v = load i8, ptr %n
+  ret i8 %v
+}
+
+define i16 @ptrtoint_trunc(ptr addrspace(2) %p) {
+; CHECK-LABEL: ptrtoint_trunc:
+; CHECK:       ; %bb.0:
+; CHECK-NEXT:    ldx __rc5
+; CHECK-NEXT:    lda __rc4
+; CHECK-NEXT:    rts
+  %i = ptrtoint ptr addrspace(2) %p to i32
+  %t = trunc i32 %i to i16
+  ret i16 %t
+}
