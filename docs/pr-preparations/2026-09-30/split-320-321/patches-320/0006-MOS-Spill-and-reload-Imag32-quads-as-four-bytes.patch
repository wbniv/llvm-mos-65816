diff --git a/llvm/lib/Target/MOS/MOSInstrInfo.cpp b/llvm/lib/Target/MOS/MOSInstrInfo.cpp
index d095ecc695d6..8c4c3b4c1336 100644
--- a/llvm/lib/Target/MOS/MOSInstrInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSInstrInfo.cpp
@@ -958,9 +958,61 @@ void MOSInstrInfo::loadStoreRegStackSlot(
       Instr.addDef(Ptr, RegState::EarlyClobber);
     Instr.addFrameIndex(FrameIndex).addImm(0).addMemOperand(MMO);
   } else {
-    if ((Reg.isPhysical() && MOS::Ac16RegClass.contains(Reg)) ||
+    if ((Reg.isPhysical() && MOS::Imag32RegClass.contains(Reg)) ||
         (Reg.isVirtual() &&
-         MRI.getRegClass(Reg)->hasSuperClassEq(&MOS::Ac16RegClass))) {
+         MRI.getRegClass(Reg)->hasSuperClassEq(&MOS::Imag32RegClass))) {
+      // A far pointer is a four-byte Imag32 quad. Splitting it here is
+      // essential: the generic byte fallback would copy only one byte through
+      // a GPR, leaving an illegal GPR-to-Imag32 COPY after register allocation.
+      Register Quad = Reg;
+      Register LoWord;
+      Register HiWord;
+      if (Reg.isPhysical()) {
+        LoWord = TRI->getSubReg(Reg, MOS::sublo16);
+        HiWord = TRI->getSubReg(Reg, MOS::subhi16);
+      } else {
+        // As with Imag16 below, use fresh temporaries when introducing
+        // subregister operands after live intervals have been computed.
+        Quad = MRI.createVirtualRegister(&MOS::Imag32RegClass);
+        LoWord = MRI.createVirtualRegister(&MOS::Imag16RegClass);
+        HiWord = MRI.createVirtualRegister(&MOS::Imag16RegClass);
+        if (!IsLoad) {
+          Builder.buildCopy(Quad, Reg);
+          Builder.buildInstr(MOS::COPY).addDef(LoWord).addUse(Quad, RegState{},
+                                                              MOS::sublo16);
+          Builder.buildInstr(MOS::COPY).addDef(HiWord).addUse(Quad, RegState{},
+                                                              MOS::subhi16);
+        }
+      }
+      auto Byte = [&](Register Word, unsigned SubReg) {
+        MachineOperand MO = MachineOperand::CreateReg(Word, IsLoad);
+        if (Word.isPhysical())
+          MO.setReg(TRI->getSubReg(Word, SubReg));
+        else {
+          MO.setSubReg(SubReg);
+          if (IsLoad && SubReg == MOS::sublo)
+            MO.setIsUndef();
+        }
+        return MO;
+      };
+      MachineOperand Bytes[] = {
+          Byte(LoWord, MOS::sublo), Byte(LoWord, MOS::subhi),
+          Byte(HiWord, MOS::sublo), Byte(HiWord, MOS::subhi)};
+      for (unsigned I = 0; I != 4; ++I)
+        loadStoreByteStaticStackSlot(Builder, Bytes[I], FrameIndex, I,
+                                     MF.getMachineMemOperand(MMO, I, 1));
+      if (Reg.isVirtual() && IsLoad) {
+        Builder.buildInstr(MOS::COPY)
+            .addDef(Quad, RegState::Undef, MOS::sublo16)
+            .addUse(LoWord);
+        Builder.buildInstr(MOS::COPY)
+            .addDef(Quad, RegState{}, MOS::subhi16)
+            .addUse(HiWord);
+        Builder.buildCopy(Reg, Quad);
+      }
+    } else if ((Reg.isPhysical() && MOS::Ac16RegClass.contains(Reg)) ||
+               (Reg.isVirtual() &&
+                MRI.getRegClass(Reg)->hasSuperClassEq(&MOS::Ac16RegClass))) {
       // Spill the accumulator with a word load/store. Byte GPR copies cannot
       // represent A16. Ac16 is available only under HasAccum16, and the mode
       // insertion pass supplies the M=0 state required by these instructions.
diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.cpp b/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
index 6c1e9a8eb3d5..612d7192ba7a 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.cpp
@@ -889,6 +889,38 @@ void MOSRegisterInfo::expandLDSTStkImpl(MachineBasicBlock::iterator MI) const {
     return;
   }
 
+  if (MOS::Imag32RegClass.contains(Loc)) {
+    if (!IsLoad) {
+      // As for Imag16 below, make every covered byte live before splitting the
+      // store. A far pointer occupies the complete four-byte Imag32 register.
+      Builder.buildInstr(MOS::KILL, {Loc}, {Loc});
+    }
+    Register Lo = TRI.getSubReg(Loc, MOS::sublo16);
+    Register Hi = TRI.getSubReg(Loc, MOS::subhi16);
+    auto LoInstr = Builder.buildInstr(MI->getOpcode());
+    if (!IsLoad)
+      LoInstr.add(MI->getOperand(0));
+    LoInstr.addReg(Lo, getDefRegState(IsLoad));
+    if (IsLoad)
+      LoInstr.add(MI->getOperand(1));
+    LoInstr.add(MI->getOperand(2))
+        .add(MI->getOperand(3))
+        .addMemOperand(MF.getMachineMemOperand(*MI->memoperands_begin(), 0, 2));
+    auto HiInstr = Builder.buildInstr(MI->getOpcode());
+    if (!IsLoad)
+      HiInstr.add(MI->getOperand(0));
+    HiInstr.addReg(Hi, getDefRegState(IsLoad));
+    if (IsLoad)
+      HiInstr.add(MI->getOperand(1));
+    HiInstr.add(MI->getOperand(2))
+        .addImm(MI->getOperand(3).getImm() + 2)
+        .addMemOperand(MF.getMachineMemOperand(*MI->memoperands_begin(), 2, 2));
+    MI->eraseFromParent();
+    expandLDSTStk(LoInstr);
+    expandLDSTStk(HiInstr);
+    return;
+  }
+
   if (MOS::Imag16RegClass.contains(Loc)) {
     if (!IsLoad) {
