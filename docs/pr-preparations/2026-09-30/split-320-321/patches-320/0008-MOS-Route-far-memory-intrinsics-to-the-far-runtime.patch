 }
 
+// Far memory intrinsics require far runtime entry points. Convert any near
+// or direct-page pointer argument to address space 2 so both pointers use
+// the same ABI. Near addresses are in bank zero under the DBR=0 contract.
+static bool createFarMemLibcall(LegalizerHelper &Helper,
+                                MachineRegisterInfo &MRI, MachineInstr &MI) {
+  MachineIRBuilder &Builder = Helper.MIRBuilder;
+  auto &Ctx = Builder.getMF().getFunction().getContext();
+  const LLT PF = LLT::pointer(MOS::AS_Far, 32);
+
+  unsigned Opc = MI.getOpcode();
+  if (Opc != MOS::G_MEMSET && Opc != MOS::G_MEMCPY && Opc != MOS::G_MEMMOVE)
+    return false;
+  const bool IsSet = Opc == MOS::G_MEMSET;
+
+  // The length selects the runtime entry. The 16-bit __mem*_far entries take a
+  // size_t (0..0xFFFF); use them only when the length provably fits: a
+  // constant <= 0xFFFF, or known bits that clear everything above bit 15. Any
+  // other length, such as a constant above 0xFFFF or the loop idiom's
+  // zext(n) * 2, goes to the __mem*_far32 entries, which take a uint32_t,
+  // instead of being truncated. A length wider than 32 bits is narrowed to 32:
+  // the far index type is 32 bits, so no allocated far object is larger than
+  // INT32_MAX bytes (LangRef, "Allocated objects"). The same rule already
+  // bounds a memcpy or memmove with a near operand, whose length the
+  // IRTranslator narrowed to 16 bits.
+  Register Len = MI.getOperand(2).getReg();
+  unsigned LenBits = MRI.getType(Len).getSizeInBits();
+  bool Len16 = LenBits <= 16;
+  if (!Len16) {
+    if (auto C = getIConstantVRegValWithLookThrough(Len, MRI))
+      Len16 = C->Value.ule(0xFFFF);
+    else if (GISelValueTracking *VT = Helper.getValueTracking())
+      Len16 = VT->getKnownBits(Len).countMinLeadingZeros() >= LenBits - 16;
+  }
+
+  const char *Callee;
+  switch (Opc) {
+  case MOS::G_MEMSET:
+    Callee = Len16 ? "__memset_far" : "__memset_far32";
+    break;
+  case MOS::G_MEMCPY:
+    Callee = Len16 ? "__memcpy_far" : "__memcpy_far32";
+    break;
+  default:
+    Callee = Len16 ? "__memmove_far" : "__memmove_far32";
+    break;
+  }
+
+  // Operands are destination, value/source, length, and the tail-call
+  // immediate. Widen near and direct-page pointers to the runtime's far-pointer
+  // ABI.
+  auto asFar = [&](Register Reg) {
+    if (MRI.getType(Reg).getAddressSpace() != MOS::AS_Far)
+      Reg = Builder.buildAddrSpaceCast(PF, Reg).getReg(0);
+    return Reg;
+  };
+  Type *FarPtrTy = PointerType::get(Ctx, MOS::AS_Far);
+
+  SmallVector<CallLowering::ArgInfo, 3> Args;
+  // arg 0: destination pointer.
+  Args.push_back({asFar(MI.getOperand(0).getReg()), FarPtrTy, 0});
+  if (IsSet) {
+    // arg 1: fill byte (i8, matching __memset's `char` value).
+    Register Val = MI.getOperand(1).getReg();
+    Args.push_back(
+        {Val, IntegerType::get(Ctx, MRI.getType(Val).getSizeInBits()), 1});
+  } else {
+    // arg 1: source pointer.
+    Args.push_back({asFar(MI.getOperand(1).getReg()), FarPtrTy, 1});
+  }
+  // arg 2: length, coerced to the entry's parameter type so the ABI matches
+  // the runtime exactly: size_t (16 bits) for __mem*_far, where the value
+  // provably fits (see above), and uint32_t for __mem*_far32.
+  const unsigned ArgBits = Len16 ? 16 : 32;
+  if (LenBits > ArgBits)
+    Len = Builder.buildTrunc(LLT::scalar(ArgBits), Len).getReg(0);
+  else if (LenBits < ArgBits)
+    Len = Builder.buildZExt(LLT::scalar(ArgBits), Len).getReg(0);
+  Args.push_back({Len, IntegerType::get(Ctx, ArgBits), 2});
+
+  auto &CLI = *Builder.getMF().getSubtarget().getCallLowering();
+  CallLowering::CallLoweringInfo Info;
+  Info.CallConv = CallingConv::C; // CC_MOS; the addrspace-2 args select Imag32.
+  Info.Callee = MachineOperand::CreateES(Callee);
+  Info.OrigRet = CallLowering::ArgInfo({0}, Type::getVoidTy(Ctx), 0);
+  // The far runtime returns void; nothing consumes a return, so there is no
+  // tail call and no "returned" arg coupling (unlike the near
+  // createMemLibcall).
+  Info.IsTailCall = false;
+  llvm::append_range(Info.OrigArgs, Args);
+  if (!CLI.lowerCall(Builder, Info))
+    return false;
+  MI.eraseFromParent();
+  return true;
+}
+
 bool MOSLegalizerInfo::legalizeMemOp(LegalizerHelper &Helper,
                                      MachineRegisterInfo &MRI, MachineInstr &MI,
                                      LostDebugLocObserver &LocObserver) const {
@@ -3146,11 +3242,11 @@ bool MOSLegalizerInfo::legalizeMemOp(LegalizerHelper &Helper,
     return true;
   }
 
-  // A far memory intrinsic that is not expanded inline has no lowering: the
-  // generic libcall would pass the far pointer to the near runtime and drop
+  // A far memory intrinsic that is not expanded inline calls the far runtime;
+  // the generic libcall would pass the far pointer to the near runtime and drop
   // the bank byte.
   if (anyFarPointerOperand(MRI, MI))
-    return false;
+    return createFarMemLibcall(Helper, MRI, MI);
 
   // Try emitting a libcall.
   Result = Helper.createMemLibcall(MRI, MI, LocObserver);
diff --git a/llvm/test/CodeGen/MOS/far-memop-length.ll b/llvm/test/CodeGen/MOS/far-memop-length.ll
new file mode 100644
index 000000000000..ad9e77157a2d
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-memop-length.ll
@@ -0,0 +1,136 @@
+; RUN: split-file %s %t
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs < %t/far.ll | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs < %t/far.ll | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs < %t/far.ll | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs < %t/mixed.ll | FileCheck %s --check-prefix=MIXED
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs < %t/mixed.ll | FileCheck %s --check-prefix=MIXED
+
+; When every pointer operand is far, a memset/memcpy/memmove length is passed
+; to the 16-bit __mem*_far entries only when it provably fits 16 bits (a constant <= 0xFFFF, or known
+; bits). Any other length goes to the uint32_t __mem*_far32 entries and is never
+; truncated to 16 bits (which would turn 70000 into 4464, 65536 into 0 and 65537
+; into 1).
+
+; Mixed address spaces: the IRTranslator narrows a memcpy/memmove length to the
+; smaller pointer's index width before legalization. For a near (addrspace 0)
+; operand that is 16 bits. This is sound because LangRef ("Allocated objects")
+; bounds a near object by 32767 bytes, so a longer length is undefined
+; behaviour. 40000 fits 16 bits and is kept; 70000 is narrowed to 4464.
+
+;--- far.ll
+define void @set_65535(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_65535:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 65535, i1 false)
+  ret void
+}
+
+define void @set_65536(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_65536:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 65536, i1 false)
+  ret void
+}
+
+define void @set_65537(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_65537:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 65537, i1 false)
+  ret void
+}
+
+define void @set_70000(ptr addrspace(2) %d) {
+; CHECK-LABEL: set_70000:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 70000, i1 false)
+  ret void
+}
+
+define void @cpy_65537(ptr addrspace(2) %d, ptr addrspace(2) %s) {
+; CHECK-LABEL: cpy_65537:
+; CHECK: {{jsr|jmp}} __memcpy_far32{{$}}
+  call void @llvm.memcpy.p2.p2.i32(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 65537, i1 false)
+  ret void
+}
+
+define void @mov_70000(ptr addrspace(2) %d, ptr addrspace(2) %s) {
+; CHECK-LABEL: mov_70000:
+; CHECK: {{jsr|jmp}} __memmove_far32{{$}}
+  call void @llvm.memmove.p2.p2.i32(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 70000, i1 false)
+  ret void
+}
+
+; An unbounded runtime length.
+define void @cpy_var(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 %n) {
+; CHECK-LABEL: cpy_var:
+; CHECK: {{jsr|jmp}} __memcpy_far32{{$}}
+  call void @llvm.memcpy.p2.p2.i32(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 %n, i1 false)
+  ret void
+}
+
+define void @set_var(ptr addrspace(2) %d, i32 %n) {
+; CHECK-LABEL: set_var:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 7, i32 %n, i1 false)
+  ret void
+}
+
+; The loop idiom's zext(n) * 2 can exceed 0xFFFF.
+define void @set_scaled(ptr addrspace(2) %d, i16 %n) {
+; CHECK-LABEL: set_scaled:
+; CHECK: {{jsr|jmp}} __memset_far32{{$}}
+  %z = zext i16 %n to i32
+  %len = shl nuw nsw i32 %z, 1
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 %len, i1 false)
+  ret void
+}
+
+; Provably bounded runtime lengths stay on the 16-bit entries.
+define void @set_zext(ptr addrspace(2) %d, i16 %n) {
+; CHECK-LABEL: set_zext:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  %len = zext i16 %n to i32
+  call void @llvm.memset.p2.i32(ptr addrspace(2) %d, i8 0, i32 %len, i1 false)
+  ret void
+}
+
+define void @mov_masked(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 %n) {
+; CHECK-LABEL: mov_masked:
+; CHECK: {{jsr|jmp}} __memmove_far{{$}}
+  %len = and i32 %n, 65535
+  call void @llvm.memmove.p2.p2.i32(ptr addrspace(2) %d, ptr addrspace(2) %s, i32 %len, i1 false)
+  ret void
+}
+
+define void @set_i16(ptr addrspace(2) %d, i16 %n) {
+; CHECK-LABEL: set_i16:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  call void @llvm.memset.p2.i16(ptr addrspace(2) %d, i8 0, i16 %n, i1 false)
+  ret void
+}
+
+declare void @llvm.memset.p2.i32(ptr addrspace(2), i8, i32, i1 immarg)
+declare void @llvm.memset.p2.i16(ptr addrspace(2), i8, i16, i1 immarg)
+declare void @llvm.memcpy.p2.p2.i32(ptr addrspace(2), ptr addrspace(2), i32, i1 immarg)
+declare void @llvm.memmove.p2.p2.i32(ptr addrspace(2), ptr addrspace(2), i32, i1 immarg)
+
+;--- mixed.ll
+define void @cpy_near_40000(ptr addrspace(2) %d, ptr %s) {
+; MIXED-LABEL: cpy_near_40000:
+; MIXED: lda #64
+; MIXED-NEXT: ldx #156
+; MIXED-NEXT: {{jsr|jmp}} __memcpy_far{{$}}
+  call void @llvm.memcpy.p2.p0.i32(ptr addrspace(2) %d, ptr %s, i32 40000, i1 false)
+  ret void
+}
+
+define void @cpy_near_70000(ptr addrspace(2) %d, ptr %s) {
+; MIXED-LABEL: cpy_near_70000:
+; MIXED: lda #112
+; MIXED-NEXT: ldx #17
+; MIXED-NEXT: {{jsr|jmp}} __memcpy_far{{$}}
+  call void @llvm.memcpy.p2.p0.i32(ptr addrspace(2) %d, ptr %s, i32 70000, i1 false)
+  ret void
+}
+
+declare void @llvm.memcpy.p2.p0.i32(ptr addrspace(2), ptr, i32, i1 immarg)
diff --git a/llvm/test/CodeGen/MOS/far-memset.ll b/llvm/test/CodeGen/MOS/far-memset.ll
new file mode 100644
index 000000000000..b6c6ecf3f9f1
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-memset.ll
@@ -0,0 +1,32 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs < %s | FileCheck %s
+
+; A far fill exceeding the inline limit requires a runtime whose destination
+; parameter retains the bank byte. The i32 length is the loop-idiom form for
+; a 4096-byte fill at $7E2000. A near fill uses the near runtime ABI.
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+define void @far_constant_fill() {
+; CHECK-LABEL: far_constant_fill:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  call void @llvm.memset.p2.i32(ptr addrspace(2) inttoptr (i32 8265728 to ptr addrspace(2)), i8 66, i32 4096, i1 false)
+  ret void
+}
+
+define void @far_variable_fill(ptr addrspace(2) %dst, i8 %value, i16 %size) {
+; CHECK-LABEL: far_variable_fill:
+; CHECK: {{jsr|jmp}} __memset_far{{$}}
+  call void @llvm.memset.p2.i16(ptr addrspace(2) %dst, i8 %value, i16 %size, i1 false)
+  ret void
+}
+
+define void @near_variable_fill(ptr %dst, i8 %value, i16 %size) {
+; CHECK-LABEL: near_variable_fill:
+; CHECK: {{jsr|jmp}} __memset{{$}}
+  call void @llvm.memset.p0.i16(ptr %dst, i8 %value, i16 %size, i1 false)
+  ret void
+}
+
+declare void @llvm.memset.p2.i32(ptr addrspace(2), i8, i32, i1 immarg)
+declare void @llvm.memset.p2.i16(ptr addrspace(2), i8, i16, i1 immarg)
+declare void @llvm.memset.p0.i16(ptr, i8, i16, i1 immarg)
