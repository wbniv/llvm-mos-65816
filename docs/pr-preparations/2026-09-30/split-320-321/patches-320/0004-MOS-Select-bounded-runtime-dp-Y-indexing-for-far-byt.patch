diff --git a/llvm/lib/Target/MOS/MOSInstrGISel.td b/llvm/lib/Target/MOS/MOSInstrGISel.td
index 950e2cd9a838..180549c6d065 100644
--- a/llvm/lib/Target/MOS/MOSInstrGISel.td
+++ b/llvm/lib/Target/MOS/MOSInstrGISel.td
@@ -172,6 +172,36 @@ def G_STORE_FAR_INDIR : MOSGenericInstruction {
   let mayStore = true;
 }
 
+// Indexed far byte accesses use an Imag32 base and an s8 Y offset. The
+// 65816 adds Y to the full 24-bit address, including carry into the bank.
+// The legalizer proves the offset range before selecting these pseudos.
+def G_LOAD_FAR_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr, type1:$index);
+  let mayStore = true;
+}
+// The wide-index forms retain an s16 offset under HasIndex16. Selection
+// keeps the Y load and memory access together until emission, with XLow
+// requesting 16-bit index mode.
+def G_LOAD_FAR_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasW65816, HasIndex16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasW65816, HasIndex16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr, type1:$index);
+  let mayStore = true;
+}
 
 // Generalized 8-bit store using the absolute indexed addressing mode. The base
 // argument isn't a pointer; it's either a global value or a 16-bit immediate.
diff --git a/llvm/lib/Target/MOS/MOSInstrLogical.td b/llvm/lib/Target/MOS/MOSInstrLogical.td
index 8e5e4a180e27..a7f0b3b74097 100644
--- a/llvm/lib/Target/MOS/MOSInstrLogical.td
+++ b/llvm/lib/Target/MOS/MOSInstrLogical.td
@@ -665,6 +665,36 @@ def STIndirLong : MOSStore, PseudoInstExpansion<(STA_IndirectLong addr8:$addr)>
   dag InOperandList = (ins Ac:$src, Imag32:$addr);
 }
 
+def LDIndirLongIdx : MOSLoad,
+    PseudoInstExpansion<(LDA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag32:$addr, Yc:$offset);
+}
+
+def STIndirLongIdx : MOSStore,
+    PseudoInstExpansion<(STA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag InOperandList = (ins Ac:$src, Imag32:$addr, Yc:$offset);
+}
+
+// An Imag16 index is loaded into Y immediately before the byte access. Keep
+// both operations in one pseudo until emission so spills cannot insert a
+// sep #$10 between them and clear Y's high byte. XLow brackets the pair with
+// 16-bit index mode; the accumulator remains 8 bits wide.
+let Defs = [Y16], Size = 4 in {
+def LDIndirLongYIdx : MOSLoad {
+  let Predicates = [HasW65816, HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag32:$addr, Imag16:$idx);
+}
+def STIndirLongYIdx : MOSStore {
+  let Predicates = [HasW65816, HasIndex16]; let XLow = 1;
+  dag InOperandList  = (ins Ac:$src, Imag32:$addr, Imag16:$idx);
+}
+}
+
