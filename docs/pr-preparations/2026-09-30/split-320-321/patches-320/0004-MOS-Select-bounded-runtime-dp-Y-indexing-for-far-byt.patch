diff --git a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
index ba1d2bafc534..8d664c29c5c2 100644
--- a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
@@ -2525,6 +2525,10 @@ bool MOSLegalizerInfo::selectAddressingMode(LegalizerHelper &Helper,
     // long (`lda [dp]`) through a ZP Imag32 quad.
     if (tryFarAbsoluteAddressing(Helper, MRI, MI))
       return true;
+    // #321 Phase 2 inc 1: a small constant displacement off that runtime
+    // pointer folds into `lda [dp],y`/`sta [dp],y` instead of a 32-bit add.
+    if (tryFarIndirectIndexedAddressing(Helper, MRI, MI))
+      return true;
