+// A far addressing-mode fold replaces an access's pointer with the base and
+// an offset the new instruction encodes. The G_PTR_ADDs that computed the old
+// pointer can then be left with only debug uses. The legalizer erases them,
+// and salvageDebugInfo cannot express a G_PTR_ADD, so a DBG_VALUE would name
+// an erased register, which the machine verifier rejects once DetectDeadLanes
+// marks it undef. Called with the folded access's former pointer, this finds
+// the largest tree of such dead adds (climbing through dead bases) and sets
+// the locations of their DBG_VALUEs to $noreg. A register with a live user
+// stops the walk, so no live location is dropped.
+static void dropDeadFarAddressDebugUses(MachineRegisterInfo &MRI,
+                                        Register Ptr) {
+  if (!Ptr.isVirtual() || !isDeadFarAddressTree(MRI, Ptr))
+    return;
+  Register Top = Ptr;
+  while (const auto *PA = dyn_cast_or_null<GPtrAdd>(MRI.getVRegDef(Top))) {
+    Register Base = PA->getBaseReg();
+    if (!Base.isVirtual() || !isDeadFarAddressTree(MRI, Base))
+      break;
+    Top = Base;
+  }
+  SmallVector<Register, 8> Worklist = {Top};
+  SmallPtrSet<MachineInstr *, 8> DbgUses;
+  while (!Worklist.empty()) {
+    Register R = Worklist.pop_back_val();
+    for (MachineInstr &U : MRI.use_instructions(R)) {
+      if (U.isDebugValue())
+        DbgUses.insert(&U);
+      else if (const auto *PA = dyn_cast<GPtrAdd>(&U))
+        Worklist.push_back(PA->getReg(0));
+    }
+  }
+  for (MachineInstr *U : DbgUses)
+    U->setDebugValueUndef();
