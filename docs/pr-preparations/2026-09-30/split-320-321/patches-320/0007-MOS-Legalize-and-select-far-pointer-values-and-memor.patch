+static bool isDeadFarAddressTree(const MachineRegisterInfo &MRI, Register R) {
+  for (const MachineInstr &U : MRI.use_nodbg_instructions(R)) {
+    const auto *PA = dyn_cast<GPtrAdd>(&U);
