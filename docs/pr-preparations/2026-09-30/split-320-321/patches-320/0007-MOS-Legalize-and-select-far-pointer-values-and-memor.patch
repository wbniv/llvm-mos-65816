diff --git a/llvm/test/CodeGen/MOS/far-access-non-65816.ll b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
new file mode 100644
index 000000000000..61c89a746a98
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-access-non-65816.ll
@@ -0,0 +1,106 @@
+; RUN: split-file %s %t
+; RUN: not llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR --implicit-check-not="error:"
+; RUN: not llc -mtriple=mos -mcpu=mos65c02 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR --implicit-check-not="error:"
+; RUN: not llc -mtriple=mos -mcpu=mosspc700 -O2 -verify-machineinstrs -o /dev/null %t/access.ll 2>&1 | FileCheck %s --check-prefix=ERR --implicit-check-not="error:"
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs -o /dev/null %t/access-w65816.ll
+; RUN: not llc -mtriple=mos -mcpu=mos6502 -O2 -o /dev/null %t/pass.ll 2>&1 | FileCheck %s --check-prefix=PASS --implicit-check-not="error:"
+; RUN: not llc -mtriple=mos -mcpu=mosspc700 -O0 -o /dev/null %t/pass.ll 2>&1 | FileCheck %s --check-prefix=PASS --implicit-check-not="error:"
+; RUN: not llc -mtriple=mos -mcpu=mos65c02 -O0 -o /dev/null %t/cast.ll 2>&1 | FileCheck %s --check-prefix=CAST --implicit-check-not="error:"
+; RUN: not llc -mtriple=mos -mcpu=mos6502 -O2 -o /dev/null %t/store.ll 2>&1 | FileCheck %s --check-prefix=STORE --implicit-check-not="error:"
+
+; Far (addrspace 2) memory is reached only with 65816 long addressing. On any
+; other MOS CPU a far load, store, extending load or memory intrinsic is
+; diagnosed instead of being selected as a 65816 [dp] opcode, which those CPUs
+; decode as unrelated instructions ($A7 is an undocumented LAX on the 6502).
+; Each access is diagnosed once, before a wide access is split into bytes. Far
+; pointer values themselves need Imag32 quads, which only the 65816 allocates
+; (MOSSubtarget::hasAllocatableImag32), so they are not supported elsewhere: a
+; far pointer that is passed, converted or stored stops compilation with its
+; own error instead of a generic failure to legalize its pieces. A far pointer
+; that only addresses diagnosed accesses is erased with them (access.ll).
+
+; ERR: error: {{.*}}in function ld_rt i8 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function st_rt void (ptr addrspace(2), i8): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function ld_zext i16 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function ld_i32 i32 (ptr addrspace(2)): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+; ERR: error: {{.*}}in function set_far void (ptr addrspace(2), i16): far (address space 2) memory access requires 65816 long addressing; the target CPU has none
+
+; PASS: LLVM ERROR: far (address space 2) pointer value requires the 65816; the target CPU has no far pointer registers (in function: pass_far)
+; CAST: LLVM ERROR: far (address space 2) pointer value requires the 65816; the target CPU has no far pointer registers (in function: near_to_far)
+; STORE: LLVM ERROR: far (address space 2) pointer value requires the 65816; the target CPU has no far pointer registers (in function: store_far)
+
+;--- access.ll
+define i8 @ld_rt(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+define void @st_rt(ptr addrspace(2) %p, i8 %v) {
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+define i16 @ld_zext(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  %z = zext i8 %v to i16
+  ret i16 %z
+}
+
+define i32 @ld_i32(ptr addrspace(2) %p) {
+  %v = load i32, ptr addrspace(2) %p
+  ret i32 %v
+}
+
+define void @set_far(ptr addrspace(2) %p, i16 %n) {
+  call void @llvm.memset.p2.i16(ptr addrspace(2) %p, i8 0, i16 %n, i1 false)
+  ret void
+}
+
+declare void @llvm.memset.p2.i16(ptr addrspace(2), i8, i16, i1 immarg)
+
+;--- access-w65816.ll
+define i8 @ld_rt(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+define void @st_rt(ptr addrspace(2) %p, i8 %v) {
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+define i16 @ld_zext(ptr addrspace(2) %p) {
+  %v = load i8, ptr addrspace(2) %p
+  %z = zext i8 %v to i16
+  ret i16 %z
+}
+
+define void @pass_far(ptr addrspace(2) %p) {
+  call void @use(ptr addrspace(2) %p)
+  ret void
+}
+
+declare void @use(ptr addrspace(2))
+
+;--- pass.ll
+define void @pass_far(ptr addrspace(2) %p) {
+  call void @use(ptr addrspace(2) %p)
+  ret void
+}
+
+declare void @use(ptr addrspace(2))
+
+;--- cast.ll
+define i32 @near_to_far(ptr %n) {
+  %f = addrspacecast ptr %n to ptr addrspace(2)
+  %i = ptrtoint ptr addrspace(2) %f to i32
+  ret i32 %i
+}
+
+;--- store.ll
+@slot = external global ptr addrspace(2)
+
+define void @store_far(ptr addrspace(2) %p) {
+  store ptr addrspace(2) %p, ptr @slot
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/far-addressing.ll b/llvm/test/CodeGen/MOS/far-addressing.ll
new file mode 100644
index 000000000000..9322a1c56e95
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-addressing.ll
@@ -0,0 +1,90 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs -filetype=obj -o %t.o < %s
+; RUN: llvm-objdump -d --print-imm-hex %t.o | FileCheck %s --check-prefix=OBJ
+
+; Far addressing: the four data opcodes of the AS_Far (addrspace 2) model.
+; The emulator ROM gates (dev/run.sh far_indir / far_store / far-bank1 ...) cover
+; the runtime behaviour; this test pins the SELECTED OPCODE, which they cannot.
+; These are the shapes MOSInstructionSelector::selectAddr / selectGeneric produce:
+;
+;   * a LINK-TIME far address (an addrspace(2) global -- isFarSymbol) is an
+;     absolute-long operand:         lda long / sta long  ($af / $8f)
+;   * a RUNTIME far address (inttoptr of a 32-bit value, held in an Imag32 zero-page
+;     quad) is direct-indirect-long: lda [dp] / sta [dp]  ($a7 / $87)
+;
+; The second RUN line disassembles the object so the opcode BYTE is pinned, not
+; just the mnemonic -- `lda mos24(x)` and `lda x` print similarly but are $af vs $ad.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@fardata = addrspace(2) global i8 0
+@farbuf = addrspace(2) global i8 0
+
+; A far global's address is a link-time 24-bit constant: absolute long, $af.
+define i8 @far_load_abs() {
+; CHECK-LABEL: far_load_abs:
+; CHECK: lda mos24(fardata)
+; CHECK: rts
+; OBJ-LABEL: <far_load_abs>:
+; OBJ: af {{[0-9a-f]+ [0-9a-f]+ [0-9a-f]+}} {{.*}}lda
+  %v = load i8, ptr addrspace(2) @fardata
+  ret i8 %v
+}
+
+; ... and the store half, $8f.
+define void @far_store_abs(i8 %v) {
+; CHECK-LABEL: far_store_abs:
+; CHECK: sta mos24(farbuf)
+; CHECK: rts
+; OBJ-LABEL: <far_store_abs>:
+; OBJ: 8f {{[0-9a-f]+ [0-9a-f]+ [0-9a-f]+}} {{.*}}sta
+  store i8 %v, ptr addrspace(2) @farbuf
+  ret void
+}
+
+; A runtime far pointer (inttoptr i32) lands in an Imag32 zero-page quad and is
+; dereferenced with direct-indirect-long, $a7. This is the far_indir.c shape.
+define i8 @far_load_indir(i32 %a) {
+; CHECK-LABEL: far_load_indir:
+; CHECK: lda [__rc{{[0-9]+}}]
+; CHECK: rts
+; OBJ-LABEL: <far_load_indir>:
+; OBJ: a7 {{[0-9a-f]+}} {{.*}}lda [
+  %p = inttoptr i32 %a to ptr addrspace(2)
+  %v = load i8, ptr addrspace(2) %p
+  ret i8 %v
+}
+
+; ... and the store half, $87. This is the far_store.c shape.
+define void @far_store_indir(i32 %a, i8 %v) {
+; CHECK-LABEL: far_store_indir:
+; CHECK: sta [__rc{{[0-9]+}}]
+; CHECK: rts
+; OBJ-LABEL: <far_store_indir>:
+; OBJ: 87 {{[0-9a-f]+}} {{.*}}sta [
+  %p = inttoptr i32 %a to ptr addrspace(2)
+  store i8 %v, ptr addrspace(2) %p
+  ret void
+}
+
+; A plain (AS0) global merely PLACED in a .far_* section keeps its NEAR 16-bit
+; address -- isFarSymbol restricts the section test to FUNCTIONS on purpose, so
+; taking &it must not over-trigger 24-bit materialization into a 16-bit context
+; (selectAddrLoHi/buildFarAddrWords require a 24-bit destination). Codegen must
+; emit a BARE symbol operand here, not mos24(...); dev/run.sh far_indir is the
+; matching runtime gate.
+;
+; Asm-only: what the ASSEMBLER then does with a bare unresolved symbol operand on
+; W65816 is a separate, already-tracked MC-layer question (the failing `addr24`
+; bare-symbol line in MC/MOS/addressing-modes-65816.s), so this case deliberately
+; carries no OBJ check -- it pins the codegen decision, not the encoding choice.
+@near_in_far_section = global i8 -87, section ".far_data"
+
+define i8 @near_symbol_in_far_section() {
+; CHECK-LABEL: near_symbol_in_far_section:
+; CHECK: lda near_in_far_section
+; CHECK-NOT: mos24(near_in_far_section)
+; CHECK: rts
+  %v = load volatile i8, ptr @near_in_far_section
+  ret i8 %v
+}
diff --git a/llvm/test/CodeGen/MOS/far-fold-debug.ll b/llvm/test/CodeGen/MOS/far-fold-debug.ll
new file mode 100644
index 000000000000..83de9a4890cf
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-fold-debug.ll
@@ -0,0 +1,46 @@
+; RUN: split-file %s %t
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O0 -verify-machineinstrs -stop-after=legalizer %t/global-field.ll -o - | FileCheck %s --check-prefix=DROP
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O0 -verify-machineinstrs %t/global-field.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs %t/global-field.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O0 -verify-machineinstrs %t/global-field.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs %t/global-field.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O0 -verify-machineinstrs %t/global-field.ll -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs %t/global-field.ll -o /dev/null
+
+; A far addressing-mode fold replaces an access's pointer with a base and an
+; offset the new instruction encodes, so the G_PTR_ADDs that computed the
+; pointer die. salvageDebugInfo cannot express a G_PTR_ADD, so the fold drops
+; the location of each remaining DBG_VALUE of those adds ($noreg) instead of
+; leaving it on an erased register, which the verifier rejects under -g.
+; Sections:
+;   global-field: a far global plus a constant, folded into absolute-long addressing.
+
+; DROP-LABEL: name: walk
+; DROP: DBG_VALUE $noreg, $noreg, !{{[0-9]+}}, !DIExpression()
+; DROP-NOT: G_PTR_ADD
+
+;--- global-field.ll
+@g = external addrspace(2) global [16 x i8]
+
+define i8 @walk() !dbg !10 {
+  %q = getelementptr i8, ptr addrspace(2) @g, i32 1
+  call void @llvm.dbg.value(metadata ptr addrspace(2) %q, metadata !17, metadata !DIExpression()), !dbg !20
+  %b = load i8, ptr addrspace(2) %q, !dbg !20
+  ret i8 %b, !dbg !20
+}
+
+declare void @llvm.dbg.value(metadata, metadata, metadata)
+
+!llvm.dbg.cu = !{!0}
+!llvm.module.flags = !{!2, !3}
+!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
+!1 = !DIFile(filename: "far.c", directory: "/tmp")
+!2 = !{i32 2, !"Dwarf Version", i32 4}
+!3 = !{i32 2, !"Debug Info Version", i32 3}
+!10 = distinct !DISubprogram(name: "walk", scope: !1, file: !1, line: 1, type: !11, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
+!11 = !DISubroutineType(types: !12)
+!12 = !{null}
+!13 = !DIBasicType(name: "char", size: 8, encoding: DW_ATE_unsigned_char)
+!14 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !13, size: 32)
+!17 = !DILocalVariable(name: "q", scope: !10, file: !1, line: 3, type: !14)
+!20 = !DILocation(line: 2, scope: !10)
diff --git a/llvm/test/CodeGen/MOS/far-phi.ll b/llvm/test/CodeGen/MOS/far-phi.ll
new file mode 100644
index 000000000000..d476ce22ce22
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-phi.ll
@@ -0,0 +1,60 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs -stop-after=legalizer -o - < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefix=ASM
+
+; A far-pointer PHI crosses the p2/s32 bridge before scalar narrowing.
+; Incoming values are converted in their predecessor blocks; the result is
+; converted back after all PHIs. A volatile stride keeps the far pointer on
+; the back-edge so both conversion directions and the final dereference remain.
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@stride = global i32 0
+
+define i8 @far_ptr_induction(i32 %a, i16 %n) {
+; CHECK-LABEL: name: far_ptr_induction
+;
+; Preheader: the incoming far pointer is ptrtoint'd and unmerged to the four
+; bytes that feed the phis.
+; CHECK: bb.{{[0-9]+}}.entry:
+; CHECK: %[[P0:[0-9]+]]:_(p2) = G_INTTOPTR
+; CHECK: %[[I0:[0-9]+]]:_(s32) = G_PTRTOINT %[[P0]](p2)
+; CHECK: %[[W0:[0-9]+]]:_(s16), %[[W1:[0-9]+]]:_(s16) = G_UNMERGE_VALUES %[[I0]](s32)
+; CHECK: %[[A0:[0-9]+]]:_(s8), %[[A1:[0-9]+]]:_(s8) = G_UNMERGE_VALUES %[[W0]](s16)
+; CHECK: %[[A2:[0-9]+]]:_(s8), %[[A3:[0-9]+]]:_(s8) = G_UNMERGE_VALUES %[[W1]](s16)
+;
+; Loop header: four s8 phis -- NOT a p2 phi -- re-merged and inttoptr'd back to
+; p2 for the dereference.
+; CHECK: bb.{{[0-9]+}}.loop:
+; CHECK-NOT: (p2) = G_PHI
+; CHECK: %[[Q0:[0-9]+]]:_(s8) = G_PHI %[[A0]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q1:[0-9]+]]:_(s8) = G_PHI %[[A1]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q2:[0-9]+]]:_(s8) = G_PHI %[[A2]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[Q3:[0-9]+]]:_(s8) = G_PHI %[[A3]](s8), %bb.{{[0-9]+}},
+; CHECK: %[[V0:[0-9]+]]:_(s16) = G_MERGE_VALUES %[[Q0]](s8), %[[Q1]](s8)
+; CHECK: %[[V1:[0-9]+]]:_(s16) = G_MERGE_VALUES %[[Q2]](s8), %[[Q3]](s8)
+; CHECK: %[[J:[0-9]+]]:_(s32) = G_MERGE_VALUES %[[V0]](s16), %[[V1]](s16)
+; CHECK: %[[P:[0-9]+]]:_(p2) = G_INTTOPTR %[[J]](s32)
+; CHECK: G_LOAD_FAR_INDIR %[[P]](p2)
+;
+; And it reaches a real indirect-long dereference in the emitted loop.
+; ASM-LABEL: far_ptr_induction:
+; ASM: lda [__rc{{[0-9]+}}]
+entry:
+  %p0 = inttoptr i32 %a to ptr addrspace(2)
+  br label %loop
+
+loop:
+  %p = phi ptr addrspace(2) [ %p0, %entry ], [ %pn, %loop ]
+  %i = phi i16 [ 0, %entry ], [ %in, %loop ]
+  %acc = phi i8 [ 0, %entry ], [ %accn, %loop ]
+  %v = load i8, ptr addrspace(2) %p
+  %accn = add i8 %acc, %v
+  %s = load volatile i32, ptr @stride
+  %pn = getelementptr inbounds i8, ptr addrspace(2) %p, i32 %s
+  %in = add i16 %i, 1
+  %c = icmp ult i16 %in, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret i8 %accn
+}
