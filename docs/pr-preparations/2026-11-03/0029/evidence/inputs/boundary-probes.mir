# Instruction-local undef names must preserve equality within an instruction,
# leave real values and debug locations intact, and include implicit uses.
--- |
  define void @distinct_sources() { ret void }
  define void @mixed_tied_untied() { ret void }
  define void @phi_edges() { ret void }
  define void @debug_live() !dbg !4 { ret void }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "review probe", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "probe.c", directory: "/")
  !2 = !DISubroutineType(types: !{})
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "debug_live", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !5 = !DILocalVariable(name: "value", scope: !4, file: !1, line: 1, type: !6)
  !6 = !DIBasicType(name: "char", size: 8, encoding: DW_ATE_signed_char)
  !7 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: distinct_sources
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
body: |
  bb.0:
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0, reguse:GPR, undef %0, reguse:GPR, undef %1
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0
    RTS
...
---
name: mixed_tied_untied
tracksRegLiveness: true
body: |
  bb.0:
    %0:imag16 = IMPLICIT_DEF
    %1:gpr = LDAbs 1000
    %2:anyi8 = IncMB undef %0.subhi(tied-def 0), implicit-def $c, implicit-def $v, implicit undef %1
    STAbs %1, 2000
    RTS
...
---
name: phi_edges
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:gpr = LDAbs 1000
    CmpBrZero %bb.1, undef $z, 1, %0, implicit-def $c
    JMP %bb.2
  bb.1:
    JMP %bb.2
  bb.2:
    %1:gpr = PHI undef %0, %bb.0, undef %0, %bb.1
    STAbs %1, 2000
    RTS
...
---
name: debug_live
tracksRegLiveness: true
body: |
  bb.0:
    %0:gpr = LDAbs 1000
    DBG_VALUE %0, $noreg, !5, !DIExpression(), debug-location !7
    INLINEASM &"", sideeffect attdialect, reguse:GPR, undef %0
    DBG_VALUE %0, $noreg, !5, !DIExpression(), debug-location !7
    STAbs %0, 2000
    RTS
...
