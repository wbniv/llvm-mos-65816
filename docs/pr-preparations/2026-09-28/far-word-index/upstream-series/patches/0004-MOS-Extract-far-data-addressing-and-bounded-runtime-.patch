+// Generalized 8-bit load using 65816 absolute-long (24-bit) addressing,
+// for far (addrspace 2) pointers. The address argument is a global value or a
+// 24-bit immediate. Selects to LDA AbsoluteLong (accumulator only). Additionally
+// expects a MachineMemOperand.
+def G_LOAD_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$addr);
+  let mayLoad = true;
+}
+
 // Generalized 8-bit load using the absolute indexed addressing mode. The base
 // argument isn't a pointer; it's either a global value or a 16-bit immediate.
 // The index argument is an 8-bit scalar. Additionally expects a
@@ -132,8 +143,65 @@ def G_STORE_ABS : MOSGenericInstruction {
   let mayStore = true;
 }
 
+// Generalized 8-bit store using 65816 absolute-long (24-bit) addressing,
+// for far (addrspace 2) pointers. The address argument is a global value or a
+// 24-bit immediate. Selects to STA AbsoluteLong (accumulator only). Additionally
+// expects a MachineMemOperand.
+def G_STORE_FAR_ABS : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$addr);
+  let mayStore = true;
+}
 
+// 8-bit load/store through a RUNTIME far (addrspace 2) pointer
+// via 65816 indirect-long (`lda [dp]`/`sta [dp]`). The address operand is the
+// far pointer itself (a 32-bit value that lands in a contiguous Imag32 ZP quad);
+// the selector lowers these to LDIndirLong/STIndirLong. Mirror of
+// G_LOAD_FAR_ABS/G_STORE_FAR_ABS for the non-constant (indirect) far case.
+def G_LOAD_FAR_INDIR : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr);
+  let mayLoad = true;
+}
+def G_STORE_FAR_INDIR : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr);
+  let mayStore = true;
+}
 
+// Indexed far byte accesses use an Imag32 base and an s8 Y offset. The
+// 65816 adds Y to the full 24-bit address, including carry into the bank.
+// The legalizer proves the offset range before selecting these pseudos.
+def G_LOAD_FAR_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_INDIR_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr, type1:$index);
+  let mayStore = true;
+}
+// The wide-index forms retain an s16 offset under HasIndex16. Selection
+// keeps the Y load and memory access together until emission, with XLow
+// requesting 16-bit index mode.
+def G_LOAD_FAR_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasW65816, HasIndex16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins ptype1:$addr, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_INDIR_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasW65816, HasIndex16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, ptype1:$addr, type1:$index);
+  let mayStore = true;
+}
 
 // Generalized 8-bit store using the absolute indexed addressing mode. The base
 // argument isn't a pointer; it's either a global value or a 16-bit immediate.
