+def LDAbsLong : MOSLoad, PseudoInstExpansion<(LDA_AbsoluteLong addr24:$src)> {
+  let Predicates = [HasW65816];
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList = (ins addr24:$src);
+}
+
+def STAbsLong : MOSStore, PseudoInstExpansion<(STA_AbsoluteLong addr24:$dst)> {
+  let Predicates = [HasW65816];
+  dag InOperandList = (ins Ac:$src, addr24:$dst);
+}
+
+def LDIndirLong : MOSLoad, PseudoInstExpansion<(LDA_IndirectLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag32:$addr);
+}
+
+def STIndirLong : MOSStore, PseudoInstExpansion<(STA_IndirectLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag InOperandList = (ins Ac:$src, Imag32:$addr);
+}
+
+def LDIndirLongIdx : MOSLoad,
+    PseudoInstExpansion<(LDA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag32:$addr, Yc:$offset);
+}
+
+def STIndirLongIdx : MOSStore,
+    PseudoInstExpansion<(STA_IndirectIndexedLong addr8:$addr)> {
+  let Predicates = [HasW65816];
+  dag InOperandList = (ins Ac:$src, Imag32:$addr, Yc:$offset);
+}
+
+// An Imag16 index is loaded into Y immediately before the byte access. Keep
+// both operations in one pseudo until emission so spills cannot insert a
+// sep #$10 between them and clear Y's high byte. XLow brackets the pair with
+// 16-bit index mode; the accumulator remains 8 bits wide.
+let Defs = [Y16], Size = 4 in {
+def LDIndirLongYIdx : MOSLoad {
+  let Predicates = [HasW65816, HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag32:$addr, Imag16:$idx);
+}
+def STIndirLongYIdx : MOSStore {
+  let Predicates = [HasW65816, HasIndex16]; let XLow = 1;
+  dag InOperandList  = (ins Ac:$src, Imag32:$addr, Imag16:$idx);
+}
+}
