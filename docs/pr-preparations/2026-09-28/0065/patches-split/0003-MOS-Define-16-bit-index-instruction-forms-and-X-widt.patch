+# RUN: llvm-mc -triple=mos -mcpu=mosw65816 -filetype=obj %s -o %t.o
+# RUN: llvm-objdump -t %t.o | FileCheck %s
+
+# The 8-bit index-register memory forms require 8-bit index registers, so on
+# the 65816 each of them opens an $xh mapping region after a 16-bit index
+# instruction. Every probe below follows a 16-bit `ldx` ($xl), so each one
+# must start its own $xh region at its own offset.
+
+# CHECK-DAG: 00000003 l .text 00000000 $xh.1
+# CHECK-DAG: 00000008 l .text 00000000 $xh.3
+# CHECK-DAG: 0000000d l .text 00000000 $xh.5
+# CHECK-DAG: 00000013 l .text 00000000 $xh.7
+# CHECK-DAG: 00000018 l .text 00000000 $xh.9
+# CHECK-DAG: 0000001e l .text 00000000 $xh.11
+# CHECK-DAG: 00000023 l .text 00000000 $xh.13
+# CHECK-DAG: 00000029 l .text 00000000 $xh.15
+# CHECK-DAG: 0000002e l .text 00000000 $xh.17
+# CHECK-DAG: 00000034 l .text 00000000 $xh.19
+# CHECK-DAG: 00000039 l .text 00000000 $xh.21
+# CHECK-DAG: 0000003e l .text 00000000 $xh.23
+# CHECK-DAG: 00000044 l .text 00000000 $xh.25
+# CHECK-DAG: 00000049 l .text 00000000 $xh.27
+# CHECK-DAG: 0000004f l .text 00000000 $xh.29
+
+ldx #mos16($1234)
+stx $12
+ldx #mos16($1234)
+stx $12,y
+ldx #mos16($1234)
+stx $1234
+ldx #mos16($1234)
+ldx $12
+ldx #mos16($1234)
+ldx $1234
+ldx #mos16($1234)
+ldx $12,y
+ldx #mos16($1234)
+ldx $1234,y
+ldx #mos16($1234)
+sty $12
+ldx #mos16($1234)
+sty $1234
+ldx #mos16($1234)
+sty $12,x
+ldx #mos16($1234)
+ldy $12,x
+ldx #mos16($1234)
+ldy $1234,x
+ldx #mos16($1234)
+ldy $12
+ldx #mos16($1234)
+cpy $1234
+ldx #mos16($1234)
+cpx $12
