diff --git a/llvm/lib/Target/MOS/MOSInstrFormats.td b/llvm/lib/Target/MOS/MOSInstrFormats.td
index 2716e7a36359..faddda0a9cc5 100644
--- a/llvm/lib/Target/MOS/MOSInstrFormats.td
+++ b/llvm/lib/Target/MOS/MOSInstrFormats.td
@@ -66,6 +66,12 @@ def HasAccum16 : Predicate<"Subtarget->hasAccum16()">,
   let PredicateName = "FeatureAccum16";
 }
 
+// Native indices: opt-in 16-bit-index-register codegen (FeatureIndex16 / +mos-xy16).
+def HasIndex16 : Predicate<"Subtarget->hasIndex16()">,
+                AssemblerPredicate<(all_of FeatureIndex16), "mos-xy16"> {
+  let PredicateName = "FeatureIndex16";
+}
+
 def Has65EL02 : Predicate<"Subtarget->has65EL02()">,
                 AssemblerPredicate<(all_of Feature65EL02), "65EL02"> {
   let PredicateName = "Feature65EL02";
@@ -980,9 +986,13 @@ multiclass CC0_Regular< bits<3> aaa, string OpcodeStr = "nop"> {
     let XLow = 1;
   }
 
-  def _ZeroPage : Inst16<OpcodeStr, OpcodeC0<aaa, 0b001>, ZeroPage>;
+  def _ZeroPage : Inst16<OpcodeStr, OpcodeC0<aaa, 0b001>, ZeroPage> {
+    let XHigh = 1;
+  }
 
-  def _Absolute : Inst24<OpcodeStr, OpcodeC0<aaa, 0b011>, Absolute>;
+  def _Absolute : Inst24<OpcodeStr, OpcodeC0<aaa, 0b011>, Absolute> {
+    let XHigh = 1;
+  }
 }
 
