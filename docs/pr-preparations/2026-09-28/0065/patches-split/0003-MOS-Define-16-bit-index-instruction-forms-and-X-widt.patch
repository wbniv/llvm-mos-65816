 /// The conditional branch instructions all have the form xxy10000. The flag
 /// indicated by xx is compared with y, and the branch is taken if they are
diff --git a/llvm/lib/Target/MOS/MOSInstrLogical.td b/llvm/lib/Target/MOS/MOSInstrLogical.td
index 23227194a85b..9e3f4439c099 100644
--- a/llvm/lib/Target/MOS/MOSInstrLogical.td
+++ b/llvm/lib/Target/MOS/MOSInstrLogical.td
@@ -73,6 +73,15 @@ class MOSLogicalInstr : Instruction {
   // ops with REP/SEP. Defaults to 0 (8-bit); set to 1 on the 16-bit forms.
   bit MLow = 0;
   let TSFlags{0} = MLow;
+
+  // Native indices: the X (index width) TSFlag, mirroring the MC `Inst` base at the
+  // same bit positions (TSFlagXLow = bit 2, TSFlagXHigh = bit 3). Defaults to 0
+  // (X-width agnostic). XLow=1 means the instruction requires X=16-bit; XHigh=1
+  // means it requires X=8-bit (used for CPX_Immediate / CPY_Immediate forms).
+  bit XLow = 0;
+  bit XHigh = 0;
+  let TSFlags{2} = XLow;
+  let TSFlags{3} = XHigh;
 }
 
 //===---------------------------------------------------------------------===//
@@ -731,6 +740,54 @@ def STIndirIdx16 : MOSStore, PseudoInstExpansion<(STA_IndirectIndexed addr8:$add
   dag InOperandList = (ins Ac16:$src, Imag16:$addr, Yc:$offset);
 }
 
+// Native indices: abs,X16 and (zp),Y16 indexed load/store with 16-bit X/Y index (X=0).
+// XLow=1 → MOSInsertREPSEP brackets with rep #$10 / sep #$10 (X mode).
+// MLow=1 additionally brackets with rep #$20 / sep #$20 (accumulator mode).
+// Combined MLow+XLow → rep #$30 / sep #$30 emitted via insertSwitch (both flags).
+// The Xc16/Yc16 operand is an extra constraint: RA assigns physical X/Y; the
+// operand is dropped during PseudoInstExpansion (hardware uses X/Y implicitly).
+//
+// abs,X with 8-bit data (M=1, X=0): rep #$10; lda abs,x; sep #$10
+def LDAbsXIdx : MOSLoad, PseudoInstExpansion<(LDA_AbsoluteX addr16:$addr)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins addr16:$addr, Xc16:$idx);
+}
+def STAbsXIdx : MOSStore, PseudoInstExpansion<(STA_AbsoluteX addr16:$addr)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag InOperandList = (ins Ac:$src, addr16:$addr, Xc16:$idx);
+}
+// abs,X with 16-bit data (M=0, X=0): rep #$30; lda abs,x; sep #$30
+def LDAbsXIdx16 : MOSLoad, PseudoInstExpansion<(LDA_AbsoluteX addr16:$addr)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList  = (ins addr16:$addr, Xc16:$idx);
+}
+def STAbsXIdx16 : MOSStore, PseudoInstExpansion<(STA_AbsoluteX addr16:$addr)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
+  dag InOperandList = (ins Ac16:$src, addr16:$addr, Xc16:$idx);
+}
+// (zp),Y with 8-bit data (M=1, X=0): rep #$10; lda (zp),y; sep #$10
+def LDIndirYIdx : MOSLoad, PseudoInstExpansion<(LDA_IndirectIndexed addr8:$addr)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Ac:$dst);
+  dag InOperandList  = (ins Imag16:$addr, Yc16:$offset);
+}
+def STIndirYIdx : MOSStore, PseudoInstExpansion<(STA_IndirectIndexed addr8:$addr)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag InOperandList = (ins Ac:$src, Imag16:$addr, Yc16:$offset);
+}
+// (zp),Y with 16-bit data (M=0, X=0): rep #$30; lda (zp),y; sep #$30
+def LDIndirYIdx16 : MOSLoad, PseudoInstExpansion<(LDA_IndirectIndexed addr8:$addr)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Ac16:$dst);
+  dag InOperandList  = (ins Imag16:$addr, Yc16:$offset);
+}
+def STIndirYIdx16 : MOSStore, PseudoInstExpansion<(STA_IndirectIndexed addr8:$addr)> {
+  let Predicates = [HasAccum16, HasIndex16]; let MLow = 1; let XLow = 1;
+  dag InOperandList = (ins Ac16:$src, Imag16:$addr, Yc16:$offset);
+}
+
 // Imag16 values enter A16 through word loads and leave through word stores.
 // Avoid Ac16-to-byte COPY instructions, which could coalesce different widths.
 
@@ -909,3 +966,156 @@ def : Pat<(i8 (trunc Imag16:$s)), (EXTRACT_SUBREG Imag16:$s, sublo)>;
 
 def : Pat<(i1 imm:$s), (LDImm1 imm:$s)>;
 def : Pat<(i8 imm:$s), (LDImm imm:$s)>;
+
+//===---------------------------------------------------------------------===//
+// Native indices: 16-bit X/Y index-register instructions (+mos-xy16)
+//===---------------------------------------------------------------------===//
+//
+// Each pseudo carries XLow=1 so MOSInsertREPSEP knows X must be 16-bit.
+// TXA16/TAX16/TYA16/TAY16 additionally carry MLow=1 because they run with
+// both M and X in native-16-bit mode (TXA copies X→A, needs A16 not A8).
+// Transfer pseudos are needed for the soft-stack spill path (Xc16 ↔ Ac16).
+
+// ---- X register loads ----
+def LDXAbs16 : MOSLoad, PseudoInstExpansion<(LDX_Absolute addr16:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins addr16:$src);
+}
+def LDXImag16 : MOSLoad, PseudoInstExpansion<(LDX_ZeroPage addr8:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins Imag16:$src);
+}
+def LDXImm16 : MOSLoad, PseudoInstExpansion<(LDX_Immediate16 imm16:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins imm16:$src);
+}
+
+// ---- X register stores ----
+def STXAbs16 : MOSStore, PseudoInstExpansion<(STX_Absolute addr16:$dst)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag InOperandList = (ins Xc16:$src, addr16:$dst);
+}
+def STXImag16 : MOSLogicalInstr, PseudoInstExpansion<(STX_ZeroPage addr8:$dst)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let mayStore = true;
+  dag OutOperandList = (outs Imag16:$dst); dag InOperandList = (ins Xc16:$src);
+}
+
+// ---- X register compare ----
+def CPXAbs16 : MOSLogicalInstr, PseudoInstExpansion<(CPX_Absolute addr16:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let mayLoad = true; let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Xc16:$l, addr16:$r);
+}
+def CPXImag16 : MOSLogicalInstr, PseudoInstExpansion<(CPX_ZeroPage addr8:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let mayLoad = true; let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Xc16:$l, Imag16:$r);
+}
+def CPXImm16 : MOSLogicalInstr, PseudoInstExpansion<(CPX_Immediate16 imm16:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Xc16:$l, imm16:$r);
+}
+
+// ---- X register inc/dec (accumulator RMW, like INCAcc16) ----
+def INX16 : MOSLogicalInstr, PseudoInstExpansion<(INX_Implied)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let Constraints = "$dst = $src";
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins Xc16:$src);
+}
+def DEX16 : MOSLogicalInstr, PseudoInstExpansion<(DEX_Implied)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let Constraints = "$dst = $src";
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins Xc16:$src);
+}
+
+// ---- Y register loads ----
+def LDYAbs16 : MOSLoad, PseudoInstExpansion<(LDY_Absolute addr16:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins addr16:$src);
+}
+def LDYImag16 : MOSLoad, PseudoInstExpansion<(LDY_ZeroPage addr8:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins Imag16:$src);
+}
+def LDYImm16 : MOSLoad, PseudoInstExpansion<(LDY_Immediate16 imm16:$src)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins imm16:$src);
+}
+
+// ---- Y register stores ----
+def STYAbs16 : MOSStore, PseudoInstExpansion<(STY_Absolute addr16:$dst)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  dag InOperandList = (ins Yc16:$src, addr16:$dst);
+}
+def STYImag16 : MOSLogicalInstr, PseudoInstExpansion<(STY_ZeroPage addr8:$dst)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let mayStore = true;
+  dag OutOperandList = (outs Imag16:$dst); dag InOperandList = (ins Yc16:$src);
+}
+
+// ---- Y register compare ----
+def CPYAbs16 : MOSLogicalInstr, PseudoInstExpansion<(CPY_Absolute addr16:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let mayLoad = true; let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Yc16:$l, addr16:$r);
+}
+def CPYImag16 : MOSLogicalInstr, PseudoInstExpansion<(CPY_ZeroPage addr8:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let mayLoad = true; let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Yc16:$l, Imag16:$r);
+}
+def CPYImm16 : MOSLogicalInstr, PseudoInstExpansion<(CPY_Immediate16 imm16:$r)> {
+  let Predicates = [HasIndex16]; let XLow = 1;
+  let isCompare = true;
+  dag OutOperandList = (outs Cc:$carry); dag InOperandList = (ins Yc16:$l, imm16:$r);
+}
+
+// ---- Y register inc/dec ----
+def INY16 : MOSLogicalInstr, PseudoInstExpansion<(INY_Implied)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let Constraints = "$dst = $src";
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins Yc16:$src);
+}
+def DEY16 : MOSLogicalInstr, PseudoInstExpansion<(DEY_Implied)> {
+  let Predicates = [HasIndex16]; let XLow = 1; let Constraints = "$dst = $src";
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins Yc16:$src);
+}
+
+// ---- 16-bit transfer pseudos for soft-stack spill (Xc16 ↔ Ac16 via TXA/TAX) ----
+// Both MLow=1 and XLow=1: these run with M=0 and X=0. The A16 clobber is encoded
+// in the explicit Ac16 operands; no additional implicit annotations needed.
+def TXA16 : MOSLogicalInstr, PseudoInstExpansion<(TXA_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Ac16:$dst); dag InOperandList = (ins Xc16:$src);
+}
+def TAX16 : MOSLogicalInstr, PseudoInstExpansion<(TAX_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Xc16:$dst); dag InOperandList = (ins Ac16:$src);
+}
+def TYA16 : MOSLogicalInstr, PseudoInstExpansion<(TYA_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Ac16:$dst); dag InOperandList = (ins Yc16:$src);
+}
+def TAY16 : MOSLogicalInstr, PseudoInstExpansion<(TAY_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1; let XLow = 1;
+  dag OutOperandList = (outs Yc16:$dst); dag InOperandList = (ins Ac16:$src);
+}
+
+// ---- 16-bit accumulator push/pull (A16 preservation around an X16/Y16 spill) ----
+// `pha`/`pla` move TWO bytes when M=0, so with MLow=1 (MOSInsertREPSEP supplies the
+// rep/sep #$20 bracket) this pair round-trips the whole 16-bit accumulator through
+// the hardware stack. Sole user: MOSRegisterInfo::expandLDSTStk, which must stage an
+// X16/Y16 soft-stack spill through A16 (TXA16/TAX16 + STAIndir16/LDAIndir16 are the
+// only route from a 16-bit index register to a (zp)-indirect slot) while the LDStk /
+// STStk pseudo carries no A16 operand for register allocation to see. Not selectable:
+// no pattern, emitted only by that expansion. Predicated on HasIndex16 for the same
+// reason as TAX16/TXA16 above — the staging path exists only under +mos-xy16.
+def PHA16 : MOSLogicalInstr, PseudoInstExpansion<(PHA_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1;
+  let mayStore = true;
+  let isReMaterializable = false;
+  dag InOperandList = (ins Ac16:$src);
+}
+def PLA16 : MOSLogicalInstr, PseudoInstExpansion<(PLA_Implied)> {
+  let Predicates = [HasIndex16]; let MLow = 1;
+  let mayLoad = true;
+  let isReMaterializable = false;
+  dag OutOperandList = (outs Ac16:$dst);
+}
diff --git a/llvm/test/CodeGen/MOS/xy16-index-forms.mir b/llvm/test/CodeGen/MOS/xy16-index-forms.mir
new file mode 100644
index 000000000000..403784f3bfc8
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/xy16-index-forms.mir
@@ -0,0 +1,53 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -start-before=branch-relaxation -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -start-before=branch-relaxation -verify-machineinstrs -filetype=obj %s -o %t.o
+# RUN: llvm-objdump -d --print-imm-hex %t.o | FileCheck %s --check-prefix=OBJ
+
+# Each 16-bit index pseudo emits the width-agnostic opcode of its addressing
+# mode; the object carries the three-byte index immediates.
+
+# CHECK-LABEL: index_forms:
+# CHECK:      ldx #511
+# CHECK-NEXT: inx
+# CHECK-NEXT: cpx #4660
+# CHECK-NEXT: ldy __rc2
+# CHECK-NEXT: dey
+# CHECK-NEXT: sty __rc4
+# CHECK-NEXT: lda {{.*}}t,x
+# CHECK-NEXT: pha
+# CHECK-NEXT: txa
+# CHECK-NEXT: tax
+# CHECK-NEXT: pla
+# CHECK-NEXT: sta {{.*}}t,x
+# CHECK-NEXT: rts
+
+# OBJ-LABEL: <index_forms>:
+# OBJ:      a2 ff 01 {{.*}}ldx
+# OBJ-NEXT: e8 {{.*}}inx
+# OBJ-NEXT: e0 34 12 {{.*}}cpx
+# OBJ-NEXT: a4 00 {{.*}}ldy
+# OBJ-NEXT: 88 {{.*}}dey
+# OBJ-NEXT: 84 00 {{.*}}sty
+--- |
+  @t = global [4 x i16] zeroinitializer
+  define void @index_forms() { ret void }
+...
+---
+name: index_forms
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rs1, $rs2
+    $x16 = LDXImm16 511
+    $x16 = INX16 $x16
+    $c = CPXImm16 $x16, 4660
+    $y16 = LDYImag16 $rs1
+    $y16 = DEY16 $y16
+    $rs2 = STYImag16 $y16
+    $a16 = LDAbsXIdx16 @t, $x16
+    PHA16 $a16
+    $a16 = TXA16 $x16
+    $x16 = TAX16 $a16
+    $a16 = PLA16
+    STAbsXIdx16 killed $a16, @t, $x16
+    RTS
+...
