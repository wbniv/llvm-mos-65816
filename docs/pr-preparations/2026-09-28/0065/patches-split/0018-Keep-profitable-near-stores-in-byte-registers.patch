diff --git a/llvm/test/CodeGen/MOS/a16-near-store-profit-boundaries.ll b/llvm/test/CodeGen/MOS/a16-near-store-profit-boundaries.ll
new file mode 100644
index 000000000000..bda4527ebc84
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-near-store-profit-boundaries.ll
@@ -0,0 +1,61 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs -stop-after=legalizer < %s | FileCheck %s --check-prefixes=CHECK,DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs -stop-after=legalizer < %s | FileCheck %s --check-prefixes=CHECK,NATIVE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs -stop-after=legalizer < %s | FileCheck %s --check-prefixes=CHECK,NATIVE
+
+@g = global i16 0, align 2
+
+; Atomic stores remain one word operation even when unit arithmetic consumes
+; the same ABI byte pair. The attribute enables native words in every RUN.
+define i16 @atomic_indirect_increment(ptr %p, i16 %value) #0 {
+; CHECK-LABEL: name: atomic_indirect_increment
+; CHECK: G_STORE16_INDIR {{.*}} :: (store unordered (s16) into %ir.p)
+; CHECK-NEXT: {{%[0-9]+}}:_(s16) = G_ADD
+; CHECK-NOT: G_STORE
+; CHECK: RTS
+  store atomic i16 %value, ptr %p unordered, align 2
+  %result = add i16 %value, 1
+  ret i16 %result
+}
+
+define i16 @atomic_indirect_decrement(ptr %p, i16 %value) #0 {
+; CHECK-LABEL: name: atomic_indirect_decrement
+; CHECK: G_STORE16_INDIR {{.*}} :: (store unordered (s16) into %ir.p)
+; CHECK-NEXT: {{%[0-9]+}}:_(s16) = G_ADD
+; CHECK-NOT: G_STORE
+; CHECK: RTS
+  store atomic i16 %value, ptr %p unordered, align 2
+  %result = sub i16 %value, 1
+  ret i16 %result
+}
+
+define i16 @atomic_absolute_decrement(i16 %value) #0 {
+; CHECK-LABEL: name: atomic_absolute_decrement
+; CHECK: G_STORE16_ABS {{.*}}, @g :: (store unordered (s16) into @g)
+; CHECK-NEXT: {{%[0-9]+}}:_(s16) = G_ADD
+; CHECK-NOT: G_STORE
+; CHECK: RTS
+  store atomic i16 %value, ptr @g unordered, align 2
+  %result = sub i16 %value, 1
+  ret i16 %result
+}
+
+declare i16 @produce_many(i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16, i16)
+
+; Stack-passed arguments require a nonzero outgoing frame. Such a teardown is
+; outside the byte-store gate, even when the stored value is a call result.
+define void @nonzero_call_frame(ptr %p) {
+; CHECK-LABEL: name: nonzero_call_frame
+; CHECK: JSR @produce_many
+; CHECK: ADJCALLSTACKUP 24, 0
+; NATIVE-NEXT: G_STORE16_INDIR {{.*}} :: (volatile store (s16) into %ir.p, align 1)
+; NATIVE-NEXT: RTS
+; DEFAULT: G_STORE_INDIR {{.*}} :: (volatile store (s8) into %ir.p)
+; DEFAULT: G_STORE_INDIR_IDX {{.*}} :: (volatile store (s8) into %ir.p + 1)
+; DEFAULT-NOT: G_STORE
+; DEFAULT: RTS
+  %value = call i16 @produce_many(i16 1, i16 2, i16 3, i16 4, i16 5, i16 6, i16 7, i16 8, i16 9, i16 10, i16 11, i16 12, i16 13, i16 14, i16 15, i16 16, i16 17, i16 18, i16 19, i16 20)
+  store volatile i16 %value, ptr %p, align 1
+  ret void
+}
+
+attributes #0 = { "target-features"="+mos-a16" }
diff --git a/llvm/test/CodeGen/MOS/a16-near-store-profit-sub.mir b/llvm/test/CodeGen/MOS/a16-near-store-profit-sub.mir
new file mode 100644
index 000000000000..bbc3001cbc2a
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-near-store-profit-sub.mir
@@ -0,0 +1,81 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs -run-pass=legalizer -o - %s | FileCheck %s --check-prefixes=BYTE,DEFAULT
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs -run-pass=legalizer -o - %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs -run-pass=legalizer -o - %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+
+# Literal G_SUB uses the opposite constant sign from G_ADD for a unit step.
+# Absolute decrement keeps the original stored bytes and uses byte arithmetic.
+---
+name: literal_sub_absolute_dec
+body: |
+  bb.0:
+    liveins: $a, $x
+    ; BYTE-LABEL: name: literal_sub_absolute_dec
+    ; BYTE: G_STORE_ABS {{.*}}, 4660 :: (volatile store (s8))
+    ; BYTE: G_STORE_ABS {{.*}}, 4661 :: (volatile store (s8) into unknown-address + 1)
+    ; BYTE-NEXT: {{%[0-9]+}}:_(s8), {{%[0-9]+}}:_(s8) = G_DEC
+    ; BYTE-NOT: G_STORE
+    ; BYTE: RTS
+    %0:_(p0) = G_CONSTANT i16 4660
+    %1:_(s8) = COPY $a
+    %2:_(s8) = COPY $x
+    %3:_(s16) = G_MERGE_VALUES %1, %2
+    %4:_(s16) = G_CONSTANT i16 1
+    G_STORE %3(s16), %0(p0) :: (volatile store (s16), align 1)
+    %5:_(s16) = G_SUB %3, %4
+    %6:_(s8), %7:_(s8) = G_UNMERGE_VALUES %5(s16)
+    $a = COPY %6(s8)
+    $x = COPY %7(s8)
+    RTS implicit $a, implicit $x
+...
+
+# Subtracting negative one permits byte stores followed by byte increment.
+---
+name: literal_sub_indirect_inc
+body: |
+  bb.0:
+    liveins: $a, $x, $rs1
+    ; BYTE-LABEL: name: literal_sub_indirect_inc
+    ; BYTE: G_STORE_INDIR {{.*}} :: (volatile store (s8))
+    ; BYTE: G_STORE_INDIR_IDX {{.*}} :: (volatile store (s8) into unknown-address + 1)
+    ; BYTE-NEXT: {{%[0-9]+}}:_(s8), {{%[0-9]+}}:_(s8) = G_INC
+    ; BYTE-NOT: G_STORE
+    ; BYTE: RTS
+    %0:_(p0) = COPY $rs1
+    %1:_(s8) = COPY $a
+    %2:_(s8) = COPY $x
+    %3:_(s16) = G_MERGE_VALUES %1, %2
+    %4:_(s16) = G_CONSTANT i16 -1
+    G_STORE %3(s16), %0(p0) :: (volatile store (s16), align 1)
+    %5:_(s16) = G_SUB %3, %4
+    %6:_(s8), %7:_(s8) = G_UNMERGE_VALUES %5(s16)
+    $a = COPY %6(s8)
+    $x = COPY %7(s8)
+    RTS implicit $a, implicit $x
+...
+
+# Indirect decrement retains one native word store while its arithmetic narrows.
+# The replacement must retain the volatile memory operand and legalizer tracking.
+---
+name: literal_sub_indirect_dec
+body: |
+  bb.0:
+    liveins: $a, $x, $rs1
+    ; BYTE-LABEL: name: literal_sub_indirect_dec
+    ; NATIVE: G_STORE16_INDIR {{.*}} :: (volatile store (s16), align 1)
+    ; DEFAULT: G_STORE_INDIR {{.*}} :: (volatile store (s8))
+    ; DEFAULT: G_STORE_INDIR_IDX {{.*}} :: (volatile store (s8) into unknown-address + 1)
+    ; BYTE-NEXT: {{%[0-9]+}}:_(s8), {{%[0-9]+}}:_(s8) = G_DEC
+    ; BYTE-NOT: G_STORE
+    ; BYTE: RTS
+    %0:_(p0) = COPY $rs1
+    %1:_(s8) = COPY $a
+    %2:_(s8) = COPY $x
+    %3:_(s16) = G_MERGE_VALUES %1, %2
+    %4:_(s16) = G_CONSTANT i16 1
+    G_STORE %3(s16), %0(p0) :: (volatile store (s16), align 1)
+    %5:_(s16) = G_SUB %3, %4
+    %6:_(s8), %7:_(s8) = G_UNMERGE_VALUES %5(s16)
+    $a = COPY %6(s8)
+    $x = COPY %7(s8)
+    RTS implicit $a, implicit $x
+...
diff --git a/llvm/test/CodeGen/MOS/a16-near-store-profit.ll b/llvm/test/CodeGen/MOS/a16-near-store-profit.ll
new file mode 100644
index 000000000000..bc8d9aa4ef13
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-near-store-profit.ll
@@ -0,0 +1,187 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+
+@g = global i16 0, align 1
+@byte = global i8 0
+declare i16 @produce()
+declare void @opaque()
+
+; Canonical subtraction by one must preserve the stored value and return its
+; decremented value, including borrow from the high byte.
+define i16 @absolute_decrement(i16 %value) {
+; BYTE-LABEL: absolute_decrement:
+; BYTE-NOT: rep
+; BYTE: sta g
+; BYTE-NEXT: stx g+1
+; BYTE-NEXT: dec
+; BYTE: dex
+; BYTE: rts
+  store volatile i16 %value, ptr @g, align 1
+  %result = sub i16 %value, 1
+  ret i16 %result
+}
+
+; A plain pointer argument and one byte-returned increment permit byte stores.
+define i16 @indirect_increment(ptr %p, i16 %value) {
+; BYTE-LABEL: indirect_increment:
+; BYTE-NOT: rep
+; BYTE: sta (__rc2)
+; BYTE: sta (__rc2),y
+; BYTE: inc
+; BYTE: bne
+; BYTE: inc
+; BYTE: rts
+  store volatile i16 %value, ptr %p, align 1
+  %result = add i16 %value, 1
+  ret i16 %result
+}
+
+; The native store preserves the low byte for the byte decrement sequence.
+define i16 @indirect_decrement(ptr %p, i16 %value) {
+; NATIVE-LABEL: indirect_decrement:
+; NATIVE: rep #32
+; NATIVE: sta (__rc2)
+; NATIVE: sep #32
+; NATIVE: dec
+; NATIVE: dex
+; NATIVE: rts
+; DEFAULT-LABEL: indirect_decrement:
+; DEFAULT-NOT: rep
+; DEFAULT: dec
+; DEFAULT: rts
+  store volatile i16 %value, ptr %p, align 1
+  %result = sub i16 %value, 1
+  ret i16 %result
+}
+
+; The returned A:X bytes are available after the zero-size call-frame pseudo.
+define void @indirect_call_result(ptr %p) {
+; BYTE-LABEL: indirect_call_result:
+; BYTE-NOT: rep
+; BYTE: jsr produce
+; BYTE-NEXT: sta (__rc{{[0-9]+}})
+; BYTE-NEXT: ldy #1
+; BYTE-NEXT: txa
+; BYTE-NEXT: sta (__rc{{[0-9]+}}),y
+; BYTE: rts
+  %value = call i16 @produce()
+  store volatile i16 %value, ptr %p, align 1
+  ret void
+}
+
