diff --git a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
index 9279a8bb513e..8cccac99a892 100644
--- a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
@@ -95,15 +95,28 @@ MOSLegalizerInfo::MOSLegalizerInfo(const MOSSubtarget &STI) {
 
   // Integer Extension and Truncation
 
-  getActionDefinitionsBuilder(G_ANYEXT)
-      .legalFor({{S16, S8}})
-      .customIf(typeIs(1, S1))
-      .scalarize(0)
-      .unsupported();
-  getActionDefinitionsBuilder(G_TRUNC)
-      .legalFor({{S1, S8}, {S1, S16}, {S8, S16}})
-      .scalarize(0)
-      .unsupported();
+  // Native s32 values use two s16 lanes. Keep the extension and merge rules
+  // consistent with that representation; zero extensions lower through bytes.
+  {
+    auto &B = getActionDefinitionsBuilder(G_ANYEXT).scalarize(0).legalFor(
+        {{S16, S8}});
+    if (STI.hasAccum16())
+      B.legalFor({{S32, S16}, {S32, S8}})
+          .customFor({{S64, S8}, {S64, S16}, {S64, S32}});
+    // Native-width s64 extensions and sources without a native lane
+    // decomposition lower through ZEXT. ANYEXT permits zero-filled high bits.
+    B.customIf([](const LegalityQuery &Q) {
+       unsigned SrcBits = Q.Types[1].getSizeInBits();
+       return SrcBits == 1 || (SrcBits != 8 && SrcBits != 16 && SrcBits != 32);
+     }).unsupported();
+  }
+  {
+    auto &B = getActionDefinitionsBuilder(G_TRUNC).legalFor(
+        {{S1, S8}, {S1, S16}, {S8, S16}});
+    if (STI.hasAccum16())
+      B.legalFor({{S16, S32}});
+    B.scalarize(0).unsupported();
+  }
 
   getActionDefinitionsBuilder(G_SEXT).scalarize(0).custom();
 
@@ -151,12 +164,40 @@ MOSLegalizerInfo::MOSLegalizerInfo(const MOSSubtarget &STI) {
   // inserts with constant indices, which the rule above then lowers further.
   getActionDefinitionsBuilder(G_SHUFFLE_VECTOR).lower();
 
-  getActionDefinitionsBuilder(G_MERGE_VALUES)
-      .legalForCartesianProduct({S16, P}, {S8, PZ})
-      .unsupported();
-  getActionDefinitionsBuilder(G_UNMERGE_VALUES)
-      .legalForCartesianProduct({S8, PZ}, {S16, P})
-      .unsupported();
+  // Native accumulator: s32<->2x s16 (un)merge is the glue for the 2x s16
+  // representation of s32 (see the ext/trunc note above), mirroring the default
+  // s16<->s8 (un)merge.
+  {
+    auto &B = getActionDefinitionsBuilder(G_MERGE_VALUES)
+                  .legalForCartesianProduct({S16, P}, {S8, PZ});
+    if (STI.hasAccum16())
+      // {S32,S16} 2x s16->s32 is the direct legal form; {S32,S8} is a 4x
+      // s8->s32 merge (e.g. an i8->i32 sext the artifact combiner couldn't
+      // fold) that the 2-source selectMergeValues can't take — custom-rewrite
+      // it into the legal 2-level form (see legalizeMergeS32FromBytes).
+      // {S64,S32} 2x s32->s64 is the direct legal form; {S64,S16} is a 4x
+      // s16->s64 merge that the 2-source selector can't take — custom-rewrite
+      // to the 2-level form (see legalizeMergeS64FromWords). Mirror of the s32
+      // case, one level up.
+      B.legalFor({{S32, S16}, {S64, S32}}).customFor({{S32, S8}, {S64, S16}});
+    B.unsupported();
+  }
+  {
+    auto &B = getActionDefinitionsBuilder(G_UNMERGE_VALUES)
+                  .legalForCartesianProduct({S8, PZ}, {S16, P});
+    if (STI.hasAccum16())
+      // {S16,S32} 2x s16<-s32 is the direct legal form; {S8,S32} is a 4x
+      // s8<-s32 unmerge (e.g. the byte split inside an s32 ±1 add or an s32
+      // shift>=8) that the 2-dest selectUnmergeValues can't take —
+      // custom-rewrite it into the legal 2-level form (see
+      // legalizeUnmergeS32ToBytes). Mirror of the G_MERGE_VALUES rule.
+      // {S32,S64} 2x s32<-s64 is the direct legal form; {S16,S64} is a 4x
+      // s16<-s64 unmerge (e.g. splitting a 64-bit value into 16-bit lanes) —
+      // custom-rewrite to the 2-level form (see legalizeUnmergeS64ToWords).
+      // Mirror of the s32 case.
+      B.legalFor({{S16, S32}, {S32, S64}}).customFor({{S8, S32}, {S16, S64}});
+    B.unsupported();
+  }
 
   getActionDefinitionsBuilder(G_BSWAP)
       .customFor({S8})
@@ -545,6 +586,20 @@ bool MOSLegalizerInfo::legalizeCustom(LegalizerHelper &Helper, MachineInstr &MI,
   case G_FREEZE:
     return legalizeToCopy(Helper, MRI, MI);
 
+  case G_MERGE_VALUES:
+    // customFor {S32,S8} (4x s8->s32) and {S64,S16} (4x s16->s64); pick by dest
+    // width.
+    if (MRI.getType(MI.getOperand(0).getReg()).getSizeInBits() == 64)
+      return legalizeMergeS64FromWords(Helper, MRI, MI);
+    return legalizeMergeS32FromBytes(Helper, MRI, MI);
+  case G_UNMERGE_VALUES:
+    // customFor {S8,S32} (4x s8<-s32) and {S16,S64} (4x s16<-s64); pick by
+    // source width.
+    if (MRI.getType(MI.getOperand(MI.getNumOperands() - 1).getReg())
+            .getSizeInBits() == 64)
+      return legalizeUnmergeS64ToWords(Helper, MRI, MI);
+    return legalizeUnmergeS32ToBytes(Helper, MRI, MI);
+
   // Integer Operations
   case G_ADD:
   case G_SUB:
@@ -641,6 +696,105 @@ static auto unmergeDefsSplitHigh(MachineInstr *MI) {
                      MI->getOperand(MI->getNumOperands() - 2)};
 }
 
+// Native accumulator: a direct 4x s8 -> s32 G_MERGE_VALUES (only reached via
+// customFor({S32,S8}) under +mos-a16) — rewrite into the legal 2-level form so
+// it routes through the s32-as-2x-s16 representation: merge(a,b)->s16,
+// merge(c,d)->s16, then those ->s32. Both halves are legal
+// (legalForCartesianProduct {S16,S8}; legalFor {S32,S16}) and the artifact
+// combiner folds them against feeding unmerges. selectMergeValues only takes a
+// 2-source merge, so the 4-source form must be split here, not selected.
+bool MOSLegalizerInfo::legalizeMergeS32FromBytes(LegalizerHelper &Helper,
+                                                 MachineRegisterInfo &MRI,
+                                                 MachineInstr &MI) const {
+  MachineIRBuilder &Builder = Helper.MIRBuilder;
+  const LLT S16 = LLT::scalar(16);
+  Register Dst = MI.getOperand(0).getReg();
+  Register B0 = MI.getOperand(1).getReg();
+  Register B1 = MI.getOperand(2).getReg();
+  Register B2 = MI.getOperand(3).getReg();
+  Register B3 = MI.getOperand(4).getReg();
+  auto Lo = Builder.buildMergeValues(S16, {B0, B1});
+  auto Hi = Builder.buildMergeValues(S16, {B2, B3});
+  Builder.buildMergeValues(Dst, {Lo.getReg(0), Hi.getReg(0)});
+  MI.eraseFromParent();
+  return true;
+}
+
+// Native accumulator: a direct 4x s8 <- s32 G_UNMERGE_VALUES (only reached via
+// customFor({S8,S32}) under +mos-a16) — the symmetric inverse of
+// legalizeMergeS32FromBytes. Rewrite it into the legal 2-level form so it
+// routes through the s32-as-2x-s16 representation: unmerge the s32 into two s16
+// words (legal {S16,S32}), then unmerge each word into two s8 bytes (legal
+// {S8,S16}), reusing the four original byte def regs. selectUnmergeValues only
+// takes a 2-dest unmerge, so the 4-dest form must be split here, not selected.
+// Building only unmerges (no new merge) cannot create a merge<->unmerge
+// artifact-combine loop.
+bool MOSLegalizerInfo::legalizeUnmergeS32ToBytes(LegalizerHelper &Helper,
+                                                 MachineRegisterInfo &MRI,
+                                                 MachineInstr &MI) const {
+  MachineIRBuilder &Builder = Helper.MIRBuilder;
+  const LLT S16 = LLT::scalar(16);
+  Register D0 = MI.getOperand(0).getReg();
+  Register D1 = MI.getOperand(1).getReg();
+  Register D2 = MI.getOperand(2).getReg();
+  Register D3 = MI.getOperand(3).getReg();
+  Register Src =
+      MI.getOperand(4).getReg(); // G_UNMERGE: defs first, source last
+  auto Words = Builder.buildUnmerge(S16, Src);     // s32 -> Lo:s16, Hi:s16
+  Builder.buildUnmerge({D0, D1}, Words.getReg(0)); // Lo -> D0, D1
+  Builder.buildUnmerge({D2, D3}, Words.getReg(1)); // Hi -> D2, D3
+  MI.eraseFromParent();
+  return true;
+}
+
+// Native accumulator: a direct 4x s16 -> s64 G_MERGE_VALUES (only reached via
+// customFor({S64,S16}) under +mos-a16) — the s64 analogue of
+// legalizeMergeS32FromBytes, one level up: merge each pair of s16 words into an
+// s32 (legal {S32,S16}), then merge the two s32 halves into the s64 (legal
+// {S64,S32}). selectMergeValues only takes a 2-source merge, so the 4-source
+// form must be split here, not selected.
+bool MOSLegalizerInfo::legalizeMergeS64FromWords(LegalizerHelper &Helper,
+                                                 MachineRegisterInfo &MRI,
+                                                 MachineInstr &MI) const {
+  MachineIRBuilder &Builder = Helper.MIRBuilder;
+  const LLT S32 = LLT::scalar(32);
+  Register Dst = MI.getOperand(0).getReg();
+  Register W0 = MI.getOperand(1).getReg();
+  Register W1 = MI.getOperand(2).getReg();
+  Register W2 = MI.getOperand(3).getReg();
+  Register W3 = MI.getOperand(4).getReg();
+  auto Lo = Builder.buildMergeValues(S32, {W0, W1});
+  auto Hi = Builder.buildMergeValues(S32, {W2, W3});
+  Builder.buildMergeValues(Dst, {Lo.getReg(0), Hi.getReg(0)});
+  MI.eraseFromParent();
+  return true;
+}
+
+// Native accumulator: a direct 4x s16 <- s64 G_UNMERGE_VALUES (only reached via
+// customFor({S16,S64}) under +mos-a16) — the symmetric inverse of
+// legalizeMergeS64FromWords, and the s64 analogue of legalizeUnmergeS32ToBytes:
+// unmerge the s64 into two s32 halves (legal {S32,S64}), then unmerge each half
+// into two s16 words (legal {S16,S32}), reusing the four original word def
+// regs. selectUnmergeValues only takes a 2-dest unmerge, so the 4-dest form
+// must be split here.
+bool MOSLegalizerInfo::legalizeUnmergeS64ToWords(LegalizerHelper &Helper,
+                                                 MachineRegisterInfo &MRI,
+                                                 MachineInstr &MI) const {
+  MachineIRBuilder &Builder = Helper.MIRBuilder;
+  const LLT S32 = LLT::scalar(32);
+  Register D0 = MI.getOperand(0).getReg();
+  Register D1 = MI.getOperand(1).getReg();
+  Register D2 = MI.getOperand(2).getReg();
+  Register D3 = MI.getOperand(3).getReg();
+  Register Src =
+      MI.getOperand(4).getReg(); // G_UNMERGE: defs first, source last
+  auto Halves = Builder.buildUnmerge(S32, Src);     // s64 -> Lo:s32, Hi:s32
+  Builder.buildUnmerge({D0, D1}, Halves.getReg(0)); // Lo -> D0, D1
+  Builder.buildUnmerge({D2, D3}, Halves.getReg(1)); // Hi -> D2, D3
+  MI.eraseFromParent();
+  return true;
+}
+
 bool MOSLegalizerInfo::legalizeAnyExt(LegalizerHelper &Helper,
                                       MachineRegisterInfo &MRI,
                                       MachineInstr &MI) const {
