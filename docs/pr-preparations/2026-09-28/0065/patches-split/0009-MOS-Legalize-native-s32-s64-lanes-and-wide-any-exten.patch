index 12f36c429637..0df1a74b6fac 100644
--- a/llvm/lib/Target/MOS/MOSLegalizerInfo.h
+++ b/llvm/lib/Target/MOS/MOSLegalizerInfo.h
@@ -38,6 +38,26 @@ public:
                          MachineInstr &MI) const;
 
 private:
+  // Native accumulator: 4x s8 -> s32 G_MERGE_VALUES -> legal 2-level (2x s16)
+  // form.
+  bool legalizeMergeS32FromBytes(LegalizerHelper &Helper,
+                                 MachineRegisterInfo &MRI,
+                                 MachineInstr &MI) const;
+  // Native accumulator: 4x s8 <- s32 G_UNMERGE_VALUES -> legal 2-level (2x s16)
+  // form (mirror).
+  bool legalizeUnmergeS32ToBytes(LegalizerHelper &Helper,
+                                 MachineRegisterInfo &MRI,
+                                 MachineInstr &MI) const;
+  // Native accumulator: 4x s16 -> s64 G_MERGE_VALUES -> legal 2-level (2x s32)
+  // form (one level up).
+  bool legalizeMergeS64FromWords(LegalizerHelper &Helper,
+                                 MachineRegisterInfo &MRI,
+                                 MachineInstr &MI) const;
+  // Native accumulator: 4x s16 <- s64 G_UNMERGE_VALUES -> legal 2-level (2x
+  // s32) form (mirror).
+  bool legalizeUnmergeS64ToWords(LegalizerHelper &Helper,
+                                 MachineRegisterInfo &MRI,
+                                 MachineInstr &MI) const;
   // Integer Extension and Truncation
   bool legalizeAnyExt(LegalizerHelper &Helper, MachineRegisterInfo &MRI,
                       MachineInstr &MI) const;
diff --git a/llvm/test/CodeGen/MOS/anyext-masked-byte.ll b/llvm/test/CodeGen/MOS/anyext-masked-byte.ll
new file mode 100644
index 000000000000..e3ba456f0fd6
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/anyext-masked-byte.ll
@@ -0,0 +1,13 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs %s -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs %s -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs %s -o /dev/null
+
+; Legalizing the masked byte store can introduce G_ANYEXT s8 -> s64. The
+; extension must lower even when native-width lanes are enabled.
+define void @extend_masked(ptr %out, i8 %value) {
+  %scaled = mul i8 %value, 7
+  %masked = and i8 %scaled, 63
+  %extended = zext i8 %masked to i64
+  store volatile i64 %extended, ptr %out, align 1
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/anyext-wide.mir b/llvm/test/CodeGen/MOS/anyext-wide.mir
new file mode 100644
index 000000000000..2e99fc2d4029
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/anyext-wide.mir
@@ -0,0 +1,79 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+
+# Wide extensions preserve the source bytes. A shift libcall consumes the low
+# count byte, while a store consumes all bytes of the extended value.
+---
+name: anyext_shift
+body: |
+  bb.0:
+    liveins: $a
+    ; CHECK-LABEL: name: anyext_shift
+    ; CHECK: [[COUNT:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: $rc8 = COPY [[COUNT]](s8)
+    ; CHECK-NEXT: JSR &__ashldi3
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s64) = G_ANYEXT %0
+    %2:_(s64) = G_CONSTANT i64 1
+    %3:_(s64) = G_SHL %2, %1
+    %4:_(p0) = G_CONSTANT i16 512
+    G_STORE %3, %4 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s8_s64_store
+body: |
+  bb.0:
+    liveins: $a
+    ; CHECK-LABEL: name: anyext_s8_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s64) = G_ANYEXT %0
+    %2:_(p0) = G_CONSTANT i16 512
+    G_STORE %1, %2 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s16_s64_store
+body: |
+  bb.0:
+    liveins: $a, $x
+    ; CHECK-LABEL: name: anyext_s16_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: [[HI:%[0-9]+]]:_(s8) = COPY $x
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS [[HI]](s8), 513
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s8) = COPY $x
+    %2:_(s16) = G_MERGE_VALUES %0, %1
+    %3:_(s64) = G_ANYEXT %2
+    %4:_(p0) = G_CONSTANT i16 512
+    G_STORE %3, %4 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s32_s64_store
+body: |
+  bb.0:
+    liveins: $a, $x, $rc2, $rc3
+    ; CHECK-LABEL: name: anyext_s32_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: [[HI:%[0-9]+]]:_(s8) = COPY $rc3
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS [[HI]](s8), 515
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s8) = COPY $x
+    %2:_(s8) = COPY $rc2
+    %3:_(s8) = COPY $rc3
+    %4:_(s32) = G_MERGE_VALUES %0, %1, %2, %3
+    %5:_(s64) = G_ANYEXT %4
+    %6:_(p0) = G_CONSTANT i16 512
+    G_STORE %5, %6 :: (volatile store (s64))
+    RTS
+...
