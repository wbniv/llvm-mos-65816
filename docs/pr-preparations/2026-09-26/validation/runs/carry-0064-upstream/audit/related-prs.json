{"total_count":1,"incomplete_results":false,"items":[{"url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346","repository_url":"https://api.github.com/repos/llvm-mos/llvm-mos","labels_url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346/labels{/name}","comments_url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346/comments","events_url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346/events","html_url":"https://github.com/llvm-mos/llvm-mos/pull/346","id":1889102115,"node_id":"PR_kwDOE3b6385Z8zy0","number":346,"title":"Implement REP/SEP emitting on 65816 targets.","user":{"login":"asiekierka","id":113514,"node_id":"MDQ6VXNlcjExMzUxNA==","avatar_url":"https://avatars.githubusercontent.com/u/113514?v=4","gravatar_id":"","url":"https://api.github.com/users/asiekierka","html_url":"https://github.com/asiekierka","followers_url":"https://api.github.com/users/asiekierka/followers","following_url":"https://api.github.com/users/asiekierka/following{/other_user}","gists_url":"https://api.github.com/users/asiekierka/gists{/gist_id}","starred_url":"https://api.github.com/users/asiekierka/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/asiekierka/subscriptions","organizations_url":"https://api.github.com/users/asiekierka/orgs","repos_url":"https://api.github.com/users/asiekierka/repos","events_url":"https://api.github.com/users/asiekierka/events{/privacy}","received_events_url":"https://api.github.com/users/asiekierka/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2023-09-10T11:09:30Z","updated_at":"2023-09-22T17:20:03Z","closed_at":"2023-09-22T17:20:03Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/llvm-mos/llvm-mos/pulls/346","html_url":"https://github.com/llvm-mos/llvm-mos/pull/346","diff_url":"https://github.com/llvm-mos/llvm-mos/pull/346.diff","patch_url":"https://github.com/llvm-mos/llvm-mos/pull/346.patch","merged_at":null},"body":"Another small step towards proper 65816 support...\r\n\r\nThis adds support for using `REP`/`SEP` instead of `BIT` for clearing/setting the `V` flag on 65816. This saves one byte and up to one cycle per invocation, as well as removes the need for `__set_v`.\r\n\r\nThe PR also provides facilities for modeling any other processor flags on the 65816 using `REP`/`SEP`, should the project choose to model `M` and `X` flags that way.\r\n\r\nAs always, I'm not sure if I'm doing things correctly at all.","reactions":{"url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/llvm-mos/llvm-mos/issues/346/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}