body:             |
  bb.1 (%ir-block.0):
    liveins: $a
  
    %0:_(s8) = COPY $a
    %2:_(p2) = G_GLOBAL_VALUE @table
    %25:_(s8) = G_CONSTANT i8 0
    %29:_(s1) = G_CONSTANT i1 true
    %30:_(s8), %31:_(s1), %32:_, %33:_, %34:_ = G_SBC %0, %25, %29
    %26:_(s1) = COPY %32(s1)
    %27:_(s8) = G_CONSTANT i8 -1
    %28:_(s8) = G_SELECT %26(s1), %27, %25
    %6:_(s32) = G_PTRTOINT %2(p2)
    %35:_(s16), %36:_(s16) = G_UNMERGE_VALUES %6(s32)
    %8:_(s8), %9:_(s8) = G_UNMERGE_VALUES %35(s16)
    %10:_(s8), %11:_(s8) = G_UNMERGE_VALUES %36(s16)
    %24:_(s1) = G_CONSTANT i1 false
    %16:_(s8), %17:_(s1) = G_UADDE %8, %0, %24
    %18:_(s8), %19:_(s1) = G_UADDE %9, %28, %17
    %20:_(s8), %21:_(s1) = G_UADDE %10, %28, %19
    %22:_(s8), %23:_(s1) = G_UADDE %11, %28, %21
    %39:_(s16) = G_MERGE_VALUES %16(s8), %18(s8)
    %40:_(s16) = G_MERGE_VALUES %20(s8), %22(s8)
    %7:_(s32) = G_MERGE_VALUES %39(s16), %40(s16)
    %3:_(p2) = G_INTTOPTR %7(s32)
    %5:_(s8) = G_LOAD_FAR_INDIR %3(p2) :: (volatile load (s8) from %ir.p, addrspace 2)
    $a = COPY %5(s8)
    RTS implicit $a
...
