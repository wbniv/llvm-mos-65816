    G_STORE16_ABS %0(s16), @nearword :: (volatile store (s16) into @nearword, align 1)
    %5:_(s16) = G_ADD %0, %4
    %6:_(s8), %7:_(s8) = G_UNMERGE_VALUES %5(s16)
    $a = COPY %6(s8)
    $x = COPY %7(s8)
    RTS implicit $a, implicit $x
...
