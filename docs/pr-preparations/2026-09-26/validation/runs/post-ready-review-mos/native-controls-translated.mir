--- |
  ; ModuleID = 'build/post-ready-review-mos/native-tests/review-controls.ll'
  source_filename = "build/post-ready-review-mos/native-tests/review-controls.ll"
  target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-p3:24:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
  target triple = "mos"
  
  @table = external addrspace(2) global [131072 x i8]
  @farword = external addrspace(2) global i16
  @nearword = external global i16
  
  declare void @opaque() #0
  
  ; Function Attrs: norecurse
  define i8 @signed_byte_index(i8 %index) #1 {
    %offset = sext i8 %index to i32
    %p = getelementptr i8, ptr addrspace(2) @table, i32 %offset
    %value = load volatile i8, ptr addrspace(2) %p, align 1
    ret i8 %value
  }
  
  ; Function Attrs: norecurse
  define i8 @scaled_wide_index(i16 %index) #1 {
    %wide = zext i16 %index to i32
    %offset = shl nuw nsw i32 %wide, 1
    %p = getelementptr i8, ptr addrspace(2) @table, i32 %offset
    %value = load volatile i8, ptr addrspace(2) %p, align 1
    ret i8 %value
  }
  
  ; Function Attrs: norecurse
  define i16 @far_atomic_return() #1 {
    %value = load atomic i16, ptr addrspace(2) @farword unordered, align 2
    ret i16 %value
  }
  
  ; Function Attrs: norecurse
  define void @far_atomic_store_arg(i16 %value) #1 {
    store atomic i16 %value, ptr addrspace(2) @farword unordered, align 2
    ret void
  }
  
  ; Function Attrs: norecurse
  define void @far_atomic_store_zero() #1 {
    store atomic i16 0, ptr addrspace(2) @farword unordered, align 2
    ret void
  }
  
  ; Function Attrs: norecurse
  define i16 @near_store_decrement(i16 %value) #1 {
    store volatile i16 %value, ptr @nearword, align 1
    %result = add i16 %value, -1
    ret i16 %result
  }
  
  define i16 @near_store_call_increment(i16 %value) #0 {
    store volatile i16 %value, ptr @nearword, align 1
    call void @opaque()
    %result = add i16 %value, 1
    ret i16 %result
  }
  
  ; Function Attrs: norecurse
  define void @volatile_order() #1 {
    %a = load volatile i16, ptr addrspace(2) @farword, align 1
    store volatile i16 %a, ptr @nearword, align 1
    %b = load volatile i16, ptr addrspace(2) @farword, align 1
    store volatile i16 %b, ptr @nearword, align 1
    ret void
  }
  
  attributes #0 = { "target-cpu"="mosw65816" "target-features"="+mos-a16" }
  attributes #1 = { norecurse "nonreentrant" "target-cpu"="mosw65816" "target-features"="+mos-a16" }
...
---
