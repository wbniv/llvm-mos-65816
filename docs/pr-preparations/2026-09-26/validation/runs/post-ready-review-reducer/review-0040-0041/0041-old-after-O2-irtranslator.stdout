--- |
  ; ModuleID = '/home/will/llvm-mos-65816/build/post-ready-review-reducer/review-0040-0041/0041-inline-asm-multi-register.ll'
  source_filename = "/home/will/llvm-mos-65816/build/post-ready-review-reducer/review-0040-0041/0041-inline-asm-multi-register.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
  target triple = "aarch64-unknown-linux-gnu"
  
  define i128 @tied128(i128 %x) {
    %r = call i128 asm "", "=r,0"(i128 %x)
    ret i128 %r
  }
  
  define i128 @out128() {
    %r = call i128 asm "", "=r"()
    ret i128 %r
  }
  
  define i128 @multi_reg_input(i128 %x) {
    %r = call i128 asm sideeffect "/* $0 $1 */", "=&r,r"(i128 %x)
    ret i128 %r
  }
  
  define void @in128(i128 %x) {
    call void asm sideeffect "", "r"(i128 %x)
    ret void
  }
...
