body:             |
  bb.1 (%ir-block.0):
    liveins: $x0, $x1
  
    %1:_(i64) = COPY $x0
    %2:_(i64) = COPY $x1
    %0:_(i128) = G_MERGE_VALUES %1(i64), %2(i64)
    %7:_(i64) = G_TRUNC %0(i128)
    %8:_(i32) = G_TRUNC %7(i64)
    %5:gpr32common = COPY %8(i32)
    %9:_(i64) = G_CONSTANT i64 32
    %10:_(i64) = G_LSHR %7, %9(i64)
    %11:_(i32) = G_TRUNC %10(i64)
    %6:gpr32common = COPY %11(i32)
    INLINEASM &"", attdialect, regdef:GPR32common, def %3, def %4, reguse tiedto:$0, %5(tied-def 3), %6(tied-def 4)
    %13:_(i32) = COPY %3
    %14:_(i32) = COPY %4
    %15:_(i64) = G_MERGE_VALUES %13(i32), %14(i32)
    %12:_(i128) = G_ZEXT %15(i64)
    %16:_(i64), %17:_(i64) = G_UNMERGE_VALUES %12(i128)
    $x0 = COPY %16(i64)
    $x1 = COPY %17(i64)
    RET_ReallyLR implicit $x0, implicit $x1
...
