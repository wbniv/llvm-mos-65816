diff --git a/llvm/tools/llvm-reduce/deltas/Delta.h b/llvm/tools/llvm-reduce/deltas/Delta.h
--- a/llvm/tools/llvm-reduce/deltas/Delta.h
+++ b/llvm/tools/llvm-reduce/deltas/Delta.h
@@ -124,6 +124,9 @@ using ReductionFunc = function_ref<void(Oracle &, ReducerWorkItem &)>;
 /// Other implementations of the Delta Debugging algorithm can also be found in
 /// the CReduce, Delta, and Lithium projects.
 void runDeltaPass(TestRunner &Test, const DeltaPass &Pass);
+
+/// Returns the number of threads requested with -j to process chunks with.
+unsigned getNumChunkProcessingJobs();
 } // namespace llvm
 
 #endif
diff --git a/llvm/tools/llvm-reduce/llvm-reduce.cpp b/llvm/tools/llvm-reduce/llvm-reduce.cpp
--- a/llvm/tools/llvm-reduce/llvm-reduce.cpp
+++ b/llvm/tools/llvm-reduce/llvm-reduce.cpp
@@ -15,6 +15,7 @@
 #include "DeltaManager.h"
 #include "ReducerWorkItem.h"
 #include "TestRunner.h"
+#include "deltas/Delta.h"
 #include "llvm/Bitcode/BitcodeReader.h"
 #include "llvm/CodeGen/CommandFlags.h"
 #include "llvm/Support/CommandLine.h"
@@ -176,6 +177,14 @@ int main(int Argc, char **Argv) {
     return 1;
   }
 
+  // Chunks are handed to worker threads by round tripping the program through
+  // bitcode, which cannot represent MachineFunctions.
+  if (ReduceModeMIR && getNumChunkProcessingJobs() > 1) {
+    WithColor::error(errs(), ToolName)
+        << "-j is not supported for MIR reduction\n";
+    return 1;
+  }
+
   if (!PreserveDebugEnvironment)
     disableEnvironmentDebugFeatures();
 
diff --git a/llvm/test/tools/llvm-reduce/mir/parallel-jobs-valid-input.mir b/llvm/test/tools/llvm-reduce/mir/parallel-jobs-valid-input.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/tools/llvm-reduce/mir/parallel-jobs-valid-input.mir
@@ -0,0 +1,33 @@
+# REQUIRES: thread_support, x86-registered-target
+# RUN: llc -run-pass=none -verify-machineinstrs %s -o /dev/null
+# RUN: llvm-reduce -x=mir -j 1 --delta-passes=instructions --test FileCheck --test-arg --check-prefix=INTERESTING --test-arg %s --test-arg --input-file %s -o %t.serial
+# RUN: FileCheck --check-prefix=SERIAL %s < %t.serial
+# RUN: not llvm-reduce -j 2 --delta-passes=instructions --test FileCheck --test-arg --check-prefix=INTERESTING --test-arg %s --test-arg --input-file %s -o %t.parallel 2>&1 | FileCheck --check-prefix=ERR %s
+# RUN: not llvm-reduce -x=mir -j 4 --delta-passes=instructions --test FileCheck --test-arg --check-prefix=INTERESTING --test-arg %s --test-arg --input-file %s -o %t.parallel 2>&1 | FileCheck --check-prefix=ERR %s
+# RUN: llvm-reduce --abort-on-invalid-reduction -j 2 %S/../operands-skip.ll -o %t.ir --delta-passes=operands-skip --test FileCheck --test-arg %S/../operands-skip.ll --test-arg --match-full-lines --test-arg --check-prefix=INTERESTING --test-arg --input-file
+# RUN: FileCheck %S/../operands-skip.ll --input-file %t.ir --check-prefix=REDUCED
+
+# The MIR is valid and interesting for instruction reduction with one worker.
+# Parallel chunk transport cannot represent MachineFunctions; both inferred and
+# explicit MIR input modes must reject multiple workers before starting work.
+# Parallel IR reduction remains supported.
+# INTERESTING: MOV32ri 2
+# SERIAL: MOV32ri 2
+# SERIAL: RET
+# ERR: {{.*}}llvm-reduce{{.*}}: -j is not supported for MIR reduction
+
+--- |
+  target triple = "x86_64"
+  define i32 @parallel_instr_reduce() { ret i32 0 }
+...
+---
+name: parallel_instr_reduce
+tracksRegLiveness: true
+body: |
+  bb.0:
+    %0:gr32 = MOV32ri 1
+    %1:gr32 = MOV32ri 2
+    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
+    $eax = COPY %2
+    RET 0, implicit $eax
+...
