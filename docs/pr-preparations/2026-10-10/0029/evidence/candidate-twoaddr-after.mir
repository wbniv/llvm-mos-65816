body:             |
  bb.0 (%ir-block.0):
    liveins: $a, $x, $rs1
  
    %0:imag16 = COPY $rs1
    %97:ac = COPY $a
    %78:ac = COPY $x
    %32:yc = LDImm 0
    %38:yc = LDImm 1
    %55:cc = LDImm1 0
    %100:cc = LDImm1 0
    %97:ac, %100:cc, dead %119:vc = ADCIndirIdx %97, %0, %32, %100
    %78:ac, dead %100:cc, dead %117:vc = ADCIndirIdx %78, %0, %38, %100
    %99:imag8 = COPY %78
    %89:ac = COPY %0.sublo
    %91:ac = COPY %0.subhi
    %39:yc = LDImm 2
    %92:cc = LDImm1 0
    %89:ac, %92:cc, dead %116:vc = ADCImm %89, 2, %92
    %91:ac, dead %92:cc, dead %115:vc = ADCImm %91, 0, %92
    undef %84.sublo:imag16 = COPY %89
    %84.subhi:imag16 = COPY %91
    %56:ac = COPY %97
    %56:ac = EORIndirIdx %56, %0, %39 :: (load (s8) from %ir.p1)
    %78:ac = EORIndirIdx %78, %84, %38 :: (load (s8) from %ir.p1 + 1)
    %30:yc = LDImm 4
    %112:cc = LDCImm 0
    %29:ac = COPY %56
    %29:ac, dead %112:cc, dead %113:vc = ADCIndirIdx %29, %0, %30, %112 :: (load (s8) from %ir.p2)
    ADJCALLSTACKDOWN 0, 0, implicit-def $rs0, implicit $rs0
    $a = COPY %97
    $x = COPY %99
    %19:gpr = LDImm 25
    $rc2 = COPY %19
    %20:gpr = LDImm 54
    $rc3 = COPY %20
    JSR @ext, mos_csr, implicit $a, implicit $x, implicit $rc2, implicit $rc3, implicit-def $a, implicit-def $x
    %21:imag8 = COPY $a
    %22:imag8 = COPY $x
    ADJCALLSTACKUP 0, 0, implicit-def $rs0, implicit $rs0
    %69:ac = COPY %56
    %69:ac, %70:cc, dead %109:vc = ADCImag8 %69, %21, %55
    %71:ac = COPY %78
    %71:ac, dead %72:cc, dead %107:vc = ADCImag8 %71, %22, %70
    STIndirIdx %69, %0, %32 :: (store (s8) into %ir.p)
    STIndirIdx %71, %0, %38 :: (store (s8) into %ir.p + 1)
    %51:cc = LDImm1 -1
    %106:imag8 = COPY %29
    %56:ac, %51:cc, dead %59:vc = SBCImag8 %56, %106, %51
    %78:ac, dead %51:cc, dead %53:vc = SBCImm %78, 0, %51
    STIndirIdx %56, %0, %39 :: (store (s8) into %ir.p1)
    STIndirIdx %78, %84, %38 :: (store (s8) into %ir.p1 + 1)
    %29:ac = EORImag8 %29, %99
    STIndirIdx %29, %0, %30 :: (store (s8) into %ir.p2)
    RTS
...
