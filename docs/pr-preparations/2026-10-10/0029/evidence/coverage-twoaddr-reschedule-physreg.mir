# RUN: llc -mtriple=mos -mcpu=mos6502 -run-pass=twoaddressinstruction -verify-machineinstrs -o - %s | FileCheck %s --check-prefixes=CHECK,NOSCHED
# RUN: llc -mtriple=mos -mcpu=mos6502 -run-pass=liveintervals,twoaddressinstruction -verify-machineinstrs -o %t.mir %s
# RUN: FileCheck %s --check-prefixes=CHECK,LI < %t.mir
# RUN: llc -mtriple=mos -mcpu=mos6502 -start-after=twoaddressinstruction -verify-machineinstrs -o /dev/null %t.mir

# Rescheduling requires LiveIntervals. Without that analysis, the pass keeps
# the instruction order. With it, a call argument must leave A available for
# the folded arithmetic.
---
name: accumulator_argument
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $rs1, $y

    ; CHECK-LABEL: name: accumulator_argument
    ; CHECK: EORIndirIdx
    ; CHECK: STAbs
    ; CHECK: $a = COPY
    ; CHECK-NEXT: JSR
    %0:ac = COPY $a
    %1:imag16 = COPY $rs1
    %2:yc = COPY $y
    %3:ac = EORIndirIdx %0, %1, %2
    STAbs killed %3, 1234
    $a = COPY killed %0
    JSR &ext, mos_csr, implicit $a
    RTS
...

# A copy into X can move across arithmetic that only needs A and Y. A GPR
# temporary still has A and Y available even though its class also contains X.
---
name: available_accumulator
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $rs1, $y

    ; CHECK-LABEL: name: available_accumulator
    ; NOSCHED: EORIndirIdx
    ; NOSCHED: STAbs
    ; NOSCHED: $x = COPY
    ; LI: $x = COPY
    ; LI: EORIndirIdx
    ; LI: STAbs
    ; CHECK: JSR
    %0:ac = COPY $a
    %1:imag16 = COPY $rs1
    %2:yc = COPY $y
    %3:ac = EORIndirIdx %0, %1, %2
    STAbs killed %3, 1234
    %4:gpr = LDImm 42
    $rc2 = COPY killed %4
    $x = COPY killed %0
    JSR &ext, mos_csr, implicit $x, implicit $rc2
    RTS
...

# Every crossed instruction must have an available register, including the
# indexed store between the folded arithmetic and the call argument copy.
---
name: intervening_index
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $rs1

    ; CHECK-LABEL: name: intervening_index
    ; CHECK: EORAbs
    ; CHECK: STIndirIdx
    ; CHECK: $y = COPY
    ; CHECK-NEXT: JSR
    %0:ac = COPY $a
    %1:imag16 = COPY $rs1
    %2:ac = EORAbs %0, 1234
    %3:yc = LDImm 4
    STIndirIdx killed %2, %1, killed %3
    $y = COPY killed %0
    JSR &ext, mos_csr, implicit $y
    RTS
...
