diff --git a/test/README.md b/test/README.md
index 9d5d63a..90b6687 100644
--- a/test/README.md
+++ b/test/README.md
@@ -22,3 +22,16 @@ How to report results from a test case:
 * Call `test_set_result(bool)` with a pass/fail value, and then go into a busy loop or video display loop, or
 * Exit from `main()` with a status code -- zero for success, non-zero for failure, or
 * Set the `EMUTEST_FB_CRC_PASS` variable to the CRC of a known good video frame (you can find these in the test log files.)
+
+## Simulator tests
+
+`cmake --build <build-dir> --target test-sim` builds the SDK and `mos-sim`, then
+builds and runs the CTest tests in `test/sim`. Tests return zero for success and
+nonzero for failure. These tests require no Libretro core.
+
+When changing SDK libraries in an existing build, clean the test executables first:
+`cmake --build <build-dir>/test/sim/build --target clean`. The platform configuration
+selects libraries implicitly, so the test build does not track their archive timestamps.
+
+The setjmp tests cover zero normalization and preservation of nonzero 16-bit
+values at four optimization levels.
diff --git a/test/sim/CMakeLists.txt b/test/sim/CMakeLists.txt
new file mode 100644
index 0000000..c95af34
--- /dev/null
+++ b/test/sim/CMakeLists.txt
@@ -0,0 +1,16 @@
+cmake_minimum_required(VERSION 3.18)
+
+project(test-sim LANGUAGES C)
+
+include(CTest)
+
+foreach(opt IN ITEMS O0 O1 O2 Os)
+  foreach(value IN ITEMS 0 1 7 256 -1)
+    set(name setjmp-${opt}-${value})
+    add_executable(${name} setjmp.c)
+    target_compile_options(${name} PRIVATE -${opt})
+    target_compile_definitions(${name} PRIVATE JUMP_VALUE=${value})
+    add_test(NAME ${name} COMMAND ${MOS_SIM_COMMAND} $<TARGET_FILE:${name}>)
+    set_tests_properties(${name} PROPERTIES TIMEOUT 10)
+  endforeach()
+endforeach()
diff --git a/test/sim/setjmp.c b/test/sim/setjmp.c
new file mode 100644
index 0000000..3ba437c
--- /dev/null
+++ b/test/sim/setjmp.c
@@ -0,0 +1,18 @@
+#include <setjmp.h>
+
+#define EXPECTED_VALUE (JUMP_VALUE == 0 ? 1 : JUMP_VALUE)
+
+static jmp_buf env;
+static volatile unsigned char jumped;
+
+// Zero must become one; every nonzero 16-bit return value must be preserved.
+// Static state distinguishes the initial return from the non-local return.
+int main(void) {
+  if (setjmp(env) == EXPECTED_VALUE)
+    return jumped ? 0 : 44;
+  if (jumped)
+    return 42;
+  jumped = 1;
+  longjmp(env, JUMP_VALUE);
+  return 43;
+}
