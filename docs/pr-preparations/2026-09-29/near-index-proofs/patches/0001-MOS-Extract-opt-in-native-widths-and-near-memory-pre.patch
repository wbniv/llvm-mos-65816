+          .add(MI.getOperand(0))
+          .addUse(Addr)
+          .addUse(Idx)
+          .addMemOperand(*MI.memoperands_begin());
+      MI.eraseFromParent();
+      return true;
+    }
+    return false;
+  }
+  return false;
+}
