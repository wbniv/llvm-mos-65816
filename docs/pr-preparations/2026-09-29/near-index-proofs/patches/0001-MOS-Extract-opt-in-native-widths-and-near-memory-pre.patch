 void MOSAsmPrinter::emitInstruction(const MachineInstr *MI) {
+  // Keep each 16-bit Y load adjacent to its access through allocation and
+  // width insertion. Both accumulator widths use an Imag16 index operand.
+  unsigned IndexedOpcode = 0;
+  switch (MI->getOpcode()) {
+  case MOS::LDIndirYIdxFused:
+  case MOS::LDIndirYIdx16Fused:
+    IndexedOpcode = MOS::LDA_IndirectIndexed;
+    break;
+  case MOS::STIndirYIdxFused:
+  case MOS::STIndirYIdx16Fused:
+    IndexedOpcode = MOS::STA_IndirectIndexed;
+    break;
+  }
+  if (IndexedOpcode) {
+    MCOperand Idx, Addr;
+    lowerOperand(MI->getOperand(2), Idx);
+    lowerOperand(MI->getOperand(1), Addr);
+    MCInst LdY;
+    LdY.setOpcode(MOS::LDY_ZeroPage);
+    LdY.addOperand(Idx);
+    EmitToStreamer(*OutStreamer, LdY);
+    MCInst Mem;
+    Mem.setOpcode(IndexedOpcode);
+    Mem.addOperand(Addr);
+    EmitToStreamer(*OutStreamer, Mem);
+    return;
+  }
+
   // Do any auto-generated pseudo lowerings.
   if (MCInst OutInst; lowerPseudoInstExpansion(MI, OutInst)) {
     EmitToStreamer(*OutStreamer, OutInst);
