     const TargetRegisterClass *DstRC, unsigned DstSubReg,
     const TargetRegisterClass *NewRC, LiveIntervals &LIS) const {
   const auto &MRI = MI->getMF()->getRegInfo();
 
+  // Don't fold a value read straight out of a call-clobbered imaginary register
+  // ($rcN, via `vreg = COPY $rcN`) into an imaginary-register *pair* (a sub-register
+  // copy that builds an Imag16) when that value outlives the clobbering call. The
+  // pair inherits the physical-$rcN allocation hint and the allocator re-binds it to
+  // $rcN across the clobber, producing a disconnected def->use the MachineVerifier
+  // rejects ("Using an undefined physical register") — a latent miscompile hazard.
+  // Refusing keeps the COPY so the value gets its own spillable vreg.
+  //
+  // Narrowly gated to stay inert on the common case: it requires (1) a *direct*
+  // `vreg = COPY $rcN` read (unique def), (2) that vreg genuinely live across a call
+  // clobbering $rcN, and (3) a sub-register copy into an Imag16 pair — the exact shape
+  // that re-creates the re-bindable hint. It only ever keeps an extra COPY, never
+  // changing correctness. Pure virtual values without a physical-register COPY
+  // do not satisfy this guard; their call-clobber constraints belong to allocation.
+  if (NewRC == &MOS::Imag16RegClass && (DstSubReg || SubReg)) {
+    if (copiedFromClobberedPhysImag(MI->getOperand(0).getReg(), MRI, LIS) ||
+        copiedFromClobberedPhysImag(MI->getOperand(1).getReg(), MRI, LIS))
+      return false;
+  }
+
   // Don't coalesce Imag8 and AImag8 registers together when used by shifts or
   // rotates.  This may cause expensive ASL zp's to be used when ASL A would
   // have sufficed. It's better to do arithmetic in A and then copy it out.
diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.h b/llvm/lib/Target/MOS/MOSRegisterInfo.h
index 1d2f8027e01c..4374d26d8f55 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.h
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.h
@@ -77,6 +77,15 @@ public:
   void expandAddrHistk(MachineBasicBlock::iterator MI) const;
   void expandLDSTStk(MachineBasicBlock::iterator MI) const;
 
+private:
+  // The body of expandLDSTStk. expandLDSTStk itself is a thin wrapper that
+  // brackets this with an A16 save/restore when the expansion would clobber a
+  // live accumulator (see its comment); the recursive splits below re-enter
+  // through the wrapper so each split gets the same treatment.
+  void expandLDSTStkImpl(MachineBasicBlock::iterator MI) const;
+
+public:
+
   Register getFrameRegister(const MachineFunction &MF) const override;
 
   bool shouldCoalesce(MachineInstr *MI, const TargetRegisterClass *SrcRC,
diff --git a/llvm/lib/Target/MOS/MOSRegisterInfo.td b/llvm/lib/Target/MOS/MOSRegisterInfo.td
index 5d4b239d1f3d..e64c0860e596 100644
--- a/llvm/lib/Target/MOS/MOSRegisterInfo.td
+++ b/llvm/lib/Target/MOS/MOSRegisterInfo.td
@@ -111,6 +111,28 @@ def P : MOSReg<3, "P"> {
   let SubRegIndices = [subcarry, subnz, subv];
 }
 
+// Native registers alias their byte halves for allocation and liveness. The
+// full registers use the MOS DWARF native-mode numbers. Internal high-byte
+// pieces have no standalone DWARF location.
+def B : MOSReg<0, "b"> { let DwarfNumbers = [-1]; }
+def A16 : MOSReg<0x01000000, "a16"> {
+  let SubRegs = [A, B];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+def XH : MOSReg<0, "xh"> { let DwarfNumbers = [-1]; }
+def YH : MOSReg<0, "yh"> { let DwarfNumbers = [-1]; }
+def X16 : MOSReg<0x01000001, "x16"> {
+  let SubRegs = [X, XH];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+def Y16 : MOSReg<0x01000002, "y16"> {
+  let SubRegs = [Y, YH];
+  let SubRegIndices = [sublo, subhi];
+  let CoveredBySubRegs = 1;
+}
+
 //===----------------------------------------------------------------------===//
 //  Imaginary registers
 //===----------------------------------------------------------------------===//
@@ -212,6 +234,16 @@ let isPressureFineGrained = true in {
 def Imag8 : MOSReg8Class<(sequence "RC%u", 0, !add(MaxImag8Regs, -1))>;
 def Imag16 : MOSReg16Class<(sequence "RS%u", 0, !add(MaxImag16Regs, -1))>;
 
+// Native widths: the 16-bit accumulator as a register class (single member,
+// A16 = B:A — NOT the carry flag C). Target of 16-bit-accumulator load/add/store
+// under +mos-a16. Named Ac16 to parallel the 8-bit accumulator class `Ac`.
+def Ac16 : MOSReg16Class<(add A16)>;
+
+// Native indices: 16-bit index register classes, one member each. Used only under
+// +mos-xy16; inert otherwise. Mirror Ac16.
+def Xc16 : MOSReg16Class<(add X16)>;
+def Yc16 : MOSReg16Class<(add Y16)>;
+
 // Instruction-specific register classes.
 def AImag8 : MOSReg8Class<(add Imag8, A)>;
 let isPressureFineGrained = true in {
