diff --git a/llvm/test/CodeGen/MOS/a16-byte-store.ll b/llvm/test/CodeGen/MOS/a16-byte-store.ll
new file mode 100644
index 000000000000..d9c2a64528c6
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-byte-store.ll
@@ -0,0 +1,161 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+
+@g = global i16 0, align 1
+@h = global i16 0, align 1
+
+declare i16 @produce()
+
+; The ABI supplies an i16 argument in A:X. Absolute byte stores can consume
+; those registers directly when no native-width consumer needs the value.
+define void @store_arg(i16 %value) {
+; BYTE-LABEL: store_arg:
+; BYTE-NEXT: ; %bb.0:
+; BYTE-NEXT: sta g
+; BYTE-NEXT: stx g+1
+; BYTE-NEXT: rts
+  store i16 %value, ptr @g, align 1
+  ret void
+}
+
+define i16 @store_return(i16 %value) {
+; BYTE-LABEL: store_return:
+; BYTE-NEXT: ; %bb.0:
+; BYTE-NEXT: sta g
+; BYTE-NEXT: stx g+1
+; BYTE-NEXT: rts
+  store volatile i16 %value, ptr @g, align 1
+  ret i16 %value
+}
+
+define void @store_twice(i16 %value) {
+; BYTE-LABEL: store_twice:
+; BYTE-NOT: rep
+; BYTE-NOT: __rc
+; BYTE-DAG: sta g
+; BYTE-DAG: stx g+1
+; BYTE-DAG: sta h
+; BYTE-DAG: stx h+1
+; BYTE-NEXT: rts
+  store volatile i16 %value, ptr @g, align 1
+  store volatile i16 %value, ptr @h, align 1
+  ret void
+}
+
+; Call results use the same byte-register ABI as arguments.
+define void @store_call() {
+; BYTE-LABEL: store_call:
+; BYTE-NEXT: ; %bb.0:
+; BYTE-NEXT: jsr produce
+; BYTE-NEXT: sta g
+; BYTE-NEXT: stx g+1
+; BYTE-NEXT: rts
+  %value = call i16 @produce()
+  store i16 %value, ptr @g, align 1
+  ret void
+}
+
+; Native producers retain a native store so the value stays in the wide path.
+define void @store_add(i16 %value) {
+; NATIVE-LABEL: store_add:
+; NATIVE: rep #32
+; NATIVE: adc #mos16(42)
+; NATIVE-NEXT: sta g
+; NATIVE-NEXT: sep #32
+; NATIVE-NEXT: rts
+; DEFAULT-LABEL: store_add:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  %sum = add i16 %value, 42
+  store i16 %sum, ptr @g, align 1
+  ret void
+}
+
+define void @store_copy() {
+; NATIVE-LABEL: store_copy:
+; NATIVE: rep #[[WIDTH:(16|32)]]
+; NATIVE-NEXT: ld{{[axy]}} h
+; NATIVE-NEXT: st{{[axy]}} g
+; NATIVE-NEXT: sep #[[WIDTH]]
+; NATIVE-NEXT: rts
+; DEFAULT-LABEL: store_copy:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  %value = load volatile i16, ptr @h, align 1
+  store volatile i16 %value, ptr @g, align 1
+  ret void
+}
+
+; A byte-built argument with a native arithmetic use already needs Imag16.
+define i16 @store_mixed(i16 %value) {
+; NATIVE-LABEL: store_mixed:
+; NATIVE: rep #32
+; NATIVE: sta g
+; NATIVE: inc
+; NATIVE: sep #32
+; NATIVE: rts
+; DEFAULT-LABEL: store_mixed:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  store i16 %value, ptr @g, align 1
+  %sum = add i16 %value, 1
+  ret i16 %sum
+}
+
+; A value live across a call needs preserved storage. One native reload and store
+; can consume that pair without two separate byte reloads.
+declare void @opaque()
+define void @store_across_call(i16 %value) {
+; NATIVE-LABEL: store_across_call:
+; NATIVE: jsr opaque
+; NATIVE-NEXT: rep #32
+; NATIVE-NEXT: lda __rc20
+; NATIVE-NEXT: sta g
+; NATIVE-NEXT: sep #32
+; NATIVE: rts
+; DEFAULT-LABEL: store_across_call:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  call void @opaque()
+  store volatile i16 %value, ptr @g, align 1
+  ret void
+}
+
+; The argument can cross a call along one predecessor of the store block.
+define void @store_cross_block(i16 %value, i1 %condition) {
+; NATIVE-LABEL: store_cross_block:
+; NATIVE: jsr opaque
+; NATIVE: rep #32
+; NATIVE-NEXT: lda __rc20
+; NATIVE-NEXT: sta g
+; NATIVE-NEXT: sep #32
+; NATIVE: rts
+; DEFAULT-LABEL: store_cross_block:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  br i1 %condition, label %call, label %store
+call:
+  call void @opaque()
+  br label %store
+store:
+  store volatile i16 %value, ptr @g, align 1
+  ret void
+}
+
+; Clobbering inline assembly can require the same preservation as a call.
+define void @store_across_asm(i16 %value) {
+; NATIVE-LABEL: store_across_asm:
+; NATIVE: ;APP
+; NATIVE: ;NO_APP
+; NATIVE: rep #32
+; NATIVE: sta g
+; NATIVE: sep #32
+; NATIVE: rts
+; DEFAULT-LABEL: store_across_asm:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  call void asm sideeffect "", "~{a},~{x},~{y}"()
+  store volatile i16 %value, ptr @g, align 1
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/a16-immediate-width.ll b/llvm/test/CodeGen/MOS/a16-immediate-width.ll
new file mode 100644
index 000000000000..6edf13521a41
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-immediate-width.ll
@@ -0,0 +1,65 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+
+; Under +mos-a16 the accumulator is 16 bits, so these immediates are three-byte
+; Immediate16 forms. The assembler has no notion of the M flag, so a bare
+; `adc #66` re-parses as the two-byte 8-bit form -- and with M=0 the processor
+; then eats the next opcode as the immediate's high byte, desynchronising the
+; instruction stream. Anything that could fit an 8-bit immediate therefore has
+; to be printed with an explicit mos16() width.
+;
+; This has to be checked here rather than in an MC round-trip test: the
+; assembler cannot build an Immediate16 MCInst holding a plain small immediate
+; (its text always matches Imm8 first), and the disassembler wraps the operand
+; itself, so codegen is the only producer of the unmarked form.
+
+@g16 = global i16 48879
+
+define void @add_small(ptr %p) {
+; CHECK-LABEL: add_small:
+; CHECK:      rep #32
+; CHECK:      adc #mos16(66)
+; CHECK:      sep #32
+  %v = load i16, ptr @g16
+  %r = add i16 %v, 66
+  store i16 %r, ptr %p
+  ret void
+}
+
+; A value that cannot fit an 8-bit immediate already states its own width, so
+; it stays bare and ordinary 16-bit assembly does not grow a wrapper.
+define void @add_wide(ptr %p) {
+; CHECK-LABEL: add_wide:
+; CHECK:      adc #43981
+; CHECK-NOT:  mos16
+  %v = load i16, ptr @g16
+  %r = add i16 %v, 43981
+  store i16 %r, ptr %p
+  ret void
+}
+
+; The boundary: 255 is the largest value an 8-bit immediate can hold, so it is
+; still ambiguous and still has to be marked.
+define void @eor_boundary(ptr %p) {
+; CHECK-LABEL: eor_boundary:
+; CHECK:      eor #mos16(255)
+  %v = load i16, ptr @g16
+  %r = xor i16 %v, 255
+  store i16 %r, ptr %p
+  ret void
+}
+
+; A 16-bit compare is the same shape; and the 8-bit immediates the same
+; function emits once M is back to 1 must NOT be marked -- they are genuine
+; two-byte operands, not narrowed 16-bit ones.
+define i8 @cmp_small() {
+; CHECK-LABEL: cmp_small:
+; CHECK:      cmp #mos16(5)
+; CHECK:      sep #32
+; CHECK-NEXT: lda #0
+; CHECK:      sep #32
+; CHECK-NEXT: lda #1
+  %v = load i16, ptr @g16
+  %c = icmp ult i16 %v, 5
+  %r = zext i1 %c to i8
+  ret i8 %r
+}
diff --git a/llvm/test/CodeGen/MOS/a16-indirect-byte-store.ll b/llvm/test/CodeGen/MOS/a16-indirect-byte-store.ll
new file mode 100644
index 000000000000..91b7adc661cd
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-indirect-byte-store.ll
@@ -0,0 +1,187 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,DEFAULT
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=BYTE,NATIVE
+
+@g = global i16 0, align 2
+@h = global i16 0, align 1
+declare void @opaque()
+
+; The pointer already occupies an imaginary pair, while the value arrives in A:X.
+; A single indirect store can use those bytes directly in the ambient M8/X8 mode.
+define void @store_indirect(ptr %p, i16 %value) {
+; BYTE-LABEL: store_indirect:
+; BYTE-NEXT: ; %bb.0:
+; BYTE-NEXT: sta (__rc2)
+; BYTE-NEXT: ldy #1
+; BYTE-NEXT: txa
+; BYTE-NEXT: sta (__rc2),y
+; BYTE-NEXT: rts
+  store i16 %value, ptr %p, align 1
+  ret void
+}
+
+; Volatile stores preserve both bytes and their low-to-high order.
+define void @store_volatile(ptr %p, i16 %value) {
+; BYTE-LABEL: store_volatile:
+; BYTE-NEXT: ; %bb.0:
+; BYTE-NEXT: sta (__rc2)
+; BYTE-NEXT: ldy #1
+; BYTE-NEXT: txa
+; BYTE-NEXT: sta (__rc2),y
+; BYTE-NEXT: rts
+  store volatile i16 %value, ptr %p, align 1
+  ret void
+}
+
+; The byte-valued return also consumes the original low byte after the stores.
+define i16 @store_and_return(ptr %p, i16 %value) {
+; BYTE-LABEL: store_and_return:
+; BYTE-NOT: rep
+; BYTE: sta (__rc2)
+; BYTE: sta (__rc2),y
+; BYTE: lda __rc4
+; BYTE-NEXT: rts
+  store volatile i16 %value, ptr %p, align 1
+  ret i16 %value
+}
+
+; Sharing the value across stores changes its register and reload costs.
+define void @store_twice(ptr %p, ptr %q, i16 %value) {
+; NATIVE-LABEL: store_twice:
+; NATIVE: rep #32
+; NATIVE: sta (__rc2)
+; NATIVE: sta (__rc4)
+; NATIVE: sep #32
+; DEFAULT-LABEL: store_twice:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  store volatile i16 %value, ptr %p, align 1
+  store volatile i16 %value, ptr %q, align 1
+  ret void
+}
+
+define void @store_absolute_and_indirect(ptr %p, i16 %value) {
+; NATIVE-LABEL: store_absolute_and_indirect:
+; NATIVE: rep #32
+; NATIVE: sta (__rc2)
+; NATIVE: sta g
+; NATIVE: sep #32
+; DEFAULT-LABEL: store_absolute_and_indirect:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  store i16 %value, ptr %p, align 1
+  store volatile i16 %value, ptr @g, align 1
+  ret void
+}
+
+; A non-wrapping offset retains its indexed native-width store.
+define void @store_offset(ptr %p, i16 %value) {
+; NATIVE-LABEL: store_offset:
+; NATIVE: rep #32
+; NATIVE: sta (__rc2),y
+; NATIVE: sep #32
+; DEFAULT-LABEL: store_offset:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  %q = getelementptr nuw i16, ptr %p, i16 1
+  store i16 %value, ptr %q, align 1
+  ret void
+}
+
+; A native producer can feed the wide store without splitting its result.
+define void @store_computed(ptr %p, i16 %value) {
+; NATIVE-LABEL: store_computed:
+; NATIVE: rep #32
+; NATIVE: adc #mos16(42)
+; NATIVE-NEXT: sta (__rc2)
+; NATIVE-NEXT: sep #32
+; DEFAULT-LABEL: store_computed:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  %sum = add i16 %value, 42
+  store i16 %sum, ptr %p, align 1
+  ret void
+}
+
+; Intervening arithmetic changes both A:X residency and the current width.
+define void @store_native_context(ptr %p, i16 %value) {
+; NATIVE-LABEL: store_native_context:
+; NATIVE: rep #32
+; NATIVE: adc #mos16(42)
+; NATIVE: sta (__rc2)
+; NATIVE-NEXT: sep #32
+; DEFAULT-LABEL: store_native_context:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  %old = load volatile i16, ptr @h, align 1
+  %sum = add i16 %old, 42
+  store volatile i16 %sum, ptr @h, align 1
+  store i16 %value, ptr %p, align 1
+  ret void
+}
+
+; A call requires the argument to survive in preserved storage.
+define void @store_across_call(ptr %p, i16 %value) {
+; NATIVE-LABEL: store_across_call:
+; NATIVE: jsr opaque
+; NATIVE: rep #32
+; NATIVE: sta (__rc{{[0-9]+}})
+; NATIVE: sep #32
+; DEFAULT-LABEL: store_across_call:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  call void @opaque()
+  store i16 %value, ptr %p, align 1
+  ret void
+}
+
+; Later arguments already reside in imaginary registers and favor a wide load.
+define void @store_later_argument(ptr %p, i16 %first, i16 %value) {
+; NATIVE-LABEL: store_later_argument:
+; NATIVE: rep #32
+; NATIVE: sta (__rc2)
+; NATIVE: sep #32
+; DEFAULT-LABEL: store_later_argument:
+; DEFAULT-NOT: rep
+; DEFAULT: rts
+  store i16 %value, ptr %p, align 1
+  store volatile i16 %first, ptr @g, align 1
+  ret void
+}
+
+; Atomic word stores require the native single-instruction memory access. The
+; function attribute enables that path even in the default-feature RUN above.
+define void @store_atomic(ptr %p, i16 %value) #0 {
+; BYTE-LABEL: store_atomic:
+; BYTE: rep #32
+; BYTE: sta (__rc2)
+; BYTE-NEXT: sep #32
+; BYTE-NEXT: rts
+  store atomic i16 %value, ptr %p unordered, align 2
+  ret void
+}
+
+; The same atomic contract applies to absolute stores and shared values.
+define void @store_atomic_absolute(i16 %value) #0 {
+; BYTE-LABEL: store_atomic_absolute:
+; BYTE: rep #32
+; BYTE: sta g
+; BYTE-NEXT: sep #32
+; BYTE-NEXT: rts
+  store atomic i16 %value, ptr @g unordered, align 2
+  ret void
+}
+
+define void @store_atomic_shared(i16 %value) #0 {
+; BYTE-LABEL: store_atomic_shared:
+; BYTE: rep #32
+; BYTE: sta g
+; BYTE: sta h
+; BYTE-NEXT: sep #32
+; BYTE-NEXT: rts
+  store atomic i16 %value, ptr @g unordered, align 2
+  store volatile i16 %value, ptr @h, align 1
+  ret void
+}
+
+attributes #0 = { "target-features"="+mos-a16" }
diff --git a/llvm/test/CodeGen/MOS/anyext-masked-byte.ll b/llvm/test/CodeGen/MOS/anyext-masked-byte.ll
new file mode 100644
index 000000000000..e3ba456f0fd6
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/anyext-masked-byte.ll
@@ -0,0 +1,13 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs %s -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -O2 -verify-machineinstrs %s -o /dev/null
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -O2 -verify-machineinstrs %s -o /dev/null
+
+; Legalizing the masked byte store can introduce G_ANYEXT s8 -> s64. The
+; extension must lower even when native-width lanes are enabled.
+define void @extend_masked(ptr %out, i8 %value) {
+  %scaled = mul i8 %value, 7
+  %masked = and i8 %scaled, 63
+  %extended = zext i8 %masked to i64
+  store volatile i64 %extended, ptr %out, align 1
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/anyext-wide.mir b/llvm/test/CodeGen/MOS/anyext-wide.mir
new file mode 100644
index 000000000000..2e99fc2d4029
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/anyext-wide.mir
@@ -0,0 +1,79 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --implicit-check-not=G_ANYEXT
+
+# Wide extensions preserve the source bytes. A shift libcall consumes the low
+# count byte, while a store consumes all bytes of the extended value.
+---
+name: anyext_shift
+body: |
+  bb.0:
+    liveins: $a
+    ; CHECK-LABEL: name: anyext_shift
+    ; CHECK: [[COUNT:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: $rc8 = COPY [[COUNT]](s8)
+    ; CHECK-NEXT: JSR &__ashldi3
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s64) = G_ANYEXT %0
+    %2:_(s64) = G_CONSTANT i64 1
+    %3:_(s64) = G_SHL %2, %1
+    %4:_(p0) = G_CONSTANT i16 512
+    G_STORE %3, %4 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s8_s64_store
+body: |
+  bb.0:
+    liveins: $a
+    ; CHECK-LABEL: name: anyext_s8_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s64) = G_ANYEXT %0
+    %2:_(p0) = G_CONSTANT i16 512
+    G_STORE %1, %2 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s16_s64_store
+body: |
+  bb.0:
+    liveins: $a, $x
+    ; CHECK-LABEL: name: anyext_s16_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: [[HI:%[0-9]+]]:_(s8) = COPY $x
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS [[HI]](s8), 513
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s8) = COPY $x
+    %2:_(s16) = G_MERGE_VALUES %0, %1
+    %3:_(s64) = G_ANYEXT %2
+    %4:_(p0) = G_CONSTANT i16 512
+    G_STORE %3, %4 :: (volatile store (s64))
+    RTS
+...
+---
+name: anyext_s32_s64_store
+body: |
+  bb.0:
+    liveins: $a, $x, $rc2, $rc3
+    ; CHECK-LABEL: name: anyext_s32_s64_store
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = COPY $a
+    ; CHECK: [[HI:%[0-9]+]]:_(s8) = COPY $rc3
+    ; CHECK: G_STORE_ABS [[LO]](s8), 512
+    ; CHECK: G_STORE_ABS [[HI]](s8), 515
+    ; CHECK: G_STORE_ABS {{.*}}, 519
+    %0:_(s8) = COPY $a
+    %1:_(s8) = COPY $x
+    %2:_(s8) = COPY $rc2
+    %3:_(s8) = COPY $rc3
+    %4:_(s32) = G_MERGE_VALUES %0, %1, %2, %3
+    %5:_(s64) = G_ANYEXT %4
+    %6:_(p0) = G_CONSTANT i16 512
+    G_STORE %5, %6 :: (volatile store (s64))
+    RTS
+...
diff --git a/llvm/test/CodeGen/MOS/insert-rep-sep-cloned-kills.mir b/llvm/test/CodeGen/MOS/insert-rep-sep-cloned-kills.mir
new file mode 100644
index 000000000000..f193abc81071
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/insert-rep-sep-cloned-kills.mir
@@ -0,0 +1,160 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=mos-insert-rep-sep -verify-machineinstrs %s -o - | FileCheck %s
+
+---
+name:            restore_x16_preserves_value
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    liveins: $rs1
+
+    ; Each narrowing preserves X itself; the killed load source stays dead.
+    ; CHECK-LABEL: name: restore_x16_preserves_value
+    ; CHECK: $x16 = LDXImag16 killed $rs1
+    ; CHECK-NEXT: PHX_Implied implicit $x16
+    ; CHECK-NEXT: SEP_Immediate 16
+    ; CHECK-NEXT: $y = LDImm 1
+    ; CHECK-NEXT: REP_Immediate 48
+    ; CHECK-NEXT: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: dead $a16 = TXA16 $x16
+    ; CHECK-NEXT: PHX_Implied implicit $x16
+    ; CHECK-NEXT: SEP_Immediate 48
+    ; CHECK-NEXT: $y = LDImm 2
+    ; CHECK-NEXT: REP_Immediate 48
+    ; CHECK-NEXT: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: $a16 = TXA16 killed $x16
+    $x16 = LDXImag16 killed $rs1
+    $y = LDImm 1
+    dead $a16 = TXA16 $x16
+    $y = LDImm 2
+    $a16 = TXA16 killed $x16
+    RTS implicit $a16
+...
+---
+name:            overwritten_source
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    liveins: $rs1
+
+    ; The byte stores replace both aliases of the original index source.
+    ; CHECK-LABEL: name: overwritten_source
+    ; CHECK: $x16 = LDXImag16 killed $rs1
+    ; CHECK-NEXT: PHX_Implied implicit $x16
+    ; CHECK-NEXT: SEP_Immediate 16
+    ; CHECK: $rc3 = STImag8 killed $y
+    ; CHECK-NEXT: REP_Immediate 16
+    ; CHECK-NEXT: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: $a = LDAbsXIdx 2048, killed $x16
+    $x16 = LDXImag16 killed $rs1
+    $y = LDImm 4
+    $rc2 = STImag8 $y
+    $y = LDImm 2
+    $rc3 = STImag8 killed $y
+    $a = LDAbsXIdx 2048, killed $x16
+    RTS implicit $a
+...
+---
+name:            arithmetic_writer
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    ; An increment's result must be preserved without executing it twice.
+    ; CHECK-LABEL: name: arithmetic_writer
+    ; CHECK: $x16 = INX16 $x16
+    ; CHECK-NEXT: PHX_Implied implicit $x16
+    ; CHECK: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: $a = LDAbsXIdx 2048, killed $x16
+    $x16 = LDXImm16 511
+    $x16 = INX16 $x16
+    $y = LDImm 1
+    $a = LDAbsXIdx 2048, killed $x16
+    RTS implicit $a
+...
+---
+name:            y_widens_before_x_reader
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    ; Restoring the width for Y does not restore X's saved high byte.
+    ; CHECK-LABEL: name: y_widens_before_x_reader
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: $y16 = LDYImm16 513
+    ; CHECK-NEXT: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: $a = LDAbsXIdx 2048, killed $x16
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    $y16 = LDYImm16 513
+    $a = LDAbsXIdx 2048, killed $x16
+    RTS implicit $a
+...
+---
+name:            byte_definition_ends_value
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    ; A byte write replaces X, including its zeroed high byte.
+    ; CHECK-LABEL: name: byte_definition_ends_value
+    ; CHECK-NOT: PHX_Implied
+    ; CHECK-NOT: PLX_Implied
+    ; CHECK: RTS
+    $x16 = LDXImm16 511
+    $x = LDImm 42
+    $a = LDAbsXIdx 2048, killed $x16
+    RTS implicit $a
+...
+---
+name:            nested_stack
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    liveins: $a
+
+    ; The saved X word sits beneath a balanced byte push/pull pair.
+    ; CHECK-LABEL: name: nested_stack
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: PH $y
+    ; CHECK-NEXT: $y = PL
+    ; CHECK-NEXT: REP_Immediate 16
+    ; CHECK-NEXT: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: STAbsXIdx $a, 2048, killed $x16
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    PH $y
+    $y = PL
+    STAbsXIdx $a, 2048, killed $x16
+    RTS
+...
+---
+name:            live_nz
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    liveins: $a
+
+    ; A store keeps the comparison's Z live. Restore X, A, and P while
+    ; consuming the saved word, so the caller sees the original hard stack.
+    ; CHECK-LABEL: name: live_nz
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: $c = CMPImm $y, 1, implicit-def $z
+    ; CHECK-NEXT: REP_Immediate 16
+    ; CHECK-NEXT: PH $p
+    ; CHECK-NEXT: REP_Immediate 32
+    ; CHECK-NEXT: PHA16 $a16
+    ; CHECK-NEXT: LDA_StackRelative 4, implicit-def $a16
+    ; CHECK-NEXT: $x16 = TAX16 $a16
+    ; CHECK-NEXT: LDA_StackRelative 2, implicit-def $a16
+    ; CHECK-NEXT: STA_StackRelative 4, implicit $a16
+    ; CHECK-NEXT: SEP_Immediate 32
+    ; CHECK-NEXT: LDA_StackRelative 1, implicit-def $a
+    ; CHECK-NEXT: STA_StackRelative 3, implicit $a
+    ; CHECK-NEXT: REP_Immediate 32
+    ; CHECK-NEXT: $a16 = PLA16
+    ; CHECK-NEXT: $a16 = PLA16
+    ; CHECK-NEXT: $p = PL
+    ; CHECK-NEXT: STAbsXIdx $a, 2048, killed $x16
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    $c = CMPImm $y, 1, implicit-def $z
+    STAbsXIdx $a, 2048, killed $x16
+    RTS implicit $z
+...
diff --git a/llvm/test/CodeGen/MOS/insert-rep-sep-stack.mir b/llvm/test/CodeGen/MOS/insert-rep-sep-stack.mir
new file mode 100644
index 000000000000..c421564b55aa
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/insert-rep-sep-stack.mir
@@ -0,0 +1,130 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=mos-insert-rep-sep -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -start-before=mos-insert-rep-sep -verify-machineinstrs -filetype=obj %s -o %t.o
+
+# These functions also run in the SNES hard-stack gate. The gate checks their
+# byte returns, stores at $11ff/$1300/$1301, flags, and the caller's stack.
+---
+name: stack_pop_byte
+tracksRegLiveness: true
+body: |
+  bb.0:
+    ; Put the saved X word below the byte consumed by PL.
+    ; CHECK-LABEL: name: stack_pop_byte
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: LDA_StackRelative 6, implicit-def $a
+    ; CHECK-NEXT: STA_StackRelative 4, implicit $a
+    ; CHECK: STA_StackRelative 5, implicit $a16
+    ; CHECK: $y = PL
+    ; CHECK: PLX_Implied implicit-def $x16
+    $y = LDImm 123
+    PH killed $y
+    $x16 = LDXImm16 511
+    $y = PL
+    STAbs killed $y, 4864
+    $a = LDAbsXIdx 4096, killed $x16
+    RTS implicit $a
+...
+---
+name: stack_push_byte
+tracksRegLiveness: true
+body: |
+  bb.0:
+    ; Extract X from beneath an outstanding byte push and keep that byte.
+    ; CHECK-LABEL: name: stack_push_byte
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: PH killed $y
+    ; CHECK: LDA_StackRelative 5, implicit-def $a16
+    ; CHECK-NEXT: $x16 = TAX16 $a16
+    ; CHECK: STA_StackRelative 5, implicit $a16
+    ; CHECK: $a = LDAbsXIdx 4096, killed $x16
+    ; CHECK: $y = PL
+    $x16 = LDXImm16 511
+    $y = LDImm 123
+    PH killed $y
+    $a = LDAbsXIdx 4096, killed $x16
+    $y = PL
+    STAbs killed $y, 4865
+    RTS implicit $a
+...
+---
+name: stack_pop_word
+tracksRegLiveness: true
+body: |
+  bb.0:
+    ; The original two-byte pull must preserve both A bytes for the store.
+    ; CHECK-LABEL: name: stack_pop_word
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: LDA_StackRelative 6, implicit-def $a16
+    ; CHECK-NEXT: STA_StackRelative 4, implicit $a16
+    ; CHECK: STA_StackRelative 6, implicit $a16
+    ; CHECK: $a16 = PLA16
+    ; CHECK: PLX_Implied implicit-def $x16
+    ; CHECK-NEXT: STAbsXIdx16 killed $a16, 4096, killed $x16
+    $y16 = LDYImm16 43899
+    $a16 = TYA16 killed $y16
+    PHA16 killed $a16
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    $a16 = PLA16
+    STAbsXIdx16 killed $a16, 4096, killed $x16
+    $a = LDImm 123
+    RTS implicit $a
+...
+---
+name: stack_push_word
+tracksRegLiveness: true
+body: |
+  bb.0:
+    ; A word pushed inside the narrow region remains intact after X restores.
+    ; CHECK-LABEL: name: stack_push_word
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: PHA16 killed $a16
+    ; CHECK: LDA_StackRelative 6, implicit-def $a16
+    ; CHECK-NEXT: $x16 = TAX16 $a16
+    ; CHECK: STA_StackRelative 6, implicit $a16
+    ; CHECK: $a = LDAbsXIdx 4096, killed $x16
+    ; CHECK: $a16 = PLA16
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    $y16 = LDYImm16 43899
+    $a16 = TYA16 killed $y16
+    PHA16 killed $a16
+    $a = LDAbsXIdx 4096, killed $x16
+    STAbs killed $a, 4866
+    $a16 = PLA16
+    STAbs16 killed $a16, 4867
+    $a = LDImm 123
+    RTS implicit $a
+...
+---
+name: stack_live_nz
+tracksRegLiveness: true
+body: |
+  bb.0:
+    successors: %bb.1, %bb.2
+    ; Z=1 from CPY must reach the branch even though the restored X is nonzero.
+    ; CHECK-LABEL: name: stack_live_nz
+    ; CHECK: PHX_Implied implicit $x16
+    ; CHECK: $c = CMPImm $y, 1, implicit-def $z
+    ; CHECK: PH $p
+    ; CHECK: LDA_StackRelative 4, implicit-def $a16
+    ; CHECK-NEXT: $x16 = TAX16 $a16
+    ; CHECK: $p = PL
+    ; CHECK-NEXT: STAbsXIdx16 killed $a16, 4096, killed $x16
+    ; CHECK: BR %bb.1, killed $z, 1
+    $x16 = LDXImm16 511
+    $y = LDImm 1
+    $y16 = LDYImm16 43899
+    $a16 = TYA16 killed $y16
+    $y = LDImm 1
+    $c = CMPImm $y, 1, implicit-def $z
+    STAbsXIdx16 killed $a16, 4096, killed $x16
+    BR %bb.1, killed $z, 1
+    BRA %bb.2
+  bb.1:
+    $a = LDImm 123
+    RTS implicit $a
+  bb.2:
+    $a = LDImm 0
+    RTS implicit $a
+...
diff --git a/llvm/test/CodeGen/MOS/interrupt-width-65816.ll b/llvm/test/CodeGen/MOS/interrupt-width-65816.ll
new file mode 100644
index 000000000000..17a137a5e255
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/interrupt-width-65816.ll
@@ -0,0 +1,34 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 < %s | FileCheck %s
+
+; A 65816 interrupt inherits M/X from the interrupted instruction, and D and
+; DBR from the interrupted code (which may legally have moved them via inline
+; asm). Save full A/X/Y in a known 16-bit mode, save D and DBR, and establish
+; the complete C ABI state (M8/X8, D=0, DBR=0 — the latter derived from the
+; hardware-forced PBR=0 via phk/plb) before any compiled code runs; restore
+; everything in reverse before RTI, which restores the stacked P.
+; Runnable end-to-end reproducers and explanation:
+; https://biohack.net/snes/nmitally/ (M/X) and the #141 dpbank demo (D/DBR).
+
+define void @isr() "interrupt" {
+; CHECK-LABEL: isr:
+; CHECK:       rep #48
+; CHECK-NEXT:  pha
+; CHECK-NEXT:  phx
+; CHECK-NEXT:  phy
+; CHECK-NEXT:  phb
+; CHECK-NEXT:  phd
+; CHECK-NEXT:  pea 0
+; CHECK-NEXT:  pld
+; CHECK-NEXT:  phk
+; CHECK-NEXT:  plb
+; CHECK-NEXT:  sep #48
+; CHECK:       cld
+; CHECK:       rep #48
+; CHECK-NEXT:  pld
+; CHECK-NEXT:  plb
+; CHECK-NEXT:  ply
+; CHECK-NEXT:  plx
+; CHECK-NEXT:  pla
+; CHECK-NEXT:  rti
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/legalizer-indexed-offset-observer.mir b/llvm/test/CodeGen/MOS/legalizer-indexed-offset-observer.mir
new file mode 100644
index 000000000000..02e6a058a8f6
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/legalizer-indexed-offset-observer.mir
@@ -0,0 +1,28 @@
+# REQUIRES: asserts
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer,mos-combiner -verify-machineinstrs -o - %s | FileCheck %s
+#
+# The no-wrap pointer add permits native indexing. Rewriting the masked s16
+# offset must notify GISel CSE for the shared G_ADD consumer. The legalizer and
+# combiner verify that the cached operand profiles match the rewritten uses.
+---
+name: indexed_offset_rewrite_notifies_observer
+body: |
+  bb.0:
+    liveins: $rs0, $rs2, $rs4, $rc0
+    ; CHECK-LABEL: name: indexed_offset_rewrite_notifies_observer
+    ; CHECK: [[LO:%[0-9]+]]:_(s8) = G_TRUNC {{%[0-9]+}}(s16)
+    ; CHECK-NEXT: [[MERGE:%[0-9]+]]:_(s16) = G_MERGE_VALUES [[LO]](s8), {{%[0-9]+}}(s8)
+    ; CHECK-NEXT: G_STORE_INDIR_IDX {{%[0-9]+}}(s8), {{%[0-9]+}}(p0), [[LO]] :: (store (s8))
+    ; CHECK-NEXT: G_ADD [[MERGE]], {{%[0-9]+}}
+    %0:_(p0) = COPY $rs0
+    %1:_(s16) = COPY $rs2
+    %2:_(s16) = COPY $rs4
+    %3:_(s8) = COPY $rc0
+    %4:_(s16) = G_CONSTANT i16 255
+    %5:_(s16) = G_AND %1, %4
+    %6:_(p0) = nuw G_PTR_ADD %0, %5
+    G_STORE %3(s8), %6(p0) :: (store (s8))
+    %7:_(s16) = G_ADD %5, %2
+    $rs0 = COPY %7(s16)
+    RTS implicit $rs0
+...
