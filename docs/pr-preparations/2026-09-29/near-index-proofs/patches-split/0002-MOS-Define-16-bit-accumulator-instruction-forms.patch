+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -start-before=branch-relaxation -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -start-before=branch-relaxation -verify-machineinstrs -filetype=obj %s -o %t.o
+# RUN: llvm-objdump -d --print-imm-hex %t.o | FileCheck %s --check-prefix=OBJ
+
+# Each 16-bit accumulator pseudo emits the width-agnostic opcode of its
+# addressing mode. A 16-bit immediate that would fit an 8-bit field prints as
+# mos16(value), so the text reassembles to the three-byte form; a value above
+# 255 already states its width and prints bare. The object carries the
+# three-byte immediate encodings.
+
+# CHECK-LABEL: accumulator_forms:
+# CHECK:      lda __rc2
+# CHECK-NEXT: clc
+# CHECK-NEXT: adc #mos16(66)
+# CHECK-NEXT: adc #43981
+# CHECK-NEXT: and #mos16(255)
+# CHECK-NEXT: ora {{.*}}g
+# CHECK-NEXT: eor __rc4
+# CHECK-NEXT: cmp #mos16(5)
+# CHECK-NEXT: asl
+# CHECK-NEXT: lsr
+# CHECK-NEXT: inc
+# CHECK-NEXT: dec
+# CHECK-NEXT: sta __rc2
+# CHECK-NEXT: sta {{.*}}g
+# CHECK-NEXT: rts
+
+# OBJ-LABEL: <accumulator_forms>:
+# OBJ:      a5 00 {{.*}}lda
+# OBJ-NEXT: 18 {{.*}}clc
+# OBJ-NEXT: 69 42 00 {{.*}}adc
+# OBJ-NEXT: 69 cd ab {{.*}}adc
+# OBJ-NEXT: 29 ff 00 {{.*}}and
+# OBJ:      45 00 {{.*}}eor
+# OBJ-NEXT: c9 05 00 {{.*}}cmp
+# OBJ-NEXT: 0a {{.*}}asl
+# OBJ-NEXT: 4a {{.*}}lsr
+# OBJ-NEXT: 1a {{.*}}inc
+# OBJ-NEXT: 3a {{.*}}dec
+# OBJ-NEXT: 85 00 {{.*}}sta
+--- |
+  @g = global i16 0
+  define void @accumulator_forms() { ret void }
+...
+---
+name: accumulator_forms
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rs1, $rs2
+    $a16 = LDAImag16 $rs1
+    $c = LDCImm 0
+    $a16, $c, $v = ADCImm16 $a16, 66, $c
+    $a16, $c, $v = ADCImm16 $a16, 43981, $c
+    $a16 = ANDImm16 $a16, 255
+    $a16 = ORAAbs16 $a16, @g
+    $a16 = EORImag16 $a16, $rs2
+    $c = CMPImm16 $a16, 5, implicit-def $nz
+    $a16 = ASLAcc16 $a16, implicit-def $c
+    $a16 = LSRAcc16 $a16, implicit-def $c
+    $a16 = INCAcc16 $a16
+    $a16 = DECAcc16 $a16
+    $rs1 = STAImag16 $a16
+    STAbs16 killed $a16, @g
+    RTS
+...
