--- a/llvm/lib/Target/MOS/MOSInstrFormats.td
+++ b/llvm/lib/Target/MOS/MOSInstrFormats.td
@@ -57,6 +57,15 @@ def HasW65816 : Predicate<"Subtarget->hasW65816()">,
   let PredicateName = "FeatureW65816";
 }
 
+// Native widths: opt-in 16-bit-accumulator codegen (FeatureAccum16 / +mos-a16).
+// The SubtargetFeature defines the hasAccum16() accessor; this Predicate exposes it
+// to tablegen `let Predicates = [HasAccum16]` so the 16-bit logical ops / pseudos
+// are only available when the feature is on.
+def HasAccum16 : Predicate<"Subtarget->hasAccum16()">,
+                AssemblerPredicate<(all_of FeatureAccum16), "Accum16"> {
+  let PredicateName = "FeatureAccum16";
+}
+
 def Has65EL02 : Predicate<"Subtarget->has65EL02()">,
                 AssemblerPredicate<(all_of Feature65EL02), "65EL02"> {
   let PredicateName = "Feature65EL02";
@@ -212,7 +221,15 @@ class imm16at<int offset> : Operand<i32> {
   let OperandNamespace = "MOSOp";
   let Type = i16;
 }
-def imm16 : imm16at<1>;
+// The 16-bit immediate of an Immediate16 instruction must be printed with an
+// explicit mos16() width whenever it would fit an 8-bit one, or the assembly
+// does not round-trip: the assembler has no M/X state, so a bare `adc #66`
+// re-parses as the two-byte form and, with M=0, desynchronises the instruction
+// stream from that point on. imm16at5 (the HuC6280 tii/tdd block length) does
+// not share this: its operand slot has no narrower sibling to collapse into.
+def imm16 : imm16at<1> {
+  let PrintMethod = "printImm16Operand";
+}
 def imm16at5 : imm16at<5>;
 
