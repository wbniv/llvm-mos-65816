+void MOSPassConfig::addPreEmitPass() {
+  // Native widths: insert REP/SEP for 16-bit-accumulator instructions (opt-in,
+  // +mos-a16; a no-op otherwise). Runs before branch relaxation so the added
+  // REP/SEP are accounted for in branch distances.
+  addPass(createMOSInsertREPSEPPass());
+  addPass(&BranchRelaxationPassID);
+}
 
