diff --git a/llvm/test/CodeGen/MOS/near-index-proofs-debug.ll b/llvm/test/CodeGen/MOS/near-index-proofs-debug.ll
new file mode 100644
index 000000000000..25ea5ccca3e1
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/near-index-proofs-debug.ll
@@ -0,0 +1,42 @@
+; REQUIRES: asserts
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -debug-only=mos-near-nowrap-recovery -o /dev/null < %s 2>&1 | FileCheck %s
+
+; Each near address is recovered by a specific proof: a nuw recurrence that
+; starts at the GEP's base, or the unsigned ordering of result and base when
+; the recurrence has no nuw flag.
+
+; CHECK: Recovered nuw from recurrence: {{.*}}getelementptr i8, ptr %dst, i16
+; CHECK: Recovered nuw from ordering: {{.*}}getelementptr i8, ptr inttoptr (i16 -256 to ptr), i16
+; CHECK-NOT: Recovered nuw
+
+define void @inbounds_fill(ptr %dst, i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i8 [ 0, %entry ], [ %j1, %loop ]
+  %d = getelementptr inbounds i8, ptr %dst, i8 %j
+  store volatile i8 %v, ptr %d, align 1
+  %j1 = add nuw nsw i8 %j, 1
+  %c = icmp eq i8 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+define void @ordered_const_base(i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i16 [ 0, %entry ], [ %j1, %loop ]
+  %a = getelementptr i8, ptr inttoptr (i16 -256 to ptr), i16 %j
+  store volatile i8 %v, ptr %a, align 1
+  %j1 = add nuw nsw i16 %j, 1
+  %c = icmp eq i16 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/near-index-proofs.ll b/llvm/test/CodeGen/MOS/near-index-proofs.ll
new file mode 100644
index 000000000000..c3e478def5ca
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/near-index-proofs.ll
@@ -0,0 +1,163 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mos-recover-near-nowrap=false -verify-machineinstrs < %s | FileCheck %s --check-prefix=DISABLED
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -stop-after=mos-near-nowrap-recovery < %s | FileCheck %s --check-prefix=IR
+; RUN: llc -mtriple=mos -mcpu=mos6502 -stop-after=mos-near-nowrap-recovery < %s | FileCheck %s --check-prefix=PLAIN
+; opt accepts each registered legacy pass name as an option, so the pass
+; name must differ from the -mos-recover-near-nowrap switch.
+; RUN: opt -passes=verify -disable-output < %s
+
+; 65816 indexed addressing carries into the next data bank, so a near address
+; addition folds into an index only with an unsigned no-wrap proof. Loop
+; strength reduction rebuilds these byte addresses without their inbounds
+; flags; the recovered nuw flag lets them use indexed addressing again.
+
+@buf = global [64 x i8] zeroinitializer
+
+; Both inbounds addresses start at their base and count up by one.
+; IR-LABEL: define void @near_copy
+; IR: getelementptr nuw i8, ptr %src, i16
+; IR: getelementptr nuw i8, ptr %dst, i16
+; PLAIN-LABEL: define void @near_copy
+; PLAIN: getelementptr i8, ptr %src, i16
+; PLAIN: getelementptr i8, ptr %dst, i16
+; CHECK-LABEL: near_copy:
+; CHECK-NOT: adc
+; CHECK: lda (__rc{{[0-9]+}}),y
+; CHECK-NEXT: sta (__rc{{[0-9]+}}),y
+; CHECK: rts
+; DISABLED-LABEL: near_copy:
+; DISABLED: adc
+; DISABLED: lda (__rc{{[0-9]+}}){{$}}
+; DISABLED: sta (__rc{{[0-9]+}}){{$}}
+; DISABLED: rts
+define void @near_copy(ptr %src, ptr %dst) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i8 [ 0, %entry ], [ %j1, %loop ]
+  %s = getelementptr inbounds i8, ptr %src, i8 %j
+  %v = load i8, ptr %s, align 1
+  %d = getelementptr inbounds i8, ptr %dst, i8 %j
+  store i8 %v, ptr %d, align 1
+  %j1 = add nuw nsw i8 %j, 1
+  %c = icmp eq i8 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; A fixed buffer regains absolute indexed addressing.
+; IR-LABEL: define void @global_fill
+; IR: getelementptr nuw i8, ptr @buf, i16
+; CHECK-LABEL: global_fill:
+; CHECK-NOT: adc
+; CHECK: sta buf,x
+; CHECK: rts
+; DISABLED-LABEL: global_fill:
+; DISABLED: adc
+; DISABLED: sta (__rc{{[0-9]+}}){{$}}
+; DISABLED: rts
+define void @global_fill(i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i8 [ 0, %entry ], [ %j1, %loop ]
+  %d = getelementptr inbounds i8, ptr @buf, i8 %j
+  store volatile i8 %v, ptr %d, align 1
+  %j1 = add nuw nsw i8 %j, 1
+  %c = icmp eq i8 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; Without inbounds, the near address may wrap even with a nonnegative index,
+; so it must still be formed before an unindexed store.
+; IR-LABEL: define void @wrapping_fill
+; IR: getelementptr i8, ptr %dst, i16
+; CHECK-LABEL: wrapping_fill:
+; CHECK: adc
+; CHECK: sta (__rc{{[0-9]+}}){{$}}
+; CHECK: rts
+define void @wrapping_fill(ptr %dst, i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i8 [ 0, %entry ], [ %j1, %loop ]
+  %d = getelementptr i8, ptr %dst, i8 %j
+  store volatile i8 %v, ptr %d, align 1
+  %j1 = add nuw nsw i8 %j, 1
+  %c = icmp eq i8 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; A pointer-increment recurrence does not start at the GEP's base; no flag is
+; recorded without a direct ordering proof.
+; IR-LABEL: define void @pointer_step
+; IR-NOT: getelementptr nuw
+; IR: getelementptr i8, ptr %{{.+}}, i16 1
+; IR-NOT: getelementptr nuw
+; IR: ret void
+define void @pointer_step(ptr %dst, i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i16 [ 0, %entry ], [ %j1, %loop ]
+  %d = getelementptr inbounds i8, ptr %dst, i16 %j
+  store volatile i8 %v, ptr %d, align 1
+  %j1 = add nuw nsw i16 %j, 1
+  %c = icmp eq i16 %j1, 300
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; The recurrence starting at the constant base 0xFF00 carries no nuw flag, but
+; the unsigned ordering proof shows that 64 byte steps stay below 0x10000.
+; IR-LABEL: define void @ordered_const_base
+; IR: getelementptr nuw i8, ptr inttoptr (i16 -256 to ptr), i16
+define void @ordered_const_base(i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i16 [ 0, %entry ], [ %j1, %loop ]
+  %a = getelementptr i8, ptr inttoptr (i16 -256 to ptr), i16 %j
+  store volatile i8 %v, ptr %a, align 1
+  %j1 = add nuw nsw i16 %j, 1
+  %c = icmp eq i16 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; From 0xFFF0 the same loop wraps at its 16th store, so no flag is recorded.
+; IR-LABEL: define void @wrapping_const_base
+; IR: getelementptr i8, ptr inttoptr (i16 -16 to ptr), i16
+define void @wrapping_const_base(i8 %v) {
+entry:
+  br label %loop
+
+loop:
+  %j = phi i16 [ 0, %entry ], [ %j1, %loop ]
+  %a = getelementptr i8, ptr inttoptr (i16 -16 to ptr), i16 %j
+  store volatile i8 %v, ptr %a, align 1
+  %j1 = add nuw nsw i16 %j, 1
+  %c = icmp eq i16 %j1, 64
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
