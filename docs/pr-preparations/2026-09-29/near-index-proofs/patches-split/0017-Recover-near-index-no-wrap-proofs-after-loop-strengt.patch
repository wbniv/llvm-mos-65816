diff --git a/llvm/lib/Target/MOS/MOSRecoverNearNoWrap.cpp b/llvm/lib/Target/MOS/MOSRecoverNearNoWrap.cpp
new file mode 100644
index 000000000000..2eb1e8165c3e
--- /dev/null
+++ b/llvm/lib/Target/MOS/MOSRecoverNearNoWrap.cpp
@@ -0,0 +1,105 @@
+//===-- MOSRecoverNearNoWrap.cpp - MOS near address no-wrap proofs --------===//
+//
+// Part of LLVM-MOS, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines the MOS pass that records unsigned no-wrap proofs on near
+// byte addresses immediately after loop strength reduction. LSR rebuilds
+// address arithmetic without the original IR flags, while its preserved
+// ScalarEvolution can still show that the rebuilt address does not wrap. The
+// 65816 needs that proof to fold a near addition into indexed addressing,
+// because indexed addressing carries into the next data bank.
+//
+//===----------------------------------------------------------------------===//
+
+#include "MOSRecoverNearNoWrap.h"
+
+#include "MOS.h"
+#include "MOSTargetMachine.h"
+#include "llvm/Analysis/LoopInfo.h"
+#include "llvm/Analysis/LoopPass.h"
+#include "llvm/Analysis/ScalarEvolution.h"
+#include "llvm/Analysis/ScalarEvolutionExpressions.h"
+#include "llvm/CodeGen/TargetPassConfig.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/InitializePasses.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/Debug.h"
+
+#define DEBUG_TYPE "mos-near-nowrap-recovery"
+
+using namespace llvm;
+
+static cl::opt<bool> RecoverNearNoWrap(
+    "mos-recover-near-nowrap", cl::Hidden, cl::init(true),
+    cl::desc("Recover unsigned no-wrap proofs for near byte GEPs after LSR"));
+
+namespace {
+class MOSRecoverNearNoWrap : public LoopPass {
+public:
+  static char ID;
+  MOSRecoverNearNoWrap() : LoopPass(ID) {
+    initializeMOSRecoverNearNoWrapPass(*PassRegistry::getPassRegistry());
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.addRequired<TargetPassConfig>();
+    AU.addRequired<ScalarEvolutionWrapperPass>();
+    AU.setPreservesAll();
+  }
+
+  bool runOnLoop(Loop *L, LPPassManager &) override {
+    if (!RecoverNearNoWrap || skipLoop(L))
+      return false;
+    const Function &F = *L->getHeader()->getParent();
+    unsigned IndexWidth = F.getDataLayout().getIndexSizeInBits(0);
+    const auto &TM = getAnalysis<TargetPassConfig>().getTM<MOSTargetMachine>();
+    if (!TM.getSubtargetImpl(F)->hasW65816())
+      return false;
+    auto &SE = getAnalysis<ScalarEvolutionWrapperPass>().getSE();
+    bool Changed = false;
+    for (BasicBlock *BB : L->blocks()) {
+      for (Instruction &I : *BB) {
+        auto *GEP = dyn_cast<GetElementPtrInst>(&I);
+        if (!GEP || !GEP->getType()->isPointerTy() ||
+            GEP->getAddressSpace() != 0 || GEP->hasNoUnsignedWrap() ||
+            !GEP->getSourceElementType()->isIntegerTy(8) ||
+            GEP->getNumIndices() != 1 ||
+            !GEP->getOperand(1)->getType()->isIntegerTy(IndexWidth))
+          continue;
+
+        // A single byte index of pointer width has no scaling, truncation, or
+        // intermediate additions. Its unsigned sum cannot wrap exactly when
+        // the result is at least the base. Use LSR's preserved ScalarEvolution
+        // facts before another pass invalidates them.
+        const SCEV *Address = SE.getSCEV(GEP);
+        const SCEV *Base = SE.getSCEV(GEP->getPointerOperand());
+        const auto *AR = dyn_cast<SCEVAddRecExpr>(Address);
+        // A nuw recurrence never decreases from its start in unsigned order.
+        bool FromBase = AR && AR->hasNoUnsignedWrap() && AR->getStart() == Base;
+        if (FromBase ||
+            SE.isKnownPredicate(ICmpInst::ICMP_UGE, Address, Base)) {
+          LLVM_DEBUG(dbgs() << "Recovered nuw from "
+                            << (FromBase ? "recurrence" : "ordering") << ": "
+                            << *GEP << '\n');
+          GEP->setNoWrapFlags(GEP->getNoWrapFlags() |
+                              GEPNoWrapFlags::noUnsignedWrap());
+          Changed = true;
+        }
+      }
+    }
+    return Changed;
+  }
+};
+} // namespace
+
+char MOSRecoverNearNoWrap::ID = 0;
+char &llvm::MOSRecoverNearNoWrapID = MOSRecoverNearNoWrap::ID;
+INITIALIZE_PASS_BEGIN(MOSRecoverNearNoWrap, DEBUG_TYPE,
+                      "MOS recover near address no-wrap proofs", false, false)
+INITIALIZE_PASS_DEPENDENCY(ScalarEvolutionWrapperPass)
+INITIALIZE_PASS_END(MOSRecoverNearNoWrap, DEBUG_TYPE,
+                    "MOS recover near address no-wrap proofs", false, false)
