       // We can remove identity copies right now.
-      handleIdentityCopy(MI);
+      handleIdentityCopy(MI, CopyHasUndefLanes);
     }
diff --git a/llvm/test/CodeGen/MOS/virtregrewriter-undef-lane-identity-copy.mir b/llvm/test/CodeGen/MOS/virtregrewriter-undef-lane-identity-copy.mir
new file mode 100644
index 000000000000..fd15dc2cf89e
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/virtregrewriter-undef-lane-identity-copy.mir
@@ -0,0 +1,20 @@
+# RUN: llc -mtriple=mos -run-pass=greedy,virtregrewriter -verify-machineinstrs %s -o - | FileCheck %s
+
+---
+name:            undef_lane_identity_copy
+tracksRegLiveness: true
+body:             |
+  bb.0:
+    ; CHECK-LABEL: name: undef_lane_identity_copy
+    ; CHECK: renamable $rc2 = COPY killed renamable $x
+    ; CHECK-NEXT: renamable $rs1 = KILL renamable $rs1
+    ; CHECK: renamable $x = COPY killed renamable $rc3
+    %0:gpr = LDImm 1
+    undef %1.sublo:imag16 = COPY %0
+    %2:imag16 = COPY %1
+    %3:gpr = COPY %2.sublo
+    STAbs %3, 0
+    %4:gpr = COPY %2.subhi
+    STAbs %4, 1
+    RTS
+...
