   void expandCopyBundle(MachineInstr &MI) const;
@@ -491,3 +491,3 @@ bool VirtRegRewriter::readsUndefSubreg(const MachineInstr &MI,
 
-void VirtRegRewriter::handleIdentityCopy(MachineInstr &MI) {
+void VirtRegRewriter::handleIdentityCopy(MachineInstr &MI, bool HasUndefLanes) {
   if (!MI.isIdentityCopy())
@@ -512,3 +512,3 @@ void VirtRegRewriter::handleIdentityCopy(MachineInstr &MI) {
   // instruction to maintain this information.
-  if (MI.getOperand(1).isUndef() || MI.getNumOperands() > 2) {
