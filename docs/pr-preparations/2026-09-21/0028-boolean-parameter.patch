@@ -663,2 +663,22 @@ void VirtRegRewriter::rewrite() {
     for (MachineInstr &MI : llvm::make_early_inc_range(MBBI->instrs())) {
+      // A full COPY defines its destination even where the source has no live
+      // lane. An identity COPY must retain that definition as a KILL so later
+      // uses of those destination lanes have a physical register definition.
+      bool CopyHasUndefLanes = false;
+      if (MI.isCopy()) {
+        const MachineOperand &Src = MI.getOperand(1);
+        if (Src.getReg().isVirtual() && LIS && LIS->hasInterval(Src.getReg())) {
+          const LiveInterval &LI = LIS->getInterval(Src.getReg());
+          if (LI.hasSubRanges()) {
+            LaneBitmask UndefLanes =
+                Src.getSubReg() ? TRI->getSubRegIndexLaneMask(Src.getSubReg())
+                                : MRI->getMaxLaneMaskForVReg(Src.getReg());
+            SlotIndex Idx = LIS->getInstructionIndex(MI);
+            for (const LiveInterval::SubRange &SR : LI.subranges())
+              if (SR.liveAt(Idx))
+                UndefLanes &= ~SR.LaneMask;
+            CopyHasUndefLanes = UndefLanes.any();
+          }
+        }
+      }
       for (MachineOperand &MO : MI.operands()) {
