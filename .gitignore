# Python bytecode cache (e.g. from tools/snes-checksum.py).
__pycache__/
*.pyc
# Upstream SDK, cloned at build time by dev/build.sh.
/vendor/
# Build output: SDK build tree, install prefix, ROMs, maps.
/build/
# Release staging: relocatable dist tree + .tar.xz/.sha256 (dev/package-release.sh).
# Reproducible output, not source — like /build/.
/dist/
# Generated at build time by tools/mandel-bake.c (dev/mandel-interactive.sh); 16 KiB of baked
# image data — regenerable, not source. The interactive demo + jgxcheck-view bake it before compiling.
/examples/snes/mandel_image.h
# Generated at build time by tools/mandel-bake-pyramid.c (dev/mandel-zoom.sh); the baked zoom-pyramid
# levels — regenerable, not source. The zoom demo + jgxcheck-zoom bake it before compiling.
/examples/snes/pyramid_image.h
# User-supplied emulator BIOS ROMs (copyrighted; never commit). MAME's snes
# driver requires the SPC700 IPL at dev/roms/s_smp/spc700.rom — see the smoke
# loop plan + README. Supply it out-of-band (CI: from a secret).
/dev/roms/
# User-supplied macOS SDK for the osxcross cross-build (Apple license forbids redistribution).
# Track dev/sdks/README.md (the instructions), ignore the SDK tarballs themselves.
/dev/sdks/*.tar.xz
/dev/sdks/*.tar.bz2
/dev/sdks/*.tar.gz
# WDC W65C816S datasheet — copyrighted third-party reference. Keep locally for
# convenience, but never commit/redistribute (see docs/65816-references.md:
# link, don't vendor; the release tarball stays Apache-2.0/LLVM clean).
/docs/w65c816s.pdf

# Claude per-project memory (project-specific files + symlinks to ~/.claude/memory generics).
# Also TRACK the project hook wiring (settings.json + hooks/) so it's reproducible from the
# repo — e.g. the worktree-teardown guard. Everything else under .claude/ stays local
# (scheduled_tasks.lock, transcripts, etc.).
.claude/*
!.claude/memory/
!.claude/settings.json
!.claude/hooks/
