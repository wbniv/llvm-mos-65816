diff --git a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
--- a/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
+++ b/llvm/lib/Target/MOS/MOSLegalizerInfo.cpp
@@ -2937,11 +2937,14 @@
   if (!Operand.has_value())
     return false;

-  Helper.Observer.changingInstr(MI);
-  MI.setDesc(Builder.getTII().get(Opcode));
-  MI.removeOperand(1);
-  MI.addOperand(*Operand);
-  Helper.Observer.changedInstr(MI);
+  // Replacing the generic load also removes any pending legalization work for
+  // it. An extending load can have queued this instruction before selecting
+  // its far address, and target pseudos must not remain on that worklist.
+  Builder.buildInstr(Opcode)
+      .add(MI.getOperand(0))
+      .add(*Operand)
+      .cloneMemRefs(MI);
+  MI.eraseFromParent();
   return true;
 }

diff --git a/llvm/test/CodeGen/MOS/far-absolute-extload.mir b/llvm/test/CodeGen/MOS/far-absolute-extload.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/far-absolute-extload.mir
@@ -0,0 +1,40 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16,+mos-xy16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
+
+# Extending byte loads select an absolute-long address during legalization.
+# The target load must retain its memory operand and leave the generic worklist.
+--- |
+  @far_byte = external addrspace(2) global i8
+  define void @zext_constant() { ret void }
+  define void @sext_global() { ret void }
+...
+---
+name: zext_constant
+# CHECK-LABEL: name: zext_constant
+# CHECK: %{{[0-9]+}}:_(s8) = G_LOAD_FAR_ABS 8355871 :: (volatile load (s8), addrspace 2)
+# CHECK-NOT: G_ZEXTLOAD
+body: |
+  bb.0:
+    %0:_(s32) = G_CONSTANT i32 8355871
+    %1:_(p2) = G_INTTOPTR %0(s32)
+    %2:_(s16) = G_ZEXTLOAD %1(p2) :: (volatile load (s8), addrspace 2)
+    %3:_(s8), %4:_(s8) = G_UNMERGE_VALUES %2(s16)
+    $a = COPY %3(s8)
+    $x = COPY %4(s8)
+    RTS implicit $a, implicit $x
+...
+---
+name: sext_global
+# CHECK-LABEL: name: sext_global
+# CHECK: %{{[0-9]+}}:_(s8) = G_LOAD_FAR_ABS @far_byte :: (load (s8) from @far_byte, addrspace 2)
+# CHECK-NOT: G_SEXTLOAD
+body: |
+  bb.0:
+    %0:_(p2) = G_GLOBAL_VALUE @far_byte
+    %1:_(s16) = G_SEXTLOAD %0(p2) :: (load (s8) from @far_byte, addrspace 2)
+    %2:_(s8), %3:_(s8) = G_UNMERGE_VALUES %1(s16)
+    $a = COPY %2(s8)
+    $x = COPY %3(s8)
+    RTS implicit $a, implicit $x
+...
