diff --git a/llvm/test/CodeGen/MOS/late-opt-spc700.mir b/llvm/test/CodeGen/MOS/late-opt-spc700.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/late-opt-spc700.mir
@@ -0,0 +1,29 @@
+# RUN: llc -mtriple=mos -mcpu=mosspc700 -run-pass=mos-late-opt -verify-machineinstrs -o - %s | FileCheck %s
+
+# SPC700 widens LDImm's destination to Anyi8 (`mov dp, #imm`). combineLdImm must
+# skip non-GPR destinations without disturbing its A/X/Y value tracking.
+
+---
+name: ldimm_imag8_only
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: ldimm_imag8_only
+    ; CHECK: $rc2 = LDImm 42
+    ; CHECK-NEXT: RTS implicit $rc2
+    $rc2 = LDImm 42
+    RTS implicit $rc2
+...
+---
+name: ldimm_imag8_between_gprs
+body: |
+  bb.0.entry:
+    ; CHECK-LABEL: name: ldimm_imag8_between_gprs
+    ; CHECK: $a = LDImm 7
+    ; CHECK-NEXT: $rc2 = LDImm 7
+    ; CHECK-NEXT: $x = TA $a
+    ; CHECK-NEXT: RTS implicit $a, implicit $x, implicit $rc2
+    $a = LDImm 7
+    $rc2 = LDImm 7
+    $x = LDImm 7
+    RTS implicit $a, implicit $x, implicit $rc2
+...
