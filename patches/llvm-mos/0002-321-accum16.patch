+// #321 Increment 1b: a whole 16-bit memory-to-memory add, g = a + b, fused by the
+// pre-legalizer combiner from G_STORE(G_ADD(G_LOAD a, G_LOAD b), g). The three
+// operands are absolute global addresses (a, b, g); the op carries three
+// MachineMemOperands (load a, load b, store g). selectAdd16Abs lowers it to
+// LDAbs16/ADCAbs16/STAbs16 in 16-bit-accumulator mode.
+//
+// It is a MOS target-generic op: a target-specific opcode (so the legalizer skips
+// it by opcode-range — and must NOT get a getActionDefinitionsBuilder rule, which
+// corrupts the legalizer tables), yet isPreISelOpcode=true so InstructionSelect
+// still calls select() on it (same model as #320's G_LOAD_FAR_ABS). Gated on
+// HasAccum16.
+def G_ADD16_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins unknown:$a, unknown:$b, unknown:$g);
+  let mayLoad = true;
+  let mayStore = true;
