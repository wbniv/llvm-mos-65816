+// #321 Increment 1b: returns the G_GLOBAL_VALUE def of `Ptr` iff `Ptr` is a
+// plain near (addrspace 0) global address — the addressing mode the 16-bit
+// LDA/ADC/STA absolute forms can take directly. Null otherwise.
+static MachineInstr *nearAbsGlobalDef(Register Ptr,
+                                      const MachineRegisterInfo &MRI) {
+  using namespace TargetOpcode;
+  if (!Ptr.isVirtual() || MRI.getType(Ptr).getAddressSpace() != 0)
+    return nullptr;
+  MachineInstr *Def = MRI.getVRegDef(Ptr);
+  if (!Def || Def->getOpcode() != G_GLOBAL_VALUE)
+    return nullptr;
+  return Def;
+}
+
+// #321 Increment 1b: a single-use 16-bit plain G_LOAD from a near abs global, or
+// null. (The kind of operand the 16-bit lda/ALU-abs forms can take directly.)
+static GLoad *nearAbsLoad(Register R, const MachineRegisterInfo &MRI) {
+  if (MRI.getType(R) != LLT::scalar(16) || !MRI.hasOneNonDBGUse(R))
+    return nullptr;
+  auto *Ld = dyn_cast_or_null<GLoad>(MRI.getVRegDef(R));
+  if (!Ld || Ld->getOpcode() != TargetOpcode::G_LOAD ||
+      !nearAbsGlobalDef(Ld->getPointerReg(), MRI))
+    return nullptr;
+  return Ld;
+}
+
+// #321 Increment 1b: is this a commutative 16-bit ALU op (operands may be
+// swapped freely)? Subtract is excluded — order-sensitive.
+static bool isCommutativeAlu(unsigned Opc) {
+  using namespace TargetOpcode;
+  return Opc == G_ADD || Opc == G_AND || Opc == G_OR || Opc == G_XOR;
+}
+
+// #321 Increment 1b: match g = a OP b, all 16-bit near (bank 0) absolute, i.e.
+// G_STORE(G_<alu>(x, y), g) where {x,y} are either two near-abs-global loads
+// (memory form) or one such load + one 16-bit constant (immediate form, for the
+// commutative ops). Only under +mos-a16. The ALU instr is returned for apply.
+bool MOSCombinerImpl::matchAlu16Abs(MachineInstr &MI, MachineInstr *&Add) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+
+  const LLT S16 = LLT::scalar(16);
+  auto *Store = dyn_cast<GStore>(&MI);
+  if (!Store || Store->isAtomic())
+    return false;
+  if (MRI.getType(Store->getValueReg()) != S16)
+    return false;
+  if (!nearAbsGlobalDef(Store->getPointerReg(), MRI))
+    return false;
+
+  // The stored value must be a single-use 16-bit ALU op (add/sub/and/or/xor).
+  Register ValReg = Store->getValueReg();
+  if (!MRI.hasOneNonDBGUse(ValReg))
+    return false;
+  MachineInstr *AddMI = MRI.getVRegDef(ValReg);
+  if (!AddMI)
+    return false;
+  switch (AddMI->getOpcode()) {
+  case G_ADD:
+  case G_SUB:
+  case G_AND:
+  case G_OR:
+  case G_XOR:
+    break;
+  default:
+    return false;
+  }
+
+  Register R1 = AddMI->getOperand(1).getReg();
+  Register R2 = AddMI->getOperand(2).getReg();
+  GLoad *L1 = nearAbsLoad(R1, MRI), *L2 = nearAbsLoad(R2, MRI);
+  if (L1 && L2) { // memory form: both operands are near-abs loads
+    Add = AddMI;
+    return true;
+  }
+  // Immediate form (commutative ops only): exactly one near-abs load + one 16-bit
+  // constant. selectAlu16Abs puts the load in A16 and the constant in the op.
+  if (!isCommutativeAlu(AddMI->getOpcode()) || (bool)L1 == (bool)L2)
+    return false;
+  Register CReg = L1 ? R2 : R1;
+  if (MRI.getType(CReg) != S16 ||
+      !getIConstantVRegValWithLookThrough(CReg, MRI))
+    return false;
+  Add = AddMI;
+  return true;
+}
+
+void MOSCombinerImpl::applyAlu16Abs(MachineInstr &MI, MachineInstr *&Add) const {
+  auto &Store = cast<GStore>(MI);
+  B.setInstrAndDebugLoc(MI);
+
+  unsigned Pseudo;
+  switch (Add->getOpcode()) {
+  case TargetOpcode::G_ADD: Pseudo = MOS::G_ADD16_ABS; break;
+  case TargetOpcode::G_SUB: Pseudo = MOS::G_SUB16_ABS; break;
+  case TargetOpcode::G_AND: Pseudo = MOS::G_AND16_ABS; break;
+  case TargetOpcode::G_OR:  Pseudo = MOS::G_OR16_ABS;  break;
+  default:                  Pseudo = MOS::G_XOR16_ABS; break; // G_XOR
+  }
+
+  Register R1 = Add->getOperand(1).getReg();
+  Register R2 = Add->getOperand(2).getReg();
+  GLoad *LoadA = nearAbsLoad(R1, MRI), *LoadB = nearAbsLoad(R2, MRI);
+  const MachineOperand &GG =
+      nearAbsGlobalDef(Store.getPointerReg(), MRI)->getOperand(1);
+
+  if (LoadA && LoadB) {
+    // Memory form: g = a OP b. Operands a/b/g + 3 memoperands (load a/b, store g).
+    const MachineOperand &GA =
+        nearAbsGlobalDef(LoadA->getPointerReg(), MRI)->getOperand(1);
+    const MachineOperand &GB =
+        nearAbsGlobalDef(LoadB->getPointerReg(), MRI)->getOperand(1);
+    B.buildInstr(Pseudo)
+        .add(GA)
+        .add(GB)
+        .add(GG)
+        .addMemOperand(&LoadA->getMMO())
+        .addMemOperand(&LoadB->getMMO())
+        .addMemOperand(&Store.getMMO());
+    MI.eraseFromParent();
+    Add->eraseFromParent();
+    LoadA->eraseFromParent();
+    LoadB->eraseFromParent();
+    return;
+  }
+
+  // Immediate form: g = load OP const. Pseudo operand 1 is the immediate (the
+  // selector keys on isImm()); only 2 memoperands (load a, store g).
+  GLoad *Load = LoadA ? LoadA : LoadB;
+  Register CReg = LoadA ? R2 : R1;
+  int64_t Imm =
+      getIConstantVRegValWithLookThrough(CReg, MRI)->Value.getZExtValue() &
+      0xFFFF;
+  const MachineOperand &GA =
+      nearAbsGlobalDef(Load->getPointerReg(), MRI)->getOperand(1);
+  B.buildInstr(Pseudo)
+      .add(GA)
+      .addImm(Imm)
+      .add(GG)
+      .addMemOperand(&Load->getMMO())
+      .addMemOperand(&Store.getMMO());
+  MI.eraseFromParent();
+  Add->eraseFromParent();
+  Load->eraseFromParent();
+}
+
+// #321 Increment 1c: walk a 16-bit ADD tree rooted at R, gathering its leaf terms
+// (each a single-use near-abs load) into Terms and the interior G_ADD nodes into
+// Adds (pre-order, so erasing front-to-back is use-before-def safe). A constant leaf
+// folds into ConstSum (HasConst set) — rematerializable, so its use-count is
+// irrelevant and it is never erased; the const check precedes the single-use gate
+// that loads/adds require. Returns false if any node is neither a single-use 16-bit
+// G_ADD, a near-abs load, nor a 16-bit constant.
+static bool collectAddChain(Register R, const MachineRegisterInfo &MRI,
+                            SmallVectorImpl<GLoad *> &Terms,
+                            SmallVectorImpl<MachineInstr *> &Adds,
+                            int64_t &ConstSum, bool &HasConst) {
+  if (MRI.getType(R) != LLT::scalar(16))
+    return false;
+  // The combiner runs pre-legalize, so a 16-bit literal is a single G_CONSTANT.
+  if (auto C = getIConstantVRegValWithLookThrough(R, MRI)) {
+    ConstSum += C->Value.getSExtValue();
+    HasConst = true;
+    return true;
+  }
+  if (!MRI.hasOneNonDBGUse(R))
+    return false;
+  MachineInstr *Def = MRI.getVRegDef(R);
+  if (Def && Def->getOpcode() == TargetOpcode::G_ADD) {
+    Adds.push_back(Def);
+    return collectAddChain(Def->getOperand(1).getReg(), MRI, Terms, Adds, ConstSum,
+                           HasConst) &&
+           collectAddChain(Def->getOperand(2).getReg(), MRI, Terms, Adds, ConstSum,
+                           HasConst);
+  }
+  if (GLoad *Ld = nearAbsLoad(R, MRI)) {
+    Terms.push_back(Ld);
+    return true;
+  }
+  return false;
+}
+
+// #321 Increment 1c: match g = t0 + t1 + ... + tN (>=3 near-abs-global 16-bit
+// loads) — G_STORE(<add tree>, g) — so selectAddChain16 can thread the running sum
+// through A16. Disjoint from matchAlu16Abs (which handles the 2-operand cases).
+bool MOSCombinerImpl::matchAddChain16(MachineInstr &MI) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+  auto *Store = dyn_cast<GStore>(&MI);
+  if (!Store || Store->isAtomic())
+    return false;
+  if (MRI.getType(Store->getValueReg()) != LLT::scalar(16))
+    return false;
+  if (!nearAbsGlobalDef(Store->getPointerReg(), MRI))
+    return false;
+  MachineInstr *Root = MRI.getVRegDef(Store->getValueReg());
+  if (!Root || Root->getOpcode() != G_ADD)
+    return false;
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  int64_t ConstSum = 0;
+  bool HasConst = false;
+  if (!collectAddChain(Store->getValueReg(), MRI, Terms, Adds, ConstSum, HasConst))
+    return false;
+  // >=3 chain terms (loads + an optional folded constant) is a real chain; the
+  // 2-operand cases (a+b, a+const) are matchAlu16Abs's job (avoid double-fire).
+  return Terms.size() + (HasConst ? 1 : 0) >= 3;
+}
+
+void MOSCombinerImpl::applyAddChain16(MachineInstr &MI) const {
+  auto &Store = cast<GStore>(MI);
+  B.setInstrAndDebugLoc(MI);
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  int64_t ConstSum = 0;
+  bool HasConst = false;
+  collectAddChain(Store.getValueReg(), MRI, Terms, Adds, ConstSum,
+                  HasConst); // re-derive (matched)
+
+  const MachineOperand &GG =
+      nearAbsGlobalDef(Store.getPointerReg(), MRI)->getOperand(1);
+  auto MIB = B.buildInstr(MOS::G_ADDCHAIN16_ABS).add(GG); // op 0 = store global
+  for (GLoad *T : Terms)
+    MIB.add(nearAbsGlobalDef(T->getPointerReg(), MRI)->getOperand(1));
+  if (HasConst) // trailing immediate term: selector folds it to `adc #imm`
+    MIB.addImm(ConstSum & 0xFFFF);
+  for (GLoad *T : Terms) // memoperands: the N loads, then the store
+    MIB.addMemOperand(&T->getMMO());
+  MIB.addMemOperand(&Store.getMMO());
+
+  // Erase store, then the adds (pre-order: parent before child), then the loads.
+  MI.eraseFromParent();
+  for (MachineInstr *A : Adds)
+    A->eraseFromParent();
+  for (GLoad *T : Terms)
+    T->eraseFromParent();
+}
+
+// #321 load-fold (c): match a MULTI-USE 16-bit add chain t = t0 + t1 + ... + tN
+// (>=3 near-abs-global loads) rooted at the G_ADD itself (not a store) — the case
+// add_chain16 (store-rooted) can't reach. Threads the running sum through A16 with the
+// result in an Imag16 pair (selectAddChain16Ld). Disjoint from add_chain16 (single-use
+// store result) and alu16_absld (2-operand: a >=3 chain root has an interior-G_ADD
+// operand, so its both-loads test fails). collectAddChain over the root's two operands
+// requires single-use interior nodes + leaves; only the root may be multi-use.
+bool MOSCombinerImpl::matchAddChain16Ld(MachineInstr &MI) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+  if (MI.getOpcode() != G_ADD)
+    return false;
+  Register Dst = MI.getOperand(0).getReg();
+  if (MRI.getType(Dst) != LLT::scalar(16))
+    return false;
+  // Multi-use result ONLY: a single-use result is add_chain16's (store) or stays on the
+  // per-add native path. (Mirrors matchAlu16AbsLd's guard.)
+  if (MRI.hasOneNonDBGUse(Dst))
+    return false;
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  int64_t ConstSum = 0;
+  bool HasConst = false;
+  if (!collectAddChain(MI.getOperand(1).getReg(), MRI, Terms, Adds, ConstSum,
+                       HasConst) ||
+      !collectAddChain(MI.getOperand(2).getReg(), MRI, Terms, Adds, ConstSum,
+                       HasConst))
+    return false;
+  // >=3 chain terms (loads + an optional folded constant); the 2-operand cases are
+  // matchAlu16AbsLd's job (avoid double-fire).
+  return Terms.size() + (HasConst ? 1 : 0) >= 3;
+}
+
+void MOSCombinerImpl::applyAddChain16Ld(MachineInstr &MI) const {
+  B.setInstrAndDebugLoc(MI);
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  int64_t ConstSum = 0;
+  bool HasConst = false;
+  collectAddChain(MI.getOperand(1).getReg(), MRI, Terms, Adds, ConstSum,
+                  HasConst); // re-derive (matched)
+  collectAddChain(MI.getOperand(2).getReg(), MRI, Terms, Adds, ConstSum, HasConst);
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register NewDst = MRI.createGenericVirtualRegister(LLT::scalar(16));
+  auto MIB = B.buildInstr(MOS::G_ADDCHAIN16_ABSLD).addDef(NewDst); // op 0 = result
+  for (GLoad *T : Terms)
+    MIB.add(nearAbsGlobalDef(T->getPointerReg(), MRI)->getOperand(1));
+  if (HasConst) // trailing immediate term: selector folds it to `adc #imm`
+    MIB.addImm(ConstSum & 0xFFFF);
+  for (GLoad *T : Terms) // memoperands: the N loads (no store)
+    MIB.addMemOperand(&T->getMMO());
+
+  // Redirect the chain's uses to the new result, then erase the root add, the interior
+  // adds (pre-order: parent before child), and the loads.
+  MRI.replaceRegWith(Dst, NewDst);
+  MI.eraseFromParent();
+  for (MachineInstr *A : Adds)
+    A->eraseFromParent();
+  for (GLoad *T : Terms)
+    T->eraseFromParent();
+}
+
+// #321 native s16 load-fold: match a 16-bit ALU op `dst = a OP b` (add/sub/and/or/
+// xor) whose operands are near-abs-global loads (or one load + one 16-bit const,
+// commutative ops) and whose RESULT is MULTI-USE — the case alu16_abs (which needs
+// a single store of the result) and add_chain16 can't fold. Rooted at the ALU op,
+// not a store. Folding reads the globals directly via the 16-bit absolute forms
+// instead of materializing them into Imag16 pairs. Only under +mos-a16.
+bool MOSCombinerImpl::matchAlu16AbsLd(MachineInstr &MI) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+  switch (MI.getOpcode()) {
+  case G_ADD:
+  case G_SUB:
+  case G_AND:
+  case G_OR:
+  case G_XOR:
+    break;
+  default:
+    return false;
+  }
+  const LLT S16 = LLT::scalar(16);
+  Register Dst = MI.getOperand(0).getReg();
+  if (MRI.getType(Dst) != S16)
+    return false;
+  // Multi-use result ONLY: a single-use result is handled by alu16_abs (store) or
+  // add_chain16, or stays on the native Imag16 path. This guard avoids stealing
+  // those cases (and the double-fire that would leave a worse fusion).
+  if (MRI.hasOneNonDBGUse(Dst))
+    return false;
+
+  Register R1 = MI.getOperand(1).getReg();
+  Register R2 = MI.getOperand(2).getReg();
+  GLoad *L1 = nearAbsLoad(R1, MRI), *L2 = nearAbsLoad(R2, MRI);
+  if (L1 && L2) // memory form: both operands near-abs loads
+    return true;
+  // Immediate form (commutative ops only): exactly one near-abs load + one s16 const.
+  if (!isCommutativeAlu(MI.getOpcode()) || (bool)L1 == (bool)L2)
+    return false;
+  Register CReg = L1 ? R2 : R1;
+  return MRI.getType(CReg) == S16 &&
+         (bool)getIConstantVRegValWithLookThrough(CReg, MRI);
+}
+
+void MOSCombinerImpl::applyAlu16AbsLd(MachineInstr &MI) const {
+  using namespace TargetOpcode;
+  B.setInstrAndDebugLoc(MI);
+
+  unsigned Pseudo;
+  switch (MI.getOpcode()) {
+  case G_ADD: Pseudo = MOS::G_ADD16_ABSLD; break;
+  case G_SUB: Pseudo = MOS::G_SUB16_ABSLD; break;
+  case G_AND: Pseudo = MOS::G_AND16_ABSLD; break;
+  case G_OR:  Pseudo = MOS::G_OR16_ABSLD;  break;
+  default:    Pseudo = MOS::G_XOR16_ABSLD; break; // G_XOR
+  }
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register R1 = MI.getOperand(1).getReg();
+  Register R2 = MI.getOperand(2).getReg();
+  GLoad *LoadA = nearAbsLoad(R1, MRI), *LoadB = nearAbsLoad(R2, MRI);
+  // The folded ALU defines a fresh vreg; we then redirect Dst's uses to it. (Build
+  // a new def rather than reuse Dst, which is still defined by the ALU op here.)
+  Register NewDst = MRI.createGenericVirtualRegister(LLT::scalar(16));
+
+  if (LoadA && LoadB) {
+    // Memory form: dst = a OP b. Operands a/b + 2 load memoperands.
+    const MachineOperand &GA =
+        nearAbsGlobalDef(LoadA->getPointerReg(), MRI)->getOperand(1);
+    const MachineOperand &GB =
+        nearAbsGlobalDef(LoadB->getPointerReg(), MRI)->getOperand(1);
+    B.buildInstr(Pseudo)
+        .addDef(NewDst)
+        .add(GA)
+        .add(GB)
+        .addMemOperand(&LoadA->getMMO())
+        .addMemOperand(&LoadB->getMMO());
+    MRI.replaceRegWith(Dst, NewDst);
+    MI.eraseFromParent();
+    LoadA->eraseFromParent();
+    LoadB->eraseFromParent();
+    return;
+  }
+
+  // Immediate form: dst = load OP const. Pseudo operand 1 is the immediate (the
+  // selector keys on isImm()); only 1 memoperand (the load).
+  GLoad *Load = LoadA ? LoadA : LoadB;
+  Register CReg = LoadA ? R2 : R1;
+  int64_t Imm =
+      getIConstantVRegValWithLookThrough(CReg, MRI)->Value.getZExtValue() & 0xFFFF;
+  const MachineOperand &GA =
+      nearAbsGlobalDef(Load->getPointerReg(), MRI)->getOperand(1);
+  B.buildInstr(Pseudo)
+      .addDef(NewDst)
+      .add(GA)
+      .addImm(Imm)
+      .addMemOperand(&Load->getMMO());
+  MRI.replaceRegWith(Dst, NewDst);
+  MI.eraseFromParent();
+  Load->eraseFromParent();
+}
+
+// #321 native s16: G_STORE(single-use G_LOAD(absSrc), absDst), both near-abs
+// globals, is a plain 16-bit global-to-global copy. Independent load/store selection
+// would hand the value off through an Imag16 temp (lda src; sta tmp; lda tmp; sta
+// dst); fuse to G_COPY16_ABS so the selector emits lda src; sta dst directly.
+bool MOSCombinerImpl::matchCopy16Abs(MachineInstr &MI) const {
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+  auto &Store = cast<GStore>(MI);
+  if (!nearAbsGlobalDef(Store.getPointerReg(), MRI))
+    return false; // destination must be a near-abs global (absolute store)
+  // The stored value must be a single-use near-abs 16-bit load (the source copy).
+  return nearAbsLoad(Store.getValueReg(), MRI) != nullptr;
+}
+
+void MOSCombinerImpl::applyCopy16Abs(MachineInstr &MI) const {
+  auto &Store = cast<GStore>(MI);
+  B.setInstrAndDebugLoc(MI);
+  GLoad *Load = nearAbsLoad(Store.getValueReg(), MRI);
+  const MachineOperand &Src =
+      nearAbsGlobalDef(Load->getPointerReg(), MRI)->getOperand(1);
+  const MachineOperand &Dst =
+      nearAbsGlobalDef(Store.getPointerReg(), MRI)->getOperand(1);
+  B.buildInstr(MOS::G_COPY16_ABS)
+      .add(Src)
+      .add(Dst)
+      .addMemOperand(&Load->getMMO())
+      .addMemOperand(&Store.getMMO());
+  MI.eraseFromParent();
+  Load->eraseFromParent();
+}
+
 bool MOSCombinerImpl::matchFoldAddE(MachineInstr &MI,
                                     BuildFnTy &MatchInfo) const {
   auto LHS = getIConstantVRegValWithLookThrough(MI.getOperand(2).getReg(), MRI);
