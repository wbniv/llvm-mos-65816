+// #321 Increment 1b: returns the G_GLOBAL_VALUE def of `Ptr` iff `Ptr` is a
+// plain near (addrspace 0) global address — the addressing mode the 16-bit
+// LDA/ADC/STA absolute forms can take directly. Null otherwise.
+static MachineInstr *nearAbsGlobalDef(Register Ptr,
+                                      const MachineRegisterInfo &MRI) {
+  using namespace TargetOpcode;
+  if (!Ptr.isVirtual() || MRI.getType(Ptr).getAddressSpace() != 0)
+    return nullptr;
+  MachineInstr *Def = MRI.getVRegDef(Ptr);
+  if (!Def || Def->getOpcode() != G_GLOBAL_VALUE)
+    return nullptr;
+  return Def;
+}
+
+// #321 Increment 1b: a single-use 16-bit plain G_LOAD from a near abs global, or
+// null. (The kind of operand the 16-bit lda/ALU-abs forms can take directly.)
+static GLoad *nearAbsLoad(Register R, const MachineRegisterInfo &MRI) {
+  if (MRI.getType(R) != LLT::scalar(16) || !MRI.hasOneNonDBGUse(R))
+    return nullptr;
+  auto *Ld = dyn_cast_or_null<GLoad>(MRI.getVRegDef(R));
+  if (!Ld || Ld->getOpcode() != TargetOpcode::G_LOAD ||
+      !nearAbsGlobalDef(Ld->getPointerReg(), MRI))
+    return nullptr;
+  return Ld;
+}
+
+// #321 Increment 1b: is this a commutative 16-bit ALU op (operands may be
+// swapped freely)? Subtract is excluded — order-sensitive.
+static bool isCommutativeAlu(unsigned Opc) {
+  using namespace TargetOpcode;
+  return Opc == G_ADD || Opc == G_AND || Opc == G_OR || Opc == G_XOR;
+}
+
+// #321 Increment 1b: match g = a OP b, all 16-bit near (bank 0) absolute, i.e.
+// G_STORE(G_<alu>(x, y), g) where {x,y} are either two near-abs-global loads
+// (memory form) or one such load + one 16-bit constant (immediate form, for the
+// commutative ops). Only under +mos-a16. The ALU instr is returned for apply.
+bool MOSCombinerImpl::matchAlu16Abs(MachineInstr &MI, MachineInstr *&Add) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+
+  const LLT S16 = LLT::scalar(16);
+  auto *Store = dyn_cast<GStore>(&MI);
+  if (!Store || Store->isAtomic())
+    return false;
+  if (MRI.getType(Store->getValueReg()) != S16)
+    return false;
+  if (!nearAbsGlobalDef(Store->getPointerReg(), MRI))
+    return false;
+
+  // The stored value must be a single-use 16-bit ALU op (add/sub/and/or/xor).
+  Register ValReg = Store->getValueReg();
+  if (!MRI.hasOneNonDBGUse(ValReg))
+    return false;
+  MachineInstr *AddMI = MRI.getVRegDef(ValReg);
+  if (!AddMI)
+    return false;
+  switch (AddMI->getOpcode()) {
+  case G_ADD:
+  case G_SUB:
+  case G_AND:
+  case G_OR:
+  case G_XOR:
+    break;
+  default:
+    return false;
+  }
+
+  Register R1 = AddMI->getOperand(1).getReg();
+  Register R2 = AddMI->getOperand(2).getReg();
+  GLoad *L1 = nearAbsLoad(R1, MRI), *L2 = nearAbsLoad(R2, MRI);
+  if (L1 && L2) { // memory form: both operands are near-abs loads
+    Add = AddMI;
+    return true;
+  }
+  // Immediate form (commutative ops only): exactly one near-abs load + one 16-bit
+  // constant. selectAlu16Abs puts the load in A16 and the constant in the op.
+  if (!isCommutativeAlu(AddMI->getOpcode()) || (bool)L1 == (bool)L2)
+    return false;
+  Register CReg = L1 ? R2 : R1;
+  if (MRI.getType(CReg) != S16 ||
+      !getIConstantVRegValWithLookThrough(CReg, MRI))
+    return false;
+  Add = AddMI;
+  return true;
+}
+
+void MOSCombinerImpl::applyAlu16Abs(MachineInstr &MI, MachineInstr *&Add) const {
+  auto &Store = cast<GStore>(MI);
+  B.setInstrAndDebugLoc(MI);
+
+  unsigned Pseudo;
+  switch (Add->getOpcode()) {
+  case TargetOpcode::G_ADD: Pseudo = MOS::G_ADD16_ABS; break;
+  case TargetOpcode::G_SUB: Pseudo = MOS::G_SUB16_ABS; break;
+  case TargetOpcode::G_AND: Pseudo = MOS::G_AND16_ABS; break;
+  case TargetOpcode::G_OR:  Pseudo = MOS::G_OR16_ABS;  break;
+  default:                  Pseudo = MOS::G_XOR16_ABS; break; // G_XOR
+  }
+
+  Register R1 = Add->getOperand(1).getReg();
+  Register R2 = Add->getOperand(2).getReg();
+  GLoad *LoadA = nearAbsLoad(R1, MRI), *LoadB = nearAbsLoad(R2, MRI);
+  const MachineOperand &GG =
+      nearAbsGlobalDef(Store.getPointerReg(), MRI)->getOperand(1);
+
+  if (LoadA && LoadB) {
+    // Memory form: g = a OP b. Operands a/b/g + 3 memoperands (load a/b, store g).
+    const MachineOperand &GA =
+        nearAbsGlobalDef(LoadA->getPointerReg(), MRI)->getOperand(1);
+    const MachineOperand &GB =
+        nearAbsGlobalDef(LoadB->getPointerReg(), MRI)->getOperand(1);
+    B.buildInstr(Pseudo)
+        .add(GA)
+        .add(GB)
+        .add(GG)
+        .addMemOperand(&LoadA->getMMO())
+        .addMemOperand(&LoadB->getMMO())
+        .addMemOperand(&Store.getMMO());
+    MI.eraseFromParent();
+    Add->eraseFromParent();
+    LoadA->eraseFromParent();
+    LoadB->eraseFromParent();
+    return;
+  }
+
+  // Immediate form: g = load OP const. Pseudo operand 1 is the immediate (the
+  // selector keys on isImm()); only 2 memoperands (load a, store g).
+  GLoad *Load = LoadA ? LoadA : LoadB;
+  Register CReg = LoadA ? R2 : R1;
+  int64_t Imm =
+      getIConstantVRegValWithLookThrough(CReg, MRI)->Value.getZExtValue() &
+      0xFFFF;
+  const MachineOperand &GA =
+      nearAbsGlobalDef(Load->getPointerReg(), MRI)->getOperand(1);
+  B.buildInstr(Pseudo)
+      .add(GA)
+      .addImm(Imm)
+      .add(GG)
+      .addMemOperand(&Load->getMMO())
+      .addMemOperand(&Store.getMMO());
+  MI.eraseFromParent();
+  Add->eraseFromParent();
+  Load->eraseFromParent();
+}
+
+// #321 Increment 1c: walk a 16-bit ADD tree rooted at R, gathering its leaf terms
+// (each a single-use near-abs load) into Terms and the interior G_ADD nodes into
+// Adds (pre-order, so erasing front-to-back is use-before-def safe). Returns false
+// if any node is neither a single-use 16-bit G_ADD nor a near-abs load.
+static bool collectAddChain(Register R, const MachineRegisterInfo &MRI,
+                            SmallVectorImpl<GLoad *> &Terms,
+                            SmallVectorImpl<MachineInstr *> &Adds) {
+  if (MRI.getType(R) != LLT::scalar(16) || !MRI.hasOneNonDBGUse(R))
+    return false;
+  MachineInstr *Def = MRI.getVRegDef(R);
+  if (Def && Def->getOpcode() == TargetOpcode::G_ADD) {
+    Adds.push_back(Def);
+    return collectAddChain(Def->getOperand(1).getReg(), MRI, Terms, Adds) &&
+           collectAddChain(Def->getOperand(2).getReg(), MRI, Terms, Adds);
+  }
+  if (GLoad *Ld = nearAbsLoad(R, MRI)) {
+    Terms.push_back(Ld);
+    return true;
+  }
+  return false;
+}
+
+// #321 Increment 1c: match g = t0 + t1 + ... + tN (>=3 near-abs-global 16-bit
+// loads) — G_STORE(<add tree>, g) — so selectAddChain16 can thread the running sum
+// through A16. Disjoint from matchAlu16Abs (which handles the 2-operand cases).
+bool MOSCombinerImpl::matchAddChain16(MachineInstr &MI) const {
+  using namespace TargetOpcode;
+  if (!B.getMF().getSubtarget<MOSSubtarget>().hasAccum16())
+    return false;
+  auto *Store = dyn_cast<GStore>(&MI);
+  if (!Store || Store->isAtomic())
+    return false;
+  if (MRI.getType(Store->getValueReg()) != LLT::scalar(16))
+    return false;
+  if (!nearAbsGlobalDef(Store->getPointerReg(), MRI))
+    return false;
+  MachineInstr *Root = MRI.getVRegDef(Store->getValueReg());
+  if (!Root || Root->getOpcode() != G_ADD)
+    return false;
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  if (!collectAddChain(Store->getValueReg(), MRI, Terms, Adds))
+    return false;
+  // >=3 terms is a real chain; 2 terms is matchAlu16Abs's job (avoid double-fire).
+  return Terms.size() >= 3;
+}
+
+void MOSCombinerImpl::applyAddChain16(MachineInstr &MI) const {
+  auto &Store = cast<GStore>(MI);
+  B.setInstrAndDebugLoc(MI);
+
+  SmallVector<GLoad *, 8> Terms;
+  SmallVector<MachineInstr *, 8> Adds;
+  collectAddChain(Store.getValueReg(), MRI, Terms, Adds); // re-derive (matched)
+
+  const MachineOperand &GG =
+      nearAbsGlobalDef(Store.getPointerReg(), MRI)->getOperand(1);
+  auto MIB = B.buildInstr(MOS::G_ADDCHAIN16_ABS).add(GG); // op 0 = store global
+  for (GLoad *T : Terms)
+    MIB.add(nearAbsGlobalDef(T->getPointerReg(), MRI)->getOperand(1));
+  for (GLoad *T : Terms) // memoperands: the N loads, then the store
+    MIB.addMemOperand(&T->getMMO());
+  MIB.addMemOperand(&Store.getMMO());
+
+  // Erase store, then the adds (pre-order: parent before child), then the loads.
+  MI.eraseFromParent();
+  for (MachineInstr *A : Adds)
+    A->eraseFromParent();
+  for (GLoad *T : Terms)
+    T->eraseFromParent();
+}
