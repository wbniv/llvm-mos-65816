+// near abs globals) to a 16-bit-accumulator sequence. Handles add/sub/and/or/xor
+// (G_{ADD,SUB,AND,OR,XOR}16_ABS). Operands 0/1/2 are the global addresses a/b/g;
+// the three MachineMemOperands are load-a, load-b, store-g (in that order).
+// Emits:
+//   add:  clc ; lda a ; adc b ; sta g
+//   sub:  sec ; lda a ; sbc b ; sta g   (a = minuend, b = subtrahend)
+//   and/or/xor:   lda a ; and|ora|eor b ; sta g   (no carry)
+// all on the A16 register class. For add/sub the carry-init (LDImm1, width-
+// agnostic) goes FIRST, outside the 16-bit run, so MOSInsertREPSEP brackets the
+// MLow=1 ops with a single rep #$20 … sep #$20 — a carry-init between lda and the
+// ALU op would split the bracket. lda doesn't touch carry, so ordering it after
+// the carry-init is correct. ADC carry-in is 0 (clc); SBC carry-in is 1 (sec).
+bool MOSInstructionSelector::selectAlu16Abs(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  // Operand 1 is the second ALU operand: a global (memory form) or an immediate
+  // (immediate form, g = a OP #const). The latter has no load-b memoperand.
+  const MachineOperand &GA = MI.getOperand(0);
+  const MachineOperand &Rhs = MI.getOperand(1);
+  const MachineOperand &GG = MI.getOperand(2);
+  const bool IsImm = Rhs.isImm();
+
+  // Map the pseudo to (abs ALU opcode, imm ALU opcode, carry-init: -1/0/1).
+  unsigned AbsOpc, ImmOpc;
+  int CarryInit;
+  switch (MI.getOpcode()) {
+  case MOS::G_ADD16_ABS: AbsOpc = MOS::ADCAbs16; ImmOpc = MOS::ADCImm16; CarryInit = 0;  break;
+  case MOS::G_SUB16_ABS: AbsOpc = MOS::SBCAbs16; ImmOpc = MOS::SBCAbs16; CarryInit = 1;  break;
+  case MOS::G_AND16_ABS: AbsOpc = MOS::ANDAbs16; ImmOpc = MOS::ANDImm16; CarryInit = -1; break;
+  case MOS::G_OR16_ABS:  AbsOpc = MOS::ORAAbs16; ImmOpc = MOS::ORAImm16; CarryInit = -1; break;
+  default:               AbsOpc = MOS::EORAbs16; ImmOpc = MOS::EORImm16; CarryInit = -1; break; // XOR
+  }
+  const unsigned AluOpc = IsImm ? ImmOpc : AbsOpc;
+  const bool IsArith = CarryInit >= 0;
+
+  // load-a is the first memoperand, store-g the last; load-b (memory form only)
+  // is in between.
+  unsigned NumMMO = MI.getNumMemOperands();
+  assert(NumMMO == (IsImm ? 2u : 3u) && "ALU16Abs mem-operand count");
+  MachineMemOperand *MMOA = *MI.memoperands_begin();
+  MachineMemOperand *MMOG = *(MI.memoperands_begin() + (NumMMO - 1));
+  MachineMemOperand *MMOB = IsImm ? nullptr : *(MI.memoperands_begin() + 1);
+
+  // #321 native 16-bit inc/dec: a ±1 immediate ADD is `inc a`/`dec a` on A16 instead of
+  // `clc; adc #$0001` — `lda <g>; inc/dec a; sta <g>` (3 instrs vs 4), reusing the same
+  // long (24-bit) load/store addressing. Only G_ADD16_ABS is ever the immediate form
+  // (SUB is non-commutative, so `g - 1` canonicalizes to `g + 0xFFFF`). A DBR-relative
+  // `inc abs` memory-RMW is deliberately avoided (see MOSInstrLogical.td: no `inc long`;
+  // would couple correctness to DBR==0 + bank-0 placement).
+  if (IsImm && MI.getOpcode() == MOS::G_ADD16_ABS) {
+    int64_t I = Rhs.getImm() & 0xFFFF;
+    int Step = I == 1 ? 1 : (I == 0xFFFF ? -1 : 0);
+    if (Step) {
+      Register Lo = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+      Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+      SmallVector<MachineInstrBuilder, 3> New;
+      New.push_back(Builder.buildInstr(MOS::LDAbs16).addDef(Lo).add(GA).addMemOperand(MMOA));
+      New.push_back(Builder.buildInstr(Step > 0 ? MOS::INCAcc16 : MOS::DECAcc16)
+                        .addDef(Res).addUse(Lo));
+      New.push_back(Builder.buildInstr(MOS::STAbs16).addUse(Res).add(GG).addMemOperand(MMOG));
+      for (MachineInstrBuilder &B : New)
+        constrainSelectedInstRegOperands(*B.getInstr(), TII, TRI, RBI);
+      MI.eraseFromParent();
+      return true;
+    }
+  }
+
+  Register Lo = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+
+  SmallVector<MachineInstrBuilder, 4> New;
+  Register Carry;
+  if (IsArith) {
+    // clc (0) for add, sec (1) for subtract — first, outside the 16-bit run.
+    Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(
+        Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(CarryInit));
+  }
+  // lda a  (16-bit) -> A16
+  New.push_back(
+      Builder.buildInstr(MOS::LDAbs16).addDef(Lo).add(GA).addMemOperand(MMOA));
+  // the ALU op (16-bit): A16 = Lo OP (#imm | [b]).
+  auto Alu = Builder.buildInstr(AluOpc).addDef(Res);
+  if (IsArith) {
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    Alu.addDef(CarryOut).addDef(VOut).addUse(Lo);
+    if (IsImm)
+      Alu.addImm(Rhs.getImm());
+    else
+      Alu.add(Rhs);
+    Alu.addUse(Carry);
+  } else {
+    Alu.addUse(Lo);
+    if (IsImm)
+      Alu.addImm(Rhs.getImm());
+    else
+      Alu.add(Rhs);
+  }
+  if (!IsImm)
+    Alu.addMemOperand(MMOB);
+  New.push_back(Alu);
+  // sta g  (16-bit)
+  New.push_back(
+      Builder.buildInstr(MOS::STAbs16).addUse(Res).add(GG).addMemOperand(MMOG));
+
+  for (MachineInstrBuilder &B : New)
+    constrainSelectedInstRegOperands(*B.getInstr(), TII, TRI, RBI);
+
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 native s16 load-fold: lower G_{...}16_ABSLD — like selectAlu16Abs (reads
+// the global operands directly via the 16-bit absolute forms) but the RESULT goes
+// to a register (an Imag16 pair, via STAImag16) instead of a fused store, so it
+// serves the multi-use case. Operand 0 is the s16 result; operand 1 is the load-a
+// global; operand 2 is the load-b global OR a 16-bit immediate. Memoperands:
+// load-a, [load-b]. Emits: (clc|sec;) lda a; adc|sbc|and|ora|eor (#imm | b); sta
+// dst — one rep/sep bracket; no Ac16<->8-bit COPY (the native invariant).
+bool MOSInstructionSelector::selectAlu16AbsLd(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  Register Dst = MI.getOperand(0).getReg();
+  const MachineOperand &GA = MI.getOperand(1);
+  const MachineOperand &Rhs = MI.getOperand(2);
+  const bool IsImm = Rhs.isImm();
+
+  unsigned AbsOpc, ImmOpc;
+  int CarryInit;
+  switch (MI.getOpcode()) {
+  case MOS::G_ADD16_ABSLD: AbsOpc = MOS::ADCAbs16; ImmOpc = MOS::ADCImm16; CarryInit = 0;  break;
+  case MOS::G_SUB16_ABSLD: AbsOpc = MOS::SBCAbs16; ImmOpc = MOS::SBCAbs16; CarryInit = 1;  break;
+  case MOS::G_AND16_ABSLD: AbsOpc = MOS::ANDAbs16; ImmOpc = MOS::ANDImm16; CarryInit = -1; break;
+  case MOS::G_OR16_ABSLD:  AbsOpc = MOS::ORAAbs16; ImmOpc = MOS::ORAImm16; CarryInit = -1; break;
+  default:                 AbsOpc = MOS::EORAbs16; ImmOpc = MOS::EORImm16; CarryInit = -1; break; // XOR
+  }
+  const unsigned AluOpc = IsImm ? ImmOpc : AbsOpc;
+  const bool IsArith = CarryInit >= 0;
+
+  // load-a is the first memoperand; load-b (memory form only) is the second.
+  // There is no store memoperand (the result is a register).
+  MachineMemOperand *MMOA = *MI.memoperands_begin();
+  MachineMemOperand *MMOB = IsImm ? nullptr : *(MI.memoperands_begin() + 1);
+
+  Register Lo = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+
+  SmallVector<MachineInstrBuilder, 4> New;
+  Register Carry;
+  if (IsArith) {
+    Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(
+        Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(CarryInit));
+  }
+  // lda a (16-bit) -> A16
+  New.push_back(
+      Builder.buildInstr(MOS::LDAbs16).addDef(Lo).add(GA).addMemOperand(MMOA));
+  // the ALU op (16-bit): A16 = Lo OP (#imm | [b]).
+  auto Alu = Builder.buildInstr(AluOpc).addDef(Res);
+  if (IsArith) {
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    Alu.addDef(CarryOut).addDef(VOut).addUse(Lo);
+    if (IsImm)
+      Alu.addImm(Rhs.getImm());
+    else
+      Alu.add(Rhs);
+    Alu.addUse(Carry);
+  } else {
+    Alu.addUse(Lo);
+    if (IsImm)
+      Alu.addImm(Rhs.getImm());
+    else
+      Alu.add(Rhs);
+  }
+  if (!IsImm)
+    Alu.addMemOperand(MMOB);
+  New.push_back(Alu);
+  // sta dst (16-bit): the Imag16 dst is DEF'd by the store (imaginary-reg write).
+  New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Res));
+
+  for (MachineInstrBuilder &B : New)
+    constrainSelectedInstRegOperands(*B.getInstr(), TII, TRI, RBI);
+
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 Increment 1c: lower a fused 16-bit ADD chain g = t0 + t1 + ... + tN. The
+// variadic operands are: 0 = store global, 1..N = the term globals; the mem
+// operands are the N term loads followed by the store. Threads the running sum
+// through A16: lda t0; (clc; adc t1) ...; sta g. Each clc is M-agnostic so the
+// whole chain stays in one REP/SEP bracket; clc before each adc discards the
+// previous add's carry-out (independent 16-bit adds, associative mod 2^16).
+bool MOSInstructionSelector::selectAddChain16(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  // Operands: 0 = store global, 1..G = term globals, then an OPTIONAL trailing
+  // immediate (the folded constant term). Memoperands: G loads, then the store.
+  const MachineOperand &GG = MI.getOperand(0);
+  const bool HasConst = MI.getOperand(MI.getNumOperands() - 1).isImm();
+  const unsigned NumGlobals = MI.getNumOperands() - 1 - (HasConst ? 1 : 0);
+  assert(NumGlobals >= 2 && MI.getNumMemOperands() == NumGlobals + 1 &&
+         "ADDCHAIN16 shape");
+  auto MMO = MI.memoperands_begin(); // [0..G-1] loads, [G] store
+
+  SmallVector<MachineInstrBuilder, 8> New;
+  // lda t0 -> A16
+  Register Acc = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  New.push_back(Builder.buildInstr(MOS::LDAbs16)
+                    .addDef(Acc)
+                    .add(MI.getOperand(1))
+                    .addMemOperand(MMO[0]));
+  // clc; adc tI  for each remaining global term, threading A16.
+  for (unsigned I = 1; I < NumGlobals; ++I) {
+    Register Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(0)); // clc
+    Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    New.push_back(Builder.buildInstr(MOS::ADCAbs16)
+                      .addDef(Res)
+                      .addDef(CarryOut)
+                      .addDef(VOut)
+                      .addUse(Acc)
+                      .add(MI.getOperand(1 + I))
+                      .addUse(Carry)
+                      .addMemOperand(MMO[I]));
+    Acc = Res;
+  }
+  // clc; adc #imm  for the folded constant term (if any).
+  if (HasConst) {
+    Register Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(0)); // clc
+    Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    New.push_back(Builder.buildInstr(MOS::ADCImm16)
+                      .addDef(Res)
+                      .addDef(CarryOut)
+                      .addDef(VOut)
+                      .addUse(Acc)
+                      .addImm(MI.getOperand(MI.getNumOperands() - 1).getImm())
+                      .addUse(Carry));
+    Acc = Res;
+  }
+  // sta g
+  New.push_back(Builder.buildInstr(MOS::STAbs16)
+                    .addUse(Acc)
+                    .add(GG)
+                    .addMemOperand(MMO[NumGlobals]));
+
+  for (MachineInstrBuilder &B : New)
+    constrainSelectedInstRegOperands(*B.getInstr(), TII, TRI, RBI);
+
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 load-fold (c): lower the MULTI-USE add chain t = t0 + ... + tN. Like
+// selectAddChain16 but operand 0 is the s16 RESULT (register) and there is no store
+// global: N term globals (operands 1..N) + N load memoperands. Threads the running sum
+// through A16 and leaves it in an Imag16 pair: lda t0; (clc; adc tI)...; sta dst.
+bool MOSInstructionSelector::selectAddChain16Ld(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  Register Dst = MI.getOperand(0).getReg(); // result (Imag16)
+  // Operands: 0 = result def, 1..G = term globals, then an OPTIONAL trailing immediate
+  // (the folded constant term). Memoperands: G loads (no store).
+  const bool HasConst = MI.getOperand(MI.getNumOperands() - 1).isImm();
+  const unsigned NumGlobals = MI.getNumOperands() - 1 - (HasConst ? 1 : 0);
+  assert(NumGlobals >= 2 && MI.getNumMemOperands() == NumGlobals &&
+         "ADDCHAIN16LD shape");
+  auto MMO = MI.memoperands_begin(); // [0..G-1] loads (no store)
+
+  SmallVector<MachineInstrBuilder, 8> New;
+  // lda t0 -> A16
+  Register Acc = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  New.push_back(Builder.buildInstr(MOS::LDAbs16)
+                    .addDef(Acc)
+                    .add(MI.getOperand(1))
+                    .addMemOperand(MMO[0]));
+  // clc; adc tI  for each remaining global term, threading A16.
+  for (unsigned I = 1; I < NumGlobals; ++I) {
+    Register Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(0)); // clc
+    Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    New.push_back(Builder.buildInstr(MOS::ADCAbs16)
+                      .addDef(Res)
+                      .addDef(CarryOut)
+                      .addDef(VOut)
+                      .addUse(Acc)
+                      .add(MI.getOperand(1 + I))
+                      .addUse(Carry)
+                      .addMemOperand(MMO[I]));
+    Acc = Res;
+  }
+  // clc; adc #imm  for the folded constant term (if any).
+  if (HasConst) {
+    Register Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(0)); // clc
+    Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    New.push_back(Builder.buildInstr(MOS::ADCImm16)
+                      .addDef(Res)
+                      .addDef(CarryOut)
+                      .addDef(VOut)
+                      .addUse(Acc)
+                      .addImm(MI.getOperand(MI.getNumOperands() - 1).getImm())
+                      .addUse(Carry));
+    Acc = Res;
+  }
+  // sta dst (16-bit): the Imag16 dst is DEF'd by the store (imaginary-reg write).
+  New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Acc));
+
+  for (MachineInstrBuilder &B : New)
+    constrainSelectedInstRegOperands(*B.getInstr(), TII, TRI, RBI);
+
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 native s16: extract a 16-bit compile-time constant from an operand, if it
+// is one. Handles both forms a 16-bit literal takes by the time it reaches the
+// selector: a direct (look-through) constant, and — the common case — a
+// G_MERGE_VALUES of two byte constants (a 16-bit immediate is split into lo/hi
+// bytes before selection; getIConstantVRegValWithLookThrough does NOT look
+// through the merge, so reconstruct it here). Used to fold `var OP const` into
+// the *Imm16 forms instead of materializing the constant into an Imag16 pair.
+static std::optional<int64_t> getImm16Operand(Register R,
+                                              MachineRegisterInfo &MRI) {
+  if (auto C = getIConstantVRegValWithLookThrough(R, MRI))
+    return C->Value.getZExtValue() & 0xFFFF;
+  MachineInstr *Def = getDefIgnoringCopies(R, MRI);
+  if (Def && Def->getOpcode() == TargetOpcode::G_MERGE_VALUES &&
+      Def->getNumOperands() == 3) {
+    auto Lo = getIConstantVRegValWithLookThrough(Def->getOperand(1).getReg(), MRI);
+    auto Hi = getIConstantVRegValWithLookThrough(Def->getOperand(2).getReg(), MRI);
+    if (Lo && Hi)
+      return ((Hi->Value.getZExtValue() & 0xFF) << 8) |
+             (Lo->Value.getZExtValue() & 0xFF);
+  }
+  return std::nullopt;
+}
+
+// #321 Increment 1d-retry: select a native s16 ALU op `%dst = G_OP %a, %b` whose
+// value lives in an Imag16 zero-page pair — the case the 1b/1c combiner peephole
+// can't reach (locals, multi-use intermediates). Mirrors selectAlu16Abs but with
+// Imag16 operands instead of absolute globals:
+//
+//   add:        clc ; lda <a:zp> ; adc <b:zp> ; sta <dst:zp>
+//   sub:        sec ; lda <a:zp> ; sbc <b:zp> ; sta <dst:zp>   (a minuend)
+//   and/or/xor:       lda <a:zp> ; and|ora|eor <b:zp> ; sta <dst:zp>
+//
+// all MLow=1 -> one rep/sep bracket; the carry-init (clc/sec) is M-width-agnostic
+// (MOSInsertREPSEP) so it sits outside the 16-bit run. The accumulator A16 (Ac16
+// vregs Lo/Res) is entered only by LDAImag16 and left only by STAImag16 (which
+// DEFS the dst Imag16) — there is NO COPY between Ac16 and an 8-bit reg, so the
+// register coalescer cannot merge an 8-bit value into A16 (the exact crash that
+// sank the first 1d prototype).
+//
+// Immediate fold: if an operand is a compile-time constant, the ALU op uses the
+// *Imm16 form (`adc #$0345`) instead of materializing the constant into an Imag16
+// pair — for the commutative ops (add/and/or/xor) either operand may be the
+// constant (swap so the register is loaded). SUB has no SBCImm16 (and `x - C` is
+// canonicalized to `x + (-C)` upstream), so it never folds an immediate. The now-
+// dead constant def is removed automatically by isTriviallyDead in the generic
+// InstructionSelect pass.
+//
+// Mixed-operand fold: a single near-abs global operand (the other being an Imag16
+// register — a local/multi-use value, the case the both-global combiner peephole
+// can't reach) is read directly instead of being materialized into an Imag16 pair.
+// Two independent fold sites: operand A folds into the LHS `lda abs` (LDAbs16);
+// operand B folds into the absolute ALU form (`adc|sbc|and|ora|eor abs`). SUB stays
+// correct without a swap — the minuend is always A (loaded), the subtrahend B. Same
+// 1-to-1 volatile-safe single-use fold as the compare-operand fold (selectSbc16).
+bool MOSInstructionSelector::selectAlu16Native(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register A = MI.getOperand(1).getReg();
+  Register B = MI.getOperand(2).getReg();
+
+  // Map the generic opcode to (zp ALU opcode, abs ALU opcode, imm ALU opcode
+  // [0 = none], carry-init: -1 none / 0 clc / 1 sec, commutative). AbsOpc reads a
+  // near-abs global operand directly (the mixed-operand fold below).
+  unsigned AluOpc, AbsOpc, ImmOpc;
+  int CarryInit;
+  bool Commutative;
+  switch (MI.getOpcode()) {
+  case MOS::G_ADD: AluOpc = MOS::ADCImag16; AbsOpc = MOS::ADCAbs16; ImmOpc = MOS::ADCImm16; CarryInit = 0;  Commutative = true;  break;
+  case MOS::G_SUB: AluOpc = MOS::SBCImag16; AbsOpc = MOS::SBCAbs16; ImmOpc = 0;             CarryInit = 1;  Commutative = false; break;
+  case MOS::G_AND: AluOpc = MOS::ANDImag16; AbsOpc = MOS::ANDAbs16; ImmOpc = MOS::ANDImm16; CarryInit = -1; Commutative = true;  break;
+  case MOS::G_OR:  AluOpc = MOS::ORAImag16; AbsOpc = MOS::ORAAbs16; ImmOpc = MOS::ORAImm16; CarryInit = -1; Commutative = true;  break;
+  default:         AluOpc = MOS::EORImag16; AbsOpc = MOS::EORAbs16; ImmOpc = MOS::EORImm16; CarryInit = -1; Commutative = true;  break; // G_XOR
+  }
+  const bool IsArith = CarryInit >= 0;
+
+  // #321 native 16-bit inc/dec: a 16-bit ±1 is one `inc a`/`dec a` on A16 (1 byte, no
+  // carry-init), not `(clc;) adc #$0001`. Compute the signed step from a constant
+  // operand: ADD by +1 / SUB by -1 -> inc; ADD by -1 (0xFFFF) / SUB by +1 -> dec. For
+  // ADD (commutative) the constant may be either operand; for SUB it must be the
+  // subtrahend B (`1 - x` is not a decrement). The value loads via the LHS abs-fold
+  // (lda abs near-abs global, else lda zp); inc/dec a sets N/Z (carry-out unused). All
+  // MLow=1 -> one rep/sep bracket, value enters/leaves A16 only via the load/store.
+  if (MI.getOpcode() == MOS::G_ADD || MI.getOpcode() == MOS::G_SUB) {
+    auto stepOf = [](int64_t C) -> int { return C == 1 ? 1 : (C == 0xFFFF ? -1 : 0); };
+    int Step = 0;
+    Register Val;
+    if (MI.getOpcode() == MOS::G_ADD) {
+      if (auto C = getImm16Operand(B, MRI)) { Step = stepOf(*C); Val = A; }
+      if (!Step)
+        if (auto C = getImm16Operand(A, MRI)) { Step = stepOf(*C); Val = B; }
+    } else { // G_SUB: only the subtrahend (B) as a constant is an inc/dec
+      if (auto C = getImm16Operand(B, MRI)) { Step = -stepOf(*C); Val = A; }
+    }
+    if (Step) {
+      SmallVector<MachineInstrBuilder, 3> New;
+      MachineInstr *LdV = foldableAbsLoad16(Val, MI, MRI);
+      Register Lo = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+      if (LdV)
+        New.push_back(Builder.buildInstr(MOS::LDAbs16).addDef(Lo)
+                          .add(LdV->getOperand(1)).cloneMemRefs(*LdV));
+      else
+        New.push_back(Builder.buildInstr(MOS::LDAImag16).addDef(Lo).addUse(Val));
+      Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+      New.push_back(Builder.buildInstr(Step > 0 ? MOS::INCAcc16 : MOS::DECAcc16)
+                        .addDef(Res).addUse(Lo));
+      New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Res));
+      for (MachineInstrBuilder &Bld : New)
+        constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
+      if (LdV)
+        LdV->eraseFromParent();
+      MI.eraseFromParent();
+      return true;
+    }
+  }
+
+  // Fold a constant operand into the immediate form (not for SUB: no SBCImm16).
+  // After the (optional) swap, A is the register loaded into A16 and Imm (if set)
+  // is the second operand; otherwise B is the register second operand.
+  std::optional<int64_t> Imm;
+  if (ImmOpc) {
+    if ((Imm = getImm16Operand(B, MRI))) {
+      // B is the immediate; A stays the loaded register.
+    } else if (Commutative && (Imm = getImm16Operand(A, MRI))) {
+      std::swap(A, B); // load the old-B register; the old-A constant is the imm.
+    }
+  }
+
+  // Mixed-operand fold sites: a single-use near-abs global A folds into `lda abs`;
+  // a single-use near-abs global B (no immediate) folds into the `OP abs` form.
+  SmallVector<MachineInstr *, 2> Folded;
+  MachineInstr *LdA = foldableAbsLoad16(A, MI, MRI);
+  MachineInstr *LdB = Imm ? nullptr : foldableAbsLoad16(B, MI, MRI);
+
+  SmallVector<MachineInstrBuilder, 4> New;
+
+  // lda a (16-bit) -> A16. Fold a near-abs global LHS straight into `lda abs`.
+  Register Lo = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  if (LdA) {
+    New.push_back(Builder.buildInstr(MOS::LDAbs16)
+                      .addDef(Lo)
+                      .add(LdA->getOperand(1))
+                      .cloneMemRefs(*LdA));
+    Folded.push_back(LdA);
+  } else {
+    New.push_back(Builder.buildInstr(MOS::LDAImag16).addDef(Lo).addUse(A));
+  }
+
+  Register Carry;
+  if (IsArith) {
+    // clc (add) / sec (sub) — outside the 16-bit run (carry-init is M-agnostic).
+    Carry = MRI.createVirtualRegister(&MOS::CcRegClass);
+    New.push_back(Builder.buildInstr(MOS::LDImm1).addDef(Carry).addImm(CarryInit));
+  }
+
+  // the ALU op (16-bit): A16 = a OP (b | [b:abs] | #imm) (+carry for add/sub). The
+  // second operand is an immediate, a near-abs global (abs form), or an Imag16 reg.
+  Register Res = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  unsigned EffAluOpc = Imm ? ImmOpc : (LdB ? AbsOpc : AluOpc);
+  auto Alu = Builder.buildInstr(EffAluOpc).addDef(Res);
+  if (IsArith) {
+    Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+    Register VOut = MRI.createVirtualRegister(&MOS::VcRegClass);
+    Alu.addDef(CarryOut).addDef(VOut).addUse(Lo);
+    if (Imm)
+      Alu.addImm(*Imm);
+    else if (LdB)
+      Alu.add(LdB->getOperand(1));
+    else
+      Alu.addUse(B);
+    Alu.addUse(Carry);
+  } else {
+    Alu.addUse(Lo);
+    if (Imm)
+      Alu.addImm(*Imm);
+    else if (LdB)
+      Alu.add(LdB->getOperand(1));
+    else
+      Alu.addUse(B);
+  }
+  if (LdB) {
+    Alu.cloneMemRefs(*LdB);
+    Folded.push_back(LdB);
+  }
+  New.push_back(Alu);
+
+  // sta dst (16-bit): the Imag16 dst is DEF'd by the store (imaginary-reg write).
+  New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Res));
+
+  for (MachineInstrBuilder &Bld : New)
+    constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
+
+  // Erase the folded loads (single-use; this op was their only consumer, and
+  // selection is bottom-up so they are not yet selected).
+  for (MachineInstr *F : Folded)
+    F->eraseFromParent();
+
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 native s16 constant shift: `dst = src << k` / `dst = src >> k` (unsigned),
+// k a compile-time constant in [1,7] left un-narrowed by the legalizer under
+// +mos-a16. In 16-bit-accumulator mode one `asl a` / `lsr a` shifts all 16 bits,
+// so emit `lda src; (asl|lsr)*k; sta dst` — all MLow=1, so MOSInsertREPSEP wraps
+// the run in one rep/sep. The value enters A16 only via LDAImag16 and leaves only
+// via STAImag16 (no Ac16<->8-bit COPY). No carry-init: each shift self-fills 0.
+bool MOSInstructionSelector::selectShift16Native(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  Register Dst = MI.getOperand(0).getReg();
+  Register Src = MI.getOperand(1).getReg();
+  Register AmtReg = MI.getOperand(2).getReg();
+
+  auto AmtVal = getIConstantVRegValWithLookThrough(AmtReg, MRI);
+  if (!AmtVal)
+    return false; // legalizer only leaves constant amounts native; be defensive
+  uint64_t Amt = AmtVal->Value.getZExtValue();
+
+  const unsigned Opc = MI.getOpcode();
+  const bool IsAshr = Opc == MOS::G_ASHR;
+
+  SmallVector<MachineInstrBuilder, 16> New;
+
+  // lda src (16-bit) -> A16
+  Register Cur = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  New.push_back(Builder.buildInstr(MOS::LDAImag16).addDef(Cur).addUse(Src));
+
+  // Amt iterations on A16, each threading a fresh Ac16 from the previous (the tied
+  // $dst=$src collapses the chain onto A16 in regalloc).
+  //  - G_SHL  -> asl a  (fill 0 at bit 0)
+  //  - G_LSHR -> lsr a  (fill 0 at bit 15)
+  //  - G_ASHR -> cmp #$8000; ror a  (cmp sets C = sign bit; ror rotates it into
+  //              bit 15, replicating the sign; the ror's carry-out is dead).
+  for (uint64_t I = 0; I < Amt; ++I) {
+    Register Next = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    if (IsAshr) {
+      Register Sign = MRI.createVirtualRegister(&MOS::CcRegClass);
+      New.push_back(Builder.buildInstr(MOS::CMPImm16)
+                        .addDef(Sign)
+                        .addUse(Cur)
+                        .addImm(0x8000));
+      Register CarryOut = MRI.createVirtualRegister(&MOS::CcRegClass);
+      New.push_back(Builder.buildInstr(MOS::RORAcc16)
+                        .addDef(Next)
+                        .addDef(CarryOut)
+                        .addUse(Cur)
+                        .addUse(Sign));
+    } else {
+      const unsigned ShOpc = Opc == MOS::G_SHL ? MOS::ASLAcc16 : MOS::LSRAcc16;
+      New.push_back(Builder.buildInstr(ShOpc).addDef(Next).addUse(Cur));
+    }
+    Cur = Next;
+  }
+
+  // sta dst (16-bit): the Imag16 dst is DEF'd by the store (imaginary-reg write).
+  New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(Dst).addUse(Cur));
+
+  for (MachineInstrBuilder &Bld : New)
+    constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
+
+  MI.eraseFromParent();
+  return true;
+}
+
+Register MOSInstructionSelector::loadStoreValueIntoA16(
+    MachineIRBuilder &Builder, MachineInstr &StoreMI, Register Value,
+    SmallVectorImpl<MachineInstrBuilder> &New, MachineInstr *&FoldedLoad) {
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+  FoldedLoad = nullptr;
+  Register A16 = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  MachineInstr *Def = MRI.getVRegDef(Value);
+  if (Def && MRI.hasOneNonDBGUse(Value) &&
+      (Def->getOpcode() == MOS::G_LOAD16_ABS ||
+       Def->getOpcode() == MOS::G_LOAD16_INDIR) &&
+      shouldFoldMemAccess(StoreMI, *Def, AA)) {
+    // Indirect/mixed copy: fold the load directly into A16 (no Imag16 temp). The
+    // load's operand 1 is its address (abs operand or pointer); operand 0 is the
+    // value vreg this store consumes.
+    const bool LdAbs = Def->getOpcode() == MOS::G_LOAD16_ABS;
+    auto Ld = Builder.buildInstr(LdAbs ? MOS::LDAbs16 : MOS::LDAIndir16)
+                  .addDef(A16)
+                  .add(Def->getOperand(1));
+    Ld.cloneMemRefs(*Def);
+    New.push_back(Ld);
+    FoldedLoad = Def;
+  } else {
+    // Value is already a 16-bit register (Imag16): load it into A16.
+    New.push_back(Builder.buildInstr(MOS::LDAImag16).addDef(A16).addUse(Value));
+  }
+  return A16;
+}
+
+// #321 native s16 indirect load/store: a 16-bit value through a runtime pointer.
+//  G_LOAD16_INDIR  (dst s16, ptr) -> lda (zp)16 -> A16; sta zp16 -> Imag16 dst
+//  G_STORE16_INDIR (val s16, ptr) -> lda zp16 (val -> A16); sta (zp)16
+// The pointer operand is constrained to the Imag16 zero-page pair (same as the
+// 8-bit LDIndir/STIndir); the value enters/leaves A16 only via the Imag16 load/
+// store -> no Ac16<->8-bit COPY. Both ops are MLow=1, so MOSInsertREPSEP brackets
+// the pair with one rep/sep.
+bool MOSInstructionSelector::selectMem16Indir(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+  const bool IsLoad = MI.getOpcode() == MOS::G_LOAD16_INDIR;
+
+  Register ValOrDst = MI.getOperand(0).getReg();
+  Register Ptr = MI.getOperand(1).getReg();
+
+  // The user's memory access is the indirect op (LDAIndir16 / STAIndir16); carry
+  // the memref there. The Imag16 load/store that moves the value to/from A16 is an
+  // internal zp register transfer with no memref (mirrors selectAlu16AbsLd).
+  SmallVector<MachineInstrBuilder, 2> New;
+  MachineInstr *FoldedLoad = nullptr;
+  if (IsLoad) {
+    Register A16 = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    auto Ld = Builder.buildInstr(MOS::LDAIndir16).addDef(A16).addUse(Ptr);
+    Ld.cloneMemRefs(MI);
+    New.push_back(Ld);
+    New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(ValOrDst).addUse(A16));
+  } else {
+    Register A16 = loadStoreValueIntoA16(Builder, MI, ValOrDst, New, FoldedLoad);
+    auto St = Builder.buildInstr(MOS::STAIndir16).addUse(A16).addUse(Ptr);
+    St.cloneMemRefs(MI);
+    New.push_back(St);
+  }
+
+  for (MachineInstrBuilder &Bld : New)
+    constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
+  if (FoldedLoad)
+    FoldedLoad->eraseFromParent();
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 native s16 absolute load/store: a 16-bit value at an absolute (global/static)
+// address. Mirror of selectMem16Indir, using LDAbs16/STAbs16 (the abs operand rides
+// the real memory op; the Imag16 transfer carries no memref). One rep/sep each; no
+// Ac16<->8-bit COPY.
+//  G_LOAD16_ABS  (dst s16, absOp) -> lda abs16 -> A16; sta zp16 -> Imag16 dst
+//  G_STORE16_ABS (val s16, absOp) -> lda zp16 (val -> A16); sta abs16
+bool MOSInstructionSelector::selectMem16Abs(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+  const bool IsLoad = MI.getOpcode() == MOS::G_LOAD16_ABS;
+
+  Register ValOrDst = MI.getOperand(0).getReg();
+  const MachineOperand &AbsOp = MI.getOperand(1);
+
+  SmallVector<MachineInstrBuilder, 2> New;
+  MachineInstr *FoldedLoad = nullptr;
+  if (IsLoad) {
+    Register A16 = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+    auto Ld = Builder.buildInstr(MOS::LDAbs16).addDef(A16).add(AbsOp);
+    Ld.cloneMemRefs(MI);
+    New.push_back(Ld);
+    New.push_back(Builder.buildInstr(MOS::STAImag16).addDef(ValOrDst).addUse(A16));
+  } else {
+    Register A16 = loadStoreValueIntoA16(Builder, MI, ValOrDst, New, FoldedLoad);
+    auto St = Builder.buildInstr(MOS::STAbs16).addUse(A16).add(AbsOp);
+    St.cloneMemRefs(MI);
+    New.push_back(St);
+  }
+
+  for (MachineInstrBuilder &Bld : New)
+    constrainSelectedInstRegOperands(*Bld.getInstr(), TII, TRI, RBI);
+  if (FoldedLoad)
+    FoldedLoad->eraseFromParent();
+  MI.eraseFromParent();
+  return true;
+}
+
+// #321 native s16 global-to-global copy: G_COPY16_ABS (src global, dst global, ld
+// memref, st memref) -> lda src(16-bit) -> A16; sta dst(16-bit). No Imag16 temp; both
+// MLow=1 -> one rep/sep. The fused form of a plain `g = gg` copy.
+bool MOSInstructionSelector::selectCopy16Abs(MachineInstr &MI) {
+  MachineIRBuilder Builder(MI);
+  MachineRegisterInfo &MRI = *Builder.getMRI();
+
+  const MachineOperand &Src = MI.getOperand(0);
+  const MachineOperand &Dst = MI.getOperand(1);
+  const unsigned NumMMO = MI.getNumMemOperands();
+  MachineMemOperand *LdMMO = *MI.memoperands_begin();
+  MachineMemOperand *StMMO = *(MI.memoperands_begin() + (NumMMO - 1));
+
+  Register A16 = MRI.createVirtualRegister(&MOS::Ac16RegClass);
+  auto Ld = Builder.buildInstr(MOS::LDAbs16).addDef(A16).add(Src).addMemOperand(LdMMO);
+  auto St = Builder.buildInstr(MOS::STAbs16).addUse(A16).add(Dst).addMemOperand(StMMO);
+
+  constrainSelectedInstRegOperands(*Ld.getInstr(), TII, TRI, RBI);
+  constrainSelectedInstRegOperands(*St.getInstr(), TII, TRI, RBI);
+  MI.eraseFromParent();
+  return true;
+}
