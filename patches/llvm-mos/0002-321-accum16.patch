+// #321 native s16 load-fold: the register-result counterparts of G_{...}16_ABS.
+// Where G_ADD16_ABS fuses `g = a OP b` for a single store (peephole), these fold
+// the global-operand LOADS into a 16-bit ALU op whose RESULT stays in a vreg
+// (allocated to an Imag16 pair) — for the multi-use case the store-fused peephole
+// can't reach (`t = a16v OP b16v; use(t); use(t)`). $dst is the s16 result; $a is
+// a near-abs global (loaded into A16); $b is a near-abs global OR a 16-bit
+// immediate (same dual-form selectAlu16Abs inspects via isImm). Carries the load
+// memoperand(s). selectAlu16AbsLd emits lda/adc|sbc|and|ora|eor abs16 -> sta zp
+// (STAImag16). Gated on HasAccum16; NO legalizer rule (skipped by opcode-range,
+// like G_ADD16_ABS — a rule corrupts the legalizer tables).
+def G_ADD16_ABSLD : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$a, unknown:$b);
+  let mayLoad = true;
+}
+def G_SUB16_ABSLD : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$a, unknown:$b);
+  let mayLoad = true;
+}
+class MOSGenericBit16AbsLd : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$a, unknown:$b);
+  let mayLoad = true;
+}
+def G_AND16_ABSLD : MOSGenericBit16AbsLd;
+def G_OR16_ABSLD  : MOSGenericBit16AbsLd;
+def G_XOR16_ABSLD : MOSGenericBit16AbsLd;
+
+// #321 Increment 1c: a homogeneous ADD chain g = t0 + t1 + ... + tN (all near abs
+// globals), fused by the pre-legalizer combiner from a tree of G_ADDs over loads.
+// Variadic: operand 0 is the store global, operands 1..N are the term globals; it
+// carries N load memoperands + 1 store memoperand. selectAddChain16 threads the
+// running sum through A16 (lda t0; clc; adc t1; ...; sta g). Gated on HasAccum16.
+def G_ADDCHAIN16_ABS : MOSGenericInstruction {
+  let Predicates = [HasAccum16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins variable_ops);
+  let mayLoad = true;
+  let mayStore = true;
+}
