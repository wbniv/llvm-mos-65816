diff --git a/llvm/lib/Target/MOS/MOSInsertREPSEP.cpp b/llvm/lib/Target/MOS/MOSInsertREPSEP.cpp
new file mode 100644
index 000000000..408571c52
--- /dev/null
+++ b/llvm/lib/Target/MOS/MOSInsertREPSEP.cpp
@@ -0,0 +1,631 @@
+//===-- MOSInsertREPSEP.cpp - Insert 65816 REP/SEP for 16-bit mode --------===//
+//
+// Part of LLVM-MOS, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// #321: a late pass that inserts the 65816's REP/SEP to set the M (accumulator
+// width) and X (index width) status flags where an instruction requires 16-bit
+// mode. Each instruction's required M/X width is carried by the MLow/MHigh/
+// XLow/XHigh TSFlags — the same signals MOSMCELFStreamer reads to emit the
+// $ml/$mh ELF mapping symbols.
+//
+// Increment 2 (cross-block churn minimization): a forward dataflow that
+// propagates the M mode across the CFG and places REP/SEP only at genuine mode
+// *transitions*, hoisting them out of loops. The earlier Increment 1a was
+// per-block and 8-bit-anchored (every block began and ended in 8-bit mode), so a
+// loop with a 16-bit body re-ran `rep … sep` every iteration. Now the mode is
+// held across edges: a 16-bit loop body gets `rep` in the preheader and `sep` in
+// the exit, with no per-iteration toggle.
+//
+// xy16 extension: a parallel X-flag lattice runs alongside the M lattice in the
+// same iteration of the fixpoint. Combined `REP/SEP #$30` is emitted when both
+// M and X switch to the same target mode in one insertSwitch call. The default
+// for most instructions is XW_None (X-agnostic): M16-only ops (LDAbs16,
+// STAbs16, …) do NOT emit surrounding rep/sep #$10 for the X flag.
+//
+// Correctness invariants:
+//   * each instruction runs in the width it requires;
+//   * function entry is 8-bit (ABI), every call/return boundary is 8-bit;
+//   * width-agnostic ops (carry-init, branches) impose no constraint.
+//
+// A mode switch on a true critical edge is placed as a single absolute-mode
+// entry switch at the target block's start (coercing every in-edge at once),
+// which is correct because the target's entry width is well-defined and A16 is
+// never live across edges. The one residual unsafe case — forcing X to 8-bit on
+// an X-passthrough target whose entry width came from a conflicting-pred meet —
+// falls back to the old per-block 8-bit anchoring (placeLegacy).
+//
+// The STZ store-of-zero fusion (Increment 1a) is independent and kept as-is.
+// Gated on FeatureAccum16; a no-op otherwise.
+//
+//===----------------------------------------------------------------------===//
+
+#include "MOSInsertREPSEP.h"
+
+#include "MCTargetDesc/MOSMCTargetDesc.h"
+#include "MOS.h"
+#include "MOSSubtarget.h"
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/CodeGen/MachineBasicBlock.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/TargetInstrInfo.h"
+#include "llvm/CodeGen/TargetRegisterInfo.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "mos-insert-rep-sep"
+
+// REP/SEP operand bits selecting the M and X status flags.
+static constexpr int64_t MFlagBit = 0x20;
+static constexpr int64_t XFlagBit = 0x10;
+
+// #321 Increment 1b: is this instruction M-width-agnostic — its behavior does not
+// depend on the accumulator (M) width, so it may sit inside a 16-bit run without
+// forcing a SEP back to 8-bit? Conservative: the carry load (LDCImm, i.e. clc/sec)
+// that the ALU selection emits as the carry-in for adc/sbc, plus an LDImm1 that
+// targets only a flag (C/V). Without this, that carry-init landing between `lda`
+// and `adc` splits the REP/SEP bracket. Extend the set as more agnostic ops appear.
+static bool isMWidthAgnostic(const MachineInstr &MI) {
+  switch (MI.getOpcode()) {
+  case MOS::LDCImm: // clc / sec — always defines only the carry flag
+    return true;
+  case MOS::LDImm1:
+    if (MI.getOperand(0).isReg()) {
+      Register D = MI.getOperand(0).getReg();
+      return D == MOS::C || D == MOS::V;
+    }
+    return false;
+  default:
+    return false;
+  }
+}
+
+namespace {
+
+// Accumulator-width lattice. MW_None is the lattice bottom (an unvisited block,
+// or — for a single instruction — "imposes no width requirement"); MW_Conflict is
+// the top (predecessors disagree). The meet of two definite, differing widths is
+// MW_Conflict.
+enum MWidth { MW_None, MW_M8, MW_M16, MW_Conflict };
+
+static MWidth meet(MWidth A, MWidth B) {
+  if (A == MW_None)
+    return B;
+  if (B == MW_None)
+    return A;
+  if (A == B)
+    return A;
+  return MW_Conflict;
+}
+
+// Resolve a lattice value to the concrete width to materialize. M16 stays M16;
+// everything else (None/Conflict/M8) resolves to 8-bit — the always-correct
+// canonical default that matches the ABI entry/boundary state.
+static bool resolveIsM16(MWidth W) { return W == MW_M16; }
+
+// The accumulator width a single instruction requires, or MW_None if it is
+// width-agnostic (carry-init, plain branches/jumps) and so imposes no constraint.
+static MWidth requiredWidth(const MachineInstr &MI) {
+  // ABI: the accumulator is 8-bit across a return and across a call boundary
+  // (the callee assumes 8-bit). Checked before the MLow test — these never carry
+  // MLow, but being explicit documents the invariant.
+  if (MI.isReturn())
+    return MW_M8;
+  if (MI.getDesc().TSFlags & MOS::TSFlagMLow)
+    return MW_M16;
+  if (isMWidthAgnostic(MI))
+    return MW_None;
+  // A plain branch/jump works in either width; the mode it leaves is set by the
+  // CFG dataflow, not by the branch itself. (Returns were handled above.)
+  if (MI.isBranch())
+    return MW_None;
+  if (MI.isCall())
+    return MW_M8;
+  // Every other instruction (ordinary 8-bit ops, our own inserted REP/SEP) runs
+  // 8-bit.
+  return MW_M8;
+}
+
+// ---- X-flag lattice (parallel to M-flag lattice above) ----
+
+// Index-width lattice, parallel to the M lattice.
+enum XWidth { XW_None, XW_X8, XW_X16, XW_Conflict };
+
+static XWidth meet(XWidth A, XWidth B) {
+  if (A == XW_None)
+    return B;
+  if (B == XW_None)
+    return A;
+  if (A == B)
+    return A;
+  return XW_Conflict;
+}
+
+static bool resolveIsX16(XWidth W) { return W == XW_X16; }
+
+// No X-agnostic ops exist yet (no carry-init equivalent for the X flag).
+// Stub retained for symmetry; body returns false so XW_None default covers it.
+static bool isXWidthAgnostic(const MachineInstr &) { return false; }
+
+// The index width a single instruction requires, or XW_None if it is
+// X-width-agnostic (most instructions: M16-only ops, ordinary 8-bit ops, etc.).
+//
+// CRITICAL: most instructions — including LDAbs16, STAbs16, ADCAbs16, … — are
+// completely indifferent to the X flag. The default MUST be XW_None, not XW_X8.
+// Returning XW_X8 by default would force a SEP #$10 after every M16-only op
+// inside an X16 block, defeating 16-bit index mode and generating wrong assembly.
+static XWidth requiredXWidth(const MachineInstr &MI,
+                             const TargetRegisterInfo *TRI) {
+  // ABI: 8-bit index registers across call/return boundaries.
+  if (MI.isReturn() || MI.isCall())
+    return XW_X8;
+  // XLow=1: our new 16-bit X/Y pseudos (INX16, LDXAbs16, TXA16, TAX16, …).
+  if (MI.getDesc().TSFlags & MOS::TSFlagXLow)
+    return XW_X16;
+  // XHigh=1: standard LDX/STX/LDY/STY real instructions (ZeroPage, Absolute,
+  // ZeroPage+index, Absolute+index) and CPX/CPY_Immediate — all require X=8.
+  if (MI.getDesc().TSFlags & MOS::TSFlagXHigh)
+    return XW_X8;
+  // MC pseudos that lower to LDX/STX/LDY/STY when the relevant operand is X
+  // or Y. These survive expandPostRAPseudo (no case there) and reach REPSEP as
+  // pseudos, so their TSFlags carry no XHigh. After RA all registers are
+  // physical, so comparing against MOS::X / MOS::Y is valid.
+  //   LDAbs / LDImag8 / LDImm / STAbs  — operand 0 is the GPR
+  //   INC / DEC (INX/INY/DEX/DEY)       — operand 0 is the GPR (def, tied src)
+  //   STImag8                           — operand 1 is the GPR (op0 = ZP addr)
+  //   CMPImm / CMPImag8 / CMPAbs        — operand 1 is the GPR (op0 = Cc carry)
+  //   LDXIdx / LDYIdx                   — always X / Y destination
+  {
+    auto isXY = [](Register R) { return R == MOS::X || R == MOS::Y; };
+    switch (MI.getOpcode()) {
+    case MOS::LDAbs:
+    case MOS::LDImag8:
+    case MOS::LDImm:
+    case MOS::STAbs:
+    // INC/DEC register form (INX/INY/DEX/DEY): operand 0 is the modified index
+    // reg. The 8-bit pseudo touches it as an 8-bit value, so it must run X8 — in
+    // an X16 ambient `iny` would increment the full 16-bit Y (the 16-bit form is
+    // the dedicated XLow INX16/… pseudo). On A (INA/DEA) operand 0 is the
+    // accumulator → not X/Y → falls through to XW_None (M-governed).
+    case MOS::INC:
+    case MOS::DEC:
+      if (MI.getOperand(0).isReg() && isXY(MI.getOperand(0).getReg()))
+        return XW_X8;
+      break;
+    case MOS::STImag8:
+      if (MI.getOperand(1).isReg() && isXY(MI.getOperand(1).getReg()))
+        return XW_X8;
+      break;
+    // Compare pseudos whose compared value $l (operand 1; operand 0 is the Cc
+    // carry def) is an index reg → CPX/CPY, 8-bit-intent. Must run X8: in an X16
+    // ambient `cpy #imm` reads a 2-byte immediate and compares Y's (garbage) high
+    // byte — the pr49419 xy16 hang. On A (CMP) operand 1 is the accumulator → not
+    // X/Y → XW_None. (CMPImm16 is the 16-bit *accumulator* compare, distinct.)
+    case MOS::CMPImm:
+    case MOS::CMPImag8:
+    case MOS::CMPAbs:
+      if (MI.getOperand(1).isReg() && isXY(MI.getOperand(1).getReg()))
+        return XW_X8;
+      break;
+    case MOS::LDXIdx: // always X dest → LDX_ZeroPageY / LDX_AbsoluteY
+    case MOS::LDYIdx: // always Y dest → LDY_ZeroPageX / LDY_AbsoluteX
+      return XW_X8;
+    // TA = TAX/TAY, TX = TXY/TYX — index-register transfers whose width is
+    // governed by the X flag, so an 8-bit-intent transfer run in X16 corrupts
+    // the high byte (the seed-160 miscompile). The plain pseudos are always
+    // 8-bit-intent: 16-bit transfers use the dedicated TAX16/TAY16/TXA16/TYA16
+    // (XLow=1, handled above). Unconditional X8.
+    // (T_A = TXA/TYA is intentionally NOT here: its width is M-governed and its
+    // result A is X-independent; requiredWidth's MW_M8 default already brackets it.)
+    case MOS::TA:
+    case MOS::TX:
+      return XW_X8;
+    // PH/PL of an index register (PHX/PLX/PHY/PLY) push/pull 2 bytes when X=16;
+    // the 8-bit pseudo is 1-byte-intent. Operand 0 is the reg ($a/$p → M-/flag-
+    // governed, X-agnostic). No 16-bit push/pull pseudo exists.
+    case MOS::PH:
+    case MOS::PL:
+      if (MI.getOperand(0).isReg() && isXY(MI.getOperand(0).getReg()))
+        return XW_X8;
+      break;
+    default:
+      break;
+    }
+  }
+  // Structural catch-all for the 8-bit indexed/indirect family (lda abs,X / lda (zp),Y /
+  // sta zp,X / ALU abs,X / RMW abs,X / the a16 *Idx16 forms with an 8-bit index / …). Any op
+  // that (a) touches memory and (b) reads an index register (X/Y) uses X/Y as an 8-bit ADDRESS
+  // index by construction: every genuine 16-bit-index form takes an Xc16/Yc16 operand and is
+  // XLow=1, so it already returned XW_X16 above (verified 32/32 against MOSInstrLogical.td).
+  // Force X8 so none can dereference a 16-bit index with a garbage high byte in a stray X=16
+  // ambient — the addressing-index sibling of the pr49419 value-compare bug (55ec505).
+  //
+  // Memory-gated on purpose: it must NOT catch the M-governed register transfer T_A (TXA/TYA),
+  // which reads X/Y as a *value* (not an index) and addresses no memory (mayLoad and mayStore
+  // are both false on it). A stray sep #$10 before a T_A reading a live 16-bit X would zero X's
+  // high byte and corrupt the transfer — turning safe hardening into a real regression. The
+  // mayLoad/mayStore gate makes the rule exact: "uses X/Y to address memory."
+  //
+  // Correctness-safe: only ever inserts sep #$10. After RA the index operand is the literal
+  // physical MOS::X/MOS::Y, so exact-match readsRegister suffices; TRI is threaded for
+  // alias-robustness against any future subreg-addressed indexed pseudo.
+  if ((MI.mayLoad() || MI.mayStore()) &&
+      (MI.readsRegister(MOS::X, TRI) || MI.readsRegister(MOS::Y, TRI)))
+    return XW_X8;
+  // Index-reading branch: the JMP (abs,X) jump-table dispatch (JMPIdxIndir, emitted by the
+  // legalizer for switch tables <=128 entries when hasJMPIdxIndir() — set on the 65816). It
+  // reads X as an 8-bit table index but is a non-mayLoad branch, so the memory catch-all above
+  // cannot reach it; it survives to REPSEP as a pseudo (no expandPostRAPseudo case). Force X8
+  // so it can't index the table with a garbage X-high byte in a stray X=16 ambient (a wild
+  // jump). Same safety floor as the memory rule: no branch carries XLow=1, so this only seps.
+  if (MI.isBranch() &&
+      (MI.readsRegister(MOS::X, TRI) || MI.readsRegister(MOS::Y, TRI)))
+    return XW_X8;
+  // Branches are X-agnostic (same treatment as M flag).
+  if (MI.isBranch())
+    return XW_None;
+  (void)isXWidthAgnostic(MI); // stub — always returns false
+  // Everything else — ordinary 8-bit ops, M16-only ops, pseudos — is X-agnostic.
+  // DO NOT return XW_X8 here; that would force X to 8-bit after every LDAbs16.
+  return XW_None;
+}
+
+class MOSInsertREPSEP : public MachineFunctionPass {
+public:
+  static char ID;
+
+  MOSInsertREPSEP() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  StringRef getPassName() const override { return "MOS Insert REP/SEP"; }
+
+private:
+  const TargetInstrInfo *TII = nullptr;
+  const TargetRegisterInfo *TRI = nullptr;
+  bool HasIndex16 = false;
+
+  // Insert REP/SEP instructions at Pos to transition M and/or X to their new
+  // widths. Emits a combined REP/SEP #$30 when both flags switch to the SAME
+  // mode simultaneously; otherwise emits separate instructions per flag.
+  void insertSwitch(MachineBasicBlock &MBB, MachineBasicBlock::iterator Pos,
+                    bool NewM16, bool NewX16, bool MChanged, bool XChanged) {
+    // Combined REP/SEP #$30 when both flags switch to the same mode at once.
+    if (MChanged && XChanged && NewM16 == NewX16) {
+      BuildMI(MBB, Pos, DebugLoc(),
+              TII->get(NewM16 ? MOS::REP_Immediate : MOS::SEP_Immediate))
+          .addImm(MFlagBit | XFlagBit);
+      return;
+    }
+    // Separate instructions for independent or opposite-direction switches.
+    if (MChanged)
+      BuildMI(MBB, Pos, DebugLoc(),
+              TII->get(NewM16 ? MOS::REP_Immediate : MOS::SEP_Immediate))
+          .addImm(MFlagBit);
+    if (XChanged)
+      BuildMI(MBB, Pos, DebugLoc(),
+              TII->get(NewX16 ? MOS::REP_Immediate : MOS::SEP_Immediate))
+          .addImm(XFlagBit);
+  }
+
+  // Seed a block at `EntryIsM16`/`EntryIsX16` and walk it, inserting REP/SEP
+  // only where the next width-requiring instruction disagrees with the running
+  // width. Does NOT force a width at block exit — the running widths flow out.
+  bool placeIntraBlock(MachineBasicBlock &MBB, bool EntryIsM16, bool EntryIsX16);
+
+  // The original Increment-1a behavior: each block begins and ends 8-bit. Always
+  // correct; used as the conservative whole-function fallback.
+  bool placeLegacy(MachineFunction &MF);
+};
+
+} // namespace
+
+bool MOSInsertREPSEP::placeIntraBlock(MachineBasicBlock &MBB,
+                                       bool EntryIsM16, bool EntryIsX16) {
+  bool Changed = false;
+  bool M16 = EntryIsM16, X16 = EntryIsX16;
+  for (MachineInstr &MI : MBB) {
+    MWidth MW = requiredWidth(MI);
+    XWidth XW = HasIndex16 ? requiredXWidth(MI, TRI) : XW_None;
+    if (MW == MW_None && XW == XW_None)
+      continue;
+    bool WantM16 = (MW == MW_None) ? M16 : resolveIsM16(MW);
+    bool WantX16 = (XW == XW_None) ? X16 : resolveIsX16(XW);
+    bool MC = (WantM16 != M16), XC = (WantX16 != X16);
+    if (MC || XC) {
+      insertSwitch(MBB, MI, WantM16, WantX16, MC, XC);
+      M16 = WantM16;
+      X16 = WantX16;
+      Changed = true;
+    }
+  }
+  return Changed;
+}
+
+bool MOSInsertREPSEP::placeLegacy(MachineFunction &MF) {
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    // Determine the final M/X state from the original instructions (before
+    // placeIntraBlock inserts REP/SEP — those would skew a replay).
+    bool EndM16 = false, EndX16 = false;
+    for (MachineInstr &MI : MBB) {
+      MWidth W = requiredWidth(MI);
+      if (W != MW_None)
+        EndM16 = (W == MW_M16);
+      if (HasIndex16) {
+        XWidth XW = requiredXWidth(MI, TRI);
+        if (XW != XW_None)
+          EndX16 = (XW == XW_X16);
+      }
+    }
+    // Each block starts 8-bit (both M and X); bracket any 16-bit run, then
+    // restore 8-bit before the terminator so every branch/return runs 8-bit.
+    Changed |= placeIntraBlock(MBB, /*EntryIsM16=*/false, /*EntryIsX16=*/false);
+    if (EndM16 || EndX16) {
+      insertSwitch(MBB, MBB.getFirstTerminator(),
+                   /*NewM16=*/false, /*NewX16=*/false,
+                   /*MChanged=*/EndM16, /*XChanged=*/EndX16);
+      Changed = true;
+    }
+  }
+  return Changed;
+}
+
+bool MOSInsertREPSEP::runOnMachineFunction(MachineFunction &MF) {
+  const MOSSubtarget &STI = MF.getSubtarget<MOSSubtarget>();
+  // Opt-in only: inert unless 16-bit accumulator mode was requested. Default
+  // (6502, plain mosw65816 far-pointer) codegen is untouched.
+  if (!STI.hasAccum16())
+    return false;
+  TII = STI.getInstrInfo();
+  TRI = STI.getRegisterInfo();
+  HasIndex16 = STI.hasIndex16();
+
+  bool Changed = false;
+
+  // #321 Increment 1a: fuse a 16-bit store-of-zero. A `uint16_t g = 0` lowers to
+  // two adjacent 8-bit `STZAbs @g` / `STZAbs @g+1`; in 16-bit-A mode a single STZ
+  // writes both bytes, so replace the pair with `REP #$20; STZAbs @g; SEP #$20`
+  // (drop the second). The reusable demonstration of REP/SEP-bracketed 16-bit
+  // codegen — no new instruction form, legalizer, or selector needed.
+  SmallVector<std::pair<MachineInstr *, MachineInstr *>, 4> Fusions;
+  SmallPtrSet<MachineInstr *, 8> Consumed;
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : MBB) {
+      if (MI.getOpcode() != MOS::STZAbs || Consumed.count(&MI))
+        continue;
+      MachineInstr *Next = MI.getNextNode();
+      if (!Next || Next->getOpcode() != MOS::STZAbs || Consumed.count(Next))
+        continue;
+      const MachineOperand &Lo = MI.getOperand(0);
+      const MachineOperand &Hi = Next->getOperand(0);
+      if (!Lo.isGlobal() || !Hi.isGlobal() || Lo.getGlobal() != Hi.getGlobal() ||
+          Hi.getOffset() != Lo.getOffset() + 1)
+        continue;
+      Fusions.push_back({&MI, Next});
+      Consumed.insert(&MI);
+      Consumed.insert(Next);
+    }
+  }
+  for (auto &F : Fusions) {
+    MachineInstr *Lo = F.first, *Hi = F.second;
+    MachineBasicBlock &MBB = *Lo->getParent();
+    BuildMI(MBB, *Lo, Lo->getDebugLoc(), TII->get(MOS::REP_Immediate))
+        .addImm(MFlagBit);
+    BuildMI(MBB, *Hi, Lo->getDebugLoc(), TII->get(MOS::SEP_Immediate))
+        .addImm(MFlagBit);
+    Hi->eraseFromParent(); // the kept Lo STZ stores both bytes in 16-bit mode
+    Changed = true;
+  }
+
+  // ---- Cross-block mode propagation (the Increment 2 core) ----
+  //
+  // Step 1 — per-block transfer facts. First[B] / XFirst[B] is the width the
+  // first width-requiring instruction needs (MW_None/XW_None if the block is
+  // "passthrough": it has no width-requiring instruction and merely forwards its
+  // entry width). Last[B] / XLast[B] is the width the last such instruction leaves.
+  DenseMap<MachineBasicBlock *, MWidth> First, Last;
+  DenseMap<MachineBasicBlock *, XWidth> XFirst, XLast;
+  for (MachineBasicBlock &MBB : MF) {
+    MWidth Fst = MW_None, Lst = MW_None;
+    XWidth XFst = XW_None, XLst = XW_None;
+    for (MachineInstr &MI : MBB) {
+      MWidth W = requiredWidth(MI);
+      if (W != MW_None) {
+        if (Fst == MW_None)
+          Fst = W;
+        Lst = W;
+      }
+      if (HasIndex16) {
+        XWidth XW = requiredXWidth(MI, TRI);
+        if (XW != XW_None) {
+          if (XFst == XW_None)
+            XFst = XW;
+          XLst = XW;
+        }
+      }
+    }
+    First[&MBB] = Fst;
+    Last[&MBB] = Lst;
+    XFirst[&MBB] = XFst;
+    XLast[&MBB] = XLst;
+  }
+  auto isPassthroughM = [&](MachineBasicBlock *B) { return First[B] == MW_None; };
+  auto isPassthroughX = [&](MachineBasicBlock *B) { return XFirst[B] == XW_None; };
+
+  MachineBasicBlock *Entry = &MF.front();
+
+  // Step 2 — fixpoint for entry modes In[B] / XIn[B]. A non-passthrough block's
+  // entry width is pinned to First[B] / XFirst[B]: the block will start in
+  // exactly the width its first op needs, and entering edges are fixed up to
+  // deliver that width. The entry block is 8-bit by ABI.
+  DenseMap<MachineBasicBlock *, MWidth> In, Out;
+  DenseMap<MachineBasicBlock *, XWidth> XIn, XOut;
+  for (MachineBasicBlock &MBB : MF) {
+    if (&MBB == Entry) {
+      In[&MBB] = MW_M8;
+      XIn[&MBB] = XW_X8; // ABI entry: both flags are 8-bit
+    } else {
+      In[&MBB] = isPassthroughM(&MBB) ? MW_None : First[&MBB];
+      XIn[&MBB] = (HasIndex16 && !isPassthroughX(&MBB)) ? XFirst[&MBB] : XW_None;
+    }
+  }
+  auto outOfM = [&](MachineBasicBlock *B) -> MWidth {
+    return isPassthroughM(B) ? In[B] : Last[B];
+  };
+  auto outOfX = [&](MachineBasicBlock *B) -> XWidth {
+    return isPassthroughX(B) ? XIn[B] : XLast[B];
+  };
+  bool Stable = false;
+  while (!Stable) {
+    Stable = true;
+    for (MachineBasicBlock &MBB : MF) {
+      if (&MBB == Entry)
+        continue;
+      if (isPassthroughM(&MBB)) {
+        MWidth NewIn = MW_None;
+        for (MachineBasicBlock *Pred : MBB.predecessors())
+          NewIn = meet(NewIn, outOfM(Pred));
+        if (NewIn != In[&MBB]) {
+          In[&MBB] = NewIn;
+          Stable = false;
+        }
+      }
+      if (HasIndex16 && isPassthroughX(&MBB)) {
+        XWidth NewXIn = XW_None;
+        for (MachineBasicBlock *Pred : MBB.predecessors())
+          NewXIn = meet(NewXIn, outOfX(Pred));
+        if (NewXIn != XIn[&MBB]) {
+          XIn[&MBB] = NewXIn;
+          Stable = false;
+        }
+      }
+    }
+  }
+  for (MachineBasicBlock &MBB : MF) {
+    Out[&MBB] = outOfM(&MBB);
+    XOut[&MBB] = outOfX(&MBB);
+  }
+
+  // Step 3a — decide where each mode transition lands.
+  //
+  // A transition on a true critical edge (source has >1 successor AND target has
+  // >1 predecessor) cannot be placed at the source's end without disturbing the
+  // source's other successors. Instead of bailing the whole function, place ONE
+  // absolute-mode entry switch at the *target's start*, which coerces every
+  // in-edge to the target's required entry width in a single REP/SEP. This is
+  // correct because insertSwitch sets an absolute mode and the target's entry
+  // width (In/XIn) is a single well-defined value:
+  //   * M — A16 is never live across an edge (the backend spills it to an Imag16
+  //     ZP slot), so forcing M at the target start never truncates a live
+  //     accumulator.
+  //   * X — forcing X16 only widens (safe). Forcing X8 could truncate an X16
+  //     value live *through* the target, but that requires the target to be
+  //     X-passthrough (it has no X-op, so it does not clobber X); a
+  //     non-passthrough target pins XIn via a real X-op that operates on X at
+  //     that width, so nothing X16 is live-through. The lone unsafe case — an
+  //     X-passthrough target forced to X8 (its XIn came from a conflicting-pred
+  //     meet) — retains the conservative whole-function placeLegacy fallback.
+  // (Before: any such critical edge bailed the entire function to placeLegacy,
+  // which forces 8-bit at every block terminator and so truncated a 16-bit X
+  // value live across a block boundary — the seed-31 miscompile.)
+  struct Placement {
+    MachineBasicBlock *MBB;
+    bool AtEnd;
+    bool MChanged = false, ToM16 = false;
+    bool XChanged = false, ToX16 = false;
+  };
+  SmallVector<Placement, 8> Placements;
+  bool Bail = false;
+  for (MachineBasicBlock &B : MF) {
+    if (&B == Entry)
+      continue; // entry has no CFG predecessor edges; its In=M8/X8 is the ABI state
+    const bool NeedM16 = resolveIsM16(In[&B]);
+    const bool NeedX16 = HasIndex16 ? resolveIsX16(XIn[&B]) : false;
+    // Survey the in-edges: which flags differ on some edge, and whether any
+    // transition is forced onto a true critical edge.
+    bool AnyMDiff = false, AnyXDiff = false, CriticalEdge = false;
+    for (MachineBasicBlock *P : B.predecessors()) {
+      bool M_diff = resolveIsM16(Out[P]) != NeedM16;
+      bool X_diff = HasIndex16 && (resolveIsX16(XOut[P]) != NeedX16);
+      if (!M_diff && !X_diff)
+        continue;
+      AnyMDiff |= M_diff;
+      AnyXDiff |= X_diff;
+      if (P->succ_size() != 1 && B.pred_size() != 1)
+        CriticalEdge = true;
+    }
+    if (CriticalEdge) {
+      // Unsafe only when forcing X8 onto an X-passthrough target (its X8 came
+      // from a conflicting-pred meet, so an X16 value may be live-through).
+      if (AnyXDiff && !NeedX16 && isPassthroughX(&B)) {
+        Bail = true;
+        break;
+      }
+      // One absolute-mode entry switch at the target start covers every in-edge
+      // (redundant on edges that already deliver the right width; correct on the
+      // rest). Skip per-edge placement for this block.
+      Placements.push_back(
+          {&B, /*AtEnd=*/false, AnyMDiff, NeedM16, AnyXDiff, NeedX16});
+      continue;
+    }
+    // No critical edge — per-edge placement (avoids redundant switches).
+    for (MachineBasicBlock *P : B.predecessors()) {
+      bool M_diff = resolveIsM16(Out[P]) != NeedM16;
+      bool X_diff = HasIndex16 && (resolveIsX16(XOut[P]) != NeedX16);
+      if (!M_diff && !X_diff)
+        continue; // edge already delivers the right widths
+      MachineBasicBlock *PlaceMBB;
+      bool AtEnd;
+      if (P->succ_size() == 1) {
+        PlaceMBB = P;
+        AtEnd = true;
+      } else {
+        // B.pred_size() == 1 here (else CriticalEdge would be set). A diff on a
+        // single-predecessor target means XIn/In is pinned by a real op (not a
+        // passthrough meet), so forcing it at the target start is safe.
+        PlaceMBB = &B;
+        AtEnd = false;
+      }
+      Placements.push_back({PlaceMBB, AtEnd,
+                            M_diff, NeedM16, X_diff, NeedX16});
+    }
+  }
+
+  if (Bail) {
+    Changed |= placeLegacy(MF);
+    return Changed;
+  }
+
+  // Step 3b — intra-block placement, each block seeded with its entry widths.
+  for (MachineBasicBlock &MBB : MF)
+    Changed |= placeIntraBlock(MBB,
+                               resolveIsM16(In[&MBB]),
+                               resolveIsX16(XIn[&MBB]));
+
+  // Step 3c — materialize the edge transitions.
+  for (const Placement &Pl : Placements) {
+    MachineBasicBlock::iterator Pos =
+        Pl.AtEnd ? Pl.MBB->getFirstTerminator() : Pl.MBB->begin();
+    insertSwitch(*Pl.MBB, Pos,
+                 Pl.ToM16, Pl.ToX16, Pl.MChanged, Pl.XChanged);
+    Changed = true;
+  }
+
+  return Changed;
+}
+
+char MOSInsertREPSEP::ID = 0;
+
+INITIALIZE_PASS(MOSInsertREPSEP, DEBUG_TYPE, "MOS Insert REP/SEP", false, false)
+
+MachineFunctionPass *llvm::createMOSInsertREPSEPPass() {
+  return new MOSInsertREPSEP;
+}
