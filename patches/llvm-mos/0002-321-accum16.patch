+  // selectSbc16's a16abscmp fold on the ordering path. Defs/Predicates as the
+  // Imag16/Imm16 forms above. (`g1 == 0x1234` is a deferred follow-up — see the v3 plan.)
+  def CmpBrAbsAbs16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, addr16:$l, addr16:$r);
+  }
+  // #321 `g == 0x1234`: near-abs GLOBAL LHS read by `lda abs` (LDAbs16), 16-bit
+  // immediate RHS compared by `cmp #imm` (CMPImm16). expandCmpBr16 -> `LDAbs16 $l;
+  // CMPImm16 $r; BR`. Reachable once the EQ matcher recovers a byte-split constant
+  // (getI16Const) — before that the constant materialized and this never fired.
+  def CmpBrAbsImm16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, addr16:$l, i16imm:$r);
+  }
+  // #321 task7 computed-vs-global: Imag16-resident LHS (computed/indirect value in zp) vs near-abs
+  // GLOBAL RHS — `lda zp_l` (LDAImag16, LhsAbs=false) + `cmp abs_r` (CMPAbs16). The global's
+  // memref rides on this pseudo and is cloned to the CMP by expandCmpBr16. Fills the mixed gap
+  // between CmpBrImag16 (both-Imag16) and CmpBrAbsAbs16 (both-global).
+  def CmpBrImagAbs16 : MOSCmpBr {
+    let Predicates = [HasAccum16];
+    let Defs = [C, A16, NZ];
+    dag InOperandList = (ins label:$tgt, Flag:$flag, i1imm:$flag_val, Imag16:$l, addr16:$r);
+  }
 }
