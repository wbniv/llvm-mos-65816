+// #321 Increment 1b: g = a + b (all 16-bit absolute near globals) =>
+// ADD16Abs, a single 16-bit-accumulator add. Matches the clean pre-legalizer
+// DAG G_STORE(G_ADD(G_LOAD a, G_LOAD b), g); gated on +mos-a16. The matchinfo
+// carries the G_ADD so apply can re-derive the loads.
+def alu16_abs_matchdata : GIDefMatchData<"MachineInstr*">;
+def alu16_abs : GICombineRule<
+  (defs root:$root, alu16_abs_matchdata:$matchinfo),
+  (match (wip_match_opcode G_STORE):$root,
+          [{ return matchAlu16Abs(*${root}, ${matchinfo}); }]),
+  (apply [{ applyAlu16Abs(*${root}, ${matchinfo}); }])>;
+
+// #321 Increment 1c: g = t0 + t1 + ... + tN (>=3 near-abs-global loads) =>
+// G_ADDCHAIN16_ABS, a single 16-bit add chain threading the running sum through
+// A16. Disjoint from alu16_abs (which only fires on a 2-operand load/const ALU).
+def add_chain16 : GICombineRule<
+  (defs root:$root),
+  (match (wip_match_opcode G_STORE):$root,
+          [{ return matchAddChain16(*${root}); }]),
+  (apply [{ applyAddChain16(*${root}); }])>;
+
+// #321 load-fold (c): the MULTI-USE-result form of add_chain16 — t = t0+...+tN
+// (>=3 near-abs loads) where t is reused => G_ADDCHAIN16_ABSLD (result in Imag16),
+// threading the sum through A16 with no intermediate round-trips. Rooted at the G_ADD;
+// disjoint from add_chain16 (single-store result) and alu16_absld (2-operand).
+def add_chain16_ld : GICombineRule<
+  (defs root:$root),
+  (match (wip_match_opcode G_ADD):$root,
+          [{ return matchAddChain16Ld(*${root}); }]),
+  (apply [{ applyAddChain16Ld(*${root}); }])>;
+
+// #321 native s16 load-fold: dst = a OP b (near-abs-global loads, or load + const)
+// where dst is MULTI-USE => G_{...}16_ABSLD, reading the globals directly via the
+// 16-bit absolute forms with the result in Imag16. Rooted at the ALU op (not a
+// store); disjoint from alu16_abs/add_chain16, which need a single store of the
+// result (the >1-use guard in matchAlu16AbsLd prevents stealing their cases).
+def alu16_absld : GICombineRule<
+  (defs root:$root),
+  (match (wip_match_opcode G_ADD, G_SUB, G_AND, G_OR, G_XOR):$root,
+          [{ return matchAlu16AbsLd(*${root}); }]),
+  (apply [{ applyAlu16AbsLd(*${root}); }])>;
+
+// #321 native s16: a fused 16-bit global-to-global copy. DAG
+// G_STORE(single-use G_LOAD(absSrc), absDst) => G_COPY16_ABS, dropping the Imag16
+// temp round-trip the independent load/store selection would otherwise emit. Gated
+// on +mos-a16; both addresses near-abs globals. Disjoint from alu16_abs/add_chain16
+// (those need a G_ALU value, this needs a plain G_LOAD value).
+def copy16abs : GICombineRule<
+  (defs root:$root),
+  (match (wip_match_opcode G_STORE):$root,
+          [{ return matchCopy16Abs(*${root}); }]),
+  (apply [{ applyCopy16Abs(*${root}); }])>;
+
 def fold_adde : GICombineRule<
   (defs root:$root, build_fn_matchinfo:$matchinfo),
   (match (wip_match_opcode G_UADDE, G_SADDE):$root,
@@ -96,6 +148,11 @@ def MOSCombiner : GICombiner<"MOSCombinerImpl", [
