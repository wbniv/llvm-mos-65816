diff --git a/llvm/lib/Target/MOS/MOSMCInstLower.cpp b/llvm/lib/Target/MOS/MOSMCInstLower.cpp
index 75fc2ea7bded..b0badcb4d5ea 100644
--- a/llvm/lib/Target/MOS/MOSMCInstLower.cpp
+++ b/llvm/lib/Target/MOS/MOSMCInstLower.cpp
@@ -39,10 +39,12 @@ static bool canUseZeroPageIdx(const MachineOperand &MO) {
   if (!MO.isGlobal())
     return false;
 
-  // Global values in the zero page must end before the zero page, which means
-  // that pointers based on them can never overflow it.
-  return MO.getGlobal()->getAliaseeObject()->getAddressSpace() ==
-         MOS::AS_ZeroPage;
+  // Zero-page globals must fit wholly in zero page, so valid accesses based
+  // on them cannot overflow it. This applies to both the address space and
+  // explicit zero-page sections.
+  const auto *GV = MO.getGlobal()->getAliaseeObject();
+  return GV->getAddressSpace() == MOS::AS_ZeroPage ||
+         MOS::isZeroPageSectionName(GV->getSection());
 }
 
 // Instructions with indexed addressing must have zero page-matching bases
