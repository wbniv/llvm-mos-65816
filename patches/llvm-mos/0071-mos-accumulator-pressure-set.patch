diff --git a/llvm/test/CodeGen/MOS/accumulator-pressure-set.ll b/llvm/test/CodeGen/MOS/accumulator-pressure-set.ll
new file mode 100644
index 0000000..4e372a4
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/accumulator-pressure-set.ll
@@ -0,0 +1,76 @@
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -O2 -verify-machineinstrs < %s | FileCheck %s
+
+; Without native widths, MOS appends a pressure set for the accumulator with a
+; limit of 1. The generated sets count A only in GPR_LSB, with X, Y and the
+; flags. Without the accumulator set, MachineLICM hoists the round constants of
+; this TEA loop across it and the scheduler lets accumulator values overlap:
+; 4 or 5 more stack spills and a saved carry (bcs/bcc). With the set, the
+; scheduler keeps accumulator values apart, and the computed-carry model keeps
+; the carries of the resulting chains from overlapping, so no carry is saved.
+; (The TEA encipher loop of examples/65816/tea.h, as clang -Os emits it.)
+
+; CHECK-LABEL: tea:
+; CHECK-NOT:     {{bcc|bcs}}
+; CHECK-COUNT-9: Folded Spill
+; CHECK-NOT:     Folded Spill
+; CHECK-NOT:     {{bcc|bcs}}
+; CHECK:         rts
+
+target datalayout = "e-m:e-p:16:8-p1:8:8-p2:32:8-p3:24:8-i16:8-i32:8-i64:8-f32:8-f64:8-a:8-Fi8-n8"
+
+@corpus_result = global i16 0, align 1
+
+define i16 @tea() #0 {
+  br label %1
+
+1:
+  %2 = phi i16 [ 0, %0 ], [ %36, %31 ]
+  %3 = phi i16 [ 0, %0 ], [ %35, %31 ]
+  %4 = zext nneg i16 %2 to i32
+  %5 = or disjoint i16 %2, 8
+  %6 = zext nneg i16 %5 to i32
+  br label %7
+
+7:
+  %8 = phi i8 [ 0, %1 ], [ %29, %7 ]
+  %9 = phi i32 [ 0, %1 ], [ %12, %7 ]
+  %10 = phi i32 [ %6, %1 ], [ %28, %7 ]
+  %11 = phi i32 [ %4, %1 ], [ %20, %7 ]
+  %12 = add i32 %9, -1640531527
+  %13 = shl i32 %10, 4
+  %14 = add i32 %13, 19088743
+  %15 = add i32 %12, %10
+  %16 = lshr i32 %10, 5
+  %17 = add nuw nsw i32 %16, -1985229329
+  %18 = xor i32 %14, %15
+  %19 = xor i32 %18, %17
+  %20 = add i32 %19, %11
+  %21 = shl i32 %20, 4
+  %22 = add i32 %21, -19088744
+  %23 = add i32 %20, %12
+  %24 = xor i32 %22, %23
+  %25 = lshr i32 %20, 5
+  %26 = add nuw nsw i32 %25, 1985229328
+  %27 = xor i32 %24, %26
+  %28 = add i32 %27, %10
+  %29 = add nuw nsw i8 %8, 1
+  %30 = icmp eq i8 %29, 32
+  br i1 %30, label %31, label %7
+
+31:
+  %32 = tail call i16 @llvm.fshl.i16(i16 %3, i16 %3, i16 1)
+  %33 = xor i32 %28, %20
+  %34 = trunc i32 %33 to i16
+  %35 = xor i16 %32, %34
+  %36 = add nuw nsw i16 %2, 1
+  %37 = icmp eq i16 %36, 8
+  br i1 %37, label %38, label %1
+
+38:
+  ret i16 %35
+}
+
+declare i16 @llvm.fshl.i16(i16, i16, i16)
+
+attributes #0 = { nounwind optsize }
