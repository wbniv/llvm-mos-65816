     return MOSGenRegisterInfo::getRegPressureSetLimit(MF, Idx);
+  if (!hasNativePressureSets())
+    return 1;
   auto Units = regunits(NativePressureRegs[Idx - N]);
   return std::distance(Units.begin(), Units.end());
 }
@@ -189,6 +227,10 @@ MOSRegisterInfo::getRegClassPressureSets(const TargetRegisterClass *RC) const {
     const auto &L = NativeClassPSets[RC->getID()];
     if (!L.empty())
       return L.data();
+  } else {
+    const auto &L = AccumClassPSets[RC->getID()];
+    if (!L.empty())
+      return L.data();
   }
   return MOSGenRegisterInfo::getRegClassPressureSets(RC);
 }
@@ -198,6 +240,10 @@ const int *MOSRegisterInfo::getRegUnitPressureSets(MCRegUnit RegUnit) const {
     const auto &L = NativeUnitPSets[static_cast<unsigned>(RegUnit)];
     if (!L.empty())
       return L.data();
+  } else {
+    const auto &L = AccumUnitPSets[static_cast<unsigned>(RegUnit)];
+    if (!L.empty())
+      return L.data();
   }
   return MOSGenRegisterInfo::getRegUnitPressureSets(RegUnit);
