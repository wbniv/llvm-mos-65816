@@ -1,6 +1,11 @@
 ; RUN: llvm-mc -triple mos -motorola-integers --filetype=obj -o=%t.obj %s
 ; RUN: llvm-readelf --relocs -x .header %t.obj | FileCheck %s

+; A symbolic .mos_addr_asciz operand must round-trip as plain text under the
+; non-object-file (-show-encoding) streamer, including when its value is not
+; yet resolvable at parse time.
+; RUN: llvm-mc -triple mos -motorola-integers -show-encoding %s | FileCheck %s --check-prefix=ASM
+
 .section .header,"a",@progbits
   .mos_addr_asciz _start, 5
   .mos_addr_asciz 42, 5
@@ -11,3 +16,5 @@
 # CHECK-LABEL: section '.header':
 # CHECK-NEXT: 0x00000000 30000000 00003432 00000000 39393939 0.....42....9999
 # CHECK-NEXT: 0x00000010 39393939 00                         9999.
+
+# ASM: .mos_addr_asciz _start, 5
