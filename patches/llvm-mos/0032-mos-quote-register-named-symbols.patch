index 51c99f7d705e..0d069114abea 100644
--- a/llvm/lib/Target/MOS/MCTargetDesc/MOSMCAsmInfo.cpp
+++ b/llvm/lib/Target/MOS/MCTargetDesc/MOSMCAsmInfo.cpp
@@ -12,6 +12,7 @@
 
 #include "MOSMCAsmInfo.h"
 #include "MCTargetDesc/MOSMCExpr.h"
+#include "MOSInstPrinter.h"
 #include "MOSMCTargetDesc.h"
 
 #include "llvm/ADT/Enum.h"
@@ -53,6 +54,22 @@ MOSMCAsmInfo::MOSMCAsmInfo(const Triple &TT, const MCTargetOptions &Options)
   SupportsDebugInformation = true;
 
   initializeAtSpecifiers(AtSpecifiers);
+
+  // Symbol names that also denote registers need quotes in operand position.
+  // The parser recognizes both prefixed names and their unprefixed aliases.
+  const auto ReserveName = [&](StringRef Name) {
+    auto It = ReservedNames.insert(Name.lower()).first;
+    getReservedIdentifiers().insert(CachedHashStringRef(It->getKey()));
+  };
+  for (unsigned Reg = 1; Reg < MOS::NUM_TARGET_REGS; ++Reg) {
+    StringRef Name = MOSInstPrinter::getRegisterName(Reg);
+    ReserveName(Name);
+    if (Name.consume_front("llvm_mos_"))
+      ReserveName(Name);
+  }
+  // These operand tokens do not have matching names in the register table.
+  for (StringRef Name : {"sp", "r", "rp", "ya", "psw"})
+    ReserveName(Name);
 }
 
