+// a time. a16-INDEPENDENT (the passing machinery is far-side, not accumulator).
+def FeatureFarCCImag32 :
+  SubtargetFeature<
+    "mos-farcc-imag32", "HasFarCCImag32", "true",
+    "Far-pointer CC variant (a): pass/return a far pointer in one 32-bit Imag32 (RL) quad.">;
+def FeatureFarCCSplit :
+  SubtargetFeature<
+    "mos-farcc-split", "HasFarCCSplit", "true",
+    "Far-pointer CC variant (b): pass/return a far pointer as low-16 (RS pair) + bank byte (RC).">;
+def FeatureFarCCAXY :
+  SubtargetFeature<
+    "mos-farcc-axy", "HasFarCCAXY", "true",
+    "Far-pointer CC variant (c): pass/return a far pointer in A:X (low-16) + Y (bank byte).">;
+def FeatureFarCCStack :
+  SubtargetFeature<
+    "mos-farcc-stack", "HasFarCCStack", "true",
+    "Far-pointer CC variant (d): pass/return a far pointer on the 65816 hardware stack.">;
diff --git a/llvm/lib/Target/MOS/MOSISelLowering.cpp b/llvm/lib/Target/MOS/MOSISelLowering.cpp
