                     CCValAssign::LocInfo LocInfo, ISD::ArgFlagsTy ArgFlags,
                     Type *OrigTy, CCState &State);
 
+/// #320 Inc 4 Ph2: far-pointer calling-convention variant selectors. Each returns
+/// true iff the current function's subtarget has the matching off-by-default
+/// +mos-farcc-* feature (see MOSSubtarget::farPtrCC()). Referenced by the gated
+/// far (addrspace 2) pointer rules in CC_MOS (MOSCallingConv.td); with no feature
+/// set all return false, so a far pointer falls through to the generic near-pointer
+/// rule and default codegen stays byte-identical.
+bool MOSFarCCImag32(CCState &State);
+bool MOSFarCCSplit(CCState &State);
+bool MOSFarCCAXY(CCState &State);
+bool MOSFarCCStack(CCState &State);
+
+/// #320 Inc 4 Ph2 variant (b): custom CC assigner for a far (addrspace 2) pointer
+/// split into a 16-bit offset (an RS# Imag16 pair) + an 8-bit bank (an RC# Imag8).
+/// Pushes TWO custom CCValAssigns for the one value; MOSCallLowering's
+/// assignCustomValue does the pointer<->{offset,bank} (de)composition. Referenced
+/// by the gated far-ptr rule in CC_MOS (MOSCallingConv.td).
+bool CC_MOS_FarPtrSplit(unsigned ValNo, MVT ValVT, MVT LocVT,
+                        CCValAssign::LocInfo LocInfo, ISD::ArgFlagsTy ArgFlags,
+                        CCState &State);
+
+/// #320 Inc 4 Ph2 variant (c): custom CC assigner for a far (addrspace 2) pointer
+/// carried in A:X (16-bit offset, A=low/X=high) + Y (bank byte). Pushes THREE
+/// custom CCValAssigns {A, X, Y}; MOSCallLowering's assignCustomValue dispatches on
+/// the count (3 -> this variant). Referenced by the gated far-ptr rule in CC_MOS.
+bool CC_MOS_FarPtrAXY(unsigned ValNo, MVT ValVT, MVT LocVT,
+                      CCValAssign::LocInfo LocInfo, ISD::ArgFlagsTy ArgFlags,
+                      CCState &State);
+
 } // namespace llvm
 
 #endif // not LLVM_LIB_TARGET_MOS_MOSCALLINGCONV_H
diff --git a/llvm/lib/Target/MOS/MOSCallingConv.td b/llvm/lib/Target/MOS/MOSCallingConv.td
index 3f0d04c55389..b8992d68d97e 100644
--- a/llvm/lib/Target/MOS/MOSCallingConv.td
+++ b/llvm/lib/Target/MOS/MOSCallingConv.td
@@ -58,6 +58,35 @@ let Entry = 1 in {
 def CC_MOS : CallingConv<[
   CCIfType<[i1], CCPromoteToType<i8>>,
 
+  // #320 Inc 4 Ph2: a 32-bit far (addrspace 2) pointer crossing a call. Each
+  // variant is gated on an off-by-default subtarget feature (selected by the A-B
+  // measurement harness via -target-feature). With none set the MOSFarCC* guards
+  // all return false, so these never match and a far pointer falls through to the
+  // generic 16-bit CCIfPtr rule below — exactly as before this change (where it
+  // then errors, since a 16-bit slot can't hold a 24-bit address). Placed BEFORE
+  // CCIfPtr so a selected variant claims the far pointer first.
+  //
+  // Variant (a) Imag32: the whole 32-bit pointer in one Imag32 (RL) quad — the
+  // natural width-extension of how near pointers pass in RS pairs. RL1/RL2/RL3 are
+  // the caller-saved quads (RL0 overlaps the soft-stack pointer RS0, RL4 the
+  // scavenger RS8); they alias RS2..RS7, and CCState::AllocateReg honors the shared
+  // __rc register units so a far ptr and a near ptr never double-book a byte.
+  CCIfPtrAddrSpace<2, CCIf<"MOSFarCCImag32(State)",
+      CCAssignToReg<[RL1, RL2, RL3]>>>,
+
+  // Variant (b) Imag16+bank: 16-bit offset in an RS# pair + bank byte in an RC#.
+  // A heterogeneous {i16,i8} split can't be a uniform CCAssignToReg, so it routes
+  // to the C++ custom assigner CC_MOS_FarPtrSplit (which pushes the two locations);
+  // MOSCallLowering::assignCustomValue does the pointer<->{offset,bank} composition.
+  CCIfPtrAddrSpace<2, CCIf<"MOSFarCCSplit(State)",
+      CCCustom<"CC_MOS_FarPtrSplit">>>,
+
+  // Variant (c) A:X+Y: 16-bit offset in A:X (A=low, X=high) + bank byte in Y. A:X
+  // is not a 16-bit class, so this is a 3-way {i8,i8,i8} split — the custom assigner
+  // CC_MOS_FarPtrAXY pushes the three locations and assignCustomValue composes them.
+  CCIfPtrAddrSpace<2, CCIf<"MOSFarCCAXY(State)",
+      CCCustom<"CC_MOS_FarPtrAXY">>>,
+
   // Pointers are preferentially assigned to imaginary registers so indirect
   // addressing modes work without additional copying.
   //
