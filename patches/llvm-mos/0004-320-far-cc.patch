+  // #320 Inc 4 Ph2 variants (b)/(c): a far (addrspace 2) pointer arriving as a
+  // formal argument / call return was split across registers by a custom CC
+  // assigner. Read each location, zero-extend to 32, shift into place, OR together,
+  // and inttoptr. Dispatch on the VA count: 2 = variant (b) {offset i16 @ 0, bank
+  // i8 @ 16}; 3 = variant (c) {lo i8 @ 0, hi i8 @ 8, bank i8 @ 16}. The top byte
+  // (bits 24..31) stays zero — a far address is 24-bit.
+  unsigned assignCustomValue(CallLowering::ArgInfo &Arg,
+                             ArrayRef<CCValAssign> VAs,
+                             std::function<void()> *Thunk = nullptr) override {
+    assert(Arg.Regs.size() == 1 && "far pointer occupies one vreg");
+    assert((VAs.size() == 2 || VAs.size() == 3) &&
+           "far-ptr split is 2 (variant b) or 3 (variant c) locations");
+
+    Register Combined;
+    auto AddPiece = [&](unsigned Width, unsigned Shift, const CCValAssign &VA) {
+      assert(VA.needsCustom() && "expected custom VA");
+      Register V = MRI.createGenericVirtualRegister(LLT::scalar(Width));
+      assignValueToReg(V, VA.getLocReg(), VA);
+      Register V32 = MIRBuilder.buildZExt(LLT::scalar(32), V).getReg(0);
+      if (Shift)
+        V32 = MIRBuilder
+                  .buildShl(LLT::scalar(32), V32,
+                            MIRBuilder.buildConstant(LLT::scalar(32), Shift))
+                  .getReg(0);
+      Combined = Combined
+                     ? MIRBuilder.buildOr(LLT::scalar(32), Combined, V32).getReg(0)
+                     : V32;
+    };
+
+    if (VAs.size() == 3) {
+      AddPiece(8, 0, VAs[0]);  // A = offset.lo
+      AddPiece(8, 8, VAs[1]);  // X = offset.hi
+      AddPiece(8, 16, VAs[2]); // Y = bank
+    } else {
+      AddPiece(16, 0, VAs[0]);  // RS# = offset (i16)
+      AddPiece(8, 16, VAs[1]);  // RC# = bank (i8)
+    }
+    MIRBuilder.buildIntToPtr(Arg.Regs[0], Combined);
+    return VAs.size();
+  }
