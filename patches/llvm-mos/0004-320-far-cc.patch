+
+  // #320 Inc 4 Ph2 variant (b): a far (addrspace 2) pointer leaving the function
+  // (call arg or return value) is split into a 16-bit offset + an 8-bit bank by
+  // CC_MOS_FarPtrSplit, which pushed two custom CCValAssigns. Decompose the 32-bit
+  // pointer and drive each half to its register. Like ARM's f64->2x GPR split, the
+  // actual copies are deferred via Thunk so they land after mem-loc assignments.
+  unsigned assignCustomValue(CallLowering::ArgInfo &Arg,
+                             ArrayRef<CCValAssign> VAs,
+                             std::function<void()> *Thunk = nullptr) override {
+    assert(Arg.Regs.size() == 1 && "far pointer occupies one vreg");
+    const CCValAssign &OffVA = VAs[0];
+    const CCValAssign &BankVA = VAs[1];
+    assert(OffVA.needsCustom() && BankVA.needsCustom() && "expected custom VAs");
+
+    // offset = (i16)p2 ; bank = (i8)(p2 >> 16). The pointer must be ptrtoint'd
+    // first: generic trunc/extract can't operate on a pointer type directly.
+    auto P2Int = MIRBuilder.buildPtrToInt(LLT::scalar(32), Arg.Regs[0]);
+    auto Offset = MIRBuilder.buildTrunc(LLT::scalar(16), P2Int);
+    auto Shifted = MIRBuilder.buildLShr(
+        LLT::scalar(32), P2Int,
+        MIRBuilder.buildConstant(LLT::scalar(32), 16));
+    auto Bank = MIRBuilder.buildTrunc(LLT::scalar(8), Shifted);
+
+    Register OffReg = Offset.getReg(0);
+    Register BankReg = Bank.getReg(0);
+    auto DoAssign = [=]() {
+      assignValueToReg(OffReg, OffVA.getLocReg(), OffVA);
+      assignValueToReg(BankReg, BankVA.getLocReg(), BankVA);
+    };
+    if (Thunk)
+      *Thunk = DoAssign;
+    else
+      DoAssign();
+    return 2;
+  }
 };
 
