diff --git a/llvm/lib/Target/MOS/MOSInstructionSelector.cpp b/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
--- a/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
+++ b/llvm/lib/Target/MOS/MOSInstructionSelector.cpp
@@ -2316,6 +2316,19 @@ bool MOSInstructionSelector::selectTrunc(MachineInstr &MI) {
 
   Register From = MI.getOperand(1).getReg();
 
+  // The generated s8 -> s1 pattern normally inserts any needed Ac copy.
+  // If this fallback receives an s8 source, retry through an explicit Ac
+  // copy. The s16 -> s1 path below requires a source wider than s8.
+  if (Builder.getMRI()->getType(From) == S8) {
+    auto &MRI = *Builder.getMRI();
+    Register AcFrom = MRI.createGenericVirtualRegister(S8);
+    MRI.setRegClass(AcFrom, &MOS::AcRegClass);
+    auto Copy = Builder.buildCopy(AcFrom, From);
+    constrainGenericOp(*Copy);
+    MI.getOperand(1).setReg(AcFrom);
+    return selectImpl(MI, *CoverageInfo);
+  }
+
   assert(Builder.getMRI()->getType(From) == LLT::scalar(16));
   assert(Builder.getMRI()->getType(MI.getOperand(0).getReg()) ==
          LLT::scalar(1));
diff --git a/llvm/test/CodeGen/MOS/a16-trunc-i32.ll b/llvm/test/CodeGen/MOS/a16-trunc-i32.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/a16-trunc-i32.ll
@@ -0,0 +1,8 @@
+; RUN: llc -mtriple=mos -mcpu=mosw65816 -mattr=+mos-a16 -verify-machineinstrs < %s | FileCheck %s
+
+define i16 @trunc_i32_to_i16(i32 %value) {
+; CHECK-LABEL: trunc_i32_to_i16:
+; CHECK: rts
+  %low = trunc i32 %value to i16
+  ret i16 %low
+}
