+; CHECK: [[L0:%[0-9]+]]:_(s8) = COPY [[D0]]
+; CHECK: [[L1:%[0-9]+]]:_(s8) = COPY [[D1]]
+; CHECK: %{{[0-9]+}}:_(s32) = G_MERGE_VALUES [[L0]](s8), [[L1]](s8), %{{[0-9]+}}(s8), %{{[0-9]+}}(s8)
+; ASM-LABEL: tied_i32:
+; ASM: rts
