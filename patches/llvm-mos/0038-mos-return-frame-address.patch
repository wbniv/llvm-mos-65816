index 70e8bb0d45b3..23b706c2d58e 100644
--- a/llvm/lib/Target/MOS/MOSInstrGISel.td
+++ b/llvm/lib/Target/MOS/MOSInstrGISel.td
@@ -41,6 +41,18 @@ def G_BRCOND_IMM : MOSGenericInstruction {
   let isTerminator = true;
 }

+// One byte of the address the current function returns to, as JSR/JSL left it
+// on the hard stack: byte 0 is the low byte, byte 1 the high byte. Everything
+// pushed on the hard stack since entry sits above that word, so the read stays
+// where it is (hasSideEffects) and MOSLowerReturnAddress expands the selected
+// pseudo once the instruction stream is final and the depth is known.
+def G_RETURN_ADDRESS_BYTE : MOSGenericInstruction {
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins i8imm:$byte);
+  let hasSideEffects = true;
+  let mayLoad = true;
+}
