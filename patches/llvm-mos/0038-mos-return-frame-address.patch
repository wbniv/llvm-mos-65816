index 21910cfeab37..14e033c2449c 100644
--- a/llvm/lib/Target/MOS/MOSInstrPseudos.td
+++ b/llvm/lib/Target/MOS/MOSInstrPseudos.td
@@ -59,6 +59,23 @@ def LDAbsIdx : MOSPseudo {
   let mayLoad = true;
 }

+// The selected forms of G_RETURN_ADDRESS_BYTE, expanded by
+// MOSLowerReturnAddress once the hard-stack depth at the entry block is final.
+// The 6502 family reads the stack through TSX and an absolute indexed load in
+// page 1, so the pseudo owns a scratch X; the 65816 reads it with a
+// stack-relative load and needs no index register.
+let hasSideEffects = true, mayLoad = true in {
+  def ReturnAddressByte : MOSPseudo {
+    dag OutOperandList = (outs Ac:$dst, Xc:$scratch);
+    dag InOperandList = (ins i8imm:$byte);
+  }
+  def ReturnAddressByteSR : MOSPseudo {
+    let Predicates = [HasW65816];
+    dag OutOperandList = (outs Ac:$dst);
+    dag InOperandList = (ins i8imm:$byte);
+  }
+}
