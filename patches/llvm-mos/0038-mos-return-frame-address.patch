diff --git a/llvm/lib/Target/MOS/MOSLowerReturnAddress.cpp b/llvm/lib/Target/MOS/MOSLowerReturnAddress.cpp
new file mode 100644
index 000000000000..1e765145cc0b
--- /dev/null
+++ b/llvm/lib/Target/MOS/MOSLowerReturnAddress.cpp
@@ -0,0 +1,193 @@
+//===-- MOSLowerReturnAddress.cpp - Expand return-address reads -----------===//
+//
+// Part of LLVM-MOS, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Expands ReturnAddressByte and ReturnAddressByteSR, the selected forms of
+// __builtin_return_address(0).
+//
+// The word JSR left on the hard stack sits below everything pushed since the
+// function was entered: callee-saved registers, a scavenger PHA/PLA bracket
+// around a frame-index expansion, a PHP. None of that exists before frame
+// lowering and register scavenging, so this pass runs after both. It computes
+// the hard-stack depth at the start of every block by forward dataflow over the
+// CFG (every path into a block must agree, as it must for RTS to work at all),
+// adds the pushes that precede each read within its block, and expands the read
+// with that depth:
+//
+//   6502 family:  tsx ; lda $0100+1+depth+byte,x   (8-bit S, stack in page 1;
+//                 SPC700 through its TSX and LDA abs,X equivalents)
+//   65816:        lda 1+depth+byte,s               (16-bit S, stack anywhere
+//                 in bank 0; stack-relative addressing covers it directly)
+//
+//===----------------------------------------------------------------------===//
+
+#include "MOSLowerReturnAddress.h"
+
+#include "MCTargetDesc/MOSMCTargetDesc.h"
+#include "MOS.h"
+#include "MOSInstrInfo.h"
+#include "MOSSubtarget.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/PostOrderIterator.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/Support/ErrorHandling.h"
+
+#define DEBUG_TYPE "mos-lower-return-address"
+
+using namespace llvm;
+
+namespace {
+
+class MOSLowerReturnAddress : public MachineFunctionPass {
+public:
+  static char ID;
+
+  MOSLowerReturnAddress() : MachineFunctionPass(ID) {}
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  StringRef getPassName() const override { return "MOS Lower Return Address"; }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesCFG();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+};
+
+} // namespace
+
+static bool isReturnAddressByte(const MachineInstr &MI) {
+  return MI.getOpcode() == MOS::ReturnAddressByte ||
+         MI.getOpcode() == MOS::ReturnAddressByteSR;
+}
+
+// The net number of bytes MI leaves on the hard stack. A call is balanced by
+// its callee. PHA/PHX/PHY and their pulls move one byte: MOSInsertREPSEP
+// narrows the register before any of them on the 65816.
+static int hardStackPushBytes(const MachineInstr &MI) {
+  switch (MI.getOpcode()) {
+  case MOS::PH:
+  case MOS::PHA_Implied:
+  case MOS::PHX_Implied:
+  case MOS::PHY_Implied:
+  case MOS::PHP_Implied:
+  case MOS::PHB_Implied:
+  case MOS::PHK_Implied:
+    return 1;
+  case MOS::PHD_Implied:
+  case MOS::PEA_Absolute:
+  case MOS::PEI_Indirect:
+  case MOS::PER_Relative:
+    return 2;
+  case MOS::PL:
+  case MOS::PLA_Implied:
+  case MOS::PLX_Implied:
+  case MOS::PLY_Implied:
+  case MOS::PLP_Implied:
+  case MOS::PLB_Implied:
+    return -1;
+  case MOS::PLD_Implied:
+    return -2;
+  default:
+    return 0;
+  }
+}
+
+static int hardStackPushBytes(const MachineBasicBlock &MBB) {
+  int Bytes = 0;
+  for (const MachineInstr &MI : MBB)
+    Bytes += hardStackPushBytes(MI);
+  return Bytes;
+}
+
+// The hard-stack depth relative to function entry at the start of each
+// reachable block.
+static DenseMap<const MachineBasicBlock *, int>
+computeEntryDepths(MachineFunction &MF) {
+  DenseMap<const MachineBasicBlock *, int> Depth;
+  Depth[&MF.front()] = 0;
+  ReversePostOrderTraversal<MachineFunction *> RPOT(&MF);
+  bool Changed = true;
+  while (Changed) {
+    Changed = false;
+    for (const MachineBasicBlock *MBB : RPOT) {
+      auto It = Depth.find(MBB);
+      if (It == Depth.end())
+        continue;
+      int Out = It->second + hardStackPushBytes(*MBB);
+      for (const MachineBasicBlock *Succ : MBB->successors()) {
+        auto SuccIt = Depth.find(Succ);
+        if (SuccIt == Depth.end()) {
+          Depth[Succ] = Out;
+          Changed = true;
+        } else if (SuccIt->second != Out) {
+          report_fatal_error("hard stack depth differs between paths into " +
+                             Twine(Succ->getFullName()));
+        }
+      }
+    }
+  }
+  return Depth;
+}
+
+static void expandReturnAddressByte(MachineInstr &MI, int Depth) {
+  MachineBasicBlock &MBB = *MI.getParent();
+  const MOSSubtarget &STI = MBB.getParent()->getSubtarget<MOSSubtarget>();
+  const TargetInstrInfo &TII = *STI.getInstrInfo();
+  const DebugLoc &DL = MI.getDebugLoc();
+  Register Dst = MI.getOperand(0).getReg();
+  int64_t Byte = MI.getOperand(MI.getNumExplicitDefs()).getImm();
+  // JSR left the word just above the stack pointer: byte 0 at S+1, byte 1 at
+  // S+2, both displaced by what was pushed since.
+  int64_t Offset = 1 + Depth + Byte;
+
+  if (MI.getOpcode() == MOS::ReturnAddressByteSR) {
+    BuildMI(MBB, MI, DL, TII.get(MOS::LDA_StackRelative))
+        .addImm(Offset)
+        .addReg(Dst, RegState::ImplicitDefine);
+  } else {
+    Register Scratch = MI.getOperand(1).getReg();
+    BuildMI(MBB, MI, DL, TII.get(MOS::TSX_Implied))
+        .addReg(Scratch, RegState::ImplicitDefine);
+    BuildMI(MBB, MI, DL, TII.get(MOS::LDAAbsIdx), Dst)
+        .addImm(0x100 + Offset)
+        .addReg(Scratch);
+  }
+  MI.eraseFromParent();
+}
+
+bool MOSLowerReturnAddress::runOnMachineFunction(MachineFunction &MF) {
+  if (!MF.getFrameInfo().isReturnAddressTaken())
+    return false;
+
+  DenseMap<const MachineBasicBlock *, int> EntryDepth = computeEntryDepths(MF);
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    // An unreachable block never runs; any depth serves it.
+    int Depth = EntryDepth.lookup(&MBB);
+    for (MachineInstr &MI : make_early_inc_range(MBB)) {
+      if (isReturnAddressByte(MI)) {
+        expandReturnAddressByte(MI, Depth);
+        Changed = true;
+      } else {
+        Depth += hardStackPushBytes(MI);
+      }
+    }
+  }
+  return Changed;
+}
+
+char MOSLowerReturnAddress::ID = 0;
+
+INITIALIZE_PASS(MOSLowerReturnAddress, DEBUG_TYPE, "MOS Lower Return Address",
+                false, false)
+
+MachineFunctionPass *llvm::createMOSLowerReturnAddressPass() {
+  return new MOSLowerReturnAddress;
+}
