+
+bool MOSSchedStrategy::hasCompetingCarries(ScheduleDAGMI *DAG) const {
+  // Two values cannot overlap if every use of either one must precede the
+  // other's definition. A use at the definition ends the first live range.
+  auto EndsBefore = [&](const CarryValue &A, const CarryValue &B) {
+    return llvm::all_of(A.Users, [&](SUnit *User) {
+      return User == B.Def ||
+             (!User->isBoundaryNode() && DAG->IsReachable(B.Def, User));
+    });
+  };
+  for (unsigned I = 0; I < Carries.size(); ++I)
+    for (unsigned J = I + 1; J < Carries.size(); ++J)
+      if (!EndsBefore(Carries[I], Carries[J]) &&
+          !EndsBefore(Carries[J], Carries[I]))
+        return true;
+  return false;
 }

