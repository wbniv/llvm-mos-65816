   let Predicates = [HasW65816];
   let OutOperandList = (outs);
   let InOperandList = (ins type0:$src, unknown:$addr);
+  let mayStore = true;
+}
+
+// A far global plus an unsigned offset that fits X can use the 65816 absolute-long,X form.
+// The address remains 24-bit even when its numeric value fits in 16 bits.
+def G_LOAD_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$base, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_ABS_IDX : MOSGenericInstruction {
+  let Predicates = [HasW65816];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$base, type1:$index);
+  let mayStore = true;
+}
+
+def G_LOAD_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16];
+  let OutOperandList = (outs type0:$dst);
+  let InOperandList = (ins unknown:$base, type1:$index);
+  let mayLoad = true;
+}
+def G_STORE_FAR_ABS_IDX16 : MOSGenericInstruction {
+  let Predicates = [HasIndex16];
+  let OutOperandList = (outs);
+  let InOperandList = (ins type0:$src, unknown:$base, type1:$index);
   let mayStore = true;
 }
 
