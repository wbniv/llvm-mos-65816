diff --git a/llvm/test/CodeGen/MOS/coalesce-rc-undef.mir b/llvm/test/CodeGen/MOS/coalesce-rc-undef.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/coalesce-rc-undef.mir
@@ -0,0 +1,28 @@
+# RUN: llc -mtriple=mos -mcpu=mosw65816 -run-pass=register-coalescer %s -o - | FileCheck %s
+
+# A value read straight out of an imaginary return register ($rc3) that is then
+# clobbered by a call it stays live across, folded into an Imag16 pair via a
+# sub-register COPY. Coalescing the COPY pulls the `COPY $rc3` def into the pair, so
+# the allocator re-binds the pair to $rc3 across the call's clobber -> a use of $rc3
+# with no reaching def (MachineVerifier: "Using an undefined physical register"). The
+# coalescer must KEEP the COPY (MOSRegisterInfo::shouldCoalesce).
+--- |
+  define void @dont_coalesce_clobbered_rc_into_pair() { ret void }
+  declare void @g()
+...
+---
+name: dont_coalesce_clobbered_rc_into_pair
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $rc3
+    ; CHECK: [[V:%[0-9]+]]:imag8 = COPY $rc3
+    ; CHECK: JSR
+    ; CHECK: undef %{{[0-9]+}}.sublo:imag16 = COPY [[V]]
+    %0:imag8 = COPY $rc3
+    JSR @g, mos_csr, implicit-def $rc3
+    undef %1.sublo:imag16 = COPY %0
+    %1.subhi:imag16 = COPY %0
+    $rc2 = COPY %1.sublo
+    RTS implicit $rc2
+...
