@@ -619,15 +632,8 @@ bool InlineAsmLowering::lowerInlineAsm(

   // Finally, copy the output operands into the output registers
   ArrayRef<Register> ResRegs = GetOrCreateVRegs(Call);
-  // FIXME: This check doesn't account for indirect output constraints (=*).
-  // Indirect outputs write through a pointer argument and don't produce a
-  // return value, so they shouldn't be counted in OutputOperands when
-  // comparing against ResRegs. For example:
-  //   call void asm "...", "=*X"(ptr %p)
-  // has one output constraint (=*X) but returns void (ResRegs is empty).
-  // This causes the check below to incorrectly fail. To fix this, we would
-  // need to filter OutputOperands to only count direct outputs, or track
-  // indirect vs direct outputs separately.
+  // OutputOperands holds the direct outputs only; indirect register outputs
+  // are stored through their pointer below and produce no call result.
   if (ResRegs.size() != OutputOperands.size()) {
     LLVM_DEBUG(dbgs() << "Expected the number of output registers to match the "
                          "number of destination registers (ResRegs="
@@ -691,6 +697,40 @@ bool InlineAsmLowering::lowerInlineAsm(
     }
   }

+  // Store each indirect register output through its pointer argument, as
+  // SelectionDAG does for "=*r"-style constraints.
+  for (GISelAsmOperandInfo &OpInfo : IndirectOutputs) {
+    if (OpInfo.Regs.size() != 1) {
+      LLVM_DEBUG(dbgs() << "Indirect output operands with multiple defining "
+                           "registers are not supported yet\n");
+      return false;
+    }
+    Register SrcReg = OpInfo.Regs[0];
+    unsigned SrcSize = TRI->getRegSizeInBits(SrcReg, *MRI);
+    LLT ValTy = getLLTForType(*OpInfo.IndirectTy, DL);
+    Register Val;
+    if (ValTy.isScalar() && ValTy.getSizeInBits() < SrcSize) {
+      auto Copy = MIRBuilder.buildCopy(LLT::integer(SrcSize), SrcReg);
+      Val = MIRBuilder.buildTrunc(ValTy, Copy).getReg(0);
+    } else if (ValTy.getSizeInBits() == SrcSize) {
+      Val = MIRBuilder.buildCopy(ValTy, SrcReg).getReg(0);
+    } else {
+      LLVM_DEBUG(dbgs() << "Unhandled indirect output operand with mismatched "
+                           "register size\n");
+      return false;
+    }
+    ArrayRef<Register> PtrRegs = GetOrCreateVRegs(*OpInfo.CallOperandVal);
+    if (PtrRegs.size() != 1) {
+      LLVM_DEBUG(dbgs() << "Expected the indirect output pointer to fit into a "
+                           "single virtual register\n");
+      return false;
+    }
+    MachineMemOperand *MMO = MF.getMachineMemOperand(
+        MachinePointerInfo(OpInfo.CallOperandVal), MachineMemOperand::MOStore,
+        ValTy, DL.getABITypeAlign(OpInfo.IndirectTy));
+    MIRBuilder.buildStore(Val, PtrRegs[0], *MMO);
+  }
+
   return true;
 }

diff --git a/llvm/test/CodeGen/AArch64/GlobalISel/inline-asm-indirect-output.ll b/llvm/test/CodeGen/AArch64/GlobalISel/inline-asm-indirect-output.ll
new file mode 100644
index 000000000..9523e2544
--- /dev/null
+++ b/llvm/test/CodeGen/AArch64/GlobalISel/inline-asm-indirect-output.ll
@@ -0,0 +1,34 @@
+; RUN: llc -mtriple=aarch64-linux-gnu -global-isel -global-isel-abort=1 -O0 -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=aarch64-linux-gnu -global-isel -global-isel-abort=1 -O0 < %s | FileCheck %s --check-prefix=ASM
+
+; An indirect register output ("=*r", what Clang emits for "+g") is stored
+; through its pointer argument after the asm instead of being a call result.
+
+define i32 @barrier(i32 %u) {
+; CHECK-LABEL: name: barrier
+; CHECK: [[P:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0.u.addr
+; CHECK: INLINEASM &"", {{.*}} regdef:GPR32common, def [[D:%[0-9]+]], reguse tiedto:$0, %{{[0-9]+}}(tied-def 3)
+; CHECK: [[V:%[0-9]+]]:_(i32) = COPY [[D]]
+; CHECK: G_STORE [[V]](i32), [[P]](p0) :: (store (i32) into %ir.u.addr)
+; ASM-LABEL: barrier:
+; ASM: ret
+  %u.addr = alloca i32, align 4
+  store i32 %u, ptr %u.addr, align 4
+  %v = load i32, ptr %u.addr, align 4
+  call void asm sideeffect "", "=*imr,0"(ptr nonnull elementtype(i32) %u.addr, i32 %v)
+  %r = load i32, ptr %u.addr, align 4
+  ret i32 %r
+}
+
+define void @indirect_narrow(ptr %p) {
+; CHECK-LABEL: name: indirect_narrow
+; CHECK: INLINEASM &"", {{.*}} regdef:GPR32common, def [[D:%[0-9]+]]
+; CHECK: [[W:%[0-9]+]]:_(i32) = COPY [[D]]
+; CHECK: [[V:%[0-9]+]]:_(i8) = G_TRUNC [[W]](i32)
+; CHECK: G_STORE [[V]](i8), %{{[0-9]+}}(p0) :: (store (i8) into %ir.p)
+; ASM-LABEL: indirect_narrow:
+; ASM: strb w{{[0-9]+}}, [x0]
+; ASM: ret
+  call void asm sideeffect "", "=*r"(ptr elementtype(i8) %p)
+  ret void
+}
diff --git a/llvm/test/CodeGen/MOS/inline-asm-indirect-output.ll b/llvm/test/CodeGen/MOS/inline-asm-indirect-output.ll
new file mode 100644
index 000000000..09bfa1fc2
--- /dev/null
+++ b/llvm/test/CodeGen/MOS/inline-asm-indirect-output.ll
@@ -0,0 +1,34 @@
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -stop-after=irtranslator < %s | FileCheck %s
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O2 -verify-machineinstrs < %s | FileCheck %s --check-prefix=ASM
+; RUN: llc -mtriple=mos -mcpu=mos6502 -O0 -verify-machineinstrs < %s | FileCheck %s --check-prefix=ASM
+
+; Clang lowers `asm("" : "+g"(u))` to an indirect register output ("=*imr")
+; whose value is also a tied input. The output is written back through the
+; pointer after the asm; the input is a plain register operand.
+
+define i16 @barrier(i16 %u) {
+; CHECK-LABEL: name: barrier
+; CHECK: [[P:%[0-9]+]]:_(p0) = G_FRAME_INDEX %stack.0.u.addr
+; CHECK: INLINEASM &"", {{.*}} regdef:Imag16, def [[D:%[0-9]+]], reguse tiedto:$0, %{{[0-9]+}}(tied-def 3)
+; CHECK: [[V:%[0-9]+]]:_(s16) = COPY [[D]]
+; CHECK: G_STORE [[V]](s16), [[P]](p0) :: (store (s16) into %ir.u.addr
+; ASM-LABEL: barrier:
+; ASM: rts
+  %u.addr = alloca i16, align 1
+  store i16 %u, ptr %u.addr, align 1
+  %v = load i16, ptr %u.addr, align 1
+  call void asm sideeffect "", "=*imr,0"(ptr nonnull elementtype(i16) %u.addr, i16 %v)
+  %r = load i16, ptr %u.addr, align 1
+  ret i16 %r
+}
+
+define void @indirect_only(ptr %p) {
+; CHECK-LABEL: name: indirect_only
+; CHECK: INLINEASM &"", {{.*}} regdef:Imag8, def [[D:%[0-9]+]]
+; CHECK: [[V:%[0-9]+]]:_(s8) = COPY [[D]]
+; CHECK: G_STORE [[V]](s8), %{{[0-9]+}}(p0) :: (store (s8) into %ir.p)
+; ASM-LABEL: indirect_only:
+; ASM: rts
+  call void asm sideeffect "", "=*r"(ptr elementtype(i8) %p)
+  ret void
+}
