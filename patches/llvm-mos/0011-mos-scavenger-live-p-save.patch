+// by backward dataflow — used by a later PHP — yet still have no def above.)
+static bool hasNoReachingDef(Register Reg, MachineBasicBlock::iterator Pos) {
+  MachineBasicBlock &MBB = *Pos->getParent();
+  const TargetRegisterInfo &TRI =
