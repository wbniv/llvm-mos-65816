diff --git a/llvm/lib/Target/MOS/MCTargetDesc/MOSAsmBackend.cpp b/llvm/lib/Target/MOS/MCTargetDesc/MOSAsmBackend.cpp
--- a/llvm/lib/Target/MOS/MCTargetDesc/MOSAsmBackend.cpp
+++ b/llvm/lib/Target/MOS/MCTargetDesc/MOSAsmBackend.cpp
@@ -224,10 +224,17 @@ void MOSAsmBackend::applyFixup(const MCFragment &F, const MCFixup &Fixup,
     return;
   }
   case MOS::PCRel8:
-  case MOS::PCRel16:
-    Value += getRelativeMOSPCCorrection(Kind == MOS::PCRel16);
-    ;
+  case MOS::PCRel16: {
+    const bool IsPCRel16 = Kind == MOS::PCRel16;
+    Value += getRelativeMOSPCCorrection(IsPCRel16);
+    if (IsResolved && !fitsIntoFixup(static_cast<int64_t>(Value), IsPCRel16)) {
+      Asm->getContext().reportError(
+          Fixup.getLoc(), IsPCRel16 ? "16-bit branch target out of range"
+                                   : "8-bit branch target out of range");
+      return;
+    }
     break;
+  }
   default:
     break;
   }
diff --git a/llvm/test/MC/MOS/branch-range-errors.s b/llvm/test/MC/MOS/branch-range-errors.s
new file mode 100644
--- /dev/null
+++ b/llvm/test/MC/MOS/branch-range-errors.s
@@ -0,0 +1,9 @@
+; RUN: not llvm-mc -triple mos -mcpu=mosw65816 --filetype=obj -o=/dev/null %s 2>&1 | FileCheck %s
+
+; A conditional branch has no automatic long form on the 65816. It must fail
+; rather than silently truncating its signed 8-bit displacement.
+; CHECK: [[#@LINE+1]]:7: error: 8-bit branch target out of range
+  beq far_target
+  .fill 128, 1, 0xea
+far_target:
+  rts
