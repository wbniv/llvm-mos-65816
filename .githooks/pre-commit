#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
shared_hooks=$(git config --global --get core.hooksPath || true)
if [[ -n "$shared_hooks" ]]; then
    case "$shared_hooks" in
        /*) shared_pre_commit="$shared_hooks/pre-commit" ;;
        *) shared_pre_commit="$HOME/$shared_hooks/pre-commit" ;;
    esac
    if [[ -x "$shared_pre_commit" && "$shared_pre_commit" != "$repo_root/.githooks/pre-commit" ]]; then
        "$shared_pre_commit"
    fi
fi

python3 "$repo_root/dev/check-comment-history.py"
python3 "$repo_root/dev/check-defect-evidence.py" --staged

# --staged: judge the staged blobs and HEAD, not concurrent unstaged work.
# Register a reviewed display access site with
# `dev/snes-display-quality.py --update-baseline` (and review the diff).
# CI keeps the whole-tree scan, where the tree really is the commit.
exec "$repo_root/dev/snes-display-quality.py" --staged
