#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
shared_hooks=$(git config --global --get core.hooksPath || true)
if [[ -n "$shared_hooks" ]]; then
    case "$shared_hooks" in
        /*) shared_pre_commit="$shared_hooks/pre-commit" ;;
        *) shared_pre_commit="$HOME/$shared_hooks/pre-commit" ;;
    esac
    if [[ -x "$shared_pre_commit" && "$shared_pre_commit" != "$repo_root/.githooks/pre-commit" ]]; then
        "$shared_pre_commit"
    fi
fi

# --staged: judge what this commit will contain (staged blobs + HEAD), never the
# dirty worktree. On this shared checkout the old whole-tree scan meant one
# concurrent worker's unstaged file blocked everyone's commits, so the
# SNESDQ_SKIP escape hatch it shipped with was used in 40 of 100 commits --
# a gate bypassed that often is not a gate. The hatch is gone; if this fails,
# the finding is in YOUR commit. Register a reviewed site with
# `dev/snes-display-quality.py --update-baseline` (and review the diff).
# CI keeps the whole-tree scan, where the tree really is the commit.
exec "$repo_root/dev/snes-display-quality.py" --staged
